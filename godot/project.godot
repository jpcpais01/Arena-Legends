; Engine configuration file.
config_version=5

[application]

config/name="Arena Legends"
config/description="1v1 auto battler in pixel art"
config/version="0.104.0"
run/main_scene="res://src/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
run/low_processor_mode=false
config/quit_on_go_back=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=576
window/stretch/mode="disabled"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_2d=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.09, 1)
