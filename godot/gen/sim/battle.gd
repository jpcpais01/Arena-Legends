				it["t"] = 0
			elif (it["phase"] == "return") and (it["t"] >= 0.4):
				f["item"] = null
			return
		if ab["kind"] == "repel":
			# The gale bell: it swings while it charges, then tolls a gale all round
			# its owner. Only the enemy is caught; a dodge's i-frames slip through it.
			it["x"] = home_x
			it["y"] = home_y
			if (it["phase"] == "windup") and (it["t"] >= ab["windup"]):
				self.emit({"type": "shockwave", "x": f["x"], "radius": ab["range"], "f": f["id"], "style": "gale"})
				if ((e["alive"] and f["alive"]) and (absf(e["x"] - f["x"]) <= ab["range"])) and (e["y"] < 2.4):
					self.ability_hit(f, e, ab, {"aoe": true})
				it["phase"] = "return"
				it["t"] = 0
			elif (it["phase"] == "return") and (it["t"] >= 0.45):
				f["item"] = null
			return
		if ab["kind"] == "meteor":
			it["x"] = home_x
			it["y"] = home_y
			if (it["phase"] == "windup") and (it["t"] >= ab["windup"]):
