	# ---------------------------------------------------------------------------
	# Blade locks
	# ---------------------------------------------------------------------------
	##  A swing that can bind: a grounded weapon blow from the main hand, not a riposte.
	func bindable(f, ab, a) -> bool:
		return ((((((((ab["kind"] == "melee") and ((ab["slot"] == "basic") or (ab["slot"] == "skill"))) and (not ab.get("airborne"))) and (not a["isCounter"])) and (not a["feint"])) and f["alive"]) and (f["y"] < 0.2)) and (f["pullT"] <= 0))

	## `f`'s swing just went live: if `e`'s swing is about to land too, face to
	## face and in reach of each other, the weapons meet and bind.
	func try_bind(f, e) -> void:
		var a = f["action"]
		var ea = e["action"]
		if (((self.lock != null) or (self.lock_cd > 0)) or self.over) or (ea == null):
			return
