		# left and temperament, with a fair share of luck.
		var sf: float = self.bind_strength(f, ab)
		var se: float = self.bind_strength(e, eb)
		var share: float = sf / (sf + se)
		var edge: float = absf(share - 0.5)
		var winner: float = (-1 if edge < 0.01 else (f["id"] if share > 0.5 else e["id"]))
