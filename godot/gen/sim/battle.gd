				var x: float = CoreMath.clamp_(f["x"] + (dir * minf(1.2, absf(e["x"] - f["x"]) * 0.5)), (-SimConstants.ARENA_HALF_WIDTH) + 0.6, SimConstants.ARENA_HALF_WIDTH - 0.6)
