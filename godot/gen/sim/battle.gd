		var gap: float = CoreMath.clamp_(reach * 0.62, 1.2, 1.9)
		var x: float = CoreMath.clamp_((f["x"] + e["x"]) / 2.0, (-SimConstants.ARENA_HALF_WIDTH) + (gap / 2.0), SimConstants.ARENA_HALF_WIDTH - (gap / 2.0))
		self.lock = {"t": 0, "dur": 0.85 + (0.6 * (1 - minf(1, edge * 6))), "winner": winner, "x": x, "gap": gap, "from": maxf(SimConstants.BODY_GAP, dist), "share": (share if f["id"] == 0 else 1 - share)}
		e["vx"] = 0
		f["vx"] = e["vx"]
		self.hitstop = maxf(self.hitstop, 0.06)
		self.emit({"type": "bind", "x": x, "y": 1.35, "dur": self.lock["dur"]})

	func bind_strength(f, ab) -> float:
		var s = f["stats"]
		return (((((((s["power"] * s["damageMult"]) * s["force"]) * sqrt(ab["power"])) * (1.2 if ab.get("heavy") else 1)) * (0.7 + (0.6 * SimFighter.hp_ratio(f)))) * SimBattle.BIND_STYLE.get(f["profile"]["style"])) * (1.15 if SimFighter.is_unstoppable(f) else 1)) * self.rng.range_(0.8, 1.2)

	## The struggle: both fighters held face to face, swaying, until the
	## stronger drives the other back and breaks through.
	func update_lock() -> void:
		var L = self.lock
		var _d0 = self.fighters
		var a = _d0[0]
		var b = _d0[1]
		var held = (func(f): return (f["alive"] and (not (not (null if f["action"] == null else f["action"].get("lock"))))))
		if (not held.call(a)) or (not held.call(b)):
			# Something else broke it (a knockout, a stun from a totem): whoever still holds swings through.
			var w = (a if held.call(a) else (b if held.call(b) else null))
			if w != null:
				w["action"]["lock"] = false
			self.lock = null
			self.lock_cd = SimBattle.BIND_REST
			self.emit({"type": "unbind", "winner": (w["id"] if w != null else -1), "x": (a["x"] + b["x"]) / 2.0, "y": 1.35})
			return
		L["t"] += SimConstants.DT
		var k: float = L["t"] / float(L["dur"])
		if k >= 1:
			self.break_lock()
			return
		var side: float = (1 if b["x"] >= a["x"] else -1)
		var give: float = (0 if L["winner"] == (-1) else (CoreMath.smoothstep_(0.45, 1, k) * 0.55) * (1 if L["winner"] == 0 else -1))
		var sway: float = (CoreMath.dsin(L["t"] * 11) * 0.05) * (1 - k)
		var half: float = (L["from"] + ((L["gap"] - L["from"]) * CoreMath.smoothstep_(0, 0.15, L["t"]))) / 2.0
		var mid: float = CoreMath.clamp_(L["x"] + (side * (give + sway)), (-SimConstants.ARENA_HALF_WIDTH) + half, SimConstants.ARENA_HALF_WIDTH - half)
		a["x"] = mid - (side * half)
		b["x"] = mid + (side * half)
		b["vx"] = 0
		a["vx"] = b["vx"]

	func break_lock() -> void:
		var L = self.lock
		self.lock = null
		self.lock_cd = SimBattle.BIND_REST
		var _d0 = self.fighters
		var a = _d0[0]
		var b = _d0[1]
		var mid: float = (a["x"] + b["x"]) / 2.0
