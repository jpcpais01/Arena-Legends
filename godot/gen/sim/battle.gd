		var to: float = e["x"]
		f["px"] = to
		f["x"] = f["px"]
		e["px"] = from
		e["x"] = e["px"]
		e["vx"] = 0
		f["vx"] = e["vx"]
		f["facing"] = (1 if signf(e["x"] - f["x"]) >= 0 else -1)
		e["facing"] = (-1 if f["facing"] == 1 else 1)
