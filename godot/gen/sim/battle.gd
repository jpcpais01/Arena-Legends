		if not ready:
			return
		var dx: float = e["x"] - f["x"]
		var dist: float = absf(dx)
		if (signf(dx) != f["facing"]) or (e["facing"] != (-f["facing"])):
			return
		var reach: float = minf(SimFighter.reach_of(f, ab), SimFighter.reach_of(e, eb))
		if (dist > (reach + 0.25)) or (not self.rng.chance(SimBattle.BIND_CHANCE)):
			return
		if ea["phase"] == "windup":
			ea["phase"] = "active"
			ea["t"] = 0
			self.emit({"type": "actionActive", "f": e["id"], "ability": ea["ability"]})
			self.enter_active(e, f, eb)
		ea["lock"] = true
		a["lock"] = ea["lock"]
