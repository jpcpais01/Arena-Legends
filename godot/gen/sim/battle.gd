	func update_zones() -> void:
		for i in range(self.zones.size() - 1, 0 - 1, -1):
			var z = self.zones[i]
			z["life"] -= SimConstants.DT
			var owner = self.fighters[z["owner"]]
			var e = self.other(owner)
			if z["kind"] == "strike":
				# The storm cloud's bolt comes down on its mark (a dodge's i-frames slip it).
				if z["life"] > 0:
					continue
				TS.splice(self.zones, i, 1)
				var hit: bool = ((((((not self.over) and owner["alive"]) and e["alive"]) and (absf(e["x"] - z["x"]) <= (z["radius"] + 0.3))) and (e["y"] < 2.4)) and (e["invuln"] <= 0))
				self.emit({"type": "bolt", "f": owner["id"], "x": z["x"], "hit": hit})
				if hit:
					self.ability_hit(owner, e, SimAbilities.CLOUD_BOLT, {"aoe": true})
				elif (e["invuln"] > 0) and (absf(e["x"] - z["x"]) <= (z["radius"] + 0.3)):
					self.dodged(e, owner)
				continue
			if z["life"] <= 0:
				TS.splice(self.zones, i, 1)
				continue
			if z["kind"] == "vortex":
				# The whirlpool drags them toward its heart; feet off the ground or mid-dodge, it can't.
				if (((not e["alive"]) or (e["invuln"] > 0)) or (e["y"] > 0.6)) or (e["pullT"] > 0):
					continue
				var dx: float = z["x"] - e["x"]
				if (absf(dx) > z["radius"]) or (absf(dx) < 0.05):
					continue
				var pull: float = ((SimBattle.VORTEX["pull"] * e["stats"]["knockbackTaken"]) * (0.5 if SimFighter.get_status(e, "ironskin") != null else 1)) * (0.6 + ((0.4 * absf(dx)) / float(z["radius"])))
				e["x"] += signf(dx) * minf(absf(dx), pull * SimConstants.DT)
				continue
			z["tick"] -= SimConstants.DT
			if (z["tick"]) > 0:
				continue
			var inside: bool = ((e["alive"] and (absf(e["x"] - z["x"]) <= z["radius"])) and (e["invuln"] <= 0))
			if z["kind"] == "totem":
				if ((not inside) or (e["y"] > 2.4)) or (SimFighter.get_status(e, "hidden") != null):
					z["tick"] = 0.1
					continue
				z["tick"] = z["every"]
				self.emit({"type": "zap", "f": owner["id"], "from": z["x"], "to": e["x"]})
				self.zone_hit(owner, e, z["power"], "magic", "totem")
				if e["alive"]:
					self.apply_status(e, owner, {"status": "chill", "duration": 2})
			else:
				# Caltrops only cut feet on the ground.
				if (not inside) or (e["y"] > 0.3):
					z["tick"] = 0.05
					continue
				z["tick"] = z["every"]
				self.zone_hit(owner, e, z["power"], "physical", "caltrops")
				if e["alive"]:
					self.apply_status(e, owner, {"status": "chill", "duration": 1.5})

	func zone_hit(owner, e, raw: float, dtype: String, id: String) -> void:
		var dealt: float = self.apply_damage(owner, e, raw * owner["stats"]["damageMult"], dtype)
		if dealt > 0:
			self.emit({"type": "hit", "attacker": owner["id"], "target": e["id"], "amount": dealt, "crit": false, "dtype": dtype, "blocked": false, "heavy": false, "ability": id, "x": e["x"], "y": e["y"] + (0.3 if id == "caltrops" else 1.4), "killing": (not e["alive"]), "dot": true})

	# ---------------------------------------------------------------------------
	# Hits and damage
	# ---------------------------------------------------------------------------
	## Checks whether `defender` is guarding against `attacker`.
	## Returns 'parry', 'block', 'reflect' or null.
	func guard_check(defender, attacker, ab, p = null, aoe = null) -> Variant:
		if aoe == null: aoe = false
		var a = defender["action"]
		if (a == null) or a["feint"]:
			return null
		var g = defender["abilities"][a["ability"]]
		if (g["kind"] != "guard") or (a["phase"] == "recovery"):
			return null
		# Not guarding yet while the shield or dagger is still coming out.
		if (a["phase"] == "windup") and (a["t"] < a["draw"]):
			return null
		if ab.get("unblockable"):
			return null
		var src_x: float = (p["x"] - signf(p["vx"]) if p != null else attacker["x"])
		var from_front: bool = ((signf(src_x - defender["x"]) == defender["facing"]) or (absf(src_x - defender["x"]) < 0.3))
		if (not from_front) and (not aoe):
			return null
		var guard_time: float = (0 if a["phase"] == "windup" else a["t"])
		var duelist: bool = defender["has"].has("duelist_band")
		var is_parry: bool = guard_time <= (g.get("guard")["parryWindow"] * (1.4 if duelist else 1))
		if is_parry:
			defender["totals"]["parries"] += 1
			# A parry ends the guard quickly so the defender can punish.
			a["phase"] = "recovery"
			a["t"] = 0
			a["recovery"] = 0.1 + a["stow"]
			defender["energy"] = minf(SimConstants.MAX_ENERGY, defender["energy"] + (22 if duelist else 12))
			self.hitstop = maxf(self.hitstop, 0.1)
			self.emit({"type": "parry", "defender": defender["id"], "attacker": attacker["id"], "x": defender["x"] + (defender["facing"] * 0.6), "y": 1.3})
			if p != null:
				if g.get("guard").get("reflectProjectiles"):
					return "reflect"
				return "parry"
			# Punish the attacker.
			attacker["stagger"] = maxf(attacker["stagger"], 0.65)
			if (attacker["action"] != null) and (not attacker["abilities"][attacker["action"]["ability"]].get("hyperArmor")):
				attacker["action"] = null
			self.apply_status(attacker, defender, {"status": "vulnerable", "duration": 1.4})
			if g.get("guard").get("counterPower"):
				# Instant riposte.
				var counter = TS.merge([g, {"id": "riposte", "kind": "melee", "power": g.get("guard").get("counterPower"), "stagger": 0.4, "knockback": 4, "heavy": true, "range": 2.5 * defender["stats"]["reach"]}])
				defender["action"] = {"ability": a["ability"], "phase": "recovery", "t": 0, "total": a["total"], "windup": 0, "active": 0, "recovery": 0.3 + a["stow"], "draw": a["draw"], "stow": a["stow"], "hitsDone": 1, "connected": true, "feint": false, "targetX": attacker["x"], "startX": defender["x"], "isCounter": true, "dir": defender["facing"], "through": false, "combo": 0}
				self.ability_hit(defender, attacker, counter, {"isCounter": true})
				self.emit({"type": "thought", "f": defender["id"], "text": "Perfect parry — riposte!"})
			return "parry"
		defender["totals"]["blocks"] += 1
		return "block"

	##  Returns whether the blow landed clean (not dodged, parried or blocked).
	func ability_hit(att, tgt, ab, opts, blocked = null) -> bool:
		if blocked == null: blocked = false
		if not tgt["alive"]:
			return false
		if tgt["invuln"] > 0:
			if (tgt["action"] != null) and (tgt["abilities"][tgt["action"]["ability"]]["slot"] == "evade"):
				if not self.dodged(tgt, att):
					self.emit({"type": "thought", "f": tgt["id"], "text": "Clean dodge."})
			return false
		if ((not (opts.get("fromProjectile") != null)) and (not opts.get("isCounter"))) and (not blocked):
			var g = self.guard_check(tgt, att, ab, null, (not (not opts.get("aoe"))))
			if g == "parry":
				return false
			if g == "block":
				blocked = true
		# Seer's Blindfold: saw it coming, and simply isn't there when it lands.
		if ((tgt["has"].has("seer_blindfold") and (tgt["foresightCd"] <= 0)) and (not blocked)) and (ab.get("heavy") or ((ab["power"] * att["stats"]["power"]) >= (tgt["stats"]["maxHp"] * 0.03))):
			tgt["foresightCd"] = 10
			self.emit({"type": "foresight", "f": tgt["id"], "x": tgt["x"], "y": tgt["y"] + 1.3})
			return false
		var heavy: bool = (opts.get("heavyOverride") if opts.get("heavyOverride") != null else (not (not ab.get("heavy"))))
		var raw: float = ((att["stats"]["power"] * ab["power"]) * (opts.get("mult") if opts.get("mult") != null else 1)) * att["stats"]["damageMult"]
		if opts.get("fromProjectile") != null:
			raw = ((opts.get("fromProjectile")["power"] * ab["power"]) * (opts.get("mult") if opts.get("mult") != null else 1)) * att["stats"]["damageMult"]
		if (opts.get("fromProjectile") != null) and att["has"].has("hawkeye_hood"):
			raw *= 1.2
		var body: bool = (((not (opts.get("fromProjectile") != null)) and (((ab["kind"] == "melee") or (ab["kind"] == "dash")) or (ab["kind"] == "aoe"))) and (ab["slot"] != "item"))
		# Out of the smoke: the first blow is an ambush.
		var hidden = SimFighter.get_status(att, "hidden")
		if (hidden != null) and (ab["slot"] != "item"):
			raw *= 1.5
			TS.splice(att["statuses"], att["statuses"].find(hidden), 1)
			self.emit({"type": "callout", "f": att["id"], "text": "Ambush!", "color": "#d8d8e8"})
		# Charger Cuisses: a run-up adds weight to the next melee blow.
		var charged: bool = ((body and (ab["kind"] != "aoe")) and (att["chargeT"] >= 0.8))
		if charged:
			raw *= 1.35
			att["chargeT"] = 0
			self.emit({"type": "callout", "f": att["id"], "text": "Charge!", "color": "#ffb060"})
		# Springheel Leggings: off the wall and straight back in.
		if body and (att["springT"] > 0):
			raw *= 1.4
			att["springT"] = 0
		var crit: bool = false
		var sure_crit: bool = (((att["garbT"] > 0) and (ab["slot"] != "item")) and (ab["slot"] != "evade"))
		if (ab["damageType"] != "true") and (sure_crit or self.rng.chance(att["stats"]["critChance"])):
			if sure_crit:
				att["garbT"] = 0
			crit = true
			raw *= att["stats"]["critMult"]
			if att["has"].has("executioner_hood") and ((tgt["hp"] / float(tgt["stats"]["maxHp"])) < 0.3):
				raw *= 1.5
		if blocked:
			var g_2 = tgt["abilities"][tgt["action"]["ability"]]
			raw *= 1 - ((null if g_2.get("guard") == null else g_2.get("guard")["reduction"]) if (null if g_2.get("guard") == null else g_2.get("guard")["reduction"]) != null else 0.5)
		elif (heavy and (att["grudge"] >= 1)) and att["has"].has("grudge_mail"):
			# Grudge Mail: every blow it remembered comes back at once.
			raw += att["grudge"]
			att["grudge"] = 0
			self.emit({"type": "callout", "f": att["id"], "text": "Vengeance!", "color": "#ff6a5a"})
		var dealt: float = self.apply_damage(att, tgt, raw, ab["damageType"])
		var killing: bool = (not tgt["alive"])
		att["totals"]["hits"] += 1
		if crit:
			att["totals"]["crits"] += 1
		att["totals"]["biggestHit"] = maxf(att["totals"]["biggestHit"], dealt)
		self.emit({"type": "hit", "attacker": att["id"], "target": tgt["id"], "amount": dealt, "crit": crit, "dtype": ab["damageType"], "blocked": blocked, "heavy": heavy, "ability": ab["id"], "x": tgt["x"], "y": tgt["y"] + 1.2, "killing": killing})
		if heavy and (not blocked):
			self.hitstop = maxf(self.hitstop, (0.11 if crit else 0.08))
		elif crit:
			self.hitstop = maxf(self.hitstop, 0.05)
		if killing:
			self.hitstop = maxf(self.hitstop, 0.22)
		# Lifesteal (reduced by poison on the attacker), and weapons that drink life on their own.
		var steal: float = att["stats"]["lifesteal"] + (ab.get("drainLife") if ab.get("drainLife") != null else 0)
		if (steal > 0) and (dealt > 0):
			self.heal(att, dealt * steal)
		if ab.get("drainEnergy") and (not blocked):
			var took: float = minf(tgt["energy"], ab.get("drainEnergy"))
			tgt["energy"] -= took
			att["energy"] = minf(SimConstants.MAX_ENERGY, att["energy"] + took)
		# Thorns.
		if ((((((tgt["stats"]["thorns"] > 0) and (not (opts.get("fromProjectile") != null))) and (ab["kind"] != "aoe")) and (ab["kind"] != "blade")) and (ab["kind"] != "repel")) and att["alive"]) and (dealt > 0):
			var back: float = self.apply_damage(tgt, att, dealt * tgt["stats"]["thorns"], "true")
			if back > 0:
				self.emit({"type": "hit", "attacker": tgt["id"], "target": att["id"], "amount": back, "crit": false, "dtype": "true", "blocked": false, "heavy": false, "ability": "thorns", "x": att["x"], "y": att["y"] + 1.4, "killing": (not att["alive"]), "dot": true})
		if not tgt["alive"]:
			return (not blocked)
		# Crowd control & displacement.
		if not blocked:
			if ab.get("stun"):
				self.apply_status(tgt, att, {"status": "stun", "duration": ab.get("stun")})
			if charged:
				self.apply_status(tgt, att, {"status": "stun", "duration": 0.4})
			var ironskin: bool = ((not (not (SimFighter.get_status(tgt, "ironskin") != null))) or SimFighter.is_unstoppable(tgt))
			if ab.get("stagger") and (not ironskin):
				var ta = tgt["action"]
				# Light hits only flinch fighters with low poise; strong bodies hit harder.
				if (((ab.get("stagger") * att["stats"]["force"]) > tgt["stats"]["poise"]) or heavy) or (ta == null):
					if ((ta != null) and (ta["phase"] != "active")) and (not tgt["abilities"][ta["ability"]].get("hyperArmor")):
						tgt["action"] = null
					if tgt["action"] == null:
						tgt["stagger"] = maxf(tgt["stagger"], ab.get("stagger") * (1 - (tgt["stats"]["tenacity"] * 0.5)))
			if ab.get("knockback"):
				var dir: float = (signf(tgt["x"] - att["x"]) if signf(tgt["x"] - att["x"]) else att["facing"])
				var kb: float = ((ab.get("knockback") * att["stats"]["force"]) * tgt["stats"]["knockbackTaken"]) * (0.3 if ironskin else 1)
				tgt["vx"] += dir * kb
				if heavy and (kb > 5):
					tgt["vy"] = maxf(tgt["vy"], kb * 0.45)
			if ab.get("applies") != null:
				for s in ab.get("applies"):
					self.apply_status(tgt, att, s)
			if ab.get("launch") and (not ironskin):
				# Thrown up: helpless until they land.
				tgt["vy"] = maxf(tgt["vy"], ab.get("launch") * tgt["stats"]["knockbackTaken"])
				tgt["y"] = maxf(tgt["y"], 0.05)
				if (tgt["action"] != null) and (not tgt["abilities"][tgt["action"]["ability"]].get("hyperArmor")):
					tgt["action"] = null
				if tgt["action"] == null:
					tgt["stagger"] = maxf(tgt["stagger"], ((2 * tgt["vy"]) / float(SimBattle.GRAVITY)) + 0.1)
			if ab.get("pull") and (not ironskin):
				# The chain drags them to just in front of the thrower.
				var side: float = (signf(tgt["x"] - att["x"]) if signf(tgt["x"] - att["x"]) else att["facing"])
				tgt["pullTo"] = CoreMath.clamp_(att["x"] + (side * 1.3), -SimConstants.ARENA_HALF_WIDTH, SimConstants.ARENA_HALF_WIDTH)
				tgt["pullT"] = minf(0.35, absf(tgt["x"] - tgt["pullTo"]) / 16.0)
				tgt["vx"] = 0
				if (tgt["action"] != null) and (not tgt["abilities"][tgt["action"]["ability"]].get("hyperArmor")):
					tgt["action"] = null
				if tgt["action"] == null:
					tgt["stagger"] = maxf(tgt["stagger"], tgt["pullT"] + 0.2)
				self.emit({"type": "pull", "f": att["id"], "target": tgt["id"]})
			if ab.get("reel") and att["alive"]:
				self.reel(att, tgt, ironskin)
			# Dread Helm: a heavy blow that lands puts the fear in them.
			if ((heavy and att["has"].has("dread_helm")) and (att["dreadCd"] <= 0)) and (ab["slot"] != "item"):
				att["dreadCd"] = 7
				self.apply_status(tgt, att, {"status": "fear", "duration": 1.1})
		else:
			tgt["vx"] += (signf(tgt["x"] - att["x"]) if signf(tgt["x"] - att["x"]) else att["facing"]) * 1.5
		# On-hit items (only for real ability hits, not DoTs/echoes).
		if (((ab["slot"] != "evade") and (not blocked)) and att["has"].has("gladiator_helm")) and (dealt > 0):
			self.apply_status(att, att, {"status": "momentum", "duration": 4})
		if (ab["slot"] != "evade") and (not blocked):
			if att["has"].has("frost_core") and self.rng.chance(0.5):
				self.apply_status(tgt, att, {"status": "chill", "duration": 2.5})
			if att["has"].has("ember_core") and self.rng.chance(0.5):
				self.apply_status(tgt, att, {"status": "burn", "duration": 2})
			if att["has"].has("storm_crown"):
				att["stormCounter"] += 1
				if att["stormCounter"] >= 4:
					att["stormCounter"] = 0
					self.emit({"type": "lightning", "f": att["id"], "x": tgt["x"]})
					var zap: float = self.apply_damage(att, tgt, att["stats"]["power"] * 0.75, "magic")
					self.emit({"type": "hit", "attacker": att["id"], "target": tgt["id"], "amount": zap, "crit": false, "dtype": "magic", "blocked": false, "heavy": true, "ability": "lightning", "x": tgt["x"], "y": tgt["y"] + 2, "killing": (not tgt["alive"])})
					if tgt["alive"]:
						self.apply_status(tgt, att, {"status": "stun", "duration": 0.35})
			if (att["has"].has("echo_stone") and (dealt > 0)) and self.rng.chance(0.35):
				att["echoQueue"].append({"delay": 0.35, "amount": dealt * 0.6, "dtype": ab["damageType"]})
			if (att["has"].has("magpie_mask") and (att["snatchCd"] <= 0)) and (dealt > 0):
				self.snatch(att, tgt)
		return (not blocked)

	##  Applies mitigation, shields, death and revive. Returns HP damage dealt.
	func apply_damage(att, tgt, raw: float, dtype: String) -> float:
		if (not tgt["alive"]) or (raw <= 0):
			return 0
		var dmg: float = (raw * SimConstants.OVERTIME_DAMAGE if att["empowered"] and (not is_same(att, tgt)) else raw)
		if dtype == "physical":
			dmg *= 100 / float((100 + maxf(0, tgt["stats"]["armor"])))
		elif dtype == "magic":
			dmg *= 100 / float((100 + maxf(0, tgt["stats"]["resist"])))
		dmg *= tgt["stats"]["damageTakenMult"]
		dmg = TS.round(dmg)
		if dmg <= 0:
			return 0
		if tgt["has"].has("grudge_mail") and (not is_same(att, tgt)):
			tgt["grudge"] = minf(tgt["stats"]["maxHp"] * 0.15, tgt["grudge"] + (dmg * 0.3))
		tgt["sinceHurt"] = 0
		att["sinceHit"] = 0
		if tgt["shield"] > 0:
			var absorbed: float = minf(tgt["shield"], dmg)
			tgt["shield"] -= absorbed
			dmg -= absorbed
			if tgt["shield"] <= 0:
				self.emit({"type": "shieldBreak", "f": tgt["id"]})
			att["totals"]["damageDealt"] += absorbed
			if dmg <= 0:
				return absorbed
		tgt["hp"] -= dmg
		att["totals"]["damageDealt"] += dmg
		tgt["totals"]["damageTaken"] += dmg
		att["energy"] = minf(SimConstants.MAX_ENERGY, att["energy"] + (dmg * SimConstants.ENERGY_ON_DEAL))
		tgt["energy"] = minf(SimConstants.MAX_ENERGY, tgt["energy"] + (dmg * SimConstants.ENERGY_ON_TAKE))
		if ((tgt["has"].has("hourglass") and (not tgt["rewindUsed"])) and (tgt["hp"] < (tgt["stats"]["maxHp"] * 0.25))) and (tgt["histI"] > 0):
			self.rewind(tgt)
		if (((tgt["hp"] > 0) and (not tgt["secondWind"])) and tgt["has"].has("bloodrite_wraps")) and (tgt["hp"] < (tgt["stats"]["maxHp"] * 0.35)):
			# Second wind: the wraps drink the blood spilled and give it back.
			tgt["secondWind"] = true
			self.emit({"type": "secondWind", "f": tgt["id"]})
			self.heal(tgt, tgt["stats"]["maxHp"] * 0.15)
			self.apply_status(tgt, tgt, {"status": "haste", "duration": 2})
			self.emit({"type": "thought", "f": tgt["id"], "text": "Second wind!"})
		if tgt["hp"] <= 0:
			if tgt["has"].has("phoenix_feather") and (not tgt["phoenixUsed"]):
				tgt["phoenixUsed"] = true
				tgt["hp"] = TS.round(tgt["stats"]["maxHp"] * 0.15)
				tgt["invuln"] = 1.3
				tgt["action"] = null
				tgt["stagger"] = 0
				tgt["statuses"] = TS.filter(tgt["statuses"], (func(s, _a1 = null, _a2 = null): return (((s["id"] == "rage") or (s["id"] == "haste")) or (s["id"] == "ironskin"))))
				self.emit({"type": "revive", "f": tgt["id"]})
				self.emit({"type": "thought", "f": tgt["id"], "text": "Rises from the ashes!"})
				var e = self.other(tgt)
				if (absf(e["x"] - tgt["x"]) < 3.2) and e["alive"]:
					e["vx"] += signf(e["x"] - tgt["x"]) * 9
					self.apply_status(e, tgt, {"status": "burn", "duration": 4, "stacks": 3})
				self.hitstop = maxf(self.hitstop, 0.18)
				return dmg
			tgt["hp"] = 0
			tgt["alive"] = false
			tgt["action"] = null
			tgt["vx"] += signf((tgt["x"] - att["x"] if tgt["x"] - att["x"] else -tgt["facing"])) * 7
			tgt["vy"] = 7
			self.emit({"type": "ko", "f": tgt["id"]})
		return dmg

	## Mirage Boots: a real attack passed through the dodge. The afterimage left
	## where the fighter stood strikes back at a close attacker, and the dodge
	## gives haste. Once per evade. Returns whether a mirage appeared.
	func dodged(f, att) -> bool:
		var a = f["action"]
		if ((((a == null) or a["connected"]) or (not f["has"].has("mirage_boots"))) or (f["abilities"][a["ability"]]["slot"] != "evade")) or self.over:
			return false
		a["connected"] = true
		self.emit({"type": "mirage", "f": f["id"], "x": a["startX"]})
		self.apply_status(f, f, {"status": "haste", "duration": 1.5})
		if ((att["alive"] and (absf(att["x"] - a["startX"]) <= SimBattle.MIRAGE_STRIKE["range"])) and (att["y"] < 2.2)) and (att["invuln"] <= 0):
			self.ability_hit(f, att, SimBattle.MIRAGE_STRIKE, {"isCounter": true})
		return true

	##  Grappling hook: the line bites and reels the thrower in to strike range; the target reels from the knee.
	func reel(att, tgt, ironskin: bool) -> void:
		var side: float = (signf(att["x"] - tgt["x"]) if signf(att["x"] - tgt["x"]) else -tgt["facing"])
		att["pullTo"] = CoreMath.clamp_(tgt["x"] + (side * 1.15), -SimConstants.ARENA_HALF_WIDTH, SimConstants.ARENA_HALF_WIDTH)
		att["pullT"] = minf(0.4, absf(att["x"] - att["pullTo"]) / 18.0)
		att["vx"] = 0
		self.emit({"type": "reel", "f": att["id"], "target": tgt["id"]})
		if ironskin:
			return
		if (tgt["action"] != null) and (not tgt["abilities"][tgt["action"]["ability"]].get("hyperArmor")):
			tgt["action"] = null
		if tgt["action"] == null:
			tgt["stagger"] = maxf(tgt["stagger"], att["pullT"] + 0.35)

	##  Magpie Mask: takes the enemy's best buff for the time it has left, or a pocketful of energy.
	func snatch(att, tgt) -> void:
		att["snatchCd"] = 3.5
		var best = null
		for s in tgt["statuses"]:
			if not SimBattle.STEALABLE.has(s["id"]):
				continue
			if (best == null) or ((s["remaining"] * s["stacks"]) > (best["remaining"] * best["stacks"])):
				best = s
		if best != null:
			TS.splice(tgt["statuses"], tgt["statuses"].find(best), 1)
			var mine = SimFighter.get_status(att, best["id"])
			if mine != null:
				mine["remaining"] = maxf(mine["remaining"], best["remaining"])
				mine["stacks"] = maxf(mine["stacks"], best["stacks"])
			else:
				att["statuses"].append(TS.merge([best, {"source": att["id"], "acc": 0, "tickT": 0}]))
			SimFighter.refresh_stats(tgt)
			SimFighter.refresh_stats(att)
			self.emit({"type": "snatch", "f": att["id"], "from": tgt["id"], "status": best["id"]})
			self.emit({"type": "status", "f": att["id"], "status": best["id"], "stacks": best["stacks"]})
			return
		var took: float = minf(tgt["energy"], 6)
		if took <= 0:
			return
		tgt["energy"] -= took
		att["energy"] = minf(SimConstants.MAX_ENERGY, att["energy"] + took)
		self.emit({"type": "snatch", "f": att["id"], "from": tgt["id"], "status": null})

	##  A bleeding fighter moved `metres` on their own: the wound tears a little more.
	func wound(f, metres: float) -> void:
		var s = SimFighter.get_status(f, "bleed")
		if s != null:
			s["acc"] += ((metres * s["sourcePower"]) * SimConstants.BLEED_PER_M) * s["stacks"]

	##  Sands of Time: back to where (and how healthy) the fighter was a few seconds ago.
	func rewind(f) -> void:
		f["rewindUsed"] = true
		# Oldest sample still in the ring.
		var n: float = minf(f["histI"], SimBattle.HISTORY_SIZE)
		var i: float = fmod((f["histI"] - n), SimBattle.HISTORY_SIZE)
		var x: float = f["hist"][i * 2]
		var hp: float = f["hist"][(i * 2) + 1]
		var from: float = f["x"]
		f["hp"] = maxf(f["hp"], minf(f["stats"]["maxHp"], hp + (f["stats"]["maxHp"] * 0.1)))
		f["px"] = CoreMath.clamp_(x, -SimConstants.ARENA_HALF_WIDTH, SimConstants.ARENA_HALF_WIDTH)
		f["x"] = f["px"]
		f["vx"] = 0
		f["vy"] = 0
		f["y"] = maxf(0, f["y"])
		f["action"] = null
		f["stagger"] = 0
		f["pullT"] = 0
		f["invuln"] = maxf(f["invuln"], 0.5)
		f["statuses"] = TS.filter(f["statuses"], (func(s, _a1 = null, _a2 = null): return (((not SimBattle.HARMFUL.has(s["id"])) and (s["id"] != "stun")) and (s["id"] != "frozen"))))
		self.emit({"type": "rewind", "f": f["id"], "from": from, "to": f["x"]})
		self.emit({"type": "thought", "f": f["id"], "text": "Turns back the sands!"})
		self.hitstop = maxf(self.hitstop, 0.15)

	func heal(f, amount: float) -> void:
		if not f["alive"]:
			return
		var h: float = minf(f["stats"]["maxHp"] - f["hp"], amount * f["stats"]["healMult"])
		if h <= 0:
			return
		f["hp"] += h
		f["totals"]["healed"] += h
		if h >= 4:
			self.emit({"type": "heal", "f": f["id"], "amount": TS.round(h)})

	# ---------------------------------------------------------------------------
	# Movement
	# ---------------------------------------------------------------------------
	func physics(f) -> void:
		var a = f["action"]
		var ab = (f["abilities"][a["ability"]] if a != null else null)
		var locked: bool = (((not (a == null)) or SimFighter.is_disabled(f)) or (not f["alive"]))
		var fear = SimFighter.get_status(f, "fear")
		if f["pullT"] > 0:
			# Dragged by a chain: slides straight to the spot.
			f["pullT"] -= SimConstants.DT
			var dx: float = f["pullTo"] - f["x"]
			var step: float = (dx if f["pullT"] <= 0 else dx * minf(1, SimConstants.DT / float(maxf(SimConstants.DT, f["pullT"]))))
			f["x"] += step
			f["vx"] = 0
		elif ((fear != null) and f["alive"]) and (not SimFighter.is_disabled(f)):
			# Fleeing from whoever scared it.
			var src = self.fighters[fear["source"]]
			var away: float = (signf(f["x"] - src["x"]) if signf(f["x"] - src["x"]) else -f["facing"])
			var dv: float = ((away * f["stats"]["moveSpeed"]) * 1.1) - f["vx"]
			f["vx"] += CoreMath.clamp_(dv, (-28) * SimConstants.DT, 28 * SimConstants.DT)
		elif (not locked) and (not (SimFighter.get_status(f, "root") != null)):
			var target: float = f["move"] * f["stats"]["moveSpeed"]
			var accel: float = 28
