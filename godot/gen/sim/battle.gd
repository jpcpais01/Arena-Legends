		var l = self.other(w)
		w["action"]["lock"] = false
		w["action"]["clash"] = true
		w["energy"] = minf(SimConstants.MAX_ENERGY, w["energy"] + 12)
		l["action"] = null
		l["combo"] = 0
		l["stagger"] = maxf(l["stagger"], 0.5)
		self.emit({"type": "unbind", "winner": w["id"], "x": mid, "y": 1.35})
		self.emit({"type": "thought", "f": w["id"], "text": "Broke through the bind!"})

	##  Boots whose evade does a little more than step away.
	func evade_extras(f, e) -> void:
		var dist: float = absf(e["x"] - f["x"])
		if f["has"].has("frostwalkers"):
