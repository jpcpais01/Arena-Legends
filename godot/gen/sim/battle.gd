	func in_melee_reach(f, e, range_: float) -> bool:
		var dx: float = e["x"] - f["x"]
		var dist: float = absf(dx)
		if dist > range_:
			return false
		if (dist > 0.7) and (signf(dx) != f["facing"]):
			return false
		return e["y"] < 2.2

	func spawn_projectile(f, ab, idx: float) -> void:
		var pr = ab.get("projectile")
		if pr.get("lob"):
			self.spawn_lob(f, ab, idx)
			return
