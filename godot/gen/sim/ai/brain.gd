				go = (((((pinned or kill) or (cornered and (dist < 3))) or slowed) or (self.plan == "allin")) or (self.item_ready > 3.5))
				why = ((ab["name"] + " while they're pinned!") if pinned else ((ab["name"] + " to finish!") if kill else ("Calls the " + ab["name"] + "!")))
			else:
