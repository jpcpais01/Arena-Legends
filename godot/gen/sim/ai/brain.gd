			self.bob_phase += SimConstants.DT * 2.5
			desired = maxf(self.rest_dist, (zone if self.kit["ranged"] else 0)) + (CoreMath.dsin(self.bob_phase) * 0.6)
		# Step in to punish.
		if (c["open"] > 0.3) and brawler:
