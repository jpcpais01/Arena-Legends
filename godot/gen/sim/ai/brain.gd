		elif err < (-0.25):
			move = -toward
		# Bleeding: every step tears the wound, so small adjustments aren't worth it.
		var bleed: float = SimFighter.stacks_of(f, "bleed")
		if ((bleed >= 2) and (absf(err) < (0.6 + (bleed * 0.3)))) and (self.plan != "recover"):
			move = 0
		# Don't back into the wall: hold ground instead.
		if (move == (-toward)) and (absf(f["x"] - (toward * 0.8)) > (SimConstants.ARENA_HALF_WIDTH - 0.4)):
			move = 0
		# A storm mark under my feet: get off it, by the shorter way out.
		var mark = self.mark_on(self.now, f)
		if mark != null:
			var right: float = ((mark["x"] + mark["radius"]) + 0.4) - f["x"]
			var left: float = f["x"] - ((mark["x"] - mark["radius"]) - 0.4)
			var can_r: bool = (f["x"] + right) < (SimConstants.ARENA_HALF_WIDTH - 0.2)
			var can_l: bool = (f["x"] - left) > ((-SimConstants.ARENA_HALF_WIDTH) + 0.2)
			var out: float = (1 if can_r and ((not can_l) or (right <= left)) else -1)
			if move != out:
				move = out
		return move

	# ---------------------------------------------------------------------------
	# Special item attacks (run alongside the body)
