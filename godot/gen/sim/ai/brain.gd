			var t = self.read_threat(b, e)
			var mine: float = a["windup"] - a["t"]
			if (((t != null) and t["melee"]) and (t["tti"] < (mine - 0.02))) and (t["danger"] > 0.05):
				var def = AiKit.ready_defenses(f, self.kit, t["tti"])
				var can_step: bool = ((t["reach"] + 0.3) - absf(e["x"] - f["x"])) < (f["stats"]["moveSpeed"] * (t["tti"] - 0.15))
				if ((def["any"] or can_step) and (b.rng.next() < ((0.35 + (self.p["cunning"] * 0.4)) + (self.p["caution"] * 0.2)))) and b.feint(f):
