	func move_decision(b, c, waiting: bool) -> void:
		self.f["move"] = self.footwork(c, waiting)

	##  Step toward (+), away from (−) the enemy, or hold (0), to keep the plan's spacing.
	func footwork(c, waiting: bool) -> float:
