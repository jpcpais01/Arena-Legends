				var near: bool = dist < 6
				go = ((near and (not guarding)) and (((((open > 0.15) or kill) or (self.plan == "allin")) or ((self.plan == "pressure") and (dist < (self.m["engage"] + 1.6)))) or (self.item_ready > 2.5)))
				why = ((ab["name"] + " on the opening!") if open > 0.15 else ((ab["name"] + " to finish!") if kill else ("Unleashes the " + ab["name"] + "!")))
			if go and b.start_action(f, info["idx"]):
