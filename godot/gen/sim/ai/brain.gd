		# Back off from an incoming melee hit while waiting for timing.
		if ((((c["threat"] != null) and c["threat"]["melee"]) and waiting) and (self.p["caution"] > 0.5)) and (c["threat"]["tti"] < 0.3):
			desired = maxf(desired, dist + 1)
		var err: float = dist - desired
		var move: float = 0
		if err > 0.25:
