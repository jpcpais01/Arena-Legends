			parry = true
		elif (a["defense"] == "armor") or (a["defense"] == "shield"):
			armor = true
		else:
			evade = true
	return {"parry": parry, "evade": evade, "armor": armor, "any": ((parry or evade) or armor)}

##  Fastest startup (seconds) among the fighter's ready attacks that reach `d`.
