		mist.add_color_stop(0, "rgba(190, 230, 240, 0.35)")
		mist.add_color_stop(1, "rgba(0,0,0,0)")
		g.fill_style = mist
		g.fill_rect(ax - 30, seam - 32, 60, 60)
		# Shafts of moonlight through the canopy.
		for _e0 in [[60, 18, 0.05], [96, 10, 0.04], [-130, 14, 0.035]]:
			var ox = _e0[0]
			var wd = _e0[1]
			var a = _e0[2]
			g.global_alpha = a + (sin((self.t * 0.7) + ox) * 0.012)
			g.fill_style = "#cfe8ff"
			g.begin_path()
			g.move_to(ax + ox, -4)
			g.line_to((ax + ox) + wd, -4)
			g.line_to(((ax + ox) + wd) - 70, ay + 14)
			g.line_to((ax + ox) - 70, ay + 14)
			g.close_path()
			g.fill()
		# Fireflies wandering and blinking.
