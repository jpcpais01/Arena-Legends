	pool.add_color_stop(1, "rgba(3, 8, 10, 0.68)")
	g.fill_style = pool
	g.fill_rect(0, 0, RW, RH)
	# The dais: a round, mossy stone with a ring of tiny flowers.
	ellipse(px, X, Y + 4, 52, 11, INK)
	ellipse(px, X, Y + 3, 51, 10, STONE[0])
	ellipse(px, X, Y, 51, 10, INK)
	ellipse(px, X, Y, 50, 9, STONE[1])
	ellipse(px, X, Y - 1, 46, 7, STONE[2])
	for i_12 in range(160):
		var a: float = ((i_12 / 160.0) * PI) * 2
		if hash_(i_12 * 2.3) > 0.45:
			px.call(X + (cos(a) * 50), (Y + (sin(a) * 9)) + 1, 2, 1, MOSS[1 + (i_12 % 2)])
		if (i_12 % 9) == 0:
			px.call(X + (cos(a) * 40), Y + (sin(a) * 6.5), 1, 1, FLOWERS[i_12 % FLOWERS.size()])
	for i_13 in range(30):
		px.call(X + ((hash_(i_13 * 3.1) - 0.5) * 80), (Y - 4) + (hash_(i_13 * 1.7) * 6), 2, 1, STONE[3])
	# Coin piles spilled at the dais' feet.
	for _e5 in [[-1, 1], [1, 0.8]]:
		var s_5 = _e5[0]
		var big = _e5[1]
		var cx_3: float = X + (s_5 * 46)
		var cy_3: float = Y + 10
		var rows = ([15, 13, 10, 7, 4]).map((func(n_2: float, _a1 = null, _a2 = null): return TS.round(n_2 * big)))
		var _fn6 = func(n_3: float, r_3: float, _a2 = null):
			px.call((cx_3 - (n_3 / 2.0)) - 1, (cy_3 - (r_3 * 2)) - 1, n_3 + 2, 3, INK)
		TS.for_each(rows, _fn6)
		var _fn7 = func(n_4: float, r_4: float, _a2 = null):
			px.call(cx_3 - (n_4 / 2.0), cy_3 - (r_4 * 2), n_4, 2, GOLD[1])
			for i_14 in range(0, ceili(n_4), 2):
				px.call((cx_3 - (n_4 / 2.0)) + i_14, cy_3 - (r_4 * 2), 1, 1, (GOLD[3] if hash_((i_14 + (r_4 * 5)) + s_5) > 0.5 else GOLD[2]))
		TS.for_each(rows, _fn7)
		px.call(cx_3 + (s_5 * 9), cy_3 + 1, 3, 2, INK)
		px.call(cx_3 + (s_5 * 9), cy_3 + 1, 2, 1, ("#ff5a9a" if s_5 < 0 else "#7ad8ff"))
	# Stone lanterns, moss on their caps.
	for s_6 in [-1, 1]:
		var bx: float = X + (s_6 * 66)
		var by: float = seam + 6
		px.call(bx - 6, by - 4, 13, 5, INK)
		px.call(bx - 5, by - 3, 11, 3, STONE[1])
		px.call(bx - 5, by - 3, 11, 1, STONE[2])
		px.call(bx - 3, by - 20, 7, 17, INK)
		px.call(bx - 2, by - 20, 5, 17, STONE[1])
		px.call(bx - 2, by - 20, 1, 17, STONE[3])
		px.call(bx - 9, by - 26, 19, 7, INK)
		px.call(bx - 8, by - 25, 17, 5, STONE[2])
		px.call(bx - 8, by - 25, 17, 1, STONE[3])
		px.call(bx - 8, by - 21, 17, 1, STONE[0])
		px.call(bx - 7, by - 27, 15, 2, "#3a1a06")
		for mx2 in [-8, -5, 4, 7]:
			px.call(bx + mx2, by - 21, 2, 1 + (int(mx2) & 1), MOSS[2])
		px.call(bx - 3, by - 6, 2, 3, MOSS[1])
	return {"c": c, "ax": X, "ay": Y}

class ChestFx:
	##  The art canvas everything is painted on.
	var src
	var g
	var gl
	var sprites
	var room
	var glint
	var look: String
	##  CSS px per art px; canvas size in art px.
	var k: float
	var w: float
	var h: float
	var home
	var at
	var center: bool
	var t: float
	var tier
	var glow: float
	var shake: float
	##  Steps of the charge so far (lights the rune ring).
	var steps: float
	var lid_t: float
	var gone: float
	var gone_v: float
	var rays: float
	var ray_tier: String
	var flash: float
	var flash_col: String
	var dim: float
	var dim_target: float
	var beam: float
	var beam_target: float
	var beam_light
	var starfall: float
	##  Light being drawn into the chest before it bursts.
	var gathering: float
	var halo
	var halo_t: float
	var halo_light
	var parts
	var rings
	var mote_t: float
	##  Idle: a little hop now and then, and a glint across the gold.
	var idle: bool
	var hop_t: float
	var glint_t: float
	var zoom: float
	var zoom_base: float
	var punch: float
	var raf: float
	var last: float
	func _init() -> void:
		self.room = null
		self.glint = Canvas2D.Surface.new()
		self.look = "wood"
		self.k = 3
		self.w = 0
		self.h = 0
		self.home = {"x": 0, "y": 0}
		self.at = {"x": 0, "y": 0}
		self.center = false
		self.t = 0
		self.tier = null
		self.glow = 0
		self.shake = 0
		self.steps = 0
		self.lid_t = -1
		self.gone = 0
		self.gone_v = 0
		self.rays = 0
		self.ray_tier = "rare"
		self.flash = 0
		self.flash_col = "#ffffff"
		self.dim = 0
		self.dim_target = 0
		self.beam = 0
		self.beam_target = 0
		self.beam_light = null
		self.starfall = 0
		self.gathering = 0
		self.halo = null
		self.halo_t = 0
		self.halo_light = null
		self.parts = []
		self.rings = []
		self.mote_t = 0
		self.idle = true
		self.hop_t = 1.2
		self.glint_t = 0.8
		self.zoom = 1
		self.zoom_base = 1
		self.punch = 0
		self.raf = 0
		self.last = 0
		self.src = Canvas2D.Surface.new()
		self.src.class_name_ = "chest-fx"
		self.g = self.src.get_context("2d")
		self.sprites = {"wood": {"body": UiChestFx.body_art(UiChestFx.LOOKS["wood"]), "lid": UiChestFx.lid_art(UiChestFx.LOOKS["wood"])}, "grand": {"body": UiChestFx.body_art(UiChestFx.LOOKS["grand"]), "lid": UiChestFx.lid_art(UiChestFx.LOOKS["grand"])}}
		self.glint.width = UiChestFx.W
		self.glint.height = UiChestFx.BODY_H + UiChestFx.LID_H
		self.gl = SceneGlLib.SceneGl.new(self.src)
		self.gl.canvas.class_name_ = "chest-fx"
		self.gl.vignette = {"col": "#000000", "k": 0.45}
		var _fn0 = func():
			self.gl.canvas.replace_with(self.src)
		self.gl.on_lost = _fn0

	##  The element to put on screen.
	func get_canvas() -> Variant:
		return (self.gl.canvas if self.gl.get_ok() else self.src)

	##  The camera pans to put the chest centre stage (or back home).
	func set_centered(on: bool) -> void:
		self.center = on
		self.idle = (not on)
		self.dim_target = (0.35 if on else 0)
		self.gl.vignette["k"] = (0.75 if on else 0.45)

	func reset() -> void:
		self.lid_t = -1
		self.gone = 0
		self.gone_v = 0
		self.glow = 0
		self.tier = null
		self.steps = 0
		self.shake = 0
		self.rays = 0
		self.beam = 0
		self.beam_target = 0
		self.gathering = 0
		self.starfall = 0
		self.zoom_base = 1
		self.halo = null
		self.parts.resize(int(0))
		self.rings.resize(int(0))
		self.gl.clear()
		self.halo_light = null
		self.beam_light = self.halo_light

	##  Chest top (where the light comes out), art px.
	func get_mouth() -> Variant:
		return {"x": self.at["x"], "y": self.at["y"] - UiChestFx.BODY_H}

	func color(tier: String, bright = null, i = null) -> String:
		if bright == null: bright = false
		if i == null: i = 0
		if tier == "epic":
			return UiChestFx.RAINBOW[fmod((i + floor(self.t * 6)), UiChestFx.RAINBOW.size())]
		return UiChestFx.TIER_LIGHT.get(tier)[(1 if bright else 0)]

	##  A steady colour for shader light (epic: its teal and white).
	func hue(tier: String, bright: bool) -> String:
		return UiChestFx.TIER_LIGHT.get(tier)[(1 if bright else 0)]

	##  A tier step during the charge: the chest jumps, light rings out, the room shudders.
	func pulse(tier: String) -> void:
		self.tier = tier
		self.steps += 1
		self.flash_once(self.color(tier, true), 0.18)
		var m = self.get_mouth()
		self.rings.append({"r": 6, "v": 90, "t": 0, "life": 0.5, "col": self.color(tier, true)})
		# Rune ring on the dais: a ring of light racing outward on the floor.
		self.rings.append({"x": self.at["x"], "y": self.at["y"], "r": 20, "v": 140, "t": 0, "life": 0.55, "col": self.color(tier, true)})
		for i in range(26):
			var a: float = ((-PI) / 2.0) + ((randf() - 0.5) * 2.4)
			var v: float = 40 + (randf() * 70)
			self.spark(m["x"] + ((randf() - 0.5) * UiChestFx.W), m["y"], cos(a) * v, sin(a) * v, self.color(tier, (i % 2) == 0, i), 0.5 + (randf() * 0.4), 90, (i % 5) == 0)
		var n: float = UiChestFx.TIERS.find(tier)
		self.gl.shock(m["x"], m["y"], 40 + (n * 14), 1.6 + (n * 0.5), 0.6, self.hue(tier, true))
		self.gl.add({"kind": "glow", "x": m["x"], "y": m["y"], "r0": 16, "r1": 30 + (n * 6), "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 0.7, "life": 0.7})
		self.gl.split(0.8 + (n * 0.4), 0.35)
		self.zoom_base = 1 + minf(0.12, self.steps * 0.03)
		self.punch = 0.035

	##  Light streams into the chest from all around (the moment before it blows).
	func gather(tier: String) -> void:
		self.gathering = 1
		self.tier = tier
		var m = self.get_mouth()
		for i in range(70):
			var a: float = (randf() * PI) * 2
			var r: float = 50 + (randf() * 90)
			self.parts.append({"x": m["x"] + (cos(a) * r), "y": m["y"] + ((sin(a) * r) * 0.7), "vx": 0, "vy": 0, "t": (-randf()) * 0.3, "life": 0.75, "col": self.color(tier, randf() < 0.5, i), "s": 1, "g": 0, "star": randf() < 0.25, "to": m})
		self.gl.add({"kind": "glow", "x": m["x"], "y": m["y"], "r0": 4, "r1": 34, "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 1, "life": 0.6, "fin": 0.95})
		self.gl.add({"kind": "ring", "x": m["x"], "y": m["y"], "r0": 90, "r1": 4, "w": 2, "squash": 0.7, "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 0.6, "life": 0.6, "fin": 0.3})

	##  The lid blows off: flash, shockwaves, a fountain of sparks and gold, then rays.
	func burst(tier: String) -> void:
		self.lid_t = 0
		self.gathering = 0
		self.ray_tier = tier
		self.tier = tier
		self.shake = 0
		self.gone_v = 1.6
		self.flash_once("#ffffff", 0.9)
		var m = self.get_mouth()
		var big: float = (2 if tier == "epic" else (1.5 if tier == "legendary" else 1))
		for i in range(3):
			self.rings.append({"r": 4, "v": 120 + (i * 60), "t": (-i) * 0.08, "life": 0.7, "col": self.color(tier, i == 0, i)})
		for i_2 in range(ceili(90 * big)):
			var a: float = (randf() * PI) * 2
			var v: float = 30 + ((randf() * 150) * big)
			self.spark(m["x"], m["y"], cos(a) * v, (sin(a) * v) - 40, self.color(tier, randf() < 0.5, i_2), 0.6 + (randf() * 0.9), 60, randf() < 0.2)
		# Gold spills out and bounces on the floor.
		for i_3 in range(ceili(22 + (10 * big))):
			var a_2: float = ((-PI) / 2.0) + ((randf() - 0.5) * 2.2)
			var v_2: float = 70 + (randf() * 90)
			self.parts.append({"x": m["x"] + ((randf() - 0.5) * 20), "y": m["y"], "vx": cos(a_2) * v_2, "vy": sin(a_2) * v_2, "t": 0, "life": 1.8 + (randf() * 0.8), "col": UiChestFx.GOLD[2 + (i_3 & 1)], "s": 2, "g": 260, "star": false, "coin": true, "floor": (self.at["y"] + 2) + (randf() * 12)})
		var hi: String = self.hue(tier, true)
		var lo: String = self.hue(tier, false)
		self.gl.shock(m["x"], m["y"], 150 * big, 5 * big, 0.9, hi)
		self.gl.shock(m["x"], m["y"], 70, 3, 0.5, "#ffffff")
		self.gl.add({"kind": "flare", "x": m["x"], "y": m["y"], "r0": 60, "r1": 150 * big, "w": 2.5, "hi": hi, "lo": lo, "power": 1.2, "life": 0.8})
		self.gl.add({"kind": "glow", "x": m["x"], "y": m["y"], "r0": 30, "r1": 70, "hi": hi, "lo": lo, "power": 1, "life": 1.1})
		self.gl.add({"kind": "rays", "x": m["x"], "y": m["y"] - 4, "r0": 60, "r1": 200, "hi": hi, "lo": lo, "power": 0.55, "life": 2.6, "seed": randf() * 50})
		self.gl.zoom_blur(m["x"], m["y"], 0.28 * big, 0.45)
		self.gl.split(2.5 * big, 0.6)
		self.zoom_base = 1
		self.punch = 0.1

	##  A burst of light at a point (a card being revealed); `big` for the best ones.
	func pop(x: float, y: float, tier: String, n = null) -> void:
		if n == null: n = 30
		var big: float = (2 if tier == "epic" else 1)
		self.rings.append({"x": x, "y": y, "r": 3, "v": 80 * big, "t": 0, "life": 0.45, "col": self.color(tier, true)})
		for i in range(ceili(n * big)):
			var a: float = (randf() * PI) * 2
			var v: float = 20 + ((randf() * 90) * big)
			self.spark(x, y, cos(a) * v, sin(a) * v, self.color(tier, randf() < 0.5, i), 0.4 + (randf() * 0.6), 40, randf() < 0.3)
		var r: float = UiChestFx.TIERS.find(tier)
		self.gl.add({"kind": "star", "x": x, "y": y, "r0": 10 + (r * 8), "r1": 22 + (r * 12), "w": 0.8, "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 0.8 + (r * 0.15), "life": 0.5 + (r * 0.1)})
		if r >= 1:
			self.gl.shock(x, y, 26 + (r * 14), 1.2 + (r * 0.6), 0.5, self.hue(tier, true))
		if tier == "epic":
			self.flash_once("#ffffff", 0.45)

	##  The omen before a legendary or epic: darkness, then a pillar of light out of the chest.
	func omen(tier: String) -> void:
		self.tier = tier
		self.ray_tier = tier
		self.dim_target = 0.85
		self.beam_target = 1
		self.glow = 1
		self.shake = 2.4
		if tier == "epic":
			self.starfall = 1
		for i in range(4):
			self.rings.append({"r": 4, "v": 160 + (i * 50), "t": (-i) * 0.12, "life": 0.8, "col": self.color(tier, true, i)})
		var m = self.get_mouth()
		self.gl.end(self.beam_light)
		self.beam_light = self.gl.add({"kind": "beam", "x": m["x"], "y": m["y"], "r0": m["y"] + 20, "r1": m["y"] + 20, "w": (16 if tier == "epic" else 12), "rot": (-PI) / 2.0, "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 1, "life": 6, "fin": 0.04, "hold": true})
		self.gl.shock(m["x"], m["y"], 110, 3, 0.8, self.hue(tier, true))
		self.gl.vignette["k"] = 0.95
		self.zoom_base = 1.14

	##  The tier name lands: an impact frame, a flash and a wide shockwave.
	func slam(tier: String) -> void:
		self.flash_once(self.color(tier, true), 0.5)
		var m = self.get_mouth()
		self.rings.append({"r": 10, "v": 260, "t": 0, "life": 0.9, "col": self.color(tier, true)})
		for i in range(60):
			var a: float = (randf() * PI) * 2
			var v: float = 60 + (randf() * 160)
			self.spark(m["x"], m["y"] - 30, cos(a) * v, sin(a) * v, self.color(tier, randf() < 0.5, i), 0.6 + (randf() * 0.8), 50, randf() < 0.4)
		self.gl.impact(self.hue(tier, true), UiChestFx.INK, 0.09)
		self.gl.shock(m["x"], m["y"] - 30, 200, 6, 1, self.hue(tier, true))
		self.gl.split(3, 0.5)
		self.punch = 0.08

	##  A legendary or epic card turning over: an impact frame and a shockwave from it.
	func impact_at(x: float, y: float, tier: String) -> void:
		self.gl.impact(self.hue(tier, true), UiChestFx.INK, (0.1 if tier == "epic" else 0.07))
		self.gl.shock(x, y, (170 if tier == "epic" else 120), (6 if tier == "epic" else 4), 0.8, self.hue(tier, true))
		self.gl.split((3 if tier == "epic" else 2), 0.45)
		self.gl.add({"kind": "flare", "x": x, "y": y, "r0": 40, "r1": 110, "w": 2, "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 1, "life": 0.6})
		self.flash_once(self.color(tier, true), 0.35)

	func flash_once(col: String, a: float) -> void:
		self.flash_col = col
		self.flash = maxf(self.flash, a)

	##  Lets the dark and the beam go (the burst takes over).
	func release() -> void:
		self.beam_target = 0
		self.starfall = 0
		self.dim_target = (0.35 if self.center else 0)
		self.gl.end(self.beam_light)
		self.beam_light = null
		self.gl.vignette["k"] = (0.75 if self.center else 0.45)

	func spark(x: float, y: float, vx: float, vy: float, col: String, life: float, g: float, star: bool) -> void:
		if self.parts.size() > 460:
			self.parts.pop_front()
		self.parts.append({"x": x, "y": y, "vx": vx, "vy": vy, "t": 0, "life": life, "col": col, "s": (2 if randf() < 0.3 else 1), "g": g, "star": star})

	func update(dt: float) -> void:
		self.t += dt
		var target = ({"x": TS.round(self.w / 2.0), "y": TS.round(self.h * 0.7)} if self.center else self.home)
		var e: float = 1 - exp((-dt) * 7)
		self.at["x"] += (target["x"] - self.at["x"]) * e
		self.at["y"] += (target["y"] - self.at["y"]) * e
		self.dim += (self.dim_target - self.dim) * (1 - exp((-dt) * 6))
		self.punch *= exp((-dt) * 7)
		self.zoom += ((self.zoom_base + self.punch) - self.zoom) * (1 - exp((-dt) * 10))
		if self.lid_t >= 0:
			self.lid_t += dt
		if self.gone_v:
			self.gone = minf(1, self.gone + (dt * self.gone_v))
		self.flash = maxf(0, self.flash - (dt * 2.6))
		self.beam += (self.beam_target - self.beam) * (1 - exp((-dt) * (5 if self.beam_target > self.beam else 3)))
		if self.idle:
			self.hop_t -= dt
			if self.hop_t < (-0.5):
				self.hop_t = 3 + (randf() * 2)
			self.glint_t -= dt
			if self.glint_t < (-0.6):
				self.glint_t = 2.2 + randf()
		if (self.starfall > 0) and (randf() < (dt * 40)):
			self.spark(randf() * self.w, -2, (randf() - 0.3) * 20, 40 + (randf() * 50), UiChestFx.RAINBOW[floor(randf() * UiChestFx.RAINBOW.size())], 2 + randf(), 10, randf() < 0.5)
		if self.halo != null:
			self.halo_t -= dt
			var hl = self.halo
			if self.halo_t <= 0:
				self.halo_t = (0.02 if hl["tier"] == "epic" else 0.04)
				var a: float = (randf() * PI) * 2
				var x: float = hl["x"] + ((cos(a) * hl["r"]) * 0.8)
				var y: float = hl["y"] + (sin(a) * hl["r"])
				self.spark(x, y, (-sin(a)) * 14, (cos(a) * 14) - 6, self.color(hl["tier"], randf() < 0.6, floor(randf() * 5)), 0.8 + (randf() * 0.6), -6, randf() < 0.5)
		# Motes drift up around the chest; thick with the tier colour while it charges.
		self.mote_t -= dt
		if (self.mote_t <= 0) and (self.gone < 1):
			self.mote_t = (0.025 if self.tier else 0.1)
			var col: String = (self.color(self.tier, randf() < 0.5) if self.tier else (UiChestFx.GOLD[3] if randf() < 0.5 else "#d8ff7a"))
			self.spark(self.at["x"] + ((randf() - 0.5) * (UiChestFx.W + 24)), self.at["y"] - (randf() * 8), (randf() - 0.5) * 6, (-10) - (randf() * 18), col, 1.2 + randf(), -4, false)
		for p in self.parts:
			p["t"] += dt
			if p["t"] < 0:
				continue
			if p.get("to") != null:
				# Drawn in toward the chest, faster and faster.
