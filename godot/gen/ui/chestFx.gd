		g.global_alpha = 1
		g.global_composite_operation = "source-over"

	##  Pixel flames in the stone lanterns; they take the tier's colour as the chest charges.
	func draw_flames(ax: float, ay: float) -> void:
		var g = self.g
		var seam: float = ay - 16
		var tier = (self.tier if self.tier and (self.steps > 0) else null)
		for s in [-1, 1]:
			var bx: float = ax + (s * 66)
			var base: float = (seam + 6) - 27
			for i in range(13):
				var x: float = (bx - 6) + i
				var edge: float = 1 - (absf(i - 6) / 6.5)
				var wave: float = sin(((self.t * 10) + (i * 1.1)) + s) + (sin((self.t * 17) - (i * 1.9)) * 0.6)
				var hgt: float = maxf(1, TS.round(((4 + (8 * edge)) * (1 + (self.glow * 0.4))) + (wave * 1.6)))
				for y in range(ceili(hgt)):
					var k: float = y / hgt
					g.fill_style = (self.color(tier, k > 0.75, i) if tier and (k > 0.45) else UiChestFx.FIRE[minf(4, floor(((1 - k) * 2.2) + (edge * 2.4)))])
					g.fill_rect(x, base - y, 1, 1)
			# Embers.
			if randf() < 0.12:
				self.spark(bx + ((randf() - 0.5) * 8), base - 8, (randf() - 0.5) * 6, (-14) - (randf() * 16), (self.color(tier, true) if tier else UiChestFx.FIRE[3]), 0.9 + (randf() * 0.6), -4, false)

	##  The flower ring on the dais: softly twinkling at rest, filling with the tier's light step by step.
	func draw_dais(ax: float, ay: float) -> void:
		var g = self.g
		var n: float = 64
		var lit: float = (minf(1, (self.steps / 3.0) + (self.gathering * 0.4)) if self.tier else 0)
		g.global_composite_operation = "lighter"
		for i in range(ceili(n)):
			var a: float = (((i / n) * PI) * 2) + (self.t * (0.9 if self.tier else 0.15))
			var on: bool = ((((i / n) < lit) or (randf() < 0.05)) if self.tier else fmod((i + floor(self.t * 3)), 8) == 0)
			if not on:
				continue
			g.global_alpha = (0.9 if self.tier else 0.35)
			g.fill_style = (self.color(self.tier, (i % 3) == 0, i) if self.tier else (["#ff8ac8", "#f4f0ff", "#7ad8ff", "#ffd860"])[i % 4])
			g.fill_rect(TS.round(ax + (cos(a) * 40)), TS.round(ay + (sin(a) * 6.5)), (2 if (i % 4) == 0 else 1), 1)
		if self.tier and (self.gone < 1):
			var grd = g.create_radial_gradient(ax, ay, 2, ax, ay, 50)
			grd.add_color_stop(0, self.color(self.tier, false))
			grd.add_color_stop(1, "rgba(0,0,0,0)")
			g.global_alpha = 0.25 + (lit * 0.3)
			g.fill_style = grd
			g.save()
			g.translate(ax, ay)
			g.scale(1, 0.22)
			g.fill_rect(-50, -50, 100, 100)
			g.restore()
		g.global_alpha = 1
		g.global_composite_operation = "source-over"

	func draw_lid(art, x: float, y: float, rot: float, alpha: float) -> void:
		var g = self.g
		g.global_alpha *= alpha
		if rot:
			g.save()
			g.translate(TS.round(x + (UiChestFx.W / 2.0)), TS.round(y + (UiChestFx.LID_H / 2.0)))
			g.rotate(rot)
			g.draw_image(art, (-UiChestFx.W) / 2.0, (-UiChestFx.LID_H) / 2.0)
			g.restore()
		else:
