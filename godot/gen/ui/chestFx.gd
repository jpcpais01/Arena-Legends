			var off: float = fmod((self.t * sp) + (UiChestFx.hash_(x) * 50), (len_ + gap))
			g.fill_style = ("#bfeaf6" if UiChestFx.hash_(x * 7.7) > 0.5 else "#7cc4dc")
			var y: float = (top - (len_ + gap)) + off
			while y < seam:
				var y0: float = maxf(top, TS.round(y))
				var y1: float = minf(seam - 1, TS.round(y + len_))
				if y1 > y0:
					g.fill_rect(x, y0, 1, y1 - y0)
				y += len_ + gap
			x += 1
		g.fill_style = "#e8f8ff"
