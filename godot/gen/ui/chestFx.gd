			var sh: float = (2 if hop else 0)
			g.fill_rect((x0 + 3) + sh, TS.round(self.at["y"]), (UiChestFx.W - 6) - (sh * 2), 2)
			g.fill_rect((x0 + 6) + sh, TS.round(self.at["y"]) + 2, (UiChestFx.W - 12) - (sh * 2), 1)
			g.draw_image(sp["body"]["art"], x0, y0)
