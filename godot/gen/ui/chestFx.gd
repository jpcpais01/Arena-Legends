			var fx_2: float = (ax + ((UiChestFx.hash_(i_2 * 3.7) - 0.5) * 300)) + (sin((self.t * (0.3 + (UiChestFx.hash_(i_2) * 0.4))) + i_2) * 18)
			var fy_2: float = ((seam - 4) - (UiChestFx.hash_(i_2 * 5.9) * 60)) + (sin((self.t * (0.5 + (UiChestFx.hash_(i_2 * 2) * 0.5))) + (i_2 * 2)) * 10)
			var blink: float = maxf(0, sin((self.t * (1.4 + (UiChestFx.hash_(i_2 * 9) * 1.6))) + (i_2 * 4)))
			if blink < 0.05:
				continue
			g.global_alpha = blink * (1 - (self.dim * 0.6))
			g.fill_style = (self.color(self.tier, true, i_2) if self.tier and (self.steps > 0) else "#d8ff7a")
			g.fill_rect(TS.round(fx_2), TS.round(fy_2), 1, 1)
			if blink > 0.8:
				g.global_alpha = 0.3 * blink
				g.fill_rect(TS.round(fx_2) - 1, TS.round(fy_2), 3, 1)
				g.fill_rect(TS.round(fx_2), TS.round(fy_2) - 1, 1, 3)
		g.global_composite_operation = "source-over"
		# Petals drifting down from the canopy.
		for i_3 in range(12):
			var u: float = fmod((UiChestFx.hash_(i_3 * 7.3) + (self.t * (0.04 + (UiChestFx.hash_(i_3) * 0.04)))), 1)
			var x_2: float = ((ax + ((UiChestFx.hash_(i_3 * 3.1) - 0.5) * 280)) + (sin((u * 12) + i_3) * 8)) - (u * 30)
			var y_2: float = (-6) + (u * (ay + 14))
			g.global_alpha = minf(1, sin(u * PI) * 2) * 0.85
			g.fill_style = ("#ff9ad0" if i_3 % 3 else "#ffd0ea")
			g.fill_rect(TS.round(x_2), TS.round(y_2), (2 if fmod((i_3 + floor(self.t * 4)), 3) else 1), 1)
