			var lk = UiChestFx.LOOKS.get(self.look)
			g.fill_style = (self.color(self.tier, sin(self.t * 12) > 0) if self.tier else lk["gem"])
			g.fill_rect(TS.round(x) + 23, TS.round(y) + 2, 6, 2)
			g.fill_style = "#ffffff"
			g.fill_rect(TS.round(x) + 23, TS.round(y) + 2, 1, 1)
			if (not self.tier) and (sin(self.t * 2.2) > 0.92):
