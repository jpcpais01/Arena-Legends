			var a: float = (randf() * PI) * 2
			var v: float = 20 + ((randf() * 90) * big)
			self.spark(x, y, cos(a) * v, sin(a) * v, self.color(tier, randf() < 0.5, i), 0.4 + (randf() * 0.6), 40, randf() < 0.3)
		var r: float = (["rare", "mythic", "legendary", "epic"]).find(tier)
		self.gl.add({"kind": "star", "x": x, "y": y, "r0": 12 + (r * 8), "r1": 24 + (r * 12), "w": 0.8, "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 0.9, "life": 0.6})
		self.gl.add({"kind": "glow", "x": x, "y": y, "r0": 20, "r1": 40 + (r * 6), "hi": self.hue(tier, true), "lo": self.hue(tier, false), "power": 0.6, "life": 1.4})
		if r >= 2:
			self.gl.impact(self.hue(tier, true), UiForgeFx.INK, 0.07)

	func flash_once(col: String, a: float) -> void:
		self.flash_col = col
		self.flash = maxf(self.flash, a)

	# --- Simulation ------------------------------------------------------------------------------
	func mouth() -> Variant:
		return {"x": self.at["x"] + ((UiForgeFx.MOUTH["x0"] + UiForgeFx.MOUTH["x1"]) / 2.0), "y": (self.at["y"] + UiForgeFx.MOUTH["bottom"]) - 6}

	func spark(x: float, y: float, vx: float, vy: float, col: String, life: float, g: float, star: bool) -> void:
		if self.parts.size() > 500:
			self.parts.pop_front()
		self.parts.append({"x": x, "y": y, "vx": vx, "vy": vy, "t": 0, "life": life, "col": col, "s": (2 if randf() < 0.3 else 1), "g": g, "star": star, "puff": false})

	func update(dt: float) -> void:
		self.t += dt
		var target = ({"x": TS.round(self.w / 2.0) + 22, "y": TS.round(self.h * 0.72)} if self.center else self.home)
		var e: float = 1 - exp((-dt) * 9)
		self.at["x"] += (target["x"] - self.at["x"]) * e
		self.at["y"] += (target["y"] - self.at["y"]) * e
		self.dim += (self.dim_target - self.dim) * (1 - exp((-dt) * 6))
		self.punch *= exp((-dt) * 7)
		self.zoom += (((1.06 if self.center and (self.scene_target > 0.5) else 1) + self.punch) - self.zoom) * (1 - exp((-dt) * 8))
		self.scene += (self.scene_target - self.scene) * (1 - exp((-dt) * 4))
		self.heat += (self.heat_target - self.heat) * (1 - exp((-dt) * 3))
		self.hammer += (self.hammer_target - self.hammer) * (1 - exp((-dt) * 8))
		self.beam += (self.beam_target - self.beam) * (1 - exp((-dt) * (5 if self.beam_target > self.beam else 3)))
		self.flash = maxf(0, self.flash - (dt * 2.6))
		self.shake = maxf(0, self.shake - (dt * 5))
		if (self.bar > 0) and (self.beam_target == 0):
			self.bar_heat = maxf(0.3, self.bar_heat - (dt * 0.12))
		# Molten metal in flight: an arc from the furnace to the anvil, dripping sparks.
		if self.pour_t >= 0:
			self.pour_t += dt / 0.6
			var p = self.pour_pos()
			self.spark(p["x"], p["y"], (randf() - 0.5) * 20, 10, UiForgeFx.HEAT[3 + floor(randf() * 3)], 0.4, 120, false)
			if self.pour_t >= 1:
				self.pour_t = -1
				self.bar = 1
				self.bar_heat = 1
				self.shaped = 0
				var x: float = self.at["x"] + 2
				var y: float = (self.at["y"] + UiForgeFx.ANVIL_TOP) - 2
				for i in range(24):
					self.spark(x, y, (randf() - 0.5) * 80, (-randf()) * 60, UiForgeFx.HEAT[3 + floor(randf() * 3)], 0.5, 120, false)
				self.heat_target = 0.7
		# The hammer: swings down fast, lands, then lifts back.
		if self.swing_v > 0:
			self.swing += self.swing_v * dt
			if self.swing >= 1:
				self.swing = 1
				self.swing_v = -3.2
				self.land()
		elif self.swing_v < 0:
			self.swing += self.swing_v * dt
			if self.swing <= 0:
				self.swing = 0
				self.swing_v = 0
		# Embers from the fire, more of them the hotter it burns; the chimney smokes.
		self.ember_t -= dt
		if self.ember_t <= 0:
			self.ember_t = 0.16 - (self.heat * 0.13)
			var m = self.mouth()
			var col: String = (self.color(self.flame_tier, true, floor(randf() * 5)) if self.flame_tier and (randf() < 0.4) else UiForgeFx.HEAT[2 + floor(randf() * 4)])
			self.spark(m["x"] + ((randf() - 0.5) * 18), m["y"] - 4, (randf() - 0.5) * 10, (-15) - ((randf() * 30) * (0.5 + self.heat)), col, 0.8 + (randf() * 0.8), -6, false)
			if randf() < 0.35:
				var cx: float = self.at["x"] + ((UiForgeFx.CHIMNEY["x0"] + UiForgeFx.CHIMNEY["x1"]) / 2.0)
				self.parts.append({"x": cx + ((randf() - 0.5) * 6), "y": self.at["y"] + UiForgeFx.CHIMNEY["top"], "vx": 4 + (randf() * 6), "vy": (-8) - (randf() * 8), "t": 0, "life": 2 + randf(), "col": "#4a4058", "s": 2 + floor(randf() * 2), "g": -2, "star": false, "puff": true})
		if (self.starfall > 0) and (randf() < (dt * 40)):
			self.spark(randf() * self.w, -2, (randf() - 0.3) * 20, 40 + (randf() * 50), UiForgeFx.RAINBOW[floor(randf() * UiForgeFx.RAINBOW.size())], 2 + randf(), 10, randf() < 0.5)
		if self.halo != null:
			self.halo_t -= dt
			var hl = self.halo
			if self.halo_t <= 0:
				self.halo_t = (0.02 if hl["tier"] == "epic" else 0.04)
				var a: float = (randf() * PI) * 2
				self.spark(hl["x"] + ((cos(a) * hl["r"]) * 0.8), hl["y"] + (sin(a) * hl["r"]), (-sin(a)) * 14, (cos(a) * 14) - 6, self.color(hl["tier"], randf() < 0.6, floor(randf() * 5)), 0.8 + (randf() * 0.6), -6, randf() < 0.5)
		for p_2 in self.parts:
			p_2["t"] += dt
			p_2["vy"] += p_2["g"] * dt
			p_2["vx"] *= 1 - (dt * (2 if p_2["puff"] else 1.2))
			p_2["x"] += p_2["vx"] * dt
			p_2["y"] += p_2["vy"] * dt
		self.parts = TS.filter(self.parts, (func(p_3, _a1 = null, _a2 = null): return p_3["t"] < p_3["life"]))
		for r in self.rings:
			r["t"] += dt
			if r["t"] > 0:
				r["r"] += (r["v"] * dt) * (1 - (r["t"] / float(r["life"])))
		self.rings = TS.filter(self.rings, (func(r_2, _a1 = null, _a2 = null): return r_2["t"] < r_2["life"]))

	func pour_pos() -> Variant:
		var m = self.mouth()
		var t: float = minf(1, self.pour_t)
		var x1: float = self.at["x"] + 2
		var y1: float = (self.at["y"] + UiForgeFx.ANVIL_TOP) - 3
		return {"x": m["x"] + ((x1 - m["x"]) * t), "y": (m["y"] + ((y1 - m["y"]) * t)) - (sin(t * PI) * 26)}

	# --- Drawing ---------------------------------------------------------------------------------
	func draw() -> void:
		var g = self.g
		if self.room != null:
			g.draw_image(self.room["c"], TS.round(self.at["x"]) - self.room["ax"], TS.round(self.at["y"]) - self.room["ay"])
		else:
			g.fill_style = "#120a0c"
			g.fill_rect(0, 0, self.w, self.h)
		if self.dim > 0.01:
			g.fill_style = ("rgba(6, 3, 12, " + TS.s(self.dim) + ")")
			g.fill_rect(0, 0, self.w, self.h)
		var sx: float = (TS.round(sin(self.t * 61) * self.shake) if self.shake else 0)
		var sy: float = (TS.round((cos(self.t * 47) * self.shake) * 0.6) if self.shake else 0)
		var ox: float = TS.round(self.at["x"]) + sx
		var oy: float = TS.round(self.at["y"]) + sy
		self.draw_glow(ox, oy)
		self.draw_furnace(ox, oy)
		self.draw_anvil(ox, oy)
		if self.beam > 0.01:
			self.draw_beam(ox + 2, (oy + UiForgeFx.ANVIL_TOP) - 3)
		if self.bar > 0:
			self.draw_bar(ox, oy)
		if self.hammer > 0.02:
			self.draw_hammer(ox, oy)
		if self.pour_t >= 0:
			var p = self.pour_pos()
			g.fill_style = UiForgeFx.HEAT[4]
			g.fill_rect(TS.round(p["x"]) - 2, TS.round(p["y"]) - 2, 5, 4)
			g.fill_style = UiForgeFx.HEAT[5]
			g.fill_rect(TS.round(p["x"]) - 1, TS.round(p["y"]) - 1, 3, 2)
		if self.scene < 0.99:
			g.fill_style = ("rgba(6, 3, 12, " + TS.s((1 - self.scene) * 0.92) + ")")
			g.fill_rect(0, 0, self.w, self.h)
		# Steam, rings and sparks.
		for p_2 in self.parts:
			if not p_2["puff"]:
				continue
			g.global_alpha = (1 - (p_2["t"] / float(p_2["life"]))) * 0.55
			g.fill_style = p_2["col"]
			var s: float = TS.round(p_2["s"] + (p_2["t"] * 3))
			g.fill_rect(TS.round(p_2["x"] - (s / 2.0)), TS.round(p_2["y"] - (s / 2.0)), s, s)
		g.global_composite_operation = "lighter"
		for r in self.rings:
			if r["t"] < 0:
				continue
			g.global_alpha = 1 - (r["t"] / float(r["life"]))
			g.stroke_style = r["col"]
			g.line_width = 2
			g.begin_path()
			g.ellipse(r["x"] + sx, r["y"] + sy, r["r"], r["r"] * 0.55, 0, 0, PI * 2)
			g.stroke()
		for p_3 in self.parts:
			if p_3["puff"]:
				continue
			var a: float = 1 - (p_3["t"] / float(p_3["life"]))
			g.global_alpha = a
			g.fill_style = p_3["col"]
			var x: float = TS.round(p_3["x"])
			var y: float = TS.round(p_3["y"])
			if p_3["star"] and (a > 0.3):
				g.fill_rect(x - 1, y, 3, 1)
				g.fill_rect(x, y - 1, 1, 3)
			else:
				g.fill_rect(x, y, p_3["s"], p_3["s"])
		g.global_alpha = 1
		g.global_composite_operation = "source-over"
		if self.flash > 0.01:
			g.global_alpha = minf(1, self.flash)
			g.fill_style = self.flash_col
			g.fill_rect(0, 0, self.w, self.h)
			g.global_alpha = 1

	##  Warm light from the fire on the floor and wall, flickering.
	func draw_glow(ox: float, oy: float) -> void:
		var g = self.g
		var mx: float = ox + ((UiForgeFx.MOUTH["x0"] + UiForgeFx.MOUTH["x1"]) / 2.0)
		var my: float = (oy + UiForgeFx.MOUTH["bottom"]) - 8
		var flick: float = (sin(self.t * 13) * 0.05) + (sin(self.t * 31) * 0.04)
		var rad: float = 46 + (self.heat * 50)
		g.global_composite_operation = "lighter"
		var grd = g.create_radial_gradient(mx, my, 2, mx, my, rad)
		grd.add_color_stop(0, (self.color(self.flame_tier, false) if self.flame_tier and (self.heat > 0.8) else UiForgeFx.HEAT[2]))
		grd.add_color_stop(1, "rgba(0,0,0,0)")
		g.global_alpha = ((0.28 + (self.heat * 0.35)) + flick) * (1 - (self.dim * 0.4))
		g.fill_style = grd
		g.fill_rect(mx - rad, my - rad, rad * 2, rad * 2)
		# The hot bar lights the anvil too.
		if self.bar > 0:
			var bx: float = ox + 2
			var by: float = (oy + UiForgeFx.ANVIL_TOP) - 3
			var r2: float = 24 + (self.bar_heat * 20)
			var gb = g.create_radial_gradient(bx, by, 1, bx, by, r2)
			gb.add_color_stop(0, self.bar_color(false))
			gb.add_color_stop(1, "rgba(0,0,0,0)")
			g.global_alpha = 0.25 + (self.bar_heat * 0.35)
			g.fill_style = gb
			g.fill_rect(bx - r2, by - r2, r2 * 2, r2 * 2)
		g.global_alpha = 1
		g.global_composite_operation = "source-over"
		# Floor shadows.
		g.fill_style = "rgba(0, 0, 0, 0.45)"
		g.fill_rect((ox + UiForgeFx.FURNACE["x0"]) - 2, oy, (UiForgeFx.FURNACE["x1"] - UiForgeFx.FURNACE["x0"]) + 4, 2)
		g.fill_rect(ox - 14, oy, 30, 2)

	func draw_furnace(ox: float, oy: float) -> void:
		var g = self.g
		var _fn0 = func(x: float, y: float, w: float, h: float, c: String):
			g.fill_style = c
			g.fill_rect(ox + x, oy + y, w, h)
		var px = _fn0
		# Chimney.
		px.call(UiForgeFx.CHIMNEY["x0"] - 1, UiForgeFx.CHIMNEY["top"] - 1, (UiForgeFx.CHIMNEY["x1"] - UiForgeFx.CHIMNEY["x0"]) + 2, (UiForgeFx.FURNACE["top"] - UiForgeFx.CHIMNEY["top"]) + 2, UiForgeFx.INK)
		var y_2: float = UiForgeFx.CHIMNEY["top"]
		while y_2 < UiForgeFx.FURNACE["top"]:
			px.call(UiForgeFx.CHIMNEY["x0"], y_2, UiForgeFx.CHIMNEY["x1"] - UiForgeFx.CHIMNEY["x0"], 4, UiForgeFx.STONE[1 + ((((((int(y_2)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 2) & 1)])
			px.call(UiForgeFx.CHIMNEY["x0"], y_2, UiForgeFx.CHIMNEY["x1"] - UiForgeFx.CHIMNEY["x0"], 1, UiForgeFx.STONE[3])
			y_2 += 4
		px.call(UiForgeFx.CHIMNEY["x0"] - 2, UiForgeFx.CHIMNEY["top"] - 2, (UiForgeFx.CHIMNEY["x1"] - UiForgeFx.CHIMNEY["x0"]) + 4, 3, UiForgeFx.STONE[2])
		px.call(UiForgeFx.CHIMNEY["x0"] - 2, UiForgeFx.CHIMNEY["top"] - 2, (UiForgeFx.CHIMNEY["x1"] - UiForgeFx.CHIMNEY["x0"]) + 4, 1, UiForgeFx.STONE[3])
		# Body: a stepped dome of stone blocks.
		var w_2: float = UiForgeFx.FURNACE["x1"] - UiForgeFx.FURNACE["x0"]
		var y_3: float = UiForgeFx.FURNACE["top"]
		while y_3 < 0:
			var row: float = y_3 - UiForgeFx.FURNACE["top"]
			var inset: float = (([6, 3, 2, 1])[row] if row < 4 else 0)
			px.call((UiForgeFx.FURNACE["x0"] + inset) - 1, y_3, (w_2 - (inset * 2)) + 2, 1, UiForgeFx.INK)
			px.call(UiForgeFx.FURNACE["x0"] + inset, y_3, w_2 - (inset * 2), 1, UiForgeFx.STONE[1])
			y_3 += 1
		# Block pattern.
		var y_4: float = UiForgeFx.FURNACE["top"] + 2
		while y_4 < (-2):
			var off: float = (0 if (int((y_4 - UiForgeFx.FURNACE["top"]) / 6.0) & 1) else 5)
			px.call(UiForgeFx.FURNACE["x0"] + 1, y_4, w_2 - 2, 1, UiForgeFx.STONE[0])
			var x_2: float = UiForgeFx.FURNACE["x0"] + off
			while x_2 < UiForgeFx.FURNACE["x1"]:
				px.call(x_2, y_4 + 1, 1, 5, UiForgeFx.STONE[0])
				x_2 += 10
			px.call(UiForgeFx.FURNACE["x0"] + 2, y_4 + 1, w_2 - 4, 1, UiForgeFx.STONE[2])
			y_4 += 6
		# Mouth: a dark arch with the fire inside.
		var mw: float = UiForgeFx.MOUTH["x1"] - UiForgeFx.MOUTH["x0"]
		var y_5: float = UiForgeFx.MOUTH["top"]
		while y_5 < UiForgeFx.MOUTH["bottom"]:
			var row_2: float = y_5 - UiForgeFx.MOUTH["top"]
			var inset_2: float = (([5, 3, 1, 0])[row_2] if row_2 < 4 else 0)
			px.call((UiForgeFx.MOUTH["x0"] + inset_2) - 2, y_5, (mw - (inset_2 * 2)) + 4, 1, UiForgeFx.STONE[3])
			px.call(UiForgeFx.MOUTH["x0"] + inset_2, y_5, mw - (inset_2 * 2), 1, "#120808")
			y_5 += 1
		self.draw_fire(ox, oy)
		# Lip and hearth stones.
		px.call(UiForgeFx.MOUTH["x0"] - 4, UiForgeFx.MOUTH["bottom"], mw + 8, 3, UiForgeFx.STONE[3])
		px.call(UiForgeFx.MOUTH["x0"] - 4, UiForgeFx.MOUTH["bottom"], mw + 8, 1, "#6a5e88")
		px.call(UiForgeFx.MOUTH["x0"] - 4, UiForgeFx.MOUTH["bottom"] + 3, mw + 8, 1, UiForgeFx.INK)
		# Bellows on the right side, puffing with the heat.
		var puff: float = TS.round((sin(self.t * (2 + (self.heat * 6))) + 1) * (0.5 + self.heat))
		px.call(UiForgeFx.FURNACE["x1"] - 2, (-12) + puff, 8, 9 - puff, UiForgeFx.INK)
		px.call(UiForgeFx.FURNACE["x1"] - 1, (-11) + puff, 6, 7 - puff, UiForgeFx.WOOD[2])
		px.call(UiForgeFx.FURNACE["x1"] - 1, (-11) + puff, 6, 1, UiForgeFx.WOOD[3])
		px.call(UiForgeFx.FURNACE["x1"] + 5, -9, 4, 2, UiForgeFx.IRON[2])

	##  Pixel flames: columns that lick up and down, hotter (and taller) with the heat.
	func draw_fire(ox: float, oy: float) -> void:
		var g = self.g
		var tier = (self.flame_tier if self.flame_tier and (self.heat > 0.75) else null)
		var n: float = (UiForgeFx.MOUTH["x1"] - UiForgeFx.MOUTH["x0"]) - 2
		for i in range(ceili(n)):
			var x: float = ((ox + UiForgeFx.MOUTH["x0"]) + 1) + i
			var wave: float = sin((self.t * 9) + (i * 0.9)) + (sin((self.t * 14) - (i * 1.7)) * 0.6)
			var edge: float = 1 - (absf(i - (n / 2.0)) / (n / 2.0))
			var hgt: float = maxf(1, TS.round(((3 + (self.heat * 14)) * (0.35 + (edge * 0.65))) + (wave * (1 + (self.heat * 2)))))
			var top: float = maxf(UiForgeFx.MOUTH["top"] + 3, UiForgeFx.MOUTH["bottom"] - hgt)
			var y: float = top
			while y < UiForgeFx.MOUTH["bottom"]:
				var k: float = (y - top) / float(maxf(1, UiForgeFx.MOUTH["bottom"] - top))
				var col: String
				if tier and (k < 0.45):
					col = self.color(tier, k > 0.2, i)
				else:
					col = UiForgeFx.HEAT[minf(5, 1 + floor((k * 3) + (self.heat * 2)))]
				g.fill_style = col
				g.fill_rect(x, oy + y, 1, 1)
				y += 1
		# Coals.
		for i_2 in range(0, ceili(n), 3):
			g.fill_style = (UiForgeFx.HEAT[1] if fmod((i_2 + floor(self.t * 3)), 4) else UiForgeFx.HEAT[3])
			g.fill_rect(((ox + UiForgeFx.MOUTH["x0"]) + 1) + i_2, (oy + UiForgeFx.MOUTH["bottom"]) - 2, 2, 2)

	func draw_anvil(ox: float, oy: float) -> void:
		var g = self.g
		var _fn0 = func(x: float, y: float, w: float, h: float, c: String):
			g.fill_style = c
			g.fill_rect(ox + x, oy + y, w, h)
		var px = _fn0
		# Stump.
		px.call(-12, -7, 24, 7, UiForgeFx.INK)
		px.call(-11, -6, 22, 6, UiForgeFx.WOOD[1])
		px.call(-11, -6, 22, 1, UiForgeFx.WOOD[3])
		for x_2 in [-7, -1, 5]:
			px.call(x_2, -5, 1, 5, UiForgeFx.WOOD[0])
		px.call(-9, -6, 18, 1, UiForgeFx.WOOD[2])
		# Base and feet.
		px.call(-14, -12, 28, 6, UiForgeFx.INK)
		px.call(-13, -11, 26, 4, UiForgeFx.IRON[1])
		px.call(-13, -11, 26, 1, UiForgeFx.IRON[2])
		# Waist.
		px.call(-7, -18, 14, 7, UiForgeFx.INK)
		px.call(-6, -18, 12, 7, UiForgeFx.IRON[1])
		px.call(-6, -18, 2, 7, UiForgeFx.IRON[2])
		# Face and horn.
		px.call(-15, UiForgeFx.ANVIL_TOP - 1, 33, 7, UiForgeFx.INK)
		px.call(-14, UiForgeFx.ANVIL_TOP, 31, 5, UiForgeFx.IRON[2])
		px.call(-14, UiForgeFx.ANVIL_TOP, 31, 1, UiForgeFx.IRON[4])
		px.call(-14, UiForgeFx.ANVIL_TOP + 1, 31, 1, UiForgeFx.IRON[3])
		px.call(-14, UiForgeFx.ANVIL_TOP + 4, 31, 1, UiForgeFx.IRON[1])
		# The horn tapers off to the left.
		px.call(-23, UiForgeFx.ANVIL_TOP, 9, 4, UiForgeFx.INK)
		px.call(-22, UiForgeFx.ANVIL_TOP + 1, 8, 2, UiForgeFx.IRON[2])
		px.call(-22, UiForgeFx.ANVIL_TOP + 1, 8, 1, UiForgeFx.IRON[3])
		px.call(-27, UiForgeFx.ANVIL_TOP + 1, 5, 2, UiForgeFx.INK)
		px.call(-26, UiForgeFx.ANVIL_TOP + 1, 4, 1, UiForgeFx.IRON[2])
		# Hardy hole on the heel.
		px.call(13, UiForgeFx.ANVIL_TOP + 1, 2, 2, UiForgeFx.INK)

	func bar_color(bright: bool) -> String:
		# White hot first; the cooler it gets the more its rarity shows.
		if self.bar_heat > 0.8:
			return (UiForgeFx.HEAT[5] if bright else UiForgeFx.HEAT[4])
		if (self.bar_heat > 0.6) and (self.shaped < 3):
			return (UiForgeFx.HEAT[4] if bright else UiForgeFx.HEAT[3])
		return self.color(self.bar_tier, bright, floor(self.t * 4))

	##  The bar on the anvil: a lump at first, longer and flatter with each blow.
	func draw_bar(ox: float, oy: float) -> void:
		var g = self.g
		var len_: float = ([8, 12, 16, 20])[minf(3, self.shaped)]
		var hgt: float = ([5, 4, 3, 3])[minf(3, self.shaped)]
		var x: float = (ox + 2) - (len_ / 2.0)
		var y: float = (oy + UiForgeFx.ANVIL_TOP) - hgt
		g.fill_style = UiForgeFx.INK
		g.fill_rect(x - 1, y - 1, len_ + 2, hgt + 1)
		g.fill_style = self.bar_color(false)
		g.fill_rect(x, y, len_, hgt)
		g.fill_style = self.bar_color(true)
		g.fill_rect(x + 1, y, len_ - 2, 1)
		if self.shaped >= 3:
			# A tip and a glint once it's shaped.
			g.fill_rect((x + len_) - 1, y + 1, 1, 1)
			if sin(self.t * 5) > 0.6:
				g.fill_style = "#ffffff"
				g.fill_rect((x + 2) + floor(fmod((self.t * 12), (len_ - 4))), y, 2, 1)

	func draw_hammer(ox: float, oy: float) -> void:
		var g = self.g
		var a: float = UiForgeFx.A_REST + (((UiForgeFx.A_STRIKE - UiForgeFx.A_REST) * self.swing) * self.swing)
		var px0: float = ox + UiForgeFx.PIVOT["x"]
		var py0: float = oy + UiForgeFx.PIVOT["y"]
		g.global_alpha = minf(1, self.hammer)
		# Handle: pixels along the line.
		for i in range(floori(UiForgeFx.REACH - 3) + 1):
			var x: float = TS.round(px0 + (cos(a) * i))
			var y: float = TS.round(py0 + (sin(a) * i))
			g.fill_style = UiForgeFx.INK
			g.fill_rect(x - 1, y - 1, 3, 3)
		for i_2 in range(floori(UiForgeFx.REACH - 3) + 1):
			var x_2: float = TS.round(px0 + (cos(a) * i_2))
			var y_2: float = TS.round(py0 + (sin(a) * i_2))
			g.fill_style = (UiForgeFx.WOOD[1] if i_2 < 5 else UiForgeFx.WOOD[3])
			g.fill_rect(x_2, y_2, 1, 1)
		# Head across the handle's end.
		var hx: float = px0 + (cos(a) * UiForgeFx.REACH)
		var hy: float = py0 + (sin(a) * UiForgeFx.REACH)
		g.save()
		g.translate(TS.round(hx), TS.round(hy))
		g.rotate(a + (PI / 2.0))
		g.fill_style = UiForgeFx.INK
		g.fill_rect(-6, -4, 12, 8)
		g.fill_style = UiForgeFx.IRON[3]
		g.fill_rect(-5, -3, 10, 6)
		g.fill_style = UiForgeFx.IRON[4]
		g.fill_rect(-5, -3, 10, 1)
		g.fill_style = UiForgeFx.IRON[2]
		g.fill_rect(-5, 2, 10, 1)
		g.restore()
		g.global_alpha = 1

	func draw_beam(x: float, y: float) -> void:
		var g = self.g
		var tier: String = self.beam_tier
		var wide: float = TS.round(((9 + (sin(self.t * 30) * 1.5)) * self.beam) * (1.4 if tier == "epic" else 1))
		g.global_composite_operation = "lighter"
		for i in range(3, 0 - 1, -1):
			var w: float = wide * (1 + (i * 0.7))
			g.global_alpha = self.beam * (0.16 if i else 0.9)
			g.fill_style = (self.color(tier, false, i) if i else self.color(tier, true, floor(self.t * 4)))
			g.fill_rect(TS.round(x - (w / 2.0)), 0, TS.round(w), TS.round(y))
		g.global_alpha = self.beam
		g.fill_style = "#ffffff"
		g.fill_rect(TS.round(x - maxf(1, wide / 5.0)), 0, maxf(2, TS.round(wide / 2.5)), TS.round(y))
		if randf() < self.beam:
			self.spark(x + (((randf() - 0.5) * wide) * 2), y - (randf() * 10), 0, (-120) - (randf() * 120), self.color(tier, true, floor(randf() * 5)), 0.6, 0, randf() < 0.3)
		g.global_alpha = 1
		g.global_composite_operation = "source-over"

	# --- hand-written (godot/src/patches/ui/forgeFx.ForgeFx.gd) ---

	## Device px per CSS px (the art is `k` CSS px a pixel, as on the web).
	var _dp := 1.0
	var running := false
	var _room_key := ""

	## Sizes the scene to the screen (device px) at `dp` device px per CSS px.
	func layout(box: Vector2, dp: float) -> void:
		_dp = dp
		var cw := box.x / dp
		var ch := box.y / dp
		self.k = maxf(2, floor((ch * 0.62) / 76.0))
		self.w = ceil(cw / self.k)
		self.h = ceil(ch / self.k)
		self.src.width = self.w
		self.src.height = self.h
		self.g = self.gl.gpu
		self.gl.resize(self.k, dp)
		var key := "%dx%d" % [self.w, self.h]
		if key != _room_key:
			_room_key = key
			Canvas2D.fast_gradients = true
			self.room = UiForgeFx.smithy_art(self.w, self.h)
			Canvas2D.fast_gradients = false

	## Device px per art px.
	func px_scale() -> float:
		return _dp * self.k

	## The scene stands on the bottom of a screen rect, centred in it.
	func anchor(r: Rect2) -> void:
		if r.size.x <= 0: return
		var s := px_scale()
		self.home = {"x": roundf(r.get_center().x / s) + 22, "y": roundf(r.end.y / s) - 6}
		if not self.at["x"]: self.at = self.home.duplicate()

	## Art-px point of a screen rect's centre.
	func point_of(r: Rect2) -> Variant:
		var s := px_scale()
		return {"x": r.get_center().x / s, "y": r.get_center().y / s}

	## Screen point of an art-px point.
	func screen_of(p) -> Vector2:
		return Vector2(p["x"], p["y"]) * px_scale()

	## Sparkles circling a revealed card (a screen rect); null stops them.
	func set_halo(r, tier: String = "legendary") -> void:
		if r == null:
			self.halo = null
			return
		var p = point_of(r)
		self.halo = {"x": p["x"], "y": p["y"], "r": maxf(r.size.x, r.size.y) / px_scale() / 2.0 + 3, "tier": tier}

	func start() -> void:
		running = true

	func stop() -> void:
		running = false
		self.gl.clear()

	## One frame: simulate, draw the art and hand it to the shader layer.
	func frame(dt: float) -> void:
		if not running or self.w <= 0: return
		dt = minf(0.05, dt)
		self.g.begin()
		self.update(dt)
		self.draw()
		# Heat shimmer over the furnace, stronger the hotter it burns.
		var ax: float = self.at["x"]
		var ay: float = self.at["y"]
		self.gl.haze = {"x0": ax + UiForgeFx.FURNACE["x0"] + 4, "y0": ay + UiForgeFx.CHIMNEY["top"] - 30, "x1": ax + UiForgeFx.FURNACE["x1"] - 2, "y1": ay + UiForgeFx.MOUTH["top"] + 4, "amp": (0.35 + self.heat * 1.1) * self.scene}
		var b = self.get_bar_at()
		self.gl.cam = {"x": b["x"] - 20, "y": b["y"], "zoom": self.zoom}
		self.gl.render(dt)
