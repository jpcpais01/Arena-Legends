s", "rock", "People's Champ Trunks"), E("rock", "savate_boots", "rock", "Rock Bottom Boots"), S("bloodletter", "rare", "bonesaw", "Bonesaw"), S("bloodletter", "legendary", "tithe", "Crimson Tithe"), S("grapnel", "rare", "tarred", "Tarred Grapnel"), S("grapnel", "mythic", "kraken", "Kraken Grip"), S("storm_cloud", "rare", "ember", "Ember Squall"), S("maelstrom_flask", "rare", "bog", "Bog Whirl"), S("maelstrom_flask", "legendary", "conch", "Whirlpool Conch"), S("magpie_mask", "rare", "raven", "Raven Mask"), S("grudge_mail", "rare", "gilded", "Gilded Grudge"), S("springheel_leggings", "rare", "clockwork", "Clockspring Trousers"), S("mirage_boots", "rare", "dune", "Dune Mirage"), S("boxing_gloves", "rare", "golden", "Golden Gloves"), S("boxing_gloves", "legendary", "dragon", "Dragon Fists"), S("spiked_knuckles", "rare", "obsidian", "Obsidian Knuckles"), S("spiked_knuckles", "mythic", "wolf", "Wolf Fangs"), S("spirit_wraps", "rare", "sunset", "Sunset Wraps"), S("spirit_wraps", "mythic", "lotus", "Lotus Wraps"), E("stormcrow", "bloodletter", "stormcrow", "Crowbeak Cleaver"), E("stormcrow", "grapnel", "stormcrow", "Raven Talon"), E("stormcrow", "storm_cloud", "stormcrow", "Murder of Crows"), E("stormcrow", "magpie_mask", "stormcrow", "Stormcrow Visage"), E("stormcrow", "grudge_mail", "stormcrow", "Raven Mantle"), E("stormcrow", "springheel_leggings", "stormcrow", "Corvid Breeches"), E("stormcrow", "mirage_boots", "stormcrow", "Talon Greaves")]
static var SKIN_BY_ID = TS.map_of(SKINS.map((func(s, _a1 = null, _a2 = null): return [s["id"], s])))
static var WEIGHT = {"rare": 6, "mythic": 3, "legendary": 1.2, "epic": 0.6}

static func S(gear: String, rarity: String, id: String, name: String) -> Variant:
	return ({"id": (gear + "." + id), "gear": gear, "name": name, "rarity": rarity})

static func E(set_: String, gear: String, id: String, name: String) -> Variant:
	return ({"id": (gear + "." + id), "gear": gear, "name": name, "rarity": "epic", "set": set_})

##  Skins for one item, rare first.
static func skins_for(gear: String) -> Variant:
	return TS.sort(TS.filter(SKINS, (func(s, _a1 = null, _a2 = null): return s["gear"] == gear)), (func(a, b): return SKIN_RARITIES.find(a["rarity"]) - SKIN_RARITIES.find(b["rarity"])))

##  The skin worn on an item, if any.
static func skin_on(skins, gear: String) -> Variant:
	var id = (null if skins == null else skins.get(gear))
	var s = (SKIN_BY_ID.get(id) if id else null)
	return (s if (s != null) and (s["gear"] == gear) else null)

##  Validates a skin map from storage: unknown skins, or skins on the wrong item, are dropped.
static func sanitize_skins(raw) -> Variant:
	var out = {}
	if (raw == null) or (TS.type_of(raw) != "object"):
		return out
	for gear in raw:
		var id = raw[gear]
		if TS.type_of(id) != "string":
			continue
		var s = SKIN_BY_ID.get(id)
		if (s != null) and (s["gear"] == gear):
			out[s["gear"]] = s["id"]
	return out

##  The pieces of a set, in gear slot order.
static func set_pieces(set_: String) -> Variant:
	return TS.filter(SKINS, (func(s, _a1 = null, _a2 = null): return s.get("set") == set_))

##  The set a fighter wears in full (every piece equipped, each in its set skin), if any.
static func full_set(gear, skins) -> Variant:
	var first = (null if skin_on(skins, gear["main"]) == null else skin_on(skins, gear["main"]).get("set"))
	if not first:
		return null
	for p in set_pieces(first):
		if (TS.values(gear).find(p["gear"]) < 0) or ((null if skins == null else skins.get(p["gear"])) != p["id"]):
			return null
	return first

##  Random skins for a generated rival: some items plain, rarer skins less often.
static func random_skins(gear, r = null) -> Variant:
	if r == null: r = TS.random
	var out = {}
	for id in TS.values(gear):
		var list = skins_for(id)
		if (not list.size()) or (r.call() < 0.4):
			continue
		var total: float = 0
		for s in list:
			total += WEIGHT.get(s["rarity"])
		var k: float = r.call() * total
		var pick = list[list.size() - 1]
		for s_2 in list:
			k -= WEIGHT.get(s_2["rarity"])
			if k <= 0:
				pick = s_2
				break
		out[id] = pick["id"]
	return out
