## back edge; grass past the paving at the sides. u = world px (centre at
## w/2), v = depth row (ground depth ≈ v × 2.6 px).
static func paint_courtyard(rng, w: float, h: float, D: float, v_lip: float, v_top: float, E: float, tree_u: float) -> Variant:
	var p = PixelPaint.Pix.new(w, h)
