			var base: float = blend(STONE[2], STONE[3], s * 0.85)
			var vt: float = RenderScenery.hash_(r, k, 2305)
			if vt < 0.2:
				base = blend(base, 0x9a9488, 0.3)
			elif vt < 0.34:
				base = blend(base, STONE[1], 0.28)
			# Worn a little smoother and paler along the fighters' line.
			var worn: float = (1 - smooth(5, 14, absf(v - D))) * (1 - side)
			base = blend(base, STONE[3], worn * 0.18)
			var n_2: float = ((RenderScenery.noise(x, z_2, 9, 7, 2306 + r) * 0.6) + (RenderScenery.noise(x, z_2, 3, 3, 2307) * 0.4)) + (((PixelPaint.bayer(x, v) - 0.5) * 0.25) * (1 - (worn * 0.6)))
