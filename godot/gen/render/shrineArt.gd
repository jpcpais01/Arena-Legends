##  A dressed-stone kerb along the courtyard's back edge with a clipped hedge behind it, azaleas here and there.
static func paint_hedge(p, sa, sb, rng, floor_top: float) -> void:
	var by: float = floor_top - 4
	var band = PixelPaint.Pix.new(p.w, 26)
	var oy: float = (by - band.h) + 1
	var blobs = []
	var x: float = rng.range_(-12, 0)
	while x < (p.w + 12):
		blobs.append({"x": x, "y": (band.h - 1) - rng.range_(7, 10), "rx": rng.range_(10, 15), "ry": rng.range_(7, 10)})
		x += rng.range_(13, 21)
	band.rect(0, band.h - 8, band.w, 8, HEDGE[1])
	var bloom = TS.filter(blobs, (func(_a0 = null, _a1 = null, _a2 = null): return rng.chance(0.2)))
	clumps(band, blobs, HEDGE, 1201, 0.25)
	for b in bloom:
		var c: float = rng.pick(TS.slice(AZALEA, 0, 2))
		for i in range(ceili(b["rx"] * 1.6)):
			var x_2: float = TS.round(b["x"] + (rng.range_(-0.8, 0.8) * b["rx"]))
			var y: float = TS.round(b["y"] + (rng.range_(-0.9, 0.2) * b["ry"]))
			if not band.has(x_2, y):
				continue
			band.set_(x_2, y, (AZALEA[2] if rng.chance(0.25) else c))
			if rng.chance(0.5):
				band.set_(x_2 + 1, y, c)
	band.outline(INK)
	# Fallen petals resting on top of the hedge.
	for x_3 in range(ceili(band.w)):
		if RenderScenery.hash_(x_3, 0, 1203) > 0.09:
			continue
		var y_2: float = 0
		while (y_2 < band.h) and (not band.has(x_3, y_2)):
			y_2 += 1
		if y_2 < (band.h - 6):
			band.set_(x_3, y_2 + 1, BLOSSOM[(4 if RenderScenery.hash_(x_3, 1, 1203) < 0.5 else 3)])
	p.blit(band, 0, oy)
	# The kerb: long dressed stones, lit along the top.
	var x0: float = -rng.range_(0, 20)
	while x0 < p.w:
		var bw: float = TS.round(rng.range_(16, 30))
		var x_4: float = maxf(0, TS.round(x0))
		while x_4 < minf(p.w, x0 + bw):
			var joint: bool = x_4 == TS.round(x0)
			var y_3: float = by
			while y_3 <= floor_top:
				var k: float = y_3 - by
				var c_2: float = (STONE[4] if k == 0 else (STONE[1] if k == 4 else (STONE[2] if PixelPaint.bayer(x_4, y_3) < 0.3 else STONE[3])))
				if joint:
