			var near_j: bool = (((((x - c0) < 4) or ((c1 - x) < 3)) or (dz0 < (ZS * 2))) or (dz1 < (ZS * 1.5)))
			if (near_j and (mossy > 0.7)) and (RenderScenery.hash_(x, v, 2308) < 0.75):
