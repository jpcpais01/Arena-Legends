	for r_2 in range(rows.size()):
		var row_2 = rows[r_2]
		for k_2 in range(row_2["cuts"].size() - 1):
			if RenderScenery.hash_(r_2, k_2, 2311) > 0.14:
				continue
			var x_2: float = (row_2["cuts"][k_2] + 4) + (RenderScenery.hash_(r_2, k_2, 2312) * ((row_2["cuts"][k_2 + 1] - row_2["cuts"][k_2]) - 8))
			var v_2: float = ((row_2["z0"] + (2 * ZS)) / ZS) + (RenderScenery.hash_(r_2, k_2, 2313) * (((row_2["z1"] - row_2["z0"]) / ZS) - 4))
			var dir: float = (-1 if RenderScenery.hash_(r_2, k_2, 2314) < 0.5 else 1)
			for i_2 in range(16):
				var xi: float = TS.round(x_2)
				var vi: float = TS.round(v_2)
				if ((vi < 0) or (vi >= h)) or (TS.at(kind, (vi * w) + xi) != 1):
					break
				p.set_(xi, vi, blend(PixelColor.unpack_hex(p.get_(xi, vi)), 0x262e36, 0.65))
				x_2 += dir * (1 + RenderScenery.hash_(i_2, r_2, 2315))
				v_2 += (RenderScenery.hash_(i_2, k_2, 2316) - 0.5) * 0.9
