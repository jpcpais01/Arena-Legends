	var petals = [BLOSSOM[3], BLOSSOM[4], BLOSSOM[5], BLOSSOM[4]]
	for i_3 in range(ceili((w * (v1 - v0)) * 0.05)):
		var x_3: float = rng.int(0, w - 3)
		var v_3: float = rng.int(v0, v1)
		var kd: float = kind[(v_3 * w) + x_3]
		if not kd:
