##  The far ranges, pale with distance, and one gentle snow-capped peak (lit from the right).
static func paint_far(p, rng, hz: float, px: float, sky: float) -> void:
	var base: float = hz + 6
	var amp: float = minf(30, hz * 0.12)
	var s: float = rng.int(0, 9999)
	var range_a: float = blend(0x8b9ecb, sky, 0.5)
	var range_b: float = blend(0xa6b6dc, sky, 0.45)
	var top = (func(x: float): return ((base - 6) - (RenderScenery.noise(x, 0, 80, 0, s) * amp)) - ((RenderScenery.noise(x, 0, 24, 0, s + 1) * amp) * 0.3))
	for x_2 in range(ceili(p.w)):
		var t: float = TS.round(top.call(x_2))
		var lit: bool = top.call(x_2 + 2) > top.call(x_2)
		var y: float = t
		while y < p.h:
			p.set_(x_2, y, blend((range_b if lit else range_a), sky, smooth(t, base + 4, y) * 0.55))
			y += 1
	# The peak: concave flanks and a small flat crater top, ridges and gullies
	# running down from the summit, snow reaching furthest down the gullies.
	var hk: float = minf(100, hz * 0.46)
	var hw: float = hk * 2.5
	var apex: float = base - hk
	var rock = [0x60729f, 0x7286b4, 0x8a9ec8, 0x9eb2d6]
	var snow = [0xbcc6e2, 0xd4dcf0, 0xeef2fc, 0xffffff]
	var x_3: float = floor(px - hw)
	while x_3 <= (px + hw):
		var u: float = ((x_3 + 0.5) - px) / hw
		var a: float = 1 - absf(u)
		if a <= 0:
			x_3 += 1
			continue
		var prof: float = minf(pow(a, 1.8), 0.9) / 0.9
		var yt: float = TS.round((base - (hk * prof)) + ((RenderScenery.noise(x_3, 0, 6, 0, s + 2) - 0.5) * 1.2))
		var y_2: float = maxf(0, yt)
		while y_2 < p.h:
			# Which ray down from the summit this pixel sits on.
			var ray: float = ((x_3 + 0.5) - px) / ((y_2 - apex) + (hk * 0.12))
			var g: float = (RenderScenery.noise(ray * 26, 0, 1, 0, s + 3) * 0.8) + (RenderScenery.noise(ray * 60, 0, 1, 0, s + 4) * 0.2)
			var depth: float = (y_2 - apex) / hk
			var snow_to: float = (0.3 + (0.08 * RenderScenery.noise(ray * 12, 0, 1, 0, s + 5))) + (maxf(0, g - 0.5) * 0.7)
			var lit_2: float = (0.62 if u > 0.01 else 0.2) + ((0.5 - g) * 0.45)
			var c: float
			if depth < snow_to:
				c = snow[maxf(0, minf(3, floor((lit_2 * 4) + 0.4)))]
			else:
				c = rock[maxf(0, minf(3, floor(lit_2 * 4)))]
			c = blend(c, sky, 0.16 + (smooth(apex + (hk * 0.4), base + 2, y_2) * 0.66))
			p.set_(x_3, y_2, c)
			y_2 += 1
		x_3 += 1

##  Rolling hills, a rise on the left with one small vermilion torii at its crest, and little trees along the ridges.
static func paint_hills(p, rng, hz: float, tx: float, sky: float) -> void:
	var s: float = rng.int(0, 9999)
	var back_c: float = blend(0x7c98b8, sky, 0.48)
	var front_c: float = blend(0x62869e, sky, 0.36)
	var front_lit: float = blend(0x7aa0aa, sky, 0.36)
	var kh: float = minf(42, hz * 0.2)
	var kw: float = 64
	var back = (func(x: float): return ((hz + 1) - 6) - (RenderScenery.noise(x, 0, 60, 0, s) * 12))
	# The rise: steeper on the left, a long tail to the right, its crest a little flat.
	var _fn0 = func(x_2: float):
		var k: float = (x_2 - tx) / float((kw * 0.75 if x_2 < tx else kw * 1.3))
		return ((kh * minf(1, 1.12 * pow((1 - (k * k)), 2))) * (0.92 + (0.08 * RenderScenery.noise(x_2, 0, 9, 0, s + 2))) if absf(k) < 1 else 0)
	var knoll = _fn0
	var front_top = (func(x_3: float): return (((hz + 9) - 3) - (RenderScenery.noise(x_3, 0, 44, 0, s + 1) * 9)) - knoll.call(x_3))
	for x_4 in range(ceili(p.w)):
		var y: float = TS.round(back.call(x_4))
		while y < p.h:
			p.set_(x_4, y, back_c)
			y += 1
		var t: float = TS.round(front_top.call(x_4))
		var lit: bool = front_top.call(x_4 + 2) > (front_top.call(x_4) + 0.3)
		var y_2: float = t
		while y_2 < p.h:
			p.set_(x_4, y_2, (front_lit if ((y_2 - t) < 2) and lit else front_c))
			y_2 += 1
	# Little trees along the near ridge, cherries clustering round the torii.
	var tree_c = [blend(0x3e6070, sky, 0.38), blend(0x4c7276, sky, 0.36), blend(0x5e8478, sky, 0.36)]
	var pink_c = [blend(0xb87898, sky, 0.36), blend(0xe0a0bc, sky, 0.34), blend(0xf4c4d4, sky, 0.3)]
	var x_5: float = rng.range_(0, 6)
	while x_5 < p.w:
		if absf(x_5 - tx) < 15:
			x_5 += rng.range_(4, 11)
			continue
		var near: bool = absf(x_5 - tx) < (kw * 0.85)
		if (not near) and rng.chance(0.45):
			x_5 += rng.range_(4, 11)
			continue
		var r: float = rng.range_(1.8, (4 if near else 3.4))
		var pink: bool = rng.chance((0.6 if near else 0.18))
		var y_3: float = front_top.call(x_5) - (r * 0.4)
		clumps(p, [{"x": x_5, "y": y_3, "rx": r * 1.1, "ry": r}], (pink_c if pink else tree_c), s + TS.round(x_5), 0.2)
		x_5 += rng.range_(4, 11)
	# The torii, a touch hazed by distance.
	var tp = paint_torii()
	RenderScenery.haze(tp, sky, 0.14)
	p.blit(tp, TS.round(tx - (tp.w / 2.0)), (TS.round(front_top.call(tx)) - tp.h) + 1)

##  A small torii: black-capped top beam with upturned ends, vermilion posts and tie beam.
static func paint_torii() -> Variant:
	var w: float = 21
