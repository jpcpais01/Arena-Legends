	var v_4: float = floor(D * 1.08)
	while v_4 <= v1:
		var k_3: float = 0.5 * exp((-(((D * D) / v_4) - back_2)) / 3.0)
		if k_3 < 0.04:
			v_4 += 1
			continue
		for x_4 in range(ceili(w)):
			var c_3: float = p.get_(x_4, v_4)
			if not ((int(c_3) & 0xFFFFFFFF) >> 24):
