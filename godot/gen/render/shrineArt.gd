				p.set_(x_4, y_3, c_2)
				y_3 += 1
			x_4 += 1
		x0 += bw
	# Grass tufts at the kerb's foot, swaying (two frames).
	var x_5: float = rng.range_(0, 8)
	while x_5 < p.w:
		if not rng.chance(0.5):
			x_5 += rng.range_(6, 16)
			continue
		var n: float = rng.int(2, 4)
		for j in range(ceili(n)):
			var bx: float = TS.round(x_5 + (j * 1.5))
			var hgt: float = rng.int(3, 6)
			for _e0 in [[sa, rng.range_(-0.3, 0.3)], [sb, rng.range_(0.8, 1.5)]]:
				var buf = _e0[0]
				var lean = _e0[1]
				for k_2 in range(ceili(hgt)):
					buf.set_(TS.round(bx + (lean * pow((k_2 / hgt), 2))), floor_top - k_2, (GRASS[4] if k_2 == (hgt - 1) else GRASS[2 + (k_2 & 1)]))
		x_5 += rng.range_(6, 16)

## A cherry tree in full bloom: a dark, gnarled trunk leaning toward the
## middle, boughs spreading wide, and a cloud of blossom reaching `reach` px
## inward. `dir` is the inward direction. Returns the trunk's base x and the
## underside of the inner crown, where lanterns can hang.
static func paint_cherry(rng, dir: float, ht: float, reach: float, seed_: float) -> Variant:
	var w: float = reach + 170
	var h: float = ht + 2
	var p = PixelPaint.Pix.new(w, h)
	var bx: float = (120 if dir > 0 else w - 120)
	var by: float = h - 2
	# Branch discs: x, y, radius.
	var discs = []
	var blobs = []
	# The crown's body round each fork, under the clumps.
	var mass = []
	var _fn0 = func(x: float, y: float, k: float):
		var i: float = rng.int(3, 5)
		while i > 0:
			var rx: float = rng.range_(12, 18) * k
			blobs.append({"x": x + (rng.range_(-11, 11) * k), "y": y + (rng.range_(-9, 3) * k), "rx": rx, "ry": rx * rng.range_(0.66, 0.82)})
			i -= 1
	var clump = _fn0
	var limb = [null]
	var _fn1 = func(x_2: float, y_2: float, ang: float, len_: float, r: float, depth: float):
		var n: float = maxf(2, TS.round(len_ / 2.0))
		var bend: float = rng.range_(-0.025, 0.025)
		for i_2 in range(ceili(n)):
			ang += bend + rng.range_(-0.07, 0.07)
			# Outer boughs spread out level, as cherries do.
			if depth >= 1:
				ang += (((signf(ang) * 1.45) - ang) * 0.01) * depth
			x_2 += sin(ang) * 2
			y_2 -= cos(ang) * 2
			discs.append_array([x_2, y_2, maxf(0.6, r * (1 - ((i_2 / n) * 0.35)))])
			if ((depth >= 1) and ((i_2 % 4) == 2)) and rng.chance((0.7 if depth >= 2 else 0.3)):
				clump.call(x_2, y_2, 0.8)
		if (depth >= 3) or (r < 1):
			clump.call(x_2, y_2, 1)
			return
		if depth >= 1:
			var rx_2: float = rng.range_(20, 27)
			mass.append({"x": x_2, "y": y_2 - 4, "rx": rx_2, "ry": rx_2 * 0.72})
		var kids: float = (0 if depth == 0 else 2)
		for k_2 in range(ceili(kids)):
			var spread: float = rng.range_(0.3, 0.62) * (-1 if k_2 == 0 else 1)
			limb[0].call(x_2, y_2, ang + spread, len_ * rng.range_(0.5, 0.66), r * 0.62, depth + 1)
	limb[0] = _fn1
	var trunk_len: float = ht * 0.3
	# The trunk, with a slight S-curve.
	var x_3: float = bx
	var y_3: float = by
	var ang_2: float = dir * 0.12
	var n_2: float = TS.round(trunk_len / 2.0)
	for i_3 in range(ceili(n_2)):
		ang_2 += ((sin(i_3 * 0.25) * 0.03) * dir) + rng.range_(-0.04, 0.04)
		x_3 += sin(ang_2) * 2
		y_3 -= cos(ang_2) * 2
		discs.append_array([x_3, y_3, 6.2 - ((i_3 / n_2) * 1.2)])
	# Root flare.
	for i_4 in range(9):
		discs.append_array([bx + rng.range_(-1, 1), by - i_4, 6.5 + ((9 - i_4) * 0.55)])
	for s in [-1, 1]:
		for i_5 in range(12):
			discs.append_array([bx + (s * (5 + i_5)), (by - 1) + (i_5 * 0.12), maxf(0.8, 2.6 - (i_5 * 0.18))])
	# Main boughs: a long one reaching inward, one rising, one leaning out.
	limb[0].call(x_3, y_3, dir * 0.95, reach * 0.5, 4.4, 1)
	limb[0].call(x_3, y_3, dir * 0.3, ht * 0.3, 4, 1)
	limb[0].call(x_3, y_3, (-dir) * 0.5, ht * 0.24, 3.4, 1)
	for i_6 in range(0, discs.size(), 3):
		var dx: float = discs[i_6]
		var dy: float = discs[i_6 + 1]
