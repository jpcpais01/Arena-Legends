		var du_2: float = absf((x_3 + 0.5) - cx)
		var under: float = exp(-(pow((du_2 - tree_u) / 70.0, 2))) * smooth(D, v_top, v_3)
		var dens: float = ((((0.05 + (0.25 * smooth(E * 0.5, E, du_2))) + (0.4 * smooth(D * 1.12, v_top, v_3))) + (0.3 if kd == 2 else 0)) + (0.2 if kd == 4 else 0)) + (under * 0.6)
