				p.set_(x, v, (MOSS[(2 if PixelPaint.bayer(x, v) < 0.4 else 1)] if mossy > 0.62 else (MOSS[0] if mossy > 0.48 else (0x283036 if PixelPaint.bayer(x, v) < 0.5 else 0x323c42))))
				kind[int(i)] = 2
				continue
			kind[int(i)] = 1
