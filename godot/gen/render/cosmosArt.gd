## The disc's far edge: a fine gold rim over a sliver of polished stone, its
## ends curving away. Glints run along it on alternate frames.
static func paint_back_rim(p, ta, tb, floor_top: float, half: float) -> void:
	var cx: float = p.w / 2.0
	var y: float = floor_top
	var x: float = TS.round((cx - half) + 4)
	while x < ((cx + half) - 4):
		var u: float = ((x + 0.5) - cx) / half
		var sink: float = TS.round(maxf(0, absf(u) - 0.94) * 40)
		p.set_(x, (y - 2) + sink, GOLD[3])
		p.set_(x, (y - 1) + sink, GOLD[1])
		p.set_(x, y + sink, STONE[2])
		if RenderScenery.hash_(x, 0, 1451) < 0.03:
			(ta if RenderScenery.hash_(x, 1, 1452) < 0.5 else tb).set_(x, (y - 2) + sink, 0xffffff)
		x += 1

# --- Floor ---------------------------------------------------------------------------
## The floor: polished star-stone flagstones laid in rings around the centre,
## a gold-ringed medallion with a silver compass star under the fighters, a
## zodiac band, a few constellations inlaid in silver and a gilded rim along
## the edge. Transparent past the edge (space shows).
static func paint_star_floor(w: float, h: float, D: float, v_top: float, edge_at, lip_at) -> Variant:
	var p = PixelPaint.Pix.new(w, h)
	var cx: float = w / 2.0
	var z_mid: float = D * 2.6
	var RINGS = [0, 22, 54, 72, 104, 150, 210, 280, 360, 460, 580]
	var sectors = (func(ri: float): return (1 if ri < 4 else (16 if ri < 6 else (24 if ri < 8 else 32))))
	var _fn0 = func(r: float):
		var i: float = 0
		while (i < (RINGS.size() - 1)) and (r >= RINGS[i + 1]):
			i += 1
		return i
	var ring_of = _fn0
	for v in range(ceili(h)):
		var z: float = v * 2.6
		var lz: float = z - z_mid
		var edge: float = edge_at.call(v)
		for x in range(ceili(w)):
			var du: float = (x + 0.5) - cx
			var e: float = edge - absf(du)
			if e <= 0:
				continue
			var lip_u: float = lip_at.call(du)
			if v < lip_u:
				# The rim's face showing through the curled front corners.
				p.set_(x, v, (GOLD[2] if v > (lip_u - 1.5) else (STONE[1] if PixelPaint.bayer(x, v) < ((lip_u - v) / 6.0) else STONE[2])))
				continue
			if e < 1.2:
				p.set_(x, v, GOLD[3])
				continue
			if e < 2.2:
				p.set_(x, v, GOLD[1])
				continue
			if e < 6:
				p.set_(x, v, (SILVER[1] if ((fmod(TS.round(du), 9) == 0) and (e > 3)) and (e < 5) else STONE[2]))
				continue
			var r_2: float = sqrt(du * du + lz * lz)
			var ri_2: float = ring_of.call(r_2)
			# Pixel-space distance to the ring seams and the sector seams.
			var g: float = maxf(1.0e-3, TS.hypot2(du / float(maxf(r_2, 1.0e-3)), (lz / float(maxf(r_2, 1.0e-3))) * 2.6))
			var d_in: float = (r_2 - RINGS[ri_2]) / g
			var d_out: float = ((RINGS[ri_2 + 1] - r_2) / g if (ri_2 + 1) < RINGS.size() else 99)
			var a: float = atan2(lz, du)
			var ns: float = sectors.call(ri_2)
			var sf: float = (a / float((PI * 2))) * ns
			var si: float = floor(sf)
			var ga: float = sqrt(lz * lz + (du * 2.6) * (du * 2.6)) / float(maxf(1, r_2 * r_2))
			var d_sec: float = ((minf(sf - si, 1 - (sf - si)) * ((PI * 2) / ns)) / float(maxf(1.0e-6, ga)) if ns > 1 else 99)
			var seam: float = min(d_in, d_out, d_sec)
			var c: float
			var gold_ring: bool = (minf(d_in, d_out) < 0.7 if (ri_2 == 2) or (ri_2 == 3) else false)
			if gold_ring:
				c = (GOLD[3] if RenderScenery.hash_(x, v, 1421) < 0.2 else GOLD[2])
			elif seam < 0.6:
				c = MARBLE[0]
			else:
				var cell: float = RenderScenery.hash_(ri_2, si, 1423)
				var l: float = (0.42 + ((cell - 0.5) * 0.18)) + (minf(0.12, lz / 500.0) if lz > 0 else 0)
				# Marble veins.
				var vein: float = absf(RenderScenery.noise(du, z, 46, 40, 1425 + ri_2) - 0.5)
				if vein < 0.018:
					l += 0.22
				# Polished bevel: the near edge of every stone catches a little light.
				if (seam < 1.6) and ((d_out == seam) or ((d_sec == seam) and (lz < 0))):
					l += 0.12
				c = RenderScenery.tone(MARBLE, l, x, v, 0.1)
				if vein < 0.01:
					c = PixelColor.mix(c, SILVER[0], 0.5)
				if RenderScenery.hash_(x, v, 1427) < 0.0025:
					c = SILVER[2]
			if ri_2 <= 1:
				# The medallion: an eight-point compass star in silver around a gem.
				var rs: float = 9 + (13 * pow(absf(cos(a * 4)), 5))
				if r_2 < rs:
					var facet: bool = sin(a * 8) > 0
					c = ((TEAL[4] if r_2 < 2.2 else TEAL[2]) if r_2 < 4 else (SILVER[2] if facet else SILVER[1]))
					if (absf(r_2 - rs) * minf(1, 1 / g)) < 0.7:
						c = SILVER[3]
				elif (ri_2 == 1) and (d_out < 1.2):
					c = SILVER[1]
			elif (ri_2 == 2) and (not gold_ring):
				# The zodiac band: twelve gilded marks.
				var za: float = (a / float((PI * 2))) * 12
				var zd: float = (absf(za - TS.round(za)) * ((PI * 2) / 12.0)) / float(maxf(1.0e-6, ga))
				var mid: float = (RINGS[2] + RINGS[3]) / 2.0
				if (zd < 0.8) and ((absf(r_2 - mid) / g) < 4):
					c = GOLD[2]
				elif (absf((za - TS.round(za)) - 0.5) < 0.02) and ((absf(r_2 - mid) / g) < 1):
					c = GOLD[1]
			p.set_(x, v, c)
	# Constellations inlaid in a few of the outer stones: silver lines, stars at the nodes.
	for ri_3 in range(4, RINGS.size() - 1):
		var ns_2: float = sectors.call(ri_3)
		for si_2 in range(ceili(ns_2)):
			if RenderScenery.hash_(ri_3, si_2, 1431) > 0.16:
				continue
			var rm: float = (RINGS[ri_3] + RINGS[ri_3 + 1]) / 2.0
			var am: float = (((si_2 + 0.5) / ns_2) * PI) * 2
			var span: float = minf((RINGS[ri_3 + 1] - RINGS[ri_3]) * 0.3, (((rm * PI) * 2) / ns_2) * 0.3)
			var pts = []
			var n: float = 3 + floor(RenderScenery.hash_(ri_3, si_2, 1433) * 3)
			for k in range(ceili(n)):
				var ox: float = ((RenderScenery.hash_((ri_3 * 7) + k, si_2, 1435) - 0.5) * 2) * span
				var oz: float = ((RenderScenery.hash_((ri_3 * 7) + k, si_2, 1437) - 0.5) * 2) * span
				var du_2: float = (cos(am) * rm) + ox
				var lz_2: float = (sin(am) * rm) + oz
				pts.append([TS.round(cx + du_2), TS.round((lz_2 + z_mid) / 2.6)])
			var ok = (func(x_2: float, v_2: float): return ((p.has(x_2, v_2) and ((edge_at.call(v_2) - absf((x_2 + 0.5) - cx)) > 7)) and (v_2 >= (lip_at.call(x_2 - cx) + 1))))
			for k_2 in range(1, pts.size()):
				var _d1 = pts[k_2 - 1]
				var x0 = _d1[0]
				var v0 = _d1[1]
				var _d2 = pts[k_2]
				var x1 = _d2[0]
				var v1 = _d2[1]
				var steps: float = maxf(absf(x1 - x0), absf(v1 - v0))
				for s in range(floori(steps) + 1):
					var x_3: float = TS.round(x0 + (((x1 - x0) * s) / float(maxf(1, steps))))
					var v_3: float = TS.round(v0 + (((v1 - v0) * s) / float(maxf(1, steps))))
					if ok.call(x_3, v_3):
						p.set_(x_3, v_3, PixelColor.mix(PixelColor.unpack_hex(p.get_(x_3, v_3)), SILVER[1], 0.6))
			for _e3 in pts:
				var x_4 = _e3[0]
				var v_4 = _e3[1]
				if not ok.call(x_4, v_4):
					continue
				p.set_(x_4, v_4, SILVER[3])
				if ok.call(x_4 - 1, v_4):
					p.set_(x_4 - 1, v_4, SILVER[2])
				if ok.call(x_4 + 1, v_4):
					p.set_(x_4 + 1, v_4, SILVER[2])
	# A gentle shade under the parapet at the back.
	var back: float = (D * D) / v_top
	var v_5: float = floor(D * 1.08)
	while v_5 < h:
		var k_3: float = 0.45 * exp((-(((D * D) / v_5) - back)) / 2.6)
		if k_3 < 0.04:
			v_5 += 1
			continue
		for x_5 in range(ceili(w)):
			var c_2: float = p.get_(x_5, v_5)
			if not ((int(c_2) & 0xFFFFFFFF) >> 24):
				continue
			var kq: float = floor((k_3 * 4) + PixelPaint.bayer(x_5, v_5)) / 4.0
			if kq > 0:
				p.set_(x_5, v_5, PixelColor.mix(PixelColor.unpack_hex(c_2), 0x04030c, kq))
		v_5 += 1
	return p

# --- The disc's front -------------------------------------------------------------------
## The rim (polished stone banded in gold) and, under it, the night rock the
## disc stands on, hanging into the void, crystals glinting in it and dripping
## from its spurs. Returns where the crystals glow (layer coordinates, colour).
static func paint_underside(p, rng, hw: float, lift: float) -> Variant:
	var cx: float = p.w / 2.0
	var band: float = 7
	var y0: float = lift + band
	var cone: float = 150
	var glows = []
	# The rim.
	var x: float = floor(cx - hw)
	while x < (cx + hw):
		var end: float = minf(x - (cx - hw), ((cx + hw) - 1) - x)
		var y: float = lift
		while y < y0:
			var c: float = STONE[3]
			if y == (lift + 1):
				c = GOLD[2]
			elif y == (lift + 2):
				c = GOLD[0]
			elif y == (y0 - 1):
				c = STONE[1]
			elif (y == (lift + 4)) and (fmod(TS.round(x - cx), 12) == 0):
				c = TEAL[2]
			if end < 3:
				c = PixelColor.mix(c, STONE[0], 0.4)
			p.set_(x, y, c)
			y += 1
		x += 1
	# The rock below, painted column by column: deepest under the middle, its
	# bottom broken into hanging spurs, lit from the light-star's side with a
	# faint violet bounce from the nebula along its lower edge.
	var tip: float = cx + rng.range_(-24, 24)
	var bottom = TS.typed_array(p.w)
	var x_2: float = floor(cx - hw)
	while x_2 < (cx + hw):
		var u: float = (((x_2 + 0.5) - tip) / ((tip - cx) + hw) if (x_2 + 0.5) < tip else ((x_2 + 0.5) - tip) / ((cx + hw) - tip))
		var a: float = absf(u)
		var spurs: float = (RenderScenery.noise(x_2, 0, 22, 0, 1441) * 0.7) + (RenderScenery.noise(x_2, 0, 8, 0, 1442) * 0.3)
		var depth: float = ((cone * pow((1 - pow(a, 1.1)), 1.5)) * (0.7 + (0.42 * spurs))) + 4
		var yb: float = y0 + depth
		bottom[int(x_2)] = yb
		var y_2: float = y0
		while y_2 < minf(p.h, yb):
			var v: float = (y_2 - y0) / cone
			var strata: float = RenderScenery.noise(x_2 * 0.25, y_2, 10, 3, 1443)
			var l: float = ((0.5 - (v * 0.45)) - (u * 0.22)) + ((strata - 0.5) * 0.28)
			if y_2 < (y0 + 3):
				l -= 0.25
			var c_2: float = RenderScenery.tone(STONE, l, x_2, y_2, 0.14)
			if (yb - y_2) < 2.5:
				c_2 = PixelColor.mix(c_2, VIOLET[1], (0.6 if (yb - y_2) < 1.5 else 0.3))
			p.set_(x_2, y_2, c_2)
			y_2 += 1
		x_2 += 1
	# A few crystal seams glinting in the rock.
	for i in range(7):
		var x_3: float = TS.round(cx + rng.range_((-hw) * 0.75, hw * 0.75))
		var y_3: float = TS.round((y0 + 6) + rng.range_(0, maxf(4, (bottom[x_3] - y0) - 14)))
		if (not p.has(x_3, y_3)) or (not p.has(x_3 + 2, y_3 + 3)):
			continue
		var pal = (TEAL if i % 2 else VIOLET)
		p.set_(x_3, y_3, pal[3])
		p.set_(x_3 + 1, y_3 + 1, pal[2])
		p.set_(x_3 + 1, y_3 + 2, pal[2])
		p.set_(x_3 + 2, y_3 + 3, pal[1])
		glows.append([x_3 + 1, y_3 + 1, pal[2]])
	# Crystals hanging from the underside, the biggest from the lowest point.
	var _fn0 = func(x_4: float, len_: float, pal_2):
		var xi: float = TS.round(x_4)
		var y_4: float = TS.round((TS.at(bottom, xi) if TS.at(bottom, xi) != null else y0)) - 2
		var w: float = 1.5 + (len_ * 0.13)
		p.poly([x_4 - w, y_4, x_4 + w, y_4, x_4 + 0.5, y_4 + len_], pal_2[2])
		p.poly([x_4 + 0.3, y_4, x_4 + w, y_4, x_4 + 0.5, y_4 + len_], pal_2[1])
		p.line(TS.round((x_4 - w) + 1), y_4 + 1, TS.round(x_4), TS.round((y_4 + len_) - 2), pal_2[3])
		glows.append([x_4, y_4 + (len_ * 0.4), pal_2[2]])
	var drip = _fn0
	var low: float = TS.round(tip)
	var x_5: float = TS.round(cx - (hw * 0.3))
	while x_5 < (cx + (hw * 0.3)):
		if bottom[x_5] > bottom[low]:
			low = x_5
		x_5 += 1
	drip.call(low + 0.5, 24, VIOLET)
	drip.call(low - 6.5, 11, TEAL)
	for i_2 in range(5):
		var x_6: float = cx + rng.range_((-hw) * 0.8, hw * 0.8)
		if absf(x_6 - low) < 14:
			continue
		drip.call(x_6, rng.range_(6, 13) * (1 - ((absf(x_6 - cx) / hw) * 0.5)), (TEAL if i_2 % 2 else VIOLET))
	p.outline(INK)
	# No ink along the top: the floor's lip meets the rim there.
	TS.fill(p.data, 0, (lift - 1) * p.w, lift * p.w)
	return glows

