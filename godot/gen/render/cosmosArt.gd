##  A low star-stone plinth banded in gold, marking each end of the arena.
static func paint_plinth() -> Variant:
	var w: float = 22
	var h: float = 16
	var p = PixelPaint.Pix.new(w, h)
	p.rect(5, 2, 12, 9, STONE[3])
	p.rect(5, 2, 3, 9, STONE[4])
	p.rect(14, 2, 3, 9, STONE[1])
	p.set_(10, 6, TEAL[3])
	p.set_(11, 6, TEAL[2])
	p.rect(3, 0, 16, 2, GOLD[2])
	p.rect(3, 0, 16, 1, GOLD[3])
	p.rect(2, 11, 18, 5, STONE[2])
	p.rect(2, 11, 18, 1, GOLD[2])
	p.rect(2, 15, 18, 1, STONE[0])
	p.outline(INK)
	return p

##  A four-point star crystal, faceted silver and blue, with a dithered halo.
static func paint_star() -> Variant:
	var w: float = 19
	var h: float = 25
	var p = PixelPaint.Pix.new(w, h)
	var cx: float = 9
	var cy: float = 12
	for y in range(ceili(h)):
		for x in range(ceili(w)):
			var d: float = sqrt(((x - cx) / 9.0) * ((x - cx) / 9.0) + ((y - cy) / 12.0) * ((y - cy) / 12.0))
			if (d < 1) and (PixelPaint.bayer(x, y) < ((1 - d) * 0.5)):
				p.set_(x, y, 0xa8c0ff, 100)
	var rx: float = 6.5
	var ry: float = 10.5
	for y_2 in range(ceili(h)):
		for x_2 in range(ceili(w)):
			var u: float = absf(((x_2 + 0.5) - cx) - 0.5) / rx
			var v: float = absf(((y_2 + 0.5) - cy) - 0.5) / ry
			if (sqrt(u) + sqrt(v)) > 1:
				continue
			var left: bool = x_2 < (cx + 0.5)
			var up: bool = y_2 < (cy + 0.5)
			p.set_(x_2, y_2, ((SILVER[3] if left else SILVER[2]) if up else (TEAL[3] if left else VIOLET[3])))
	p.set_(cx, cy, 0xffffff)
	p.set_(cx + 1, cy, 0xffffff)
	p.set_(cx, cy + 1, 0xffffff)
	p.set_(cx + 1, cy + 1, 0xffffff)
	var src = p.data.duplicate()
	var solid = (func(xx: float, yy: float): return (((((xx >= 0) and (xx < w)) and (yy >= 0)) and (yy < h)) and (((int(src[(yy * w) + xx]) & 0xFFFFFFFF) >> 24) == 255)))
	for y_3 in range(ceili(h)):
		for x_3 in range(ceili(w)):
			if (not solid.call(x_3, y_3)) and (((solid.call(x_3 - 1, y_3) or solid.call(x_3 + 1, y_3)) or solid.call(x_3, y_3 - 1)) or solid.call(x_3, y_3 + 1)):
				p.set_(x_3, y_3, VIOLET[1])
	return p
