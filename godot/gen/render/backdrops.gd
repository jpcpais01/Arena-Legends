			self.disc(x_2, y_2, r_2 - 0.3, c)
		if hi != null:
			for _e2 in puffs:
				var x_3 = _e2[0]
				var y_3 = _e2[1]
				var r_3 = _e2[2]
				self.disc(x_3 - (r_3 * 0.35), y_3 - (r_3 * 0.4), r_3 * 0.4, hi)

	##  Like ridge, but slopes facing right fall in shade (dunes, snowbanks).
	func dune(top, lit: float, shade: float, rim = null) -> void:
		for x in range(ceili(RenderBackdrops.BW)):
			var t: float = TS.round(top.call(x))
			var dark: bool = top.call(x + 1) > (top.call(x) + 0.15)
			var y: float = maxf(0, t)
			while y < RenderBackdrops.BH:
				self.set_(x, y, (rim if ((y == t) and (rim != null)) and (not dark) else (shade if dark else lit)))
				y += 1

	##  Single pixels scattered over a box (petals, leaves, sparks, rain).
	func scatter(seed_: float, n: float, x: float, y: float, w: float, h: float, colors, a = null) -> void:
		if a == null: a = 1
		for i in range(ceili(n)):
			self.set_(x + (RenderBackdrops.hash_(i, 1, seed_) * w), y + (RenderBackdrops.hash_(i, 2, seed_) * h), colors[floor(RenderBackdrops.hash_(i, 3, seed_) * colors.size())], a)
