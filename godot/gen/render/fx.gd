			var life: float = b["life"][0] + (self.rnd.call() * (b["life"][1] - b["life"][0]))
			self.ps.append({"x": b["x"] + (((self.rnd.call() - 0.5) * 2) * (b.get("jitter") if b.get("jitter") != null else 0)), "y": b["y"] + (((self.rnd.call() - 0.5) * 2) * ((b.get("jitterY") if b.get("jitterY") != null else b.get("jitter")) if (b.get("jitterY") if b.get("jitterY") != null else b.get("jitter")) != null else 0)), "vx": cos(a) * sp, "vy": sin(a) * sp, "life": life, "max": life, "color": b["color"], "color2": (b.get("color2") if b.get("color2") != null else b["color"]), "size": (b.get("size") if b.get("size") != null else 1), "gravity": (b.get("gravity") if b.get("gravity") != null else 0), "drag": (b.get("drag") if b.get("drag") != null else 0), "kind": (b.get("kind") if b.get("kind") != null else "dot"), "ground": (b.get("gravity") if b.get("gravity") != null else 0) > 0})
			i += 1

	func pulse(kind: String, x: float, y: float, r: float, color: float, life = null, color2 = null) -> Variant:
		if life == null: life = 0.3
		if color2 == null: color2 = color
		var q = {"kind": kind, "x": x, "y": y, "r": r, "t": 0, "max": life, "color": color, "seed": floor(self.rnd.call() * 1000), "x2": x, "y2": y, "color2": color2, "v": 0}
		self.pulses.append(q)
		return q

	##  A lightning bolt between two points (world metres).
	func bolt(x: float, y: float, x2: float, y2: float, color: float, life = null, core = null) -> void:
		if life == null: life = 0.2
		if core == null: core = 0xffffff
		var q = self.pulse("bolt", x, y, 0, color, life, core)
		q["x2"] = x2
		q["y2"] = y2

	##  A crescent slash across (x, y) facing `facing`, swept upward (`rising`) or downward.
	func slash(x: float, y: float, r: float, facing: float, rising: bool, color: float, core = null, life = null) -> void:
		if core == null: core = 0xffffff
		if life == null: life = 0.2
		var q = self.pulse("slash", x, y, r, color, life, core)
		q["x2"] = facing
		q["y2"] = (1 if rising else -1)

	## Particles drawn in to a point from a ring `r` metres round it, arriving
	## as they fade (power gathering for a super).
	func gather(x: float, y: float, r: float, count: float, color: float, color2: float, kind = null) -> void:
		if kind == null: kind = "streak"
		var i: float = 0
		while (i < count) and (self.ps.size() < RenderFx.MAX_PARTICLES):
			var a: float = (self.rnd.call() * PI) * 2
			var d: float = r * (0.7 + (self.rnd.call() * 0.3))
			var life: float = 0.18 + (self.rnd.call() * 0.12)
			var sp: float = d / life
			self.ps.append({"x": x + (cos(a) * d), "y": y + ((sin(a) * d) * 0.8), "vx": (-cos(a)) * sp, "vy": ((-sin(a)) * sp) * 0.8, "life": life, "max": life, "color": color, "color2": color2, "size": 1, "gravity": 0, "drag": 0, "kind": kind, "ground": false})
			i += 1

	func pop(text: String, x: float, y: float, style, life = null, vy = null) -> void:
		if life == null: life = 0.9
		if vy == null: vy = 1.6
		# Nudge up when stacking on a recent pop so numbers don't overlap.
		for p in self.pops:
			if ((absf(p["x"] - x) < 0.8) and (absf(p["y"] - y) < 0.35)) and (p["t"] < 0.25):
				y = p["y"] + 0.38
