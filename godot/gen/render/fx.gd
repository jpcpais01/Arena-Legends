		for i_4 in range(self.pops.size() - 1, 0 - 1, -1):
			var p_2 = self.pops[i_4]
			p_2["t"] += dt
			p_2["y"] += (p_2["vy"] * dt) * maxf(0, 1 - (p_2["t"] * 2.2))
			if p_2["t"] >= p_2["max"]:
				TS.splice(self.pops, i_4, 1)

	##  Ground-level effects (rings, cracks) drawn under the fighters.
	func draw_under(g, v) -> void:
		for q in self.pulses:
			if not RenderFx.GROUND.has(q["kind"]):
				continue
			var k: float = q["t"] / float(q["max"])
			var cx: float = TS.round(v["sx"].call(q["x"]))
			var cy: float = TS.round(v["sy"].call(0))
			if q["kind"] == "crater":
				RenderFx.draw_crater(g, q, cx, cy, k)
			elif q["kind"] == "spires":
				RenderFx.draw_spires(g, q, cx, cy, k)
			elif q["kind"] == "hellgate":
				RenderFx.draw_hellgate(g, q, cx, cy, k)
			elif q["kind"] == "vines":
				RenderFx.draw_vines(g, q, cx, cy, k)
			elif q["kind"] == "flower":
				RenderFx.draw_flower(g, q, cx, cy, k)
			elif q["kind"] == "groundRing":
				var rx: float = (q["r"] * SpriteAnimator.PPM) * (0.3 + (0.7 * sqrt(k)))
				var ry: float = rx * 0.22
				RenderFx.ellipse_outline(g, cx, cy, rx, ry, PixelColor.css(q["color"]), (0.5 if k > 0.6 else 1))
			else:
				# Radiating ground cracks that fade.
				g.fill_style = PixelColor.css(PixelColor.mix(q["color"], 0x1a1020, k))
				var s: float = q["seed"]
				for i in range(6):
					s = fmod((s * 9301) + 49297, 233280)
					var dir: float = (1 if i % 2 else -1)
					var x: float = cx
					var y: float = cy
					var len_: float = (q["r"] * SpriteAnimator.PPM) * (0.5 + ((s / 233280.0) * 0.5))
					for j in range(0, ceili(len_), 2):
						x += dir * 2
						y += ((((((int(s)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> (int((j % 7)) & 31)) & 1) - (0.5 * (int((j / 4.0)) & 1))
						g.fill_rect(TS.round(x), TS.round((y + (((((i) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 1)) - 1), 2, 1)

	func draw(g, v) -> void:
		for p in self.ps:
			var k: float = 1 - (p["life"] / float(p["max"]))
			var x: float = TS.round(v["sx"].call(p["x"]))
			var y: float = TS.round(v["sy"].call(p["y"]))
			var col: float = (p["color"] if k < 0.5 else PixelColor.mix(p["color"], p["color2"], (k - 0.5) * 2))
			if p["kind"] == "smoke":
