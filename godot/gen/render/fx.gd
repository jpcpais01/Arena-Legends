				var len_: float = minf(5, 1 + (sp * 0.35))
				var ux: float = p["vx"] / sp
				var uy: float = (-p["vy"]) / sp
				for i in range(ceili(len_)):
					g.fill_rect(TS.round(x - (ux * i)), TS.round(y - (uy * i)), 1, 1)
			elif p["kind"] == "ember":
				if (floori(p["life"] * 20) & 1) == 0:
					g.fill_rect(x, y, 1, 1)
			elif p["kind"] == "flame":
				# A flickering tongue of fire (epic skins): two pixels tall with a wide base, shrinking to one.
				g.fill_rect(x, y, 1, (2 if k < 0.55 else 1))
				if (k < 0.3) and ((floori(p["life"] * 24) & 1) == 0):
					g.fill_rect(x - 1, y + 1, 3, 1)
			elif p["kind"] == "plus":
				# A small plus that rises (regeneration), shrinking to a dot.
				g.fill_rect(x, y, 1, 1)
				if k < 0.6:
					g.fill_rect(x - 1, y, 3, 1)
					g.fill_rect(x, y - 1, 1, 3)
			elif p["kind"] == "drop":
				# A falling drop (sweat): a dot with a lighter top.
				g.fill_rect(x, y, 1, 2)
				g.fill_style = "#fff"
				g.fill_rect(x, y, 1, 1)
			elif (p["kind"] == "petal") or (p["kind"] == "flake"):
				# Drifting petals and snowflakes (usable item skins): they sway side to side as they fall.
				var sx: float = x + TS.round(sin((p["life"] * 5) + (p["max"] * 41)) * 1.4)
				if p["kind"] == "petal":
					# Two pixels, flipping between flat and tilted as it tumbles, the lit edge in the first colour.
					var flat: bool = (floori((p["life"] * 9) + (p["max"] * 13)) & 1) == 0
					g.fill_rect(sx, y, 1, 1)
					g.fill_style = PixelColor.css(PixelColor.mix(col, p["color2"], 0.5))
					g.fill_rect(sx + 1, (y if flat else y + 1), 1, 1)
				else:
					g.fill_rect(sx, y, 1, 1)
					if k < 0.35:
						g.fill_rect(sx - 1, y, 3, 1)
						g.fill_rect(sx, y - 1, 1, 3)
			elif p["kind"] == "twinkle":
				# A little four-point star that shrinks to a dot (legendary skins).
				g.fill_rect(x, y, 1, 1)
				if k < 0.45:
					g.fill_rect(x - 1, y, 3, 1)
					g.fill_rect(x, y - 1, 1, 3)
					if k < 0.15:
						g.fill_rect(x - 2, y, 5, 1)
						g.fill_rect(x, y - 2, 1, 5)
					g.fill_style = "#fff"
					g.fill_rect(x, y, 1, 1)
			else:
				var s: float = (p["size"] - 1 if (p["size"] > 1) and (k > 0.6) else p["size"])
				g.fill_rect(x, y, s, s)
		for q in self.pulses:
			if RenderFx.GROUND.has(q["kind"]):
				continue
			var k_2: float = q["t"] / float(q["max"])
			var cx: float = TS.round(v["sx"].call(q["x"]))
			var cy: float = TS.round(v["sy"].call(q["y"]))
			if q["kind"] == "ring":
				var r_2: float = (q["r"] * SpriteAnimator.PPM) * (0.25 + (0.75 * sqrt(k_2)))
				RenderFx.ellipse_outline(g, cx, cy, r_2, r_2, PixelColor.css(q["color"]), (0.5 if k_2 > 0.55 else 1))
			elif q["kind"] == "star":
				# Four-point impact flash that shrinks.
				var r_3: float = maxf(1, TS.round((q["r"] * SpriteAnimator.PPM) * (1 - k_2)))
				g.fill_style = PixelColor.css((0xffffff if k_2 < 0.3 else q["color"]))
				g.fill_rect(cx - r_3, cy, (r_3 * 2) + 1, 1)
				g.fill_rect(cx, cy - r_3, 1, (r_3 * 2) + 1)
				var d: float = TS.round(r_3 * 0.45)
				g.fill_rect(cx - d, cy - 1, (d * 2) + 1, 3)
				g.fill_rect(cx - 1, cy - d, 3, (d * 2) + 1)
				if r_3 > 4:
					g.fill_style = "#fff"
					g.fill_rect(cx - 1, cy - 1, 3, 3)
			elif q["kind"] == "bolt":
				self.draw_bolt(g, q, v, k_2)
			elif q["kind"] == "cloud":
				self.draw_cloud(g, q, cx, cy, k_2)
			elif q["kind"] == "clock":
				RenderFx.draw_clock(g, q, cx, cy, k_2)
			elif q["kind"] == "runes":
				RenderFx.draw_runes(g, q, cx, cy, k_2)
			elif q["kind"] == "eye":
				RenderFx.draw_eye(g, q, cx, cy, k_2)
			elif q["kind"] == "swirl":
				# Dots spiralling inward, trailing a second colour.
				var n: float = 10
				var R: float = (q["r"] * SpriteAnimator.PPM) * (1 - (k_2 * 0.85))
				for i_2 in range(ceili(n)):
					var a: float = ((((i_2 / n) * PI) * 2) + (k_2 * 9)) + q["seed"]
					var r_4: float = R * (0.75 + (0.25 * sin(i_2 * 2.3)))
					g.fill_style = PixelColor.css((q["color2"] if (i_2 & 1) else q["color"]))
					g.fill_rect(TS.round(cx + (cos(a) * r_4)), TS.round(cy + ((sin(a) * r_4) * 0.6)), 1, 1)
					if k_2 < 0.5:
						g.fill_rect(TS.round(cx + (cos(a - 0.25) * r_4)), TS.round(cy + ((sin(a - 0.25) * r_4) * 0.6)), 1, 1)
			elif q["kind"] == "coin":
				# Flipped up with a spin, hanging at the top before it fades.
				var s_2 = RenderSpecialArt.coin_sprite(floor(q["t"] * 18))
				var up: float = TS.round((q["r"] * SpriteAnimator.PPM) * sin((minf(1, k_2 * 1.6) * PI) * 0.5))
				if (k_2 < 0.8) or ((floori(q["t"] * 30) & 1) == 0):
					g.draw_image(s_2["img"], cx - s_2["ox"], (cy - up) - s_2["oy"])
			elif q["kind"] == "icicles":
				RenderFx.draw_icicles(g, q, cx, cy, k_2)
			elif q["kind"] == "slash":
				RenderFx.draw_slash(g, q, cx, cy, k_2)
			elif q["kind"] == "implode":
				# Closing in, brighter as it tightens.
				var r_5: float = (q["r"] * SpriteAnimator.PPM) * (1 - (k_2 * k_2))
				if r_5 >= 1:
					RenderFx.ellipse_outline(g, cx, cy, r_5, r_5 * 0.8, PixelColor.css((q["color2"] if k_2 > 0.6 else q["color"])), (0.5 if k_2 < 0.3 else 1))
			elif q["kind"] == "rays":
				RenderFx.draw_rays(g, q, cx, cy, k_2)
			elif q["kind"] == "focus":
				RenderFx.draw_focus(g, q, cx, cy, k_2)
			elif q["kind"] == "dome":
				RenderFx.draw_dome(g, q, cx, cy, k_2)
			elif q["kind"] == "constellation":
				RenderFx.draw_constellation(g, q, cx, cy, k_2)
			elif q["kind"] == "splash":
				RenderFx.draw_splash(g, q, cx, cy, k_2)
			elif q["kind"] == "wave":
				RenderFx.draw_wave(g, q, cx, cy, k_2)
			elif q["kind"] == "jet":
				RenderFx.draw_jet(g, q, cx, cy, k_2)
			elif q["kind"] == "gust":
				RenderFx.draw_gust(g, q, cx, cy, k_2)
			elif q["kind"] == "pillar":
				# Column of light (revive, meteor).
				var w: float = maxf(1, TS.round((q["r"] * SpriteAnimator.PPM) * (1 - k_2)))
				g.fill_style = PixelColor.css(q["color"])
				g.global_alpha = 1 - (k_2 * 0.6)
				g.fill_rect(cx - w, 0, w * 2, cy)
				g.fill_style = "#fff"
				g.fill_rect(cx - (((((int(w)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 1), 0, w, cy)
				g.global_alpha = 1
		for p_2 in self.pops:
			if (p_2["t"] > (p_2["max"] - 0.15)) and (floori(p_2["t"] * 30) & 1):
				continue
			RenderFont.draw_text(g, p_2["text"], v["sx"].call(p_2["x"]), v["sy"].call(p_2["y"]), p_2["style"])

	##  Jagged lightning, re-forked a few times while it lives, with a coloured halo and a branch.
	func draw_bolt(g, q, v, k: float) -> void:
		if (k > 0.55) and (floori(q["t"] * 40) & 1):
			return
		var x0: float = v["sx"].call(q["x"])
		var y0: float = v["sy"].call(q["y"])
		var x1: float = v["sx"].call(q["x2"])
		var y1: float = v["sy"].call(q["y2"])
		var len_: float = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0))
		var n: float = maxf(2, TS.round(len_ / 7.0))
		var nx: float = (-(y1 - y0)) / float((len_ if len_ else 1))
		var ny: float = (x1 - x0) / float((len_ if len_ else 1))
		var seed_ = [(q["seed"] * 7) + (floor(q["t"] * 25) * 131)]
		var _fn0 = func():
			seed_[0] = fmod((seed_[0] * 9301) + 49297, 233280)
			return (seed_[0]) / 233280.0
		var rnd = _fn0
		var pts = RenderFx.BOLT_PTS
		pts.resize(int(0))
		for i in range(floori(n) + 1):
			var t: float = i / n
			var off: float = (0 if (i == 0) or (i == n) else (rnd.call() - 0.5) * minf(12, len_ * 0.18))
			pts.append_array([TS.round((x0 + ((x1 - x0) * t)) + (nx * off)), TS.round((y0 + ((y1 - y0) * t)) + (ny * off))])
		g.fill_style = PixelColor.css(q["color"])
		var i_2: float = 0
		while (i_2 + 2) < pts.size():
			RenderFx.px_line(g, pts[i_2] + 1, pts[i_2 + 1], pts[i_2 + 2] + 1, pts[i_2 + 3])
			RenderFx.px_line(g, pts[i_2] - 1, pts[i_2 + 1], pts[i_2 + 2] - 1, pts[i_2 + 3])
			i_2 += 2
		# One fork off a middle joint.
		var j: float = 2 * (1 + floor(rnd.call() * maxf(1, n - 1)))
		if ((j + 1) < pts.size()) and (k < 0.7):
			var bx: float = (pts[j] + ((rnd.call() - 0.5) * 14)) + ((x1 - x0) * 0.12)
			var by: float = (pts[j + 1] + ((y1 - y0) * 0.15)) + ((rnd.call() - 0.5) * 8)
			RenderFx.px_line(g, pts[j], pts[j + 1], TS.round(bx), TS.round(by))
		g.fill_style = PixelColor.css(q["color2"])
		var i_3: float = 0
		while (i_3 + 2) < pts.size():
			RenderFx.px_line(g, pts[i_3], pts[i_3 + 1], pts[i_3 + 2], pts[i_3 + 3])
			i_3 += 2

	##  Billowing smoke: a few big dithered puffs that swell, drift up and thin away.
	func draw_cloud(g, q, cx: float, cy: float, k: float) -> void:
		var R: float = q["r"] * SpriteAnimator.PPM
		var grow: float = 0.55 + (0.45 * minf(1, k * 5))
		var s: float = q["seed"]
		for i in range(9):
			s = fmod((s * 9301) + 49297, 233280)
			var u: float = s / 233280.0
			s = fmod((s * 9301) + 49297, 233280)
			var w: float = s / 233280.0
			# Puffs low and wide first, the upper ones rising and drifting as it ages.
			var px: float = (cx + (((((u - 0.5) * 2) * R) * 0.75) * grow)) + (sin((q["t"] * 0.9) + i) * 2)
			var py: float = ((cy - 6) - (((w * R) * 0.9) * grow)) - ((k * 10) * w)
			var r: float = maxf(2, TS.round((((5 + (w * 7)) + ((i % 3) * 2)) * grow) * (1 + (k * 0.35))))
			var tone: float = (q["color2"] if (i % 3) == 0 else q["color"])
			# Thins out: the dither pattern gets sparser, then every other frame.
			if (k > 0.85) and (int((floor(q["t"] * 20) + i)) & 1):
				continue
			g.draw_image(self.puff(tone, r, (0.45 if k > 0.6 else (0.7 if k > 0.35 else 0.88))), TS.round(px) - r, TS.round(py) - r)

	func clear() -> void:
		self.ps.resize(int(0))
		self.pulses.resize(int(0))
		self.pops.resize(int(0))
		self.timers.resize(int(0))

	## A cloud puff: solid in the middle, dithering out at the rim, lit from
	## the upper left and shaded underneath. `density` thins the whole puff.
	func puff(col: float, r: float, density: float) -> Variant:
		var key: String = ("p" + TS.s(col) + "." + TS.s(r) + "." + TS.s(density))
		var c = self.smoke_cache.get(key)
		if c != null:
			return c
		c = Canvas2D.Surface.new()
		c.height = (r * 2) + 1
		c.width = c.height
		var g = c.get_context("2d")
		var hi: String = PixelColor.css(PixelColor.mix(col, 0xffffff, 0.3))
		var mid: String = PixelColor.css(col)
		var lo: String = PixelColor.css(PixelColor.mix(col, 0x2a2838, 0.3))
		for y in range(floori(r * 2) + 1):
			for x in range(floori(r * 2) + 1):
				var dx: float = x - r
				var dy: float = y - r
				var d: float = sqrt(dx * dx + dy * dy) / (r + 0.5)
				if d > 1:
					continue
				var fill: float = density * (1 if d < 0.55 else 1 - (((d - 0.55) / 0.45) * 0.85))
				if PixelPaint.bayer(x, y) >= fill:
					continue
				var light: float = (-((dx * 0.5) + (dy * 0.85))) / (r + 0.5)
				g.fill_style = (hi if light > 0.35 else (lo if light < (-0.3) else mid))
				g.fill_rect(x, y, 1, 1)
		TS.map_set(self.smoke_cache, key, c)
		return c

	func smoke(col: float, r: float, thin: bool) -> Variant:
		var key: String = (TS.s(col) + "." + TS.s(r) + "." + TS.s((1 if thin else 0)))
		var c = self.smoke_cache.get(key)
		if c != null:
			return c
		c = Canvas2D.Surface.new()
		c.height = (r * 2) + 1
		c.width = c.height
		var g = c.get_context("2d")
		g.fill_style = PixelColor.css(col)
		for y in range(floori(r * 2) + 1):
			for x in range(floori(r * 2) + 1):
				var d: float = sqrt((x - r) * (x - r) + (y - r) * (y - r)) / (r + 0.5)
				if d > 1:
					continue
				if PixelPaint.bayer(x, y) < ((0.35 if thin else 0.75) * (1 - ((d * d) * 0.5))):
					g.fill_rect(x, y, 1, 1)
		TS.map_set(self.smoke_cache, key, c)
		return c
