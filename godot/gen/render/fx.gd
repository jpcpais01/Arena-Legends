	func update(dt: float) -> void:
		for i in range(self.timers.size() - 1, 0 - 1, -1):
			var tm = self.timers[i]
			tm["t"] -= dt
			if (tm["t"]) > 0:
				continue
			TS.splice(self.timers, i, 1)
			tm["fn"].call()
