	var by = _d2[1]
	var x: float = x0 + ((bx - x0) * k)
	var y: float = (y0 + ((by - y0) * k)) + (sin(k * PI) * (1.1 if e.stage else 0.5))
	return [x, y, 1]

##  Where the front of the petal gust is (world x).
static func gust_x(e) -> float:
	var R: float = GUST * (1 if e.stage else 0.34)
	var k: float = (e.get_time() - 0.15) / 1.45
	return ((e.W[0] + e.F[0]) / 2.0) + (e.dir * ((-R) + ((k * 3.3) * R)))

static func finisher_length(id: String) -> float:
	return DEFS.get(id)["len"]

class Finisher:
	var id: String
	var host
	var win_at
	var fall_at
	var t: float
	var prev: float
	var timers
	##  How fast the sim runs this frame (1 = normal, 0 = frozen).
	var pace: float
	var frame
	var win_p
	var fall_p
	##  Live positions (feet) of the winner and the fallen.
	var W
	var F
	##  Which way from the winner the fallen lies (±1).
	var dir: float
	##  The fallen has been thrown up and came down again: when (finisher time), or −1.
	var land_t: float
	var flew: bool
	##  Moments a finisher fixes when they happen (a strike, a spot).
	var mark
	var bits
	var stage: bool
	var quiet: bool
	var hi: float
	var lo: float
	##  Size of drawn shapes (menu previews are small).
	var scale: float
	var top
	func _init(id: String, host, win_at, fall_at, opts) -> void:
		self.id = id
		self.host = host
		self.win_at = win_at
		self.fall_at = fall_at
		self.t = -1.0e-6
		self.prev = -1.0e-6
		self.timers = {}
		self.pace = 1
		self.frame = {"win": null, "fall": null}
		self.win_p = RenderFinisher.blank()
		self.fall_p = RenderFinisher.blank()
		self.W = [0, 0]
		self.F = [0, 0]
		self.dir = 1
		self.land_t = -1
		self.flew = false
		self.mark = {}
		self.bits = []
		self.stage = opts["stage"]
		self.quiet = (not (not opts.get("quiet")))
		self.scale = (1 if opts["stage"] else 0.62)
		self.top = (opts.get("top") if opts.get("top") != null else (func(): return (6.5 if opts["stage"] else 2.6)))
		var sig: float = CharacterFinales.FINISHERS.get(id)["color"]
		self.hi = (opts.get("hi") if opts.get("hi") != null else sig)
		self.lo = (opts.get("lo") if opts.get("lo") != null else PixelColor.mix(sig, 0x10081a, 0.55))
		self.locate()

	func get_len_() -> float:
		return RenderFinisher.DEFS.get(self.id)["len"]

	func get_time() -> float:
		return self.t

	func get_done() -> bool:
		return self.t >= self.get_len_()

	func locate() -> void:
		self.W = self.win_at.call()
		self.F = self.fall_at.call()
		self.dir = (signf(self.F[0] - self.W[0]) if signf(self.F[0] - self.W[0]) else 1)

	##  Advances on real time; false once it is over.
	func update(dt: float) -> bool:
		self.prev = self.t
		self.t += dt
		self.locate()
		if self.F[1] > 0.25:
			self.flew = true
		if (self.flew and (self.land_t < 0)) and (self.F[1] < 0.06):
			self.land_t = self.t
		RenderFinisher.reset(self.win_p)
		RenderFinisher.reset(self.fall_p)
		self.frame["fall"] = null
		self.frame["win"] = self.frame["fall"]
		self.pace = 1
		for i in range(self.bits.size() - 1, 0 - 1, -1):
			var b = self.bits[i]
			b["t"] += dt
			if b["t"] >= b["life"]:
				TS.splice(self.bits, i, 1)
				continue
			b["vy"] -= (14 if b.get("hit") == null else 0) * dt
			b["x"] += b["vx"] * dt
			b["y"] += b["vy"] * dt
			b["a"] += b["va"] * dt
			if (b["y"] < 0) and (b.get("hit") == null):
				b["y"] = 0
				b["vy"] *= -0.3
				b["vx"] *= 0.5
				b["va"] *= 0.5
		if self.get_done():
			return false
		RenderFinisher.DEFS.get(self.id)["step"].call(self, self.t)
		return true

	func draw(g, v, layer: String) -> void:
		if (self.t < 0) or self.get_done():
			return
		if RenderFinisher.DEFS.get(self.id).get("draw") != null:
			RenderFinisher.DEFS.get(self.id).get("draw").call(self, g, v, layer, self.t)

	# --- Timeline helpers ----------------------------------------------------------------------
	##  True on the frame the timeline passes `k`.
	func at(k: float) -> bool:
		return ((self.prev < k) and (self.t >= k))

	##  Every `s` seconds on its own named clock (trails, drizzles).
	func every(name: String, s: float) -> bool:
		var next: float = (self.timers.get(name) if self.timers.get(name) != null else 0)
		if self.t < next:
			return false
		TS.map_set(self.timers, name, self.t + s)
		return true

	##  The fallen has come down (or `by` passed): the moment a strike lands. Fixed the first time it happens.
	func strike(name: String, after: float, by: float) -> float:
		if ((self.mark.get(name) == null) and (self.t >= after)) and ((self.land_t >= 0) or (self.t >= by)):
			self.mark[name] = self.t
		return (self.mark.get(name) if self.mark.get(name) != null else -1)

	##  The winner shows `clip` (frame, face) instead of their animation.
	func win(clip: String, frame = null, face = null) -> Variant:
		if frame == null: frame = 0
		if face == null: face = null
		var p = self.win_p
		p["clip"] = clip
		p["frame"] = frame
		p["face"] = face
		self.frame["win"] = p
		return p

	##  The fallen keeps their animation but takes a colour wash.
	func fall(tint, a: float) -> Variant:
		var p = self.fall_p
		p["tint"] = tint
		p["tintA"] = a
		self.frame["fall"] = p
		return p

	##  The angle of the cut (eclipse, delayed cut), radians, world: down across from the winner's side.
	func get_cut_angle() -> float:
		return (-0.42 if self.dir > 0 else PI + 0.42)

	##  A height in the sky (world) that is still in view: `pad` below the top, never above `cap`.
	func sky(pad = null, cap = null) -> float:
		if pad == null: pad = 0.5
		if cap == null: cap = 5.6
		return maxf(1.6, minf(self.top.call() - pad, cap))

	##  The middle of the fallen body (world).
	func get_body() -> Variant:
		return [self.F[0], self.F[1] + 0.55]

	func get_fx() -> Variant:
		return self.host["fx"]

	func sound(name: String, k = null) -> void:
		if k == null: k = 1
		self.host["sound"].call(name, k)

	func shake(a: float) -> void:
		self.host["shake"].call((a * 0.4 if self.quiet else a))

	func flash(c: float, a: float) -> void:
		if not self.quiet:
			self.host["flash"].call(c, a)

	func light(l) -> void:
		self.host["light"].call(l)

	func impact(hi: float, lo: float, len_ = null) -> void:
		if len_ == null: len_ = 0.06
		self.host["impact"].call(hi, lo, len_)

	func split(k: float, life: float) -> void:
		self.host["split"].call(k, life)

	func vignette(c: float, k: float, life: float) -> void:
		self.host["vignette"].call(c, k, life)

	func focus(x: float, seconds: float, levels = null) -> void:
		if levels == null: levels = 1
		self.host["focus"].call(x, seconds, levels)

	func glow(x: float, y: float, r0: float, r1: float, hi: float, lo: float, life: float, power = null, extra = null) -> void:
		if power == null: power = 1
		if extra == null: extra = {}
		self.light(TS.merge([{"kind": "glow", "x": x, "y": y, "r0": r0, "r1": r1, "hi": hi, "lo": lo, "life": life, "power": power}, extra]))

	##  A shockwave bending the picture (battle) with a ring of light that also shows in the menus.
	func shock(x: float, y: float, r: float, amp: float, life: float, hi: float, squash = null) -> void:
		if squash == null: squash = 1
		self.host["shock"].call({"x": x, "y": y, "r": r, "amp": amp, "life": life, "hi": hi, "squash": squash, "dir": self.dir})
		self.light({"kind": "ring", "x": x, "y": y, "r0": r * 0.12, "r1": r * 0.85, "w": 0.06, "squash": squash, "hi": hi, "lo": PixelColor.mix(hi, 0x000000, 0.5), "life": life * 0.85, "power": 0.9, "fin": 0})

	##  A flat ring of light racing out over the ground.
	func ground_shock(x: float, r: float, hi: float, lo: float, life = null) -> void:
		if life == null: life = 0.5
		self.light({"kind": "ring", "x": x, "y": 0.04, "r0": r * 0.15, "r1": r, "w": 0.08, "squash": 0.22, "hi": hi, "lo": lo, "life": life, "power": 1.1, "fin": 0})
		self.host["shock"].call({"x": x, "y": 0.1, "r": r * 0.9, "amp": 3, "life": life * 0.9, "hi": lo, "squash": 0.35})

	##  A big blow on the spot: impact frame, shockwave, smear, colour split, flare.
	func blow(x: float, y: float, hi: float, lo: float, size = null, frame = null) -> void:
		if size == null: size = 1
		if frame == null: frame = true
		if frame:
			self.impact(hi, RenderFinisher.ink(lo), 0.05 + (0.03 * size))
		self.shock(x, y, 2.6 * size, 5 + (3 * size), 0.55, hi, 0.75)
		self.host["zoomBlur"].call(x, y, 0.025 * size, 0.22)
		self.split(1.5 * size, 0.35)
		self.light({"kind": "flare", "x": x, "y": y, "r0": 1.2 * size, "r1": 3.4 * size, "w": 0.05, "hi": hi, "lo": lo, "life": 0.5, "power": 0.9, "fin": 0, "real": true})

	##  The knockout itself, shared by every finisher: the crowd roars, the hit rings out.
	func ko(hi: float, shake = null) -> void:
		if shake == null: shake = 0.8
		self.sound("ko")
		self.shake(shake)
		var _d0 = self.get_body()
		var x = _d0[0]
		var y = _d0[1]
		self.get_fx().pulse("star", x, y, 1.1 * self.scale, 0xfff0c0, 0.25)
		self.get_fx().burst({"x": x, "y": y, "count": (26 if self.stage else 12), "speed": [3, 9], "life": [0.25, 0.6], "color": RenderFinisher.WHITE, "color2": hi, "drag": 1.5, "kind": "streak"})

	##  Dust thrown out low to both sides where the fallen lands.
	func dust(x: float, count: float, speed = null) -> void:
		if speed == null: speed = 3
		for d in [0, PI]:
			self.get_fx().burst({"x": x, "y": 0.12, "count": count, "jitter": 0.2, "jitterY": 0.08, "dir": d + (-0.25 if d else 0.25), "spread": 0.35, "speed": [speed * 0.4, speed], "life": [0.35, 0.7], "color": 0xd8c8a8, "color2": 0x6a5a48, "kind": "smoke", "size": 3, "drag": 3})
