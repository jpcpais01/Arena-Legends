	# --- Gear that rides along -------------------------------------------------------------
	##  Places a small sprite (anchor at px, py), facing like the fighter, with its night accents.
	func put(g, s, x: float, y: float, flip: bool) -> void:
		RenderBattleView.blit(g, s, x, y, flip)
		if s.get("glow") != null:
			self.glow_list.append({"s": s, "x": x, "y": y, "flip": flip})

	## The hunting hawk: perched on the near shoulder, now and then looking
	## round or rousing its wings. Charging a dive it flaps up off the
	## shoulder to where the dive starts; while it is out (the `hawk` shot) the
	## perch is empty, then it glides home and lands with a flap.
	func draw_hawk(g, f, v, px: float, py: float, dt: float) -> void:
		var fam = f["familiar"]
		var flip: bool = f["facing"] < 0
		var perch_x: float = px - (f["facing"] * (v["spread"] + 7))
		var perch_y: float = (py - v["shPx"]) + 2
		var flap: String = ("up" if (floori(self.time * 16) & 1) else "down")
		var skin = v["art"]["specialSkinId"]
		if fam["away"] > 0:
			for p in self.battle.projectiles:
				if (p["alive"] and (p["owner"] == f["id"])) and (p["style"] == "hawk"):
					return
			if v["hawkFrom"] == null:
				return
			# Flying home along a shallow arc.
			var k: float = CoreMath.clamp_(1 - (fam["away"] / float(maxf(0.05, v["hawkAway"]))), 0, 1)
			var sx: float = TS.round(self.sx(v["hawkFrom"][0]))
			var sy: float = TS.round(self.sy(v["hawkFrom"][1]))
			var hx: float = TS.round(sx + ((perch_x - sx) * k))
			var hy: float = TS.round((sy + ((perch_y - sy) * k)) - (sin(k * PI) * 14))
			var pose: String = (flap if k > 0.8 else ("up" if fmod(floor(self.time * 8), 3) == 0 else "glide"))
			self.put(g, RenderSpecialArt.hawk_sprite(pose, skin), hx, hy, perch_x < sx)
			self.item_sparks(v, hx, hy - 4)
			v["landT"] = 0.3
			return
		v["hawkFrom"] = null
		if fam["charge"] > 0:
			# Rousing, then lifting off toward the start of the dive (2.9 m up).
			var k_2: float = CoreMath.clamp_(1 - (fam["charge"] / float(SimBattle.HAWK_DIVE["windup"])), 0, 1)
			var top: float = TS.round(self.sy(f["y"] + 2.9))
			var lift: float = (0 if k_2 < 0.35 else pow((k_2 - 0.35) / 0.65, 2))
			var hy_2: float = TS.round(perch_y + ((top - perch_y) * lift))
			self.put(g, RenderSpecialArt.hawk_sprite(flap, skin), perch_x, hy_2, flip)
			self.item_sparks(v, perch_x, hy_2 - 4)
			return
		if v["landT"] > 0:
			v["landT"] -= dt
			self.put(g, RenderSpecialArt.hawk_sprite(flap, skin), perch_x, perch_y - (1 if v["landT"] > 0.15 else 0), flip)
			return
		# Idle on the perch: looks about every few seconds, rouses its wings now and then.
		var t: float = fmod((self.time + (f["id"] * 1.7)), 6)
		var pose_2: String = (("down" if t > 5.75 else "up") if t > 5.5 else ("perch1" if (t > 2.4) and (t < 3.3) else "perch0"))
		self.put(g, RenderSpecialArt.hawk_sprite(pose_2, skin), perch_x, perch_y, flip)
		self.item_sparks(v, perch_x, perch_y - 5)

	## The dragon whelp hovers just above and behind its owner's head, wings
	## beating. Charging, it rears back with its wings flared, then thrusts its
	## head forward with its jaws open as the breath comes out.
	func draw_whelp(g, f, v, px: float, py: float, dt: float) -> void:
		var fam = f["familiar"]
		var flip: bool = f["facing"] < 0
		var bob: float = TS.round(sin((self.time * 4) + f["id"]) * 1.5)
		var wx: float = px - (f["facing"] * 4)
		var wy: float = ((py - v["topPx"]) - 5) + bob
		var pose: String = ("hover1" if (floori((self.time * 7) + f["id"]) & 1) else "hover0")
		if fam["charge"] > 0:
			var k: float = 1 - (fam["charge"] / float(SimBattle.WHELP_BREATH["windup"]))
			if k < 0.65:
				pose = "rear"
				wx -= f["facing"]
				wy -= 1
			else:
				pose = "breath"
				wx += f["facing"] * 2
			v["breathT"] = 0.22
		elif v["breathT"] > 0:
			v["breathT"] -= dt
			pose = "breath"
			wx += f["facing"] * 2
		self.put(g, RenderSpecialArt.whelp_sprite(pose, v["art"]["specialSkinId"]), wx, wy, flip)
		self.item_sparks(v, wx, wy)

	##  A legendary special item sheds sparkles (or flames) from where it rides, at screen point (x, y).
	func item_sparks(v, x: float, y: float) -> void:
		var fx = (null if v["art"]["specialSkin"] == null else v["art"]["specialSkin"].get("fx"))
		var dt: float = self.last_dt
		var _c0 = false
		_c0 = fx == null
		if not _c0:
			_c0 = dt <= 0
		if not _c0:
			v["sparkT"]["item"] -= dt
			_c0 = (v["sparkT"]["item"]) > 0
		if _c0:
			return
		v["sparkT"]["item"] = 0.16
		var flame: bool = fx.get("kind") == "flame"
		self.fx.burst({"x": self.wx(x), "y": self.wy(y), "jitter": 0.12, "jitterY": 0.12, "count": 1, "dir": PI / 2.0, "spread": (0.3 if flame else 0.7), "speed": ([0.5, 1.1] if flame else [0.1, 0.4]), "life": [0.35, 0.7], "color": fx["spark"], "color2": fx["spark2"], "kind": (fx.get("kind") if fx.get("kind") != null else "twinkle")})

	##  The thunder totem's charm, floating at the back shoulder until it is planted.
	func draw_charm(g, f, v, px: float, py: float, dt: float) -> void:
		for z in self.battle.zones:
			if (z["owner"] == f["id"]) and (z["kind"] == "totem"):
				return
		var it = (f["item"] if (f["item"] != null) and (f["abilities"][f["item"]["ability"]]["kind"] == "totem") else null)
		if (it != null) and (it["phase"] != "windup"):
			return
		# Rising and shaking as it charges to be planted.
		var charge: float = (CoreMath.clamp_(it["t"] / float(f["abilities"][it["ability"]]["windup"]), 0, 1) if it != null else 0)
		var cx: float = (px - (f["facing"] * 12)) + ((floori(self.time * 30) & 1) if charge > 0.5 else 0)
		var cy: float = TS.round((((py - v["shPx"]) - 6) + (sin((self.time * 2.6) + f["id"]) * 1.5)) - (charge * 8))
		self.put(g, RenderSpecialArt.charm_sprite(v["art"]["specialSkinId"]), cx, cy, f["facing"] < 0)
		self.item_sparks(v, cx, cy)
		if ((it != null) and (dt > 0)) and (randf() < 0.5):
			var c = self.glow(f["id"], 0xf0ffff, 0x4ac0ff)
			self.fx.burst({"x": self.wx(cx), "y": self.wy(cy - 3), "count": 1, "jitter": 0.08, "speed": [0.5, 1.5], "life": [0.1, 0.25], "color": c[0], "color2": c[1], "kind": "streak"})

	## Thunderhead: a little storm cloud riding over the back shoulder. When it
	## marks the enemy it drifts over to hang above them, flickering, until the
	## bolt comes down; then it drifts home.
	func draw_cloud(g, f, v, px: float, py: float, dt: float) -> void:
		var b = self.battle
		var mark = TS.find(b.zones, (func(z, _a1 = null, _a2 = null): return ((z["owner"] == f["id"]) and (z["kind"] == "strike"))))
		var tx: float = (self.sx(mark["x"]) if mark != null else px - (f["facing"] * 10))
		var ty: float = (self.sy(3.2) if mark != null else ((py - v["topPx"]) - 4) + (sin((self.time * 2) + f["id"]) * 1.5))
		if v["cloud"] == null:
			v["cloud"] = [tx, ty]
		var c = (v["cloud"])
		var k: float = minf(1, dt * (9 if mark != null else 4))
		c[0] += (tx - c[0]) * k
		c[1] += (ty - c[1]) * k
		var cx: float = TS.round(c[0])
		var cy: float = TS.round(c[1])
		var skin = v["art"]["specialSkinId"]
		var s = RenderSpecialArt.cloud_sprite((not (mark == null)), skin, floor((self.time * (14 if mark != null else 5)) + f["id"]))
		self.put(g, s, cx, cy, f["facing"] < 0)
		if mark != null:
			self.glow_list.append({"s": s, "x": cx, "y": cy, "flip": f["facing"] < 0})
		self.item_sparks(v, cx, cy - 4)
		# A few drops of rain under it while it hangs over the mark.
		if ((mark != null) and (dt > 0)) and (randf() < (dt * 14)):
			var col = self.glow(f["id"], 0xd8f0ff, 0x6a8ac8)
			self.fx.burst({"x": self.wx(cx + ((randf() - 0.5) * 12)), "y": self.wy(cy + 1), "count": 1, "dir": (-PI) / 2.0, "spread": 0.1, "speed": [3, 4], "life": [0.15, 0.3], "color": col[0], "color2": col[1], "kind": "streak"})

	##  Bleeding: drops of blood fall off the wound, faster while the fighter moves.
	func drip(f, v, x: float, y: float, dt: float) -> void:
		v["dripT"] -= dt
		if (v["dripT"]) > 0:
			return
		var moving: bool = ((absf(f["x"] - f["px"]) > 0.002) or (f["y"] > 0.05))
		v["dripT"] = (0.07 if moving else 0.35)
		self.fx.burst({"x": x + ((randf() - 0.5) * 0.3), "y": (y + 0.7) + (randf() * 0.7), "count": 1, "dir": PI / 2.0, "spread": 0.8, "speed": [0.3, 1.2], "life": [0.4, 0.7], "color": 0xe8283a, "color2": 0x7a0a14, "gravity": 9, "kind": "drop"})

	##  Sands of Time: a small hourglass at the back shoulder, sand trickling (spent once it has turned).
	func draw_hourglass(g, f, v, px: float, py: float) -> void:
		var used: bool = f["rewindUsed"]
		var cx: float = px - (f["facing"] * 12)
		var cy: float = TS.round(((py - v["shPx"]) - 4) + (sin((self.time * 2.2) + f["id"]) * 1.5))
		if used:
			g.global_alpha = 0.6
		self.put(g, RenderSpecialArt.hourglass_sprite((0 if used else floor(self.time * 5)), v["art"]["specialSkinId"]), cx, cy, f["facing"] < 0)
		g.global_alpha = 1
		if not used:
			self.item_sparks(v, cx, cy)

	## The gale bell hangs over the back shoulder, rocking gently. Its wind rune
	## glows while it's ready to ring and goes dark while it recharges; tolling,
	## it lifts and swings hard, then settles as the swing dies away.
	func draw_bell(g, f, v, px: float, py: float, dt: float) -> void:
		var idx: float = TS.find_index(f["abilities"], (func(a, _a1 = null, _a2 = null): return a["kind"] == "repel"))
		if idx < 0:
			return
		var it = (f["item"] if (f["item"] != null) and (f["item"]["ability"] == idx) else null)
		var ready: bool = ((it == null) and (f["cooldowns"][idx] <= 0))
		var tilt: float = sin((self.time * 1.7) + (f["id"] * 2)) * 0.7
		var lift: float = 0
		if (null if it == null else it["phase"]) == "windup":
			var k: float = minf(1, it["t"] / float(f["abilities"][idx]["windup"]))
			tilt = (sin(it["t"] * 40) * 2) * (0.4 + (0.6 * k))
			lift = k * 4
		elif it != null:
			var k_2: float = minf(1, it["t"] / 0.45)
			tilt = (sin(it["t"] * 26) * 2) * (1 - k_2)
			lift = 4 * (1 - k_2)
		var state: String = ("toll" if it != null else ("ready" if ready else "spent"))
		var cx: float = px - (f["facing"] * 12)
		var cy: float = TS.round((((py - v["shPx"]) - 12) + (sin((self.time * 2.4) + f["id"]) * 1.5)) - lift)
		self.put(g, RenderSpecialArt.bell_sprite(state, tilt, v["art"]["specialSkinId"], floor((self.time * 6) + f["id"])), cx, cy, f["facing"] < 0)
		self.item_sparks(v, cx, cy + 6)
		# Ready: now and then a wisp of wind curls off the rim.
		if (ready and (dt > 0)) and (randf() < (dt * 2.5)):
			var c = self.glow(f["id"], 0xd8fff4, 0x5ad8c0)
			var side: float = (-1 if randf() < 0.5 else 1)
			self.fx.burst({"x": self.wx(cx + (side * 4)), "y": self.wy(cy + 10), "count": 1, "dir": (PI / 2.0) + (side * 0.9), "spread": 0.3, "speed": [0.4, 0.9], "life": [0.4, 0.7], "color": c[0], "color2": c[1], "kind": "twinkle"})

	##  The ward stone circles the chest; `back` draws it only on the far half of its orbit.
	func draw_ward(g, f, v, px: float, py: float, back: bool) -> void:
		var a: float = (self.time * 2.2) + (f["id"] * 2)
		if (sin(a) < 0) != back:
			return
		var lit: bool = v["wardT"] > self.time
		var x: float = TS.round(px + (cos(a) * 13))
		var y: float = TS.round(((py - (v["shPx"] * 0.72)) + (sin(a) * 3)) + sin(self.time * 3))
		if back:
			g.global_alpha = 0.85
		self.put(g, RenderSpecialArt.ward_sprite((lit or ((f["shield"] > 0) and (fmod(floor(self.time * 3), 4) == 0))), v["art"]["specialSkinId"], floor(self.time * 6)), x, y, false)
		g.global_alpha = 1
		if not back:
			self.item_sparks(v, x, y)

	##  Marks over the head: silenced (a struck-out seal), afraid (a small skull), side by side.
	func head_marks(g, f, hx: float, hy: float, fear: bool) -> void:
		var sil: bool = (not (not (SimFighter.get_status(f, "silence") != null)))
		if (not sil) and (not fear):
			return
		var both: bool = (sil and fear)
		var bob: float = TS.round(sin(self.time * 4))
		if sil:
			RenderBattleView.blit(g, RenderSpecialArt.silence_sprite(), hx - (5 if both else 0), hy + bob, false)
		if fear:
			RenderBattleView.blit(g, RenderSpecialArt.skull_sprite(), (hx + (5 if both else 0)) + (floori(self.time * 20) & 1), (hy - 1) + bob, false)

	##  Bolas cords wound round both shins, the weights hanging off them.
	func draw_cords(g, px: float, py: float, facing: float) -> void:
		var x0: float = (px - 7) + facing
		var w: float = 14
		# Two twisted cords, each a light strand over a dark one, slanting as they wrap.
		for _e0 in [[-4, 0], [-8, 2]]:
			var dy = _e0[0]
			var ph = _e0[1]
			for i in range(ceili(w)):
				var y: float = (py + dy) + (0 if i < (w / 2.0) else -1)
				g.fill_style = "#3a2414"
				g.fill_rect(x0 + i, y + 1, 1, 1)
				g.fill_style = ("#8a5a2a" if fmod((i + ph), 3) == 0 else ("#d8a868" if fmod((i + ph), 3) == 1 else "#f0d498"))
				g.fill_rect(x0 + i, y, 1, 1)
		# The two weights, swinging a little.
		var sw: float = TS.round(sin(self.time * 5))
		for side in [-1, 1]:
			var bx: float = (px + (side * 8)) + (sw if side > 0 else -sw)
			var by: float = py - 3
			g.fill_style = "#c89a5a"
			g.fill_rect(px + (side * 6), by - 4, 1, 3)
			g.fill_style = "#3a2a24"
			g.fill_rect(bx - 1, by - 1, 3, 3)
			g.fill_style = "#7a6a5a"
			g.fill_rect(bx - 1, by - 1, 2, 2)
			g.fill_style = "#b0a090"
			g.fill_rect(bx - 1, by - 1, 1, 1)

	##  Momentum: a row of small orange chevrons at the feet, one per stack, a shimmer running forward.
	func draw_momentum(g, px: float, py: float, facing: float, stacks: float) -> void:
		var n: float = minf(5, stacks)
		var run: float = fmod((self.time * 6), (n + 3))
		for i in range(ceili(n)):
			var x: float = px + (facing * (5 + (i * 3)))
			var y: float = py - 2
			g.fill_style = ("#fff0b0" if absf(run - i) < 1 else ("#ff9a2a" if i < (n - 1) else "#ffc050"))
			g.fill_rect(x, y - 1, 1, 1)
			g.fill_rect(x + facing, y, 1, 1)
			g.fill_rect(x, y + 1, 1, 1)

	##  Smoke drifting round a hidden fighter, sweat off a frightened one, motes rising while regenerating.
	func status_puffs(f, v, x: float, y: float, dt: float, hidden: bool, fear: bool) -> void:
		v["puffT"] -= dt
		if v["puffT"] > 0:
			return
		v["puffT"] = 0.09
		var fx = self.fx
		# Hiding in a skinned smoke bomb's cloud, or regenerating from a skinned tonic: the item's colours.
		var use = (v["art"]["use"] if v["art"]["useSkinId"] else null)
		if hidden:
			var c = (null if use == null else use["glow"])
			var light: bool = randf() < 0.5
			fx.burst({"x": x, "y": (y + 0.4) + (randf() * 1.4), "count": 1, "jitter": 0.45, "dir": PI / 2.0, "spread": 1.2, "speed": [0.15, 0.5], "life": [0.7, 1.2], "color": (PixelColor.mix(c[0], c[1], (0.3 if light else 0.55)) if c != null else (0xb8b8c4 if light else 0x8a8a98)), "color2": (PixelColor.mix(c[1], 0x202028, 0.3) if c != null else 0x5a5a68), "kind": "smoke", "size": 3 + floor(randf() * 3), "drag": 1})
			var ufx = ((null if v["art"]["useSkin"] == null else v["art"]["useSkin"].get("fx")) if use != null else null)
			if (ufx != null) and (randf() < 0.3):
				fx.burst({"x": x, "y": (y + 1.6) + (randf() * 0.6), "count": 1, "jitter": 0.6, "dir": (-PI) / 2.0, "spread": 0.5, "speed": [0.3, 0.6], "life": [0.9, 1.4], "color": ufx["spark"], "color2": ufx["spark2"], "kind": (ufx.get("kind") if ufx.get("kind") != null else "twinkle")})
		if fear and (randf() < 0.35):
			fx.burst({"x": x + (f["facing"] * 0.12), "y": y + 2.0, "count": 1, "jitter": 0.12, "dir": (PI / 2.0) - (f["facing"] * 0.8), "spread": 0.4, "speed": [1, 2], "life": [0.4, 0.6], "color": 0xd8f0ff, "color2": 0x6ab0e8, "gravity": 9, "kind": "drop"})
		if SimFighter.get_status(f, "regen") != null:
			var c_2 = (use["glow"] if (use != null) and (v["art"]["useId"] == "troll_tonic") else null)
			fx.burst({"x": x, "y": (y + 0.2) + (randf() * 1.4), "count": 1, "jitter": 0.42, "dir": PI / 2.0, "spread": 0.15, "speed": [0.6, 1.1], "life": [0.6, 1.0], "color": (PixelColor.mix(c_2[0], 0xffffff, 0.35) if c_2 != null else 0xd0ffb0), "color2": (c_2[1] if c_2 != null else 0x3ab85a), "kind": "plus"})
			if randf() < 0.5:
				fx.burst({"x": x, "y": y + 0.1, "count": 1, "jitter": 0.35, "dir": PI / 2.0, "spread": 0.1, "speed": [0.8, 1.4], "life": [0.5, 0.8], "color": (c_2[0] if c_2 != null else 0x9aff7a), "color2": (c_2[1] if c_2 != null else 0x2a8a4a)})

	# --- Zones -----------------------------------------------------------------------------
	##  World position of an art-px point (for particles spawned at a sprite).
	func wx(px: float) -> float:
		return self.cam_x + (((px - (self.screen.w / 2.0)) - self.shake_x) / float(SpriteAnimator.PPM))

	func wy(py: float) -> float:
		return ((self.gy + self.shake_y) - py) / float(SpriteAnimator.PPM)

	##  How solid a zone is: it fades in, and flickers away over its last second.
	func zone_alpha(z) -> float:
		var age: float = z["span"] - z["life"]
		if z["life"] < 1:
			return z["life"] * (0.4 if (floori(self.time * 20) & 1) and (z["life"] < 0.5) else 1)
		return minf(1, age * 6)

	##  On the ground: the caltrops patch, the totem's circle.
	func draw_zone_ground(g, z) -> void:
		var cx: float = TS.round(self.sx(z["x"]))
		var cy: float = TS.round(self.sy(0))
		var a: float = self.zone_alpha(z)
		if z["kind"] == "vortex":
			self.draw_vortex(g, z, cx, cy, a)
			return
		if z["kind"] == "strike":
			self.draw_mark(g, z, cx, cy)
			return
		if z["kind"] == "caltrops":
			var p = RenderSpecialArt.caltrops_patch(z["id"], TS.round(z["radius"] * SpriteAnimator.PPM), self.patch_look(z["owner"]))
			g.global_alpha = a
			g.draw_image(p["sprite"]["img"], cx - p["sprite"]["ox"], cy - p["sprite"]["oy"])
			g.global_alpha = 1
			return
		# Totem: a faint dashed circle with sparks crawling round it.
		var rx: float = z["radius"] * SpriteAnimator.PPM
		var ry: float = minf(rx * 0.22, 8)
		var hot: float = (self.zone_hot.get(float(z["id"])) if self.zone_hot.get(float(z["id"])) != null else 0)
		var _q0 = TS.at(self.fighters, z["owner"])
		var sk = (null if _q0 == null else (null if _q0["art"]["specialSkin"] == null else _q0["art"]["specialSkin"].get("glow")))
		var mid: String = (PixelColor.css(PixelColor.mix(sk[0], sk[1], 0.45)) if sk != null else "#7ad8ff")
		var light: String = (PixelColor.css(PixelColor.mix(sk[0], sk[1], 0.15)) if sk != null else "#d8f8ff")
		var hi: String = (PixelColor.css(sk[0]) if sk != null else "#f0ffff")
		g.global_alpha = a * (0.5 + (0.4 if hot > 0 else 0))
		RenderFx.ellipse_outline(g, cx, cy + 1, rx, ry, mid, 1)
		g.global_alpha = a * 0.3
		RenderFx.ellipse_outline(g, cx, cy + 1, rx - 3, ry - 1, light, 0.5)
		g.global_alpha = a
		for i in range(3):
			var t: float = (self.time * 1.4) + (((i * PI) * 2) / 3.0)
			var sx: float = TS.round(cx + (cos(t) * rx))
			var sy: float = TS.round((cy + 1) + (sin(t) * ry))
			g.fill_style = hi
			g.fill_rect(sx, sy, 1, 1)
			g.fill_style = mid
			g.fill_rect(sx - signf(sin(t)), sy, 1, 1)
		g.global_alpha = 1

	##  Maelstrom: a whirlpool on the ground, its arms spiralling in to the eye.
	func draw_vortex(g, z, cx: float, cy: float, a: float) -> void:
		var rx: float = z["radius"] * SpriteAnimator.PPM
		var ry: float = minf(rx * 0.22, 9)
		var _q0 = TS.at(self.fighters, z["owner"])
		var sk = (null if _q0 == null else (null if _q0["art"]["useSkin"] == null else _q0["art"]["useSkin"].get("glow")))
		var hi: String = PixelColor.css(((null if sk == null else sk[0]) if (null if sk == null else sk[0]) != null else 0xc8fff8))
		var mid: String = PixelColor.css((PixelColor.mix(sk[0], sk[1], 0.5) if sk != null else 0x3ac8c8))
		var deep: String = PixelColor.css(((null if sk == null else sk[1]) if (null if sk == null else sk[1]) != null else 0x1a6a8a))
		g.global_alpha = a * 0.22
		g.fill_style = deep
		g.begin_path()
		g.ellipse(cx, cy + 1, rx, ry, 0, 0, PI * 2)
		g.fill()
		g.global_alpha = a * 0.6
		RenderFx.ellipse_outline(g, cx, cy + 1, rx, ry, mid, 1)
		# Three arms of foam spiralling inward, turning.
		var spin: float = self.time * 3.2
		for arm in range(3):
			for i in range(14):
				var u: float = i / 14.0
				var ang: float = (spin + (((arm * PI) * 2) / 3.0)) + (u * 3.4)
				var rr: float = 1 - (u * 0.92)
				g.global_alpha = a * (0.3 + (0.6 * u))
				g.fill_style = (hi if u > 0.7 else mid)
				g.fill_rect(TS.round(cx + ((cos(ang) * rx) * rr)), TS.round((cy + 1) + ((sin(ang) * ry) * rr)), 1, 1)
		g.global_alpha = 1
		if (self.last_dt > 0) and (randf() < ((self.last_dt * 10) * a)):
			var ang_2: float = (randf() * PI) * 2
			var c = (sk if sk != null else [0xc8fff8, 0x3ac8c8])
			self.fx.burst({"x": z["x"] + (cos(ang_2) * z["radius"]), "y": 0.1, "count": 1, "dir": (0 if ang_2 > PI else PI), "spread": 0.3, "speed": [1, 2], "life": [0.2, 0.4], "color": c[0], "color2": c[1], "kind": "streak"})

	##  The storm cloud's mark: a ring on the ground that tightens and brightens until the bolt drops.
	func draw_mark(g, z, cx: float, cy: float) -> void:
		var k: float = CoreMath.clamp_(1 - (z["life"] / float(z["span"])), 0, 1)
		var _q0 = TS.at(self.fighters, z["owner"])
		var sk = (null if _q0 == null else (null if _q0["art"]["specialSkin"] == null else _q0["art"]["specialSkin"].get("glow")))
		var col: String = PixelColor.css(((null if sk == null else sk[0]) if (null if sk == null else sk[0]) != null else 0xd8f4ff))
		var mid: String = PixelColor.css((PixelColor.mix(sk[0], sk[1], 0.5) if sk != null else 0x7ab8ff))
		var rx: float = (z["radius"] * SpriteAnimator.PPM) * (1.25 - (0.25 * k))
		var ry: float = minf(rx * 0.22, 8)
		var blink: float = (floori(self.time * (8 + (k * 16))) & 1)
		g.global_alpha = 0.35 + (0.5 * k)
		RenderFx.ellipse_outline(g, cx, cy + 1, rx, ry, (col if blink else mid), 1)
		g.global_alpha = 0.2 + (0.4 * k)
		RenderFx.ellipse_outline(g, cx, cy + 1, (rx * (1 - k)) + 2, maxf(1, ry * (1 - k)), col, 1)
		g.global_alpha = 1

	##  A planted thunder totem: drops in, crackles, flares when it strikes, fades at the end.
	func draw_totem(g, z, dt: float) -> void:
		var age: float = z["span"] - z["life"]
		var drop: float = (TS.round(pow((1 - (age / 0.14)), 2) * 70) if age < 0.14 else 0)
		var cx: float = TS.round(self.sx(z["x"]))
		var cy: float = TS.round(self.sy(0))
		var hot: float = (self.zone_hot.get(float(z["id"])) if self.zone_hot.get(float(z["id"])) != null else 0) - dt
		if hot > 0:
			TS.map_set(self.zone_hot, float(z["id"]), hot)
		else:
			self.zone_hot.erase(float(z["id"]))
		self.arena.shadow(g, cx, cy, 6, 0.8)
		var a: float = self.zone_alpha(z)
		if a <= 0:
			return
		var _q0 = TS.at(self.fighters, z["owner"])
		var skin = (null if _q0 == null else _q0["art"]["specialSkinId"])
		var s = RenderSpecialArt.totem_sprite(((hot > 0) or (fmod(floor(self.time * 7), 9) == 0)), skin, floor(self.time * 6))
		var flip = self.zone_face.get(float(z["id"]))
		if flip == null:
			flip = self.battle.fighters[z["owner"]]["facing"] < 0
			TS.map_set(self.zone_face, float(z["id"]), flip)
		g.global_alpha = minf(1, a + 0.2)
		RenderBattleView.blit(g, s, cx, cy - drop, flip)
		if a > 0.5:
			self.glow_list.append({"s": s, "x": cx, "y": cy - drop, "flip": flip})
		g.global_alpha = 1
		if (dt <= 0) or drop:
			return
		# Crackling: sparks off the crystal, and now and then a little arc to the ground.
		var top: float = (RenderSpecialArt.totem_top(skin) - 2) / float(SpriteAnimator.PPM)
		var _q1 = TS.at(self.fighters, z["owner"])
		var sk = (null if _q1 == null else _q1["art"]["specialSkin"])
		var c = ((null if sk == null else sk.get("glow")) if (null if sk == null else sk.get("glow")) != null else [0xf0ffff, 0x4ab8ff])
		if randf() < ((dt * 9) * a):
			self.fx.burst({"x": z["x"], "y": top, "count": 1, "jitter": 0.12, "speed": [0.6, 1.8], "life": [0.12, 0.3], "color": c[0], "color2": c[1], "kind": ("twinkle" if randf() < 0.5 else "streak")})
		if randf() < ((dt * 1.2) * a):
			self.fx.bolt(z["x"], top, z["x"] + ((randf() - 0.5) * 1.2), (top + 0.3) + (randf() * 0.4), c[1], 0.09, (PixelColor.mix(c[0], c[1], 0.15) if (null if sk == null else sk.get("glow")) != null else 0xd8f8ff))
		# A legendary pole sheds its own sparkles from the carving.
