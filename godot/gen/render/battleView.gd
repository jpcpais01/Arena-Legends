	## A small strength meter over the bind: each side's colour pushing at a
	## marker that wavers, then gives way toward whoever is losing.
	func draw_bind_meter(g, dt: float) -> void:
		var b = self.battle
		var L = b.lock
		self.bind_a = CoreMath.clamp_(self.bind_a + (dt * 6 if L != null else (-dt) * 4), 0, 1)
		if ((self.bind_a <= 0) or self.quiet) or (L == null):
			return
		var _d0 = b.fighters
		var a = _d0[0]
		var c = _d0[1]
		var left: float = (0 if a["x"] <= c["x"] else 1)
		var k: float = L["t"] / float(L["dur"])
		var push: float = (0 if L["winner"] == (-1) else (1 if L["winner"] == left else -1))
		var waver: float = (sin(self.time * 7.3) * 0.22) + (sin(self.time * 12.1) * 0.08)
		var m: float = CoreMath.clamp_((waver * (1 - k)) + ((push * RenderBattleView.smooth01((k - 0.35) / 0.65)) * 0.85), -1, 1)
		var _d1 = self.bind_point()
		var x = _d1[0]
		var y = _d1[1]
		var w: float = 34
		var cx: float = TS.round(self.sx(x))
		var top: float = TS.round(self.sy(y)) - 30
		var x0: float = cx - (((((int(w)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 1)
		var mx: float = x0 + TS.round(((m + 1) / 2.0) * w)
		g.global_alpha = self.bind_a
		g.fill_style = "#140c18"
		g.fill_rect(x0 - 1, top - 1, w + 2, 5)
		g.fill_style = ("#5a9cff" if left == 0 else "#ff6a6a")
		g.fill_rect(x0, top, mx - x0, 3)
		g.fill_style = ("#ff6a6a" if left == 0 else "#5a9cff")
		g.fill_rect(mx, top, (x0 + w) - mx, 3)
		g.fill_style = "#ffffff"
		g.fill_rect(mx - 1, top - 2, 2, 7)
		g.global_alpha = 1

