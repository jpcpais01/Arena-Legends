	## Sands of Time turning back: a golden afterimage trail from where the
	## blow landed back to where they were, a clock face sweeping backwards,
	## sand swirling up, and a short sepia flash with a beat of slow motion.
	func rewind_fx(id: float, from: float, to: float) -> void:
		var fx = self.fx
		var v = self.fighters[id]
		var f = self.battle.fighters[id]
		# In the hourglass skin's colours: bright, deep and the tones between.
		var sk = (null if v["art"]["specialSkin"] == null else v["art"]["specialSkin"].get("glow"))
		var tone = (func(k: float, stock: float): return (PixelColor.mix(sk[0], sk[1], k) if sk != null else stock))
		if v["lastS"] != null:
			var n: float = 6
			var near: String = PixelColor.css(tone.call(0.1, 0xffe8a0))
			var far: String = PixelColor.css(tone.call(0.3, 0xffc860))
			for i in range(ceili(n)):
				var k_2: float = i / (n - 1)
				# From the old spot to the new one, each echo appearing a moment after the last.
				v["ghosts"].append({"x": TS.round(self.sx(from + ((to - from) * k_2))), "y": v["lastY"], "s": v["lastS"], "flip": v["lastFlip"], "t": (-k_2) * 0.18, "col": (near if k_2 < 0.5 else far), "life": 0.45, "a": 0.25 + (0.4 * k_2)})
		var y: float = f["y"] + 1.1
		fx.pulse("clock", to, y, 0.85, tone.call(0.3, 0xffd060), 0.7, tone.call(1, 0xa87a20))
		fx.pulse("swirl", to, y, 1.1, tone.call(0, 0xfff0b0), 0.5, tone.call(0.6, 0xe0a030))
		fx.pulse("swirl", from, y, 0.8, tone.call(0, 0xfff0b0), 0.35, tone.call(0.6, 0xe0a030))
		fx.burst({"x": to, "y": 0.4, "count": 26, "jitter": 0.5, "dir": PI / 2.0, "spread": 0.5, "speed": [1, 3], "life": [0.5, 0.9], "color": tone.call(0, 0xfff0b0), "color2": tone.call(0.8, 0xd09030), "drag": 1.5, "kind": "twinkle"})
		fx.burst({"x": (from + to) / 2.0, "y": y, "count": 14, "jitter": (absf(to - from) / 2.0) + 0.2, "jitterY": 0.6, "speed": [0.3, 1], "life": [0.4, 0.7], "color": tone.call(0.35, 0xf0c060), "color2": tone.call(1, 0xa07020), "drag": 1})
		fx.pop("REWIND!", to, v["headY"] + 0.45, {"color": PixelColor.css(tone.call(0.15, 0xffe08a)), "scale": 2, "shade": PixelColor.css(tone.call(1, 0xb07a20))}, 1.1)
		self.play("revive", self.pan(to), 0.6)
		self.play("gems", self.pan(to))
		self.flash((PixelColor.mix(sk[0], 0xffffff, 0.3) if sk != null else 0xffe0a0), 0.7)
		self.slowmo(0.45, 0.35)
		self.punch_in(1, 0.4, to)
		if self.arena != null:
			self.arena.cheer(0.6)

	# --- Super attacks ---------------------------------------------------------------------
	##  How dark the arena goes behind a weapon super: building through its windup. Item specials don't dim it.
	func super_dim() -> float:
		var d: float = 0
		for f in self.battle.fighters:
			if not f["alive"]:
				continue
			var a = f["action"]
