		var sy: float = (y + shape.size()) - 1
		for sx in [x - 1, x + 1]:
			if (((sy < h) and (sx >= 0)) and (sx < w)) and (not TS.at(data, (sy * w) + sx)):
				data[int((sy * w) + sx)] = shade
	p = {"sprite": {"img": canvas_of(w, h, data), "ox": half_w + 1, "oy": 1, "w": w, "h": h}, "tips": tips}
	TS.map_set(patches, key, p)
	return p

##  Drops cached patches (a new battle).
static func clear_patches() -> void:
	patches.clear()

## Thunderhead: a small dark cloud. At rest a glint of lightning wanders in its
## belly; charged (over the mark), its underside flickers with forks.
static func cloud_frame(charged: bool, skin = null, tick = null) -> Variant:
	if tick == null: tick = 0
	var art = reshaped("cloud", skin)
	if art != null:
		return skin_frame(art, pair_frame(art, charged, tick))
	var k: float = fmod((fmod(tick, 4)) + 4, 4)
	var rows = CLOUD_ROWS.map((func(r: String, _a1 = null, _a2 = null): return TS.split(r, "")))
	var spark = ([[5, 4], [9, 5], [12, 4], [7, 5]])[k]
	rows[spark[1]][int(spark[0])] = ("S" if charged else "s")
	if charged:
		# Forks licking out of the underside.
		var forks = ([[[4, 6], [3, 7]], [[10, 6], [11, 7]], [[7, 6], [7, 7]], [[13, 6], [14, 7]]])[k]
		for _e0 in forks:
			var x = _e0[0]
			var y = _e0[1]
			rows[y][int(x)] = ("S" if y == 6 else "s")
		rows[4][int(fmod((spark[0] + 4), 16) + 1)] = "s"
	return pix_frame(rows.map((func(r_2, _a1 = null, _a2 = null): return TS.join(r_2, ""))), recolor(CLOUD_PAL, CLOUD_MAP, skin), 9, 8)

static func cloud_sprite(charged: bool, skin = null, tick = null) -> Variant:
	if tick == null: tick = 0
	var art = reshaped("cloud", skin)
	var f: float = (pair_frame(art, charged, tick) if art != null else (4 if charged else 0) + (fmod((fmod(tick, 4)) + 4, 4)))
	return sprite(("cloud." + TS.s(f) + "." + (skin if skin != null else "")), (func(): return cloud_frame(charged, skin, tick)))

