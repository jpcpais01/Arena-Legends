			var y_3: float = TS.round((((self.gy - 26) - (i_3 * 9)) + (sin((t * 1.1) + i_3) * 10)) + (sin((t * 5.3) + i_3) * 1.5))
			var open: bool = sin((t * 16) + (i_3 * 5)) > 0
			g.fill_style = a["wings"][i_3]
			if open:
				g.fill_rect(x_3 - 2, y_3 - 1, 2, 2)
				g.fill_rect(x_3 + 1, y_3 - 1, 2, 2)
			else:
				g.fill_rect(x_3 - 1, y_3 - 2, 1, 2)
				g.fill_rect(x_3 + 1, y_3 - 2, 1, 2)
			g.fill_style = "#2a2030"
			g.fill_rect(x_3, y_3 - 1, 1, 2)

