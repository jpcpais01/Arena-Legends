	var spots = [0, -0.45, 0.45, -0.85, 0.85]
	var _fn1 = func(u: float, i: float, _a2 = null):
		var _fn0 = func():
			var gx: float = x + (u * R)
			fx.pulse("jet", gx, 0, 3.4 - (absf(u) * 1.4), lo, 0.75, hi)
			fx.burst({"x": gx, "y": 0.1, "count": 12, "jitter": 0.15, "jitterY": 0, "dir": PI / 2.0, "spread": 0.12, "speed": [6, 12], "life": [0.35, 0.7], "color": 0xfff0a0, "color2": lo, "gravity": 6, "kind": "flame"})
			fx.burst({"x": gx, "y": 0.3, "count": 3, "jitter": 0.2, "dir": PI / 2.0, "spread": 0.2, "speed": [2, 4], "life": [0.8, 1.3], "color": 0x3a1418, "color2": 0x0a0406, "kind": "smoke", "size": 5, "drag": 1.2})
		fx.later(i * 0.07, _fn0)
	TS.for_each(spots, _fn1)
	fx.burst({"x": x, "y": 0.6, "count": 34, "jitter": R * 0.5, "dir": PI / 2.0, "spread": 0.6, "speed": [0.5, 2], "life": [1.0, 2.0], "color": hi, "color2": lo, "gravity": -0.8, "kind": "ember"})
	# A second eruption, and burning brimstone raining back down.
	var _fn2 = func():
		cues["play"].call("fire", 0.8)
		for u_2 in [-0.65, 0.65, -0.25, 0.25]:
			fx.pulse("jet", x + (u_2 * R), 0, 1.8, lo, 0.55, hi)
			fx.burst({"x": x + (u_2 * R), "y": 0.1, "count": 7, "jitter": 0.12, "jitterY": 0, "dir": PI / 2.0, "spread": 0.12, "speed": [4, 8], "life": [0.3, 0.55], "color": hi, "color2": lo, "gravity": 6, "kind": "flame"})
		fx.burst({"x": x, "y": 6.5, "count": 18, "jitter": R, "jitterY": 1.2, "dir": ((-PI) / 2.0) + (dir * 0.25), "spread": 0.15, "speed": [6, 9], "life": [0.6, 0.9], "color": hi, "color2": lo, "gravity": 8, "kind": "flame"})
	fx.later(0.4, _fn2)

static func star(fx, cues, x: float, R: float, hi: float, lo: float, dir: float) -> void:
	var mid: float = PixelColor.mix(hi, lo, 0.5)
	cues["flash"].call(0xffffff, 1.2)
	cues["play"].call("entStars", 1.2)
	fx.pulse("star", x, 0.8, R * 0.7, 0xffd858, 0.4)
	fx.pulse("rays", x, 0.8, R * 1.1, 0xffffff, 0.35, hi)
	var i = [0]
	while i[0] < 3:
		fx.later(i[0] * 0.08, (func(): return fx.pulse("ring", x, 0.8, R * (0.45 + (i[0] * 0.3)), (hi if i[0] == 1 else (lo if i[0] else 0xffffff)), 0.45)))
		i[0] += 1
	fx.pulse("constellation", x, 0, R, 0xffd858, 1.8, mid)
	fx.pulse("crater", x, 0, R * 0.85, mid, 2.6, 0xffffff)["v"] = 3
	fx.pulse("dome", x, 0, R * 0.42, hi, 0.5, lo)
	# A nova of starlight, stardust drifting down after it.
	fx.burst({"x": x, "y": 0.6, "count": 50, "jitter": 0.3, "dir": PI / 2.0, "spread": 1.5, "speed": [3, 10], "life": [0.4, 0.9], "color": 0xffffff, "color2": hi, "drag": 2, "kind": "twinkle"})
	fx.burst({"x": x, "y": 3, "count": 26, "jitter": R, "jitterY": 1.4, "dir": (-PI) / 2.0, "spread": 0.4, "speed": [0.3, 0.9], "life": [1.2, 2.2], "color": 0xffd858, "color2": lo, "kind": "twinkle"})
	# A shower of shooting stars streaking in over the ring.
	for i_2 in range(6):
		var _fn0 = func():
			var tx: float = x + ((((randf() * 2) - 1) * R) * 0.9)
			var a: float = ((-PI) / 2.0) + (dir * 0.5)
			var fall: float = 0.32
			fx.burst({"x": tx - ((cos(a) * 13) * fall), "y": 0.2 - ((sin(a) * 13) * fall), "count": 1, "dir": a, "spread": 0, "speed": [13, 13], "life": [fall, fall], "color": 0xffffff, "color2": hi, "kind": "streak"})
			fx.later(fall, (func(): fx.burst({"x": tx, "y": 0.2, "count": 6, "speed": [1, 3], "life": [0.25, 0.5], "color": 0xffd858, "color2": hi, "drag": 2, "kind": "twinkle"})))
		fx.later(0.22 + (i_2 * 0.09), _fn0)

static func tide(fx, cues, x: float, R: float, hi: float, lo: float) -> void:
	var water: float = PixelColor.mix(hi, lo, 0.55)
	cues["flash"].call(0xe8fbff, 1)
	cues["play"].call("splash", 1.3)
	cues["light"].call({"kind": "beam", "x": x, "y": 0, "r0": 1, "r1": R * 0.95, "w": 0.35, "rot": PI / 2.0, "hi": 0xffffff, "lo": hi, "life": 0.5, "power": 0.9, "fin": 0})
	# The crown of water, the column shooting up its middle, a ring of mist.
	fx.pulse("splash", x, 0, R, water, 1.1, hi)
	fx.pulse("jet", x, 0, R * 0.95, water, 0.9, hi)
	fx.pulse("crater", x, 0, R * 0.95, hi, 3, 0xffffff)["v"] = 4
	fx.pulse("cloud", x, 0.3, R * 0.7, 0xe8f8ff, 1.3, 0x9ac8e8)
	# Spray: a thick fan of drops thrown high, finer spray and light catching it.
	fx.burst({"x": x, "y": 0.5, "count": 60, "jitter": 0.6, "dir": PI / 2.0, "spread": 1.2, "speed": [5, 13], "life": [0.7, 1.3], "color": 0xe8fbff, "color2": water, "gravity": 13, "kind": "drop"})
	fx.burst({"x": x, "y": 0.5, "count": 26, "jitter": 0.8, "dir": PI / 2.0, "spread": 1.0, "speed": [4, 9], "life": [0.6, 1.1], "color": hi, "color2": lo, "gravity": 12, "size": 2})
	fx.burst({"x": x, "y": 1, "count": 20, "jitter": R * 0.4, "jitterY": 0.8, "dir": PI / 2.0, "spread": 1.4, "speed": [0.5, 2], "life": [0.6, 1.1], "color": 0xffffff, "color2": hi, "kind": "twinkle"})
	# Waves rolling out both ways, then ripples spreading over the pool.
	var _fn0 = func():
		fx.pulse("wave", x, 0, R * 1.05, water, 1.0, hi)
		cues["play"].call("entWind", 0.6)
	fx.later(0.12, _fn0)
	var i = [0]
	while i[0] < 4:
		fx.later(0.35 + (i[0] * 0.3), (func(): return fx.pulse("groundRing", x, 0, R * (0.5 + (i[0] * 0.12)), (hi if (int(i[0]) & 1) else 0xffffff), 0.8)))
		i[0] += 1
	# The column falls back as rain over the ring.
	var _fn1 = func():
		fx.burst({"x": x, "y": 4.5, "count": 40, "jitter": R * 0.8, "jitterY": 0.8, "dir": (-PI) / 2.0, "spread": 0.08, "speed": [2, 4], "life": [0.6, 1.0], "color": 0xe8fbff, "color2": hi, "gravity": 10, "kind": "drop"})
		cues["play"].call("splash", 0.5)
	fx.later(0.55, _fn1)

static func soup(fx, cues, x: float, R: float, hi: float, lo: float, dir: float) -> void:
	var broth: float = PixelColor.mix(hi, lo, 0.5)
	cues["flash"].call(0xfff0c8, 1)
	cues["play"].call("splash", 1.3)
	cues["play"].call("hiss", 1)
	# The splash crown of broth, the pool scalding hot under it, a wave rolling out both ways.
	fx.pulse("splash", x, 0, R, broth, 1.1, hi)
	fx.pulse("jet", x, 0, R * 0.7, broth, 0.8, hi)
	fx.pulse("crater", x, 0, R * 0.9, PixelColor.mix(hi, 0xffffff, 0.2), 3, 0xfff0c0)
	fx.later(0.1, (func(): return fx.pulse("wave", x, 0, R * 1.05, broth, 1.0, hi)))
	# Broth thrown everywhere, and what was in it: carrots, potatoes, herbs, meat.
	fx.burst({"x": x, "y": 0.5, "count": 56, "jitter": 0.6, "dir": PI / 2.0, "spread": 1.2, "speed": [5, 12], "life": [0.7, 1.3], "color": 0xffd890, "color2": broth, "gravity": 13, "kind": "drop"})
	for _e0 in [[0xff8a20, 0xc85a10, 10], [0xf0dca0, 0xc8a870, 8], [0x5ac040, 0x2a7a20, 10], [0x8a4422, 0x4a2010, 5]]:
		var col = _e0[0]
		var col2 = _e0[1]
		var n = _e0[2]
		fx.burst({"x": x, "y": 0.5, "count": n, "jitter": 0.5, "dir": (PI / 2.0) + (dir * 0.15), "spread": 1.0, "speed": [4, 10], "life": [0.8, 1.3], "color": col, "color2": col2, "gravity": 16, "size": 2})
	# A great cloud of steam boiling up off it, and more rising from the pool after.
	fx.pulse("cloud", x, 0.6, R * 0.75, 0xf4f6f8, 1.8, 0xb8c0c8)
	fx.burst({"x": x, "y": 0.6, "count": 16, "jitter": R * 0.5, "dir": PI / 2.0, "spread": 0.5, "speed": [1.2, 3], "life": [1.0, 1.8], "color": 0xf4f6f8, "color2": 0xa8b0b8, "kind": "smoke", "size": 6, "drag": 1.2})
	for i in range(6):
		var _fn1 = func():
			fx.burst({"x": x, "y": 0.1, "count": 3, "jitter": R * 0.6, "jitterY": 0, "dir": PI / 2.0, "spread": 0.3, "speed": [0.8, 1.8], "life": [0.8, 1.4], "color": 0xf4f6f8, "color2": 0xb8c0c8, "kind": "smoke", "size": 4, "drag": 1})
		fx.later(0.3 + (i * 0.2), _fn1)
	# The rest of the soup rains back down over the ring.
	var _fn2 = func():
		fx.burst({"x": x, "y": 4, "count": 30, "jitter": R * 0.8, "jitterY": 0.8, "dir": ((-PI) / 2.0) + (dir * 0.2), "spread": 0.1, "speed": [2, 4], "life": [0.6, 1.0], "color": 0xffd890, "color2": broth, "gravity": 10, "kind": "drop"})
		cues["play"].call("splash", 0.5)
	fx.later(0.5, _fn2)

## The meteor leaves the sigil at (x, y): by default a beam into the sky; the Rock's pot instead flings its
## soup up and forward (`dir` +1 rightward) in a spray of broth and steam.
static func meteor_launch(fx, style: String, x: float, y: float, hi: float, dir: float) -> void:
	if style == "soup":
		var a: float = (PI / 2.0) - (dir * 0.55)
		fx.burst({"x": x + (dir * 0.4), "y": y + 0.3, "count": 22, "jitter": 0.2, "dir": a, "spread": 0.35, "speed": [6, 12], "life": [0.5, 0.9], "color": 0xffd890, "color2": 0xc8601a, "gravity": 6, "kind": "drop"})
		fx.burst({"x": x + (dir * 0.4), "y": y + 0.3, "count": 6, "jitter": 0.2, "dir": a, "spread": 0.3, "speed": [5, 10], "life": [0.5, 0.9], "color": 0xff8a20, "color2": 0xf0dca0, "gravity": 6, "size": 2})
		fx.burst({"x": x, "y": y + 0.4, "count": 6, "jitter": 0.3, "dir": PI / 2.0, "spread": 0.6, "speed": [0.8, 2], "life": [0.7, 1.2], "color": 0xf4f6f8, "color2": 0xa8b0b8, "kind": "smoke", "size": 4, "drag": 1})
		return
	fx.pulse("pillar", x, y, 0.22, hi, 0.35)
	fx.burst({"x": x, "y": y, "count": 14, "speed": [2, 5], "life": [0.25, 0.5], "color": 0xffffff, "color2": hi, "drag": 2, "kind": "twinkle"})

static func bloom(fx, cues, x: float, R: float, hi: float, lo: float) -> void:
	cues["flash"].call(PixelColor.mix(hi, 0xffffff, 0.4), 0.9)
	cues["play"].call("entChoir", 1)
	cues["play"].call("gems", 1)
	cues["light"].call({"kind": "glow", "x": x, "y": R * 0.55, "r0": 0.4, "r1": R * 0.5, "hi": 0xfff6c0, "lo": hi, "life": 1.6, "power": 0.7, "fin": 0.15})
	cues["light"].call({"kind": "rays", "x": x, "y": R * 0.55, "r0": 0.5, "r1": R * 0.9, "hi": 0xffe8a0, "lo": hi, "life": 1.2, "power": 0.45, "seed": randf() * 50, "delay": 0.2})
	# Roots and vines racing out, a carpet of green, the giant flower rising in the middle.
	fx.pulse("crater", x, 0, R * 0.9, lo, 2.8, 0xffe060)["v"] = 5
	fx.pulse("vines", x, 0, R, PixelColor.mix(hi, 0xff5ab0, 0.5), 2.6, lo)
	fx.pulse("flower", x, 0, R, PixelColor.mix(hi, 0xff6ab8, 0.45), 2.2, lo)
	fx.pulse("dome", x, 0, R * 0.35, PixelColor.mix(hi, 0xffffff, 0.3), 0.4, lo)
	# Dirt and torn leaves thrown up, pollen glittering.
	fx.burst({"x": x, "y": 0.4, "count": 26, "jitter": 0.5, "dir": PI / 2.0, "spread": 1.0, "speed": [4, 9], "life": [0.6, 1.1], "color": 0x8a6a40, "color2": 0x4a3a28, "gravity": 16, "size": 2})
	fx.burst({"x": x, "y": 0.5, "count": 30, "jitter": 0.6, "dir": PI / 2.0, "spread": 1.3, "speed": [3, 8], "life": [1.0, 1.8], "color": PixelColor.mix(lo, 0x9aff6a, 0.5), "color2": lo, "drag": 1.5, "gravity": 2, "kind": "petal"})
	fx.burst({"x": x, "y": 1.5, "count": 24, "jitter": R * 0.6, "jitterY": 1, "speed": [0.2, 0.8], "life": [1.2, 2.2], "color": 0xffe060, "color2": hi, "gravity": -0.4, "kind": "twinkle"})
	# The flower lets go: a storm of petals blown out over the whole ring.
	var _fn0 = func():
		cues["play"].call("entWind", 0.8)
		for side in [-1, 1]:
			fx.burst({"x": x, "y": R * 0.6, "count": 40, "jitter": 0.6, "jitterY": 0.4, "dir": (0.25 if side > 0 else PI - 0.25), "spread": 0.6, "speed": [2, 6], "life": [1.2, 2.2], "color": hi, "color2": PixelColor.mix(hi, 0xffffff, 0.5), "gravity": 1.2, "drag": 0.8, "kind": "petal"})
	fx.later(2.2 * 0.72, _fn0)

static func singularity(fx, cues, x: float, R: float, hi: float, lo: float) -> void:
	# It lands and swallows: the light goes out of the ring, dust and light are dragged in, the picture bends toward it.
	cues["play"].call("entPortal", 1.3)
	cues["flash"].call(0x05020a, 1.4)
	fx.pulse("dome", x, 0, R * 0.55, lo, 0.6, 0x05020a)["v"] = 1
	fx.pulse("implode", x, 1, R, hi, 0.4, lo)
	fx.pulse("crater", x, 0, R * 0.8, lo, 3, hi)["v"] = 6
	fx.pulse("crack", x, 0, R * 1.05, PixelColor.mix(lo, hi, 0.4), 2.6)
	fx.gather(x, 1, R, 70, hi, lo, "streak")
	fx.gather(x, 0.4, R * 0.8, 30, 0xffffff, hi, "twinkle")
	cues["light"].call({"kind": "ring", "x": x, "y": 1, "r0": R * 1.1, "r1": R * 0.1, "w": 0.1, "squash": 0.85, "hi": hi, "lo": lo, "life": 0.4, "power": 1.1, "fin": 0})
	cues["shock"].call({"x": x, "y": 1, "r": R * 0.9, "amp": -9, "life": 0.4, "hi": lo, "squash": 0.8})
	cues["shake"].call(0.4)
	# Then it collapses: a blinding nova, the light it ate thrown back out.
	var _fn0 = func():
		cues["play"].call("explosion", 1.2)
		cues["play"].call("entSlam", 1)
		cues["shake"].call(1.2)
		cues["flash"].call(PixelColor.mix(hi, 0xffffff, 0.5), 1.4)
		cues["impact"].call(hi, 0x05020a, 0.08)
		cues["shock"].call({"x": x, "y": 0.8, "r": R * 1.3, "amp": 8, "life": 0.6, "hi": hi, "squash": 0.7})
		cues["light"].call({"kind": "glow", "x": x, "y": 1, "r0": R * 0.3, "r1": R * 0.9, "hi": 0xffffff, "lo": hi, "life": 0.5, "power": 1.1, "fin": 0})
		cues["light"].call({"kind": "flare", "x": x, "y": 1, "r0": R * 0.8, "r1": R * 2.4, "w": 0.06, "hi": 0xffffff, "lo": hi, "life": 0.55, "power": 1, "fin": 0})
		cues["light"].call({"kind": "ring", "x": x, "y": 0.05, "r0": R * 0.2, "r1": R * 1.15, "w": 0.1, "squash": 0.22, "hi": hi, "lo": lo, "life": 0.6, "power": 1.1, "fin": 0})
		fx.pulse("star", x, 1, R * 0.6, hi, 0.35)
		fx.pulse("rays", x, 1, R * 1.2, 0xffffff, 0.35, hi)
		for i in range(2):
			fx.pulse("ring", x, 1, R * (0.55 + (i * 0.4)), (lo if i else hi), 0.45)
		fx.burst({"x": x, "y": 1, "count": 70, "jitter": 0.3, "speed": [5, 13], "life": [0.35, 0.8], "color": 0xffffff, "color2": hi, "drag": 2, "kind": "streak"})
		fx.burst({"x": x, "y": 1, "count": 30, "jitter": 0.4, "speed": [2, 6], "life": [0.6, 1.2], "color": hi, "color2": lo, "drag": 1.5, "kind": "twinkle"})
		fx.burst({"x": x, "y": 0.4, "count": 14, "jitter": R * 0.4, "dir": PI / 2.0, "spread": 0.8, "speed": [0.5, 1.5], "life": [1.0, 1.6], "color": 0x3a1a5a, "color2": 0x0a0614, "kind": "smoke", "size": 5, "drag": 1.2})
	fx.later(0.38, _fn0)
