	# All three in: the sign blinks.
	if (t > 0.7) and (floori(t * 10) & 1):
		g.fill_style = "#ffffff"
		for i_2 in range(6):
			g.fill_rect((cx - 21) + (i_2 * 8), y - 2, 2, 1)
			g.fill_rect((cx - 18) + (i_2 * 8), y + 12, 2, 1)
	g.global_alpha = 1

##  Cuts across the air that open a beat late, then fade (in the hero's facing).
static func draw_slashes(g, cx: float, gy: float, t: float, cut: float) -> void:
	if (t < cut) or (t > (cut + 0.45)):
		return
	var k: float = (t - cut) / 0.45
	var len_: float = TS.round(80 * minf(1, k * 6))
	var cuts = [[-1, -50, 0.38], [1, -28, -0.3], [1, -40, 0.05]]
	var _fn1 = func(_p0, n: float, _a2 = null):
		var d = _p0[0]
		var oy = _p0[1]
		var slope = _p0[2]
		var kk: float = clamp01((k * 6) - (n * 0.6))
		var L: float = TS.round(len_ * kk)
		var i: float = -L
		while i <= L:
			var x: float = cx + i
			var y: float = TS.round((gy + oy) + ((i * slope) * d))
			g.global_alpha = (1 - k) * (1 - (absf(i) / (L + 1)))
			g.fill_style = "#9ad8ff"
			g.fill_rect(x, y - 1, 1, 3)
			g.fill_style = "#ffffff"
			g.fill_rect(x, y, 1, 1)
			i += 1
	TS.for_each(cuts, _fn1)
	g.global_alpha = 1

##  Heat shimmer lines over the ground (inferno, meteor): short wavy dashes rising.
static func draw_heat(g, cx: float, gy: float, t: float, k: float) -> void:
	if k <= 0:
		return
	g.fill_style = "#ffd060"
	for i in range(8):
		var u: float = fmod((t * 0.9) + rnd(i), 1)
		g.global_alpha = (k * (1 - u)) * 0.6
		var x: float = cx + TS.round(((rnd(i + 3) - 0.5) * 40) + (sin((u * 9) + i) * 2))
		var y: float = (gy - 4) - TS.round(u * 40)
		g.fill_rect(x, y, 2, 1)
		g.fill_rect(x + 2, y - 1, 2, 1)
	g.global_alpha = 1
