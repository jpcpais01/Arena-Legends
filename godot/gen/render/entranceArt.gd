##  Bats: fly in from all round, whirl in a dark knot, then burst away.
static func draw_bats(g, v, e, t: float) -> void:
	if t > 1.9:
		return
	var N: float = (34 if e["stage"] else 24)
	var IN: float = 0.65
	var OUT: float = 1.15
	for i in range(ceili(N)):
		var a0: float = (i * 2.39996) + 0.3
		var far: float = 4 + ((i % 5) * 0.7)
		var orb: float = 0.35 + ((i % 4) * 0.2)
		var spin: float = (1 if (i & 1) else -1) * (5 + (i % 3))
		var big: bool = (i % 5) == 0
		var x: float
		var y: float
		var ang: float = a0 + (t * spin)
		if t < IN:
			var k: float = ease_out((t / IN) - ((i % 4) * 0.05))
			var r: float = far + ((orb - far) * k)
			x = cos(ang) * r
			y = (1.1 + ((sin(ang) * r) * 0.55)) + ((1 - k) * 1.5)
		elif t < OUT:
			x = cos(ang) * orb
			y = 1.1 + ((sin(ang) * orb) * 1.4)
		else:
