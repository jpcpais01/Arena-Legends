			var r_2: float = orb + ((k_2 * k_2) * 10)
			x = cos(a0) * r_2
			y = (1.1 + ((absf(sin(a0)) * r_2) * 0.8)) + (k_2 * 2)
		var px: float = TS.round(v["sx"].call(e["x"] + x))
		var py: float = TS.round(v["sy"].call(y))
		var up: bool = (floori((t * 22) + i) & 1) == 0
		g.fill_style = "#1a0a20"
		g.fill_rect(px - 1, py, 3, 2)
		var s: float = (2 if big else 1)
		if up:
			g.fill_rect((px - 2) - s, py - 1, 1 + s, 1)
			g.fill_rect(px + 2, py - 1, 1 + s, 1)
			g.fill_rect((px - 3) - s, py - 2, 1, 1)
			g.fill_rect((px + 3) + s, py - 2, 1, 1)
		else:
			g.fill_rect((px - 2) - s, py + 1, 1 + s, 1)
			g.fill_rect(px + 2, py + 1, 1 + s, 1)
			g.fill_rect((px - 3) - s, py + 2, 1, 1)
			g.fill_rect((px + 3) + s, py + 2, 1, 1)
		if (i % 3) == 0:
			g.fill_style = "#ff3050"
			g.fill_rect(px, py, 1, 1)
			if big:
				g.fill_rect(px + 1, py, 1, 1)
	# The knot reads as a dark cloud while it's tight.
	if (t > (IN - 0.15)) and (t < (OUT + 0.1)):
		var k_3: float = ((t - (IN - 0.15)) / 0.15 if t < IN else (1 - ((t - OUT) / 0.1) if t > OUT else 1))
		var cx: float = TS.round(v["sx"].call(e["x"]))
		var cy: float = TS.round(v["sy"].call(1.05))
		g.global_alpha = 0.7 * clamp01(k_3)
		g.fill_style = "#1a0a20"
		for i_2 in range(-17, 17 + 1):
			var w: float = TS.round((14 * sqrt(1 - pow((i_2 / 18.0), 2))) + (sin((i_2 * 1.7) + (t * 30)) * 2))
			g.fill_rect(cx - w, cy + (i_2 * 2), w * 2, 2)
		# Eyes glinting in the dark.
		g.global_alpha = clamp01(k_3)
		g.fill_style = "#ff3050"
		for i_3 in range(6):
			if fmod((floor(t * 6) + i_3), 3):
				g.fill_rect(cx + TS.round((rnd(i_3) - 0.5) * 22), cy + TS.round((rnd(i_3 + 5) - 0.5) * 50), 2, 1)
		g.global_alpha = 1

##  The slot sign above the statue: three reels spinning and locking in, then JACKPOT.
static func draw_reels(g, cx: float, top: float, t: float) -> void:
	var END: float = 1.45
	if (t < 0.05) or (t > END):
		return
