## Pre-fight entrances, played while the sim holds before the countdown. Each
## one is a short choreography over the fighter's own clips (run, air, land,
## victory...) plus offsets, fades, tints, squash and stretch, drawn effects,
## particles and light, so it costs no extra sprites. In battle the light
## comes from the shader layer (glows, beams, shockwaves, impact frames) and
## the camera leans in on the hero; the menu previews play the same
## choreography with soft canvas light.
##  A pose's frame wrapped into a clip of `n` frames (never negative).
static func wrap_frame(frame: float, n: float) -> float:
	return (fmod((fmod(floor(frame), n)) + n, n) if is_finite(frame) else 0)

static func entrance_length(id: String) -> float:
	return LEN.get(id)

##  A very dark version of a colour, for an impact frame's ink.
static func ink(c: float) -> float:
	return PixelColor.mix(c, 0x0a0614, 0.86)

static func dust(e, x: float, count: float, spread = null) -> void:
	if spread == null: spread = 1.2
	e.get_fx().burst({"x": x, "y": 0.1, "count": count, "jitter": 0.25 * spread, "speed": [0.4, 1.4 * spread], "dir": UP, "spread": 1.3, "life": [0.35, 0.7], "color": 0xc8b898, "color2": 0x7a6a58, "kind": "smoke", "size": 3, "drag": 2.5})

##  Dust thrown out low to both sides of a landing.
static func dust_wall(e, x: float, count: float, speed = null) -> void:
	if speed == null: speed = 4
	for d in [0, PI]:
		e.get_fx().burst({"x": x, "y": 0.15, "count": count, "jitter": 0.2, "jitterY": 0.1, "dir": d + (-0.25 if d else 0.25), "spread": 0.35, "speed": [speed * 0.4, speed], "life": [0.4, 0.8], "color": 0xd8c8a8, "color2": 0x6a5a48, "kind": "smoke", "size": 3, "drag": 3})

##  Rock chips thrown up and falling back.
static func debris(e, x: float, count: float, color = null, speed = null) -> void:
	if color == null: color = 0x8a7458
	if speed == null: speed = 5
	e.get_fx().burst({"x": x, "y": 0.2, "count": count, "dir": UP, "spread": 1.1, "speed": [speed * 0.4, speed], "life": [0.5, 1], "color": color, "color2": 0x3a2e28, "gravity": 14, "size": 2})

## One fighter's entrance. `x` is the fighter's spot (world metres), `facing`
## which way they look.
class Entrance:
	var id: String
	var host
	var x: float
	var facing: float
	var t: float
	var prev: float
	var pose
	var trail_t: float
	var stage: bool
	var room: float
	##  Signature colour and its deep shade.
	var hi: float
	var lo: float
	func _init(id: String, host, x: float, facing: float, opts = null) -> void:
		if opts == null: opts = {}
		self.id = id
		self.host = host
		self.x = x
		self.facing = facing
		self.pose = {"clip": "idle", "frame": 0, "face": null, "dx": 0, "dy": 0, "alpha": 1, "tint": null, "tintA": 0, "shadow": 1, "clipGround": false, "flip": false, "ghosts": 0, "ghostDx": 0, "ghostCol": null, "sx": 1, "sy": 1}
		self.trail_t = 0
		# A hair before its start, so the beats at 0 fire on the first step even without a delay.
		self.t = (-(opts.get("delay") if opts.get("delay") != null else 0)) - (1.0e-6)
		self.prev = self.t
		self.stage = (not (not opts.get("stage")))
		self.room = (opts.get("room") if opts.get("room") != null else 999)
		self.hi = CharacterEntrances.ENTRANCES.get(id)["color"]
		self.lo = PixelColor.mix(self.hi, 0x10081a, 0.55)

	func get_done() -> bool:
		return self.t >= RenderEntrance.LEN.get(self.id)

	##  Seconds since it began (negative while waiting).
	func get_time() -> float:
		return self.t

	##  Advances and returns the pose, or null once it's over (back to the normal animation).
	func update(dt: float) -> Variant:
		self.prev = self.t
		self.t += dt
		if self.get_done():
			return null
		var p = self.pose
		p["clip"] = "idle"
		p["frame"] = 0
		p["face"] = null
		p["dx"] = 0
		p["dy"] = 0
		p["alpha"] = 1
		p["tint"] = null
		p["tintA"] = 0
		p["shadow"] = 1
		p["clipGround"] = false
		p["flip"] = false
		p["ghosts"] = 0
		p["ghostDx"] = 0
		p["ghostCol"] = null
		p["sx"] = 1
		p["sy"] = 1
		if self.t < 0:
			p["alpha"] = 0
			p["shadow"] = 0
			return p
		# The camera leans in on the hero, letting go as they strike their pose.
		if self.at(0):
			self.host["focus"].call(self.x, RenderEntrance.LEN.get(self.id) - 0.4, 1)
		self.trail_t -= dt
		RenderEntrance.STEPS.get(self.id).call(self, self.t, p)
		return p

	##  True on the frame the timeline passes `k`.
	func at(k: float) -> bool:
		return ((self.prev < k) and (self.t >= k))

	##  Every `every` seconds (for trails).
	func tick(every: float) -> bool:
		if self.trail_t > 0:
			return false
		self.trail_t = every
		return true

	func get_fx() -> Variant:
		return self.host["fx"]

	func sound(name: String, k = null) -> void:
		if k == null: k = 1
		self.host["sound"].call(name, k)

	func shake(a: float) -> void:
		self.host["shake"].call(a)

	func flash(c: float, a: float) -> void:
		self.host["flash"].call(c, a)

	func light(l) -> void:
		self.host["light"].call(l)

	func impact(hi: float, lo: float, len_ = null) -> void:
		if len_ == null: len_ = 0.06
		self.host["impact"].call(hi, lo, len_)

	func vignette(c: float, k: float, life: float) -> void:
		self.host["vignette"].call(c, k, life)

	func glow(x: float, y: float, r0: float, r1: float, hi: float, lo: float, life: float, power = null, extra = null) -> void:
		if power == null: power = 1
		if extra == null: extra = {}
		self.light(TS.merge([{"kind": "glow", "x": x, "y": y, "r0": r0, "r1": r1, "hi": hi, "lo": lo, "life": life, "power": power}, extra]))

	##  A shockwave bending the picture (battle), with a ring of light that also shows in the menus.
	func shock(x: float, y: float, r: float, amp: float, life: float, hi: float, squash = null) -> void:
		if squash == null: squash = 1
		self.host["shock"].call({"x": x, "y": y, "r": r, "amp": amp, "life": life, "hi": hi, "squash": squash, "dir": self.facing})
		self.light({"kind": "ring", "x": x, "y": y, "r0": r * 0.12, "r1": r * 0.85, "w": 0.06, "squash": squash, "hi": hi, "lo": PixelColor.mix(hi, 0x000000, 0.5), "life": life * 0.85, "power": 0.9, "fin": 0})

	##  A flat ring of light racing out over the ground.
	func ground_shock(r: float, hi: float, lo: float, life = null, x = null) -> void:
		if life == null: life = 0.5
		if x == null: x = self.x
		self.light({"kind": "ring", "x": x, "y": 0.04, "r0": r * 0.15, "r1": r, "w": 0.08, "squash": 0.22, "hi": hi, "lo": lo, "life": life, "power": 1.1, "fin": 0})
		self.host["shock"].call({"x": x, "y": 0.1, "r": r * 0.9, "amp": 3, "life": life * 0.9, "hi": lo, "squash": 0.35})

	##  A big blow on the spot: impact frame, shockwave, smear and colour split.
	func blow(x: float, y: float, hi: float, lo: float, size = null, frame = null) -> void:
		if size == null: size = 1
		if frame == null: frame = true
		# The two-tone impact frame is kept for the signature moments, so it stays special.
		if frame:
			self.impact(hi, RenderEntrance.ink(lo), 0.05 + (0.03 * size))
		self.shock(x, y, 2.6 * size, 5 + (3 * size), 0.55, hi, 0.75)
		self.host["zoomBlur"].call(x, y, 0.025 * size, 0.22)
		self.host["split"].call(1.5 * size, 0.35)
		self.light({"kind": "flare", "x": x, "y": y, "r0": 1.2 * size, "r1": 3.4 * size, "w": 0.05, "hi": hi, "lo": lo, "life": 0.5, "power": 0.9, "fin": 0, "real": true})

	##  Leans the camera in harder for a moment (big impacts).
	func punch(seconds = null) -> void:
		if seconds == null: seconds = 0.4
		self.host["focus"].call(self.x, seconds, 2)

	##  Squash on landing: wide and short at `from`, springing back over `len`.
	func squash(p, t: float, from: float, amount: float, len_ = null) -> void:
		if len_ == null: len_ = 0.2
		var k: float = (t - from) / float(len_)
		if (k < 0) or (k >= 1):
			return
		# Squash, a little overshoot into stretch, then settle.
		var s: float = cos((k * PI) * 1.5) * (1 - k)
		p["sy"] = 1 - (amount * s)
		p["sx"] = 1 + ((amount * 0.6) * s)

	## The flourish every entrance ends on: a raised weapon and a shout, with the
	## crowd. Fancier entrances end on more light: a glint on the weapon (rare),
	## a glow round the hero (mythic), rays behind them (legendary).
	func cheer(p, t: float, from: float) -> void:
		var tier: String = CharacterEntrances.ENTRANCES.get(self.id)["tier"]
		if self.at(from):
			self.sound("entCheer")
			var n: float = (3 if tier == "legendary" else (2 if tier == "mythic" else (1 if tier == "rare" else 0)))
			self.get_fx().burst({"x": self.x, "y": 0.1, "count": 3 + (n * 2), "jitter": 0.3, "dir": RenderEntrance.UP, "spread": 1.4, "speed": [0.6, 1.6], "life": [0.3, 0.6], "color": 0xd8c8a8, "color2": 0x7a6a58, "kind": "smoke", "size": 2, "drag": 2.5})
			if n >= 2:
				self.glow(self.x, 1.1, 0.8, 1.5, self.hi, self.lo, 0.9, 0.45, {"fin": 0.2})
			if n >= 3:
				self.light({"kind": "rays", "x": self.x, "y": 1.2, "r0": 1.2, "r1": 2.6, "hi": self.hi, "lo": self.lo, "life": 1.0, "power": 0.55, "fin": 0.25})
				self.get_fx().burst({"x": self.x, "y": 1.1, "count": 10, "jitter": 0.5, "jitterY": 0.8, "speed": [0.3, 1], "life": [0.4, 0.8], "color": RenderEntrance.WHITE, "color2": self.hi, "kind": "twinkle"})
		# The glint as the weapon reaches the top.
		if self.at(from + 0.14):
			var tip = (self.host["tip"].call() if self.host["tip"].call() != null else [self.x + (self.facing * 0.4), 2.1])
			var big: float = (0.6 if tier == "common" else (0.85 if tier == "rare" else 1.1))
			self.light({"kind": "star", "x": tip[0], "y": tip[1], "r0": 0.35 * big, "r1": 0.75 * big, "w": 0.035, "hi": RenderEntrance.WHITE, "lo": (0xd8c8a8 if tier == "common" else self.hi), "life": 0.35, "power": 1.1, "fin": 0})
			if tier != "common":
				self.sound("shing", 0.35)
		var u: float = t - from
		p["clip"] = "victory"
		p["frame"] = fmod(floor(maxf(0, u) * 5), 2)
		# A hop of stretch as the arm goes up.
		if (u >= 0) and (u < 0.16):
			var s: float = sin((u / 0.16) * PI)
			p["sy"] = 1 + (0.07 * s)
			p["sx"] = 1 - (0.04 * s)

	##  Effects that aren't particles (pools, beams, the meteor...), behind or in front of the fighter.
	func draw(g, v, layer: String) -> void:
		var t: float = self.t
		if (t < 0) or self.get_done():
			return
		var cx: float = TS.round(v["sx"].call(self.x))
		var gy: float = TS.round(v["sy"].call(0))
		var under: bool = layer == "under"
		var _sw0 = self.id
		if _sw0 == "shadow":
			if under:
				RenderEntranceArt.draw_pool(g, cx, gy, t)
		elif _sw0 == "divine":
			if under:
				RenderEntranceArt.draw_beam(g, cx, gy, t, self.stage)
		elif _sw0 == "inferno":
			if under:
				RenderEntranceArt.draw_fire_ring(g, cx, gy, t, RenderEntrance.INF_["ERUPT"], 1.9)
				RenderEntranceArt.draw_heat(g, cx, gy, t, (t / float(RenderEntrance.INF_["ERUPT"]) if t < RenderEntrance.INF_["ERUPT"] else RenderEntranceArt.clamp01(1 - ((t - 1.2) / 0.6))))
			else:
				RenderEntranceArt.draw_fire_column(g, cx, gy, t, RenderEntrance.INF_["ERUPT"], RenderEntrance.INF_["BURN"] + 0.15)
		elif _sw0 == "frost":
			if under:
				RenderEntranceArt.draw_frost_floor(g, cx, gy, t)
			else:
				RenderEntranceArt.draw_ice_shell(g, cx, gy, t, 0.35, RenderEntrance.FROST_BREAK)
		elif _sw0 == "thunder":
			if not under:
				RenderEntranceArt.draw_storm_cloud(g, cx, (TS.round(v["sy"].call(5.2)) if self.stage else 3), t, RenderEntrance.THUNDER_HIT)
				RenderEntranceArt.draw_crackle(g, cx, gy, t, RenderEntrance.THUNDER_HIT, RenderEntrance.THUNDER_HIT + 0.75)
		elif _sw0 == "smoke":
			if not under:
				if t < RenderEntrance.SMOKE_BANG:
					var _d1 = RenderEntranceArt.bomb_at(self, t)
					var bx = _d1[0]
					var by = _d1[1]
					RenderEntranceArt.draw_bomb(g, TS.round(v["sx"].call(bx)), TS.round(v["sy"].call(by)), t)
				RenderEntranceArt.draw_smoke_cloud(g, cx, gy, t, RenderEntrance.SMOKE_BANG)
		elif _sw0 == "whirlwind":
			if not under:
				RenderEntranceArt.draw_twister(g, TS.round(v["sx"].call(RenderEntranceArt.twister_x(self, t))), gy, t)
		elif _sw0 == "bats":
			if not under:
				RenderEntranceArt.draw_bats(g, v, self, t)
		elif _sw0 == "jackpot":
			if under:
				RenderEntranceArt.draw_coin_pile(g, cx, gy, t)
			else:
				RenderEntranceArt.draw_reels(g, cx, maxf(2, TS.round(v["sy"].call(2.05)) - 11), t)
		elif _sw0 == "blade":
			if not under:
				RenderEntranceArt.draw_slashes(g, cx, gy, t, RenderEntrance.BLADE_CUT)
		elif _sw0 == "quake":
			if under:
				RenderEntranceArt.draw_quake_cracks(g, cx, gy, t)
				RenderEntranceArt.draw_pillar(g, cx, gy, t, self.get_pillar_cap())
		elif _sw0 == "rift":
			if under:
				RenderEntranceArt.draw_rift(g, TS.round(v["sx"].call(RenderEntranceArt.rift_x(self))), gy, t)
		elif _sw0 == "starborn":
			RenderEntranceArt.draw_stars(g, v, self, t, layer)
		elif _sw0 == "phoenix":
			RenderEntranceArt.draw_phoenix(g, v, self, t, layer)
		elif _sw0 == "meteor":
			if (not under) and (t < RenderEntranceArt.METEOR_HIT):
				var _d2 = RenderEntranceArt.meteor_at(self, t / float(RenderEntranceArt.METEOR_HIT))
				var mx = _d2[0]
				var my = _d2[1]
				RenderEntranceArt.draw_meteor(g, TS.round(v["sx"].call(mx)), TS.round(v["sy"].call(my)), t, self.facing, (1.2 if self.stage else 0.85))
			if under and (t > RenderEntranceArt.METEOR_HIT):
				RenderEntranceArt.draw_heat(g, cx, gy, t, RenderEntranceArt.clamp01(1 - (((t - RenderEntranceArt.METEOR_HIT) - 0.6) / 0.7)))
		else:
			pass

	##  How high the Earthshaker pillar may lift the hero here (art px).
	func get_pillar_cap() -> float:
		return maxf(8, self.room)
