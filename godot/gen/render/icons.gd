##  Icon frame for a piece of gear, optionally in a skin (cropped, outlined).
static func icon_frame(id: String, skin = null) -> Variant:
	var key: String = ((id + "|" + skin) if skin else id)
	var f = cache.get(key)
	if f != null:
		return f
	var def = SimGear.gear_of(id)
	var r = R()
	r.clear()
	r.phase = 0
	var c: float = 70
	if (def["slot"] == "main") or (def["slot"] == "secondary"):
		var w = SpriteWeapons.weapon_art(id, skin)
		var shield: bool = (((id == "kite_shield") or (id == "buckler")) or (id == "tower_shield"))
		var bow: bool = id == "longbow"
		var ang: float = ((-PI) / 2.0 if shield else ((-PI) / 4.0 if bow else PI / 4.0))
		# Long weapons are shortened along their length so every icon fits the same box.
		var back: float = (w["tip"] * 0.5 if w.get("grip2") != null else 6)
		var sx: float = minf(1, 46 / (w["tip"] + back))
		var mid: float = ((w["tip"] - back) / 2.0) * sx
		var t = (SpriteXform.Xf.new(c, c, ang, (minf(1, 40 / float((w["tip"] * 2))) if bow else 1), 1) if shield or bow else SpriteXform.Xf.new(c - (cos(ang) * mid), c + (sin(ang) * mid), ang, sx, 1))
		var h = handles(r)
		var mats = {}
		var _o0 = w["mats"]
		for k in _o0:
			var m = _o0[k]
			mats[k] = h.call(m)
		if (def["slot"] == "main") and (SpriteWeapons.MAIN_FAMILY.get(id) == "fist"):
			# Fists come as a pair, side by side, each over a clenched hand.
			var fist: float = h.call(SM["hand"])
			var back_2 = SpriteXform.Xf.new(t.ox + 5, t.oy + 5, ang)
			r.fill(back_2.circ(0, 0, 2), fist, {"group": 7, "bevel": 1.4, "toneBias": -1})
			w["draw"].call(r, back_2, (func(k_2: String): return mats.get(k_2)), {"group": 7, "toneBias": -1})
			r.fill(t.circ(0, 0, 2), fist, {"group": 6, "bevel": 1.4})
		w["draw"].call(r, t, (func(k_3: String): return mats.get(k_3)), {"group": 6})
		f = r.compose(c, c)
	elif def["slot"] == "special":
		special(id, r, c, skin)
		f = r.compose(c, c)
	elif def["slot"] == "usable":
		# Potions and bombs stand upright at their own pixel size, like armour.
		var a = SpriteUsables.usable_art(id, skin)
		var h_2 = handles(r)
		a["draw"].call(r, SpriteXform.Xf.new(c, c, (PI / 2.0) - 0.3), (func(k_4: String): return h_2.call(a["mats"].get(k_4))), {"group": 1})
		var full = r.compose(c, c)
		var side: float = max(16, full["w"], full["h"])
		f = crop(full, (full["w"] - side) / 2.0, (full["h"] - side) / 2.0, side, side)
	else:
		# Armour: drawn on an invisible body, so only the piece itself shows.
		var gear = {"main": "dagger", def["slot"]: id}
		# A piece made of bare skin (a bald dome, muscles) shows on a human with warm brown skin rather than a golem.
		var sa = (SkinsIndex.SKIN_ART.get(skin) if skin else null)
		var flesh: bool = ((not (sa == null)) and TS.some((TS.arr(TS.keys((sa.get("mats") if sa.get("mats") != null else {}))) + TS.arr(TS.keys(TS.nn_f((null if sa.get("head") == null else sa.get("head").call()["mats"]), func(): return {})))), (func(k_5: String, _a1 = null, _a2 = null): return k_5.begins_with("flesh."))))
		var look = (TS.merge([CharacterAppearance.DEFAULT_LOOK, {"species": "human", "skin": 2, "outfit": 7}]) if flesh else TS.merge([CharacterAppearance.DEFAULT_LOOK, {"species": "golem", "outfit": 7}]))
		var art = SpriteLook.make_art({"name": "", "form": "balanced", "gear": gear, "look": look, "skins": ({id: skin} if skin else {})})
		# A cloak worn over the tunic: its cloth wraps the torso too, so the icon reads as one garment.
		var _d1 = art["chest"]
		var torso = _d1.get("torso")
		var sleeve = _d1.get("sleeve")
		var wrap_: bool = ((((def["slot"] == "chest") and (torso == "outfit")) and (not (not sleeve))) and (sleeve != "outfit"))
		if wrap_:
			art = TS.merge([art, {"mats": TS.merge([art["mats"], {"outfit": art["mats"].get(sleeve)}])}])
		var hide = {}
		var _o2 = art["mats"]
		for k_6 in _o2:
			var m_2 = _o2[k_6]
			if ((BODY.has(k_6) and (not (wrap_ and (k_6 == "outfit")))) or TS.re_test("^[ws]\\.|^p\\.|^plume|^fang", k_6)) or ((def["slot"] != "chest") and BELT.has(k_6)):
				TS.id_set(hide, m_2, true)
		# A skin's own materials always belong to the piece, even under a body name.
		if skin:
			for k_7 in TS.keys(((null if SkinsIndex.SKIN_ART.get(skin) == null else SkinsIndex.SKIN_ART.get(skin).get("mats")) if (null if SkinsIndex.SKIN_ART.get(skin) == null else SkinsIndex.SKIN_ART.get(skin).get("mats")) != null else {})):
				TS.id_delete(hide, art["mats"].get(k_7))
		r.skip = hide
		var ox: float = 70
		var oy: float = 120
		SpriteDraw.draw_figure(r, art, {"pose": TS.merge([SpritePose.STAND, {"hNx": -0.3, "hNy": -0.9, "wAng": -1.8}]), "hold": {"main": "none", "sec": "gone"}, "face": "calm"}, ox, oy)
		r.skip = null
		# Centred in a square that fits the piece, so it fills its slot.
		var full_2 = r.compose(ox, oy)
		var side_2: float = max(18, full_2["w"], full_2["h"])
		f = crop(full_2, (full_2["w"] - side_2) / 2.0, (full_2["h"] - side_2) / 2.0, side_2, side_2)
	TS.map_set(cache, key, f)
	return f

