##  Half-disc polygon on the +y side (k = 1) or −y side (k = −1) of a coin at (cx, 0).
static func half(cx: float, rad: float, k: float) -> Variant:
	var out = []
	for i in range(10 + 1):
		var a: float = (i / 10.0) * PI
		out.append_array([cx + (cos(a) * rad), (k * sin(a)) * rad])
	return out

