	var chest = art.get("chest")
	# Neck first so the collar overlaps it.
	var mu: float = (chest.get("muscle") if chest.get("muscle") != null else 0)
	r.fill(PixelSdf.capsule(X.call(sk["neck"]), Y.call(sk["neck"]), X.call(sk["chest"]), Y.call(sk["chest"]), 1.9 + (mu * 0.9), 2.2 + (mu * 1.4)), m.call("skin"), {"group": G["torso"], "bevel": 1.6, "toneBias": -1})
	var shape = torso_shape(art, T)
	r.fill(shape, m.call(chest["torso"]), {"group": G["torso"], "bevel": 3.2})
	var top: float = body["torso"]
	# Belt.
	var belt_band = PixelSdf.intersect(shape, T.rect(0, 2.6, 12, 1.1))
	r.fill(belt_band, m.call(chest["belt"]), {"group": G["torso"], "bevel": 2, "noLine": true})
	r.dot(T.x(body["waistW"] + 0.2, 2.6), T.y(body["waistW"] + 0.2, 2.6), m.call("accent"), 4, G["torso"])
	# Trims per chest piece.
	if ((chest["torso"] == "plate") or (chest["torso"] == "thorn")) or (chest["torso"] == "mirror"):
		var d: float = m.call(chest["trim"])
		for yy in [top * 0.36, top * 0.52]:
			r.fill(PixelSdf.intersect(shape, T.rect(1, yy, 12, 0.45)), d, {"group": G["torso"], "flat": 1, "noLine": true})
		r.fill(PixelSdf.intersect(shape, T.ell((body["chestPush"] * 0.7) + 1.6, top - 3.6, 2.4, 2.6)), m.call(chest["torso"]), {"group": G["torso"], "bevel": 2, "lightBias": 0.25, "noLine": true})
	elif chest["torso"] == "jerkin":
		for yy_2 in range(5, ceili(top - 3), 3):
			r.dot(T.x(body["waistW"] + 0.6, yy_2), T.y(body["waistW"] + 0.6, yy_2), m.call(chest["trim"]), 2, G["torso"])
		r.fill(PixelSdf.intersect(shape, T.rect(-1, top - 1.2, 8, 0.8)), m.call(chest["trim"]), {"group": G["torso"], "flat": 1, "noLine": true})
	elif chest["torso"] == "robe":
		r.fill(PixelSdf.intersect(shape, T.rect((body["chestPush"] * 0.7) + 2.6, top * 0.5, 0.7, top * 0.5)), m.call(chest["trim"]), {"group": G["torso"], "flat": 3, "noLine": true})
	elif chest["trim"]:
		# Tunic: a collar V in the accent colour.
		var cx: float = (body["chestPush"] * 0.7) + 1
		r.line(T.x(cx - 1.5, top + 0.5), T.y(cx - 1.5, top + 0.5), T.x(cx + 1, top - 3), T.y(cx + 1, top - 3), m.call(chest["trim"]), 2, G["torso"])
		r.line(T.x(cx + 1, top - 3), T.y(cx + 1, top - 3), T.x(cx + 3.5, top - 0.4), T.y(cx + 3.5, top - 0.4), m.call(chest["trim"]), 2, G["torso"])
	if chest["hood"]:
		# Hood worn down, bunched behind the neck.
		r.fill(T.ell(-2.8, top + 0.8, 3.6, 2.6, 0.3), m.call(chest["hood"]), {"group": G["cape"], "bevel": 2})
	var bare: bool = ((chest["torso"] == "outfit") or (chest["torso"] == "jerkin"))
	if art["look"]["species"] == "golem":
		# A crack across the back and a rune glowing through whatever it wears.
		var c: float = m.call("stoneCrack")
		r.line(T.x(-1, top - 5), T.y(-1, top - 5), T.x(1, top - 8), T.y(1, top - 8), c, 0, G["torso"])
		var rx: float = (body["chestPush"] * 0.7) + 1.6
		var ry: float = top - 4.4
		var rune: float = m.call("gem")
		r.line(T.x(rx, ry + 2), T.y(rx, ry + 2), T.x(rx, ry - 2), T.y(rx, ry - 2), rune, 3, G["torso"])
		r.line(T.x(rx - 1.4, ry + 0.6), T.y(rx - 1.4, ry + 0.6), T.x(rx + 1.4, ry + 0.6), T.y(rx + 1.4, ry + 0.6), rune, 3, G["torso"])
	elif (art["look"]["species"] == "wisp") and bare:
		# The spirit's heart shows through the cloth.
		var cx_2: float = (body["chestPush"] * 0.7) + 1.4
		var cy: float = top - 4.6
		r.fill(T.poly([cx_2, cy + 1.6, cx_2 + 1.1, cy, cx_2, cy - 1.6, cx_2 - 1.1, cy]), m.call("hairGlow"), {"group": G["torso"], "flat": 3, "noLine": true})
	var fang: bool = art["gear"].get("special") == "vampiric_fang"
	if fang:
		var px: float = T.x((body["chestPush"] * 0.7) + 2.5, top - 2.5)
		var py: float = T.y((body["chestPush"] * 0.7) + 2.5, top - 2.5)
		r.dot(px, py, m.call("fangTooth"), 2, G["torso"])
		r.dot(px, py + 1, m.call("fangBlood"), 3, G["torso"])

##  Leg armour over one thigh, in thigh space (x up from the knee to the hip, y toward the front).
static func draw_leg_armour(r, art, t, len_: float, far: bool, g: float, bias: float, m) -> void:
	var body = art.get("body")
	var L = art.get("legs")
	var w: float = body["thighR"] + L["bulk"]
	var o = {"group": g, "toneBias": bias}
	var band = (func(at: float, mat: String, slant: float = 0.0, rad: float = 0.65): r.fill(t.cap(at - slant, (-w) - 0.2, at + slant, w + 0.2, rad), m.call(mat), TS.merge([o, {"bevel": 0.8}])))
	if L["wraps"]:
		for k in [0.3, 0.52, 0.74]:
			band.call(len_ * k, L["wraps"], 0.9, 0.5)
	if L["trim"]:
		band.call(len_ * 0.84, L["trim"])
		band.call(len_ * 0.22, L["trim"], 0, 0.55)
	if L["rune"]:
		# A glowing seam down the front of the thigh, with a notch.
		var y: float = w * 0.45
		var pts = [[len_ * 0.82, y], [len_ * 0.6, y - 0.6], [len_ * 0.45, y + 0.4], [len_ * 0.28, y]]
		for i in range(pts.size() - 1):
			r.line(t.x(pts[i][0], pts[i][1]), t.y(pts[i][0], pts[i][1]), t.x(pts[i + 1][0], pts[i + 1][1]), t.y(pts[i + 1][0], pts[i + 1][1]), m.call(L["rune"]), 3, g)
	if L["tasset"]:
		# A plate hanging from the belt over the top of the thigh.
		r.fill(t.poly([len_ + 1.2, (-w) - 0.4, len_ + 1.2, w + 1.2, len_ * 0.5, w + 1.4, len_ * 0.42, (-w) + 0.4], 0.4), m.call(L["tasset"]), TS.merge([o, {"bevel": 1.8}]))
		if L["trim"]:
			r.fill(PixelSdf.intersect(t.poly([len_ + 1.2, (-w) - 0.4, len_ + 1.2, w + 1.2, len_ * 0.5, w + 1.4, len_ * 0.42, (-w) + 0.4]), t.rect(len_ * 0.5, 0, 0.5, w + 2)), m.call(L["trim"]), TS.merge([o, {"flat": 1, "noLine": true}]))
	if L["knee"]:
		r.fill(t.ell(0.2, 0.6, (body["kneeR"] + L["bulk"]) + 0.6, (body["kneeR"] + L["bulk"]) + 0.9), m.call(L["knee"]), TS.merge([o, {"bevel": 1.6}]))
	if L.get("over") != null:
		L.get("over").call(r, t, m, {"g": g, "bias": bias, "far": far, "body": body, "len": len_, "w": w})

##  The usable item hanging at the front of the belt.
static func draw_use_belt(r, art, T, m) -> void:
	var um = (func(k: String): return m.call("u." + k))
	var x: float = art["body"]["waistW"] * 0.35
	var y: float = 0.6
	# Hangs neck up, tipped a little forward, a touch smaller than in hand.
	art["use"]["draw"].call(r, SpriteXform.Xf.new(T.x(x, y), T.y(x, y), (T.ang + (PI / 2.0)) - 0.25, 0.85, 0.85), um, {"group": G["skirt"], "frame": r.phase})

##  The usable item in the far hand.
static func draw_use_hand(r, art, sk, pose, hold, OX: float, OY: float, m) -> void:
	var um = (func(k: String): return m.call("u." + k))
	var t = SpriteXform.frame_at(OX, OY, sk["handF"], pose["sAng"] + pose["rot"])
	art["use"]["draw"].call(r, t, um, {"group": G["sec"], "frame": r.phase, "open": hold.get("uncorked")})
	# The fingers wrap over the bottle.
	r.fill(PixelSdf.circle(OX + sk["handF"]["x"], OY - sk["handF"]["y"], art["body"]["hand"] * 0.75), m.call(art["chest"]["hands"]), {"group": G["sec"], "bevel": 1.2})

##  A short tunic hem over the hips (when no robe).
static func draw_hem(r, art, T, m) -> void:
	var body = art.get("body")
	var chest = art.get("chest")
	if ((chest["torso"] == "plate") or (chest["torso"] == "mirror")) or (chest["torso"] == "thorn"):
		# Tassets: two small plates over the hips.
		var mat: float = m.call(chest["torso"])
		r.fill(T.poly([(-body["hipW"]) + 0.5, 1.6, body["hipW"] + 0.6, 1.6, body["hipW"] + 1.2, -2.8, -body["hipW"], -2.4]), mat, {"group": G["skirt"], "bevel": 2})
		r.fill(PixelSdf.intersect(T.poly([(-body["hipW"]) + 0.5, 1.6, body["hipW"] + 0.6, 1.6, body["hipW"] + 1.2, -2.8, -body["hipW"], -2.4]), T.rect(0, -0.6, 10, 0.4)), m.call(chest["trim"]), {"group": G["skirt"], "flat": 1, "noLine": true})
		return
	var mat_2: float = m.call(("jerkin" if chest["torso"] == "jerkin" else ("outfit" if chest["torso"] == "outfit" else chest["torso"])))
	r.fill(T.poly([(-body["hipW"]) - 0.2, 1.8, body["hipW"] + 0.9, 1.8, body["hipW"] + 1.6, -2.4, (-body["hipW"]) - 0.6, -2]), mat_2, {"group": G["skirt"], "bevel": 2.2})

static func draw_skirt(r, art, T, sk, mat: float, sway: float, trim: float) -> void:
	var body = art.get("body")
	var chest = art.get("chest")
	var leg: float = body["thigh"] + body["shin"]
	var len_: float = leg * chest["skirt"]
	# Spreads toward the feet; the hem trails the motion.
	var spread: float = maxf(absf(sk["ankleN"]["x"] - sk["ankleF"]["x"]) * 0.5, body["hipW"] + 1)
	var sw: float = sway * 2.2
	var pts = [(-body["hipW"]) - 0.3, 2, body["hipW"] + 1, 2, (spread + 2.2) - sw, -len_, ((-spread) - 1.8) - sw, (-len_) + 0.6]
	r.fill(T.poly(pts), mat, {"group": G["skirt"], "bevel": 2.6, "softLight": true})
	r.fill(PixelSdf.intersect(T.poly(pts), T.rect(0, (-len_) + 0.6, 20, 0.7)), trim, {"group": G["skirt"], "flat": 3, "noLine": true})

# -----------------------------------------------------------------------------
# Species extras behind the body
# -----------------------------------------------------------------------------
static func draw_tail(r, art, T, m, sway: float) -> void:
	if art["look"]["species"] != "imp":
		return
	# A whip of a tail in an S, ending in a heart-shaped spade.
	var s: float = sway * 2.5
	var pts = [[-3, 1.5, 1.2], [-7.5, -2, 1], [(-11.5) - s, -0.5, 0.85], [(-13) - (s * 1.3), 4, 0.7], [(-11.6) - (s * 1.5), 7.4, 0.6]]
	var shapes = []
	for i in range(1, pts.size()):
		shapes.append(T.cap(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1], pts[i - 1][2], pts[i][2]))
	r.fill(PixelSdf.union.callv(TS.arr(shapes)), m.call("skin"), {"group": G["tail"], "bevel": 1.2})
	var tx: float = (-11.6) - (s * 1.5)
	var ty: float = 8.4
	r.fill(PixelSdf.union(T.circ(tx - 1, ty + 0.6, 1.3), T.circ(tx + 1, ty + 0.6, 1.3), T.poly([tx - 2.2, ty + 0.4, tx + 2.2, ty + 0.4, tx, ty + 3.6])), m.call("horn"), {"group": G["tail"], "bevel": 1})

##  Imp: folded bat wings on the back, the far one a step behind. They flutter with the motion.
static func draw_wings(r, art, T, m, sway: float) -> void:
	var top: float = art["body"]["torso"]
	var _fn0 = func(dx: float, dy: float, k: float, bias: float):
		var s: float = (sway * 3) * k
		var ox: float = (-2.4) + dx
		var oy: float = (top - 1) + dy
		var tip = [(ox - (5 * k)) - (s * 0.5), oy + (12 * k)]
		var f1 = [(ox - (12 * k)) - s, oy + (7 * k)]
		var f2 = [(ox - (13.5 * k)) - (s * 1.2), oy + (0.5 * k)]
		var f3 = [(ox - (9.5 * k)) - s, oy - (5 * k)]
		var membrane = T.poly([ox, oy, tip[0], tip[1], f1[0], f1[1], (ox - (8.6 * k)) - (s * 0.8), oy + (3 * k), f2[0], f2[1], (ox - (7.6 * k)) - (s * 0.7), oy - (1.4 * k), f3[0], f3[1], ox - 1.5, oy - (4 * k)])
		r.fill(membrane, m.call("impWing"), {"group": G["cape"], "bevel": 1.6, "toneBias": bias, "softLight": true})
		var bone: float = m.call("horn")
		for f in [tip, f1, f2, f3]:
			r.line(T.x(ox - 0.6, oy + 0.6), T.y(ox - 0.6, oy + 0.6), T.x(f[0], f[1]), T.y(f[0], f[1]), bone, 1, G["cape"])
		r.fill(T.cap(ox - 0.6, oy + 0.6, tip[0], tip[1], 0.7, 0.4), bone, {"group": G["cape"], "bevel": 0.6, "toneBias": bias})
	var wing = _fn0
	wing.call(2.8, 2.2, 0.8, -1)
	wing.call(0, 0, 1, 0)

##  Myco: a frilled ring (the veil) around the neck.
static func draw_veil(r, art, T, m) -> void:
	var top: float = art["body"]["torso"]
	var ring = T.ell(0.4, top - 0.2, 4.2, 1.7, -0.08)
	r.fill(ring, m.call("gill"), {"group": G["cape"], "bevel": 1.4})
	# Scalloped hem: darker notches along the bottom edge.
	var x: float = -3
	while x <= 3.5:
		r.dot(T.x(x, top - 1.5), T.y(x, top - 1.5), m.call("gillDark"), 1, G["cape"])
		x += 1.6

##  Wisp motes and myco spores: a few points of light drifting around the body.
static func draw_motes(r, art, T, m, sway: float) -> void:
	var top: float = art["body"]["torso"]
	var mat: float = m.call(("hairGlow" if art["look"]["species"] == "wisp" else "capSpot"))
	var s: float = sway * 2
	var pts = ([[(-6) - s, top + 4], [6.5, (top + 7) + (s * 0.5)], [(-8) - (s * 1.4), top - 6]] if art["look"]["species"] == "wisp" else [[(-5.5) - s, top + 9], [4.5 - (s * 0.6), top + 12], [(-8) - (s * 1.2), top + 2]])
	for _e0 in pts:
		var x = _e0[0]
		var y = _e0[1]
		r.dot(floor(T.x(x, y)), floor(T.y(x, y)), mat, 4, G["smear"])

##  Human: a long scarf whose two tails stream back from the neck and trail the motion.
static func draw_scarf_tails(r, art, T, m, sway: float) -> void:
	var top: float = art["body"]["torso"] + 0.8
	var s: float = sway * 3
	var _fn0 = func(pts):
		var shapes = []
		for i in range(1, pts.size()):
			shapes.append(T.cap(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1], pts[i - 1][2], pts[i][2]))
		return PixelSdf.union.callv(TS.arr(shapes))
	var tail = _fn0
	# The far tail sits a little lower and darker, so the pair reads as two strips.
	r.fill(tail.call([[-1.5, top - 0.6, 1.4], [(-5.5) - (s * 0.5), top - 2.6, 1.3], [(-8.5) - s, top - 5.6, 1.2], [(-10) - (s * 1.3), top - 8.6, 1.1]]), m.call("scarf"), {"group": G["cape"], "bevel": 1.4, "toneBias": -1})
	r.fill(tail.call([[-1.5, top, 1.6], [(-6) - (s * 0.6), top - 0.6, 1.5], [(-10.5) - s, top - 2.4, 1.4], [(-14) - (s * 1.5), top - 4.2, 1.2]]), m.call("scarf"), {"group": G["cape"], "bevel": 1.6})
	# Frayed tip.
	r.fill(T.poly([(-13.4) - (s * 1.5), top - 3, (-16.4) - (s * 1.7), top - 3.6, (-14.6) - (s * 1.6), top - 4.6, (-15.6) - (s * 1.7), top - 5.8, (-13) - (s * 1.4), top - 5.2]), m.call("scarf"), {"group": G["cape"], "bevel": 1})

##  Human: the scarf's wrap around the neck, over the collar.
static func draw_scarf_wrap(r, art, T, m) -> void:
	if art["chest"]["hood"]:
		return
	var top: float = art["body"]["torso"]
	r.fill(T.ell(0.3, top + 0.9, 3.4, 1.9, -0.12), m.call("scarf"), {"group": G["cape"], "bevel": 1.8})
	r.fill(PixelSdf.intersect(T.ell(0.3, top + 0.9, 3.4, 1.9, -0.12), T.rect(0, top + 0.4, 6, 0.35)), m.call("scarf"), {"group": G["cape"], "flat": 1, "noLine": true})

static func draw_cape(r, T, top: float, mat: float, sway: float) -> void:
	var s: float = sway * 3
	r.fill(T.poly([-1, top + 0.5, -5.5, top - 1, (-9) - s, -6, (-7.5) - (s * 1.2), -12, (-3.5) - s, -11, -1, -2]), mat, {"group": G["cape"], "bevel": 3, "toneBias": -1, "softLight": true})

# -----------------------------------------------------------------------------
# Head, face, hair
# -----------------------------------------------------------------------------
static func head_shape(art, H) -> Variant:
	var sp: String = art["look"]["species"]
	# Golem: a carved block with a square jaw.
	if sp == "golem":
		return H.poly([-5.8, -1.6, -5.4, 5.4, -0.4, 6.9, 5.4, 5.6, 6.6, 0.4, 6.4, -4, 4.4, -6, -1.4, -5.6], 1.4)
	# Ogrin: a huge underslung jaw.
	var jaw = (H.ell(2.8, -3.2, 5.2, 3.9) if sp == "ogrin" else H.ell(1.9, -2.4, 4.1, 3.3))
	return blend_shapes(2.2, [H.ell(0, 0.5, 6.2, 6.1), jaw])

static func draw_head(r, art, H, m) -> void:
	r.fill(head_shape(art, H), m.call("skin"), {"group": G["head"], "bevel": 3.4, "softLight": true})
	var sp: String = art["look"]["species"]
	if sp == "golem":
		var c: float = m.call("stoneCrack")
		r.line(H.x(-3, 4), H.y(-3, 4), H.x(-1, 1.5), H.y(-1, 1.5), c, 0, G["head"])
		r.line(H.x(-1, 1.5), H.y(-1, 1.5), H.x(-2, -1.5), H.y(-2, -1.5), c, 0, G["head"])
		r.line(H.x(1.4, -5.4), H.y(1.4, -5.4), H.x(2.4, -3.6), H.y(2.4, -3.6), c, 0, G["head"])
		# Moss on the back of the skull.
		r.fill(PixelSdf.intersect(H.ell(-3.4, 4.6, 3.4, 1.6, 0.4), head_shape(art, H)), m.call("moss"), {"group": G["head"], "bevel": 1, "noLine": true})
	elif sp == "ogrin":
		# A heavy brow ridge shading the eyes.
		r.fill(H.ell(3.4, 2.7, 3.8, 1.2, -0.06), m.call("skin"), {"group": G["head"], "bevel": 1.2, "noLine": true, "lightBias": 0.2})

##  Pixel position of a head-local point.
static func px(H, x: float, y: float) -> Variant:
	return [floor(H.x(x, y)), floor(H.y(x, y))]

static func draw_face(r, art, H, face: String, m) -> void:
	var sp: String = art["look"]["species"]
	var glow_eyes: bool = ((sp == "wisp") or (sp == "imp"))
	var hood: bool = art["headgear"] == "executioner_hood"
	var mask: bool = ((art["headgear"] == "berserker_mask") or (not (not (null if SpriteArmour2.stock_head(art["headgear"]) == null else SpriteArmour2.stock_head(art["headgear"])["face"]))))
	if (hood or mask) and (not art["headFace"]):
		return
	if sp == "golem":
		draw_golem_face(r, H, face, m)
		return
	var _d0 = px(H, 1.4, 0.4)
	var nx = _d0[0]
	var ny = _d0[1]
	var _d1 = px(H, 4.8, 0.3)
	var fx = _d1[0]
	var fy = _d1[1]
	var lash: float = m.call("lash")
	var iris: float = (m.call("eyeGlow") if glow_eyes else m.call("iris"))
	var white: float = m.call("white")
	var g: float = G["head"]
	if face == "ko":
		# X eyes.
		r.dot(nx, ny, lash, 0, g)
		r.dot(nx + 1, ny + 1, lash, 0, g)
		r.dot(nx + 1, ny, lash, 0, g)
		r.dot(nx, ny + 1, lash, 0, g)
		r.dot(fx, fy, lash, 0, g)
		r.dot(fx, fy + 1, lash, 0, g)
	elif (face == "hurt") or (face == "blink"):
		# Squeezed shut: > <
		r.dot(nx, ny + 1, lash, 0, g)
		r.dot(nx + 1, ny + 1, lash, 0, g)
		if face == "hurt":
			r.dot(nx + 1, ny, lash, 0, g)
		r.dot(fx, fy + 1, lash, 0, g)
	else:
		# Lash line, iris with a highlight.
		r.dot(nx, ny, lash, 0, g)
		r.dot(nx + 1, ny, lash, 0, g)
		r.dot(nx, ny + 1, iris, (3 if glow_eyes else 1), g)
		r.dot(nx + 1, ny + 1, (iris if glow_eyes else white), (4 if glow_eyes else 2), g)
		r.dot(nx, ny + 2, iris, (3 if glow_eyes else 2), g)
		r.dot(nx + 1, ny + 2, iris, (3 if glow_eyes else 1), g)
		r.dot(fx, fy, lash, 0, g)
		r.dot(fx, fy + 1, iris, (3 if glow_eyes else 1), g)
		r.dot(fx, fy + 2, iris, (3 if glow_eyes else 2), g)
		if (face == "fierce") or (face == "shout"):
			# Brows angled down toward the nose.
			r.dot(nx - 1, ny - 2, lash, 0, g)
			r.dot(nx, ny - 2, lash, 0, g)
			r.dot(nx + 1, ny - 1, lash, 0, g)
			r.dot(fx - 1, fy - 1, lash, 0, g)
	if ((sp == "human") and (face != "fierce")) and (face != "shout"):
		# Humans wear their mood on their brows: level when calm, lifted when hurt.
		var lift: float = (-1 if (face == "hurt") or (face == "ko") else 0)
		var brow: float = m.call("brow")
		r.dot(nx - 1, ((ny - 2) + lift) + (1 if face == "hurt" else 0), brow, 0, g)
		r.dot(nx, (ny - 2) + lift, brow, 0, g)
		r.dot(nx + 1, (ny - 2) + lift, brow, 0, g)
		r.dot(fx, (fy - 2) + lift, brow, 0, g)
	if sp == "human":
		# A small nose: one shaded pixel under the far eye.
		var _d2 = px(H, 5.4, -1.4)
		var qx = _d2[0]
		var qy = _d2[1]
		r.dot(qx, qy, m.call("skin"), 1, g)
	# Mouth.
	var _d3 = px(H, 3.6, -3.4)
	var mx = _d3[0]
	var my = _d3[1]
	if (face == "shout") or (face == "hurt"):
		r.dot(mx, my, m.call("mouth"), 0, g)
		r.dot(mx + 1, my, m.call("mouth"), 0, g)
		r.dot(mx, my + 1, m.call("mouth"), 0, g)
		r.dot(mx + 1, my + 1, m.call("inner"), 2, g)
	elif face != "ko":
		r.dot(mx, my, m.call("mouth"), 1, g)
	else:
		r.dot(mx, my, m.call("mouth"), 0, g)
		r.dot(mx + 1, my, m.call("mouth"), 0, g)
	if sp == "ogrin":
		# Shadow under the brow, a broad flat nose, war paint and two big tusks.
		r.line(H.x(0.2, 2.6), H.y(0.2, 2.6), H.x(6.2, 2.1), H.y(6.2, 2.1), m.call("skinDark"), 0, g)
		var _d4 = px(H, 6.3, -1.2)
		var qx_2 = _d4[0]
		var qy_2 = _d4[1]
		r.dot(qx_2, qy_2, m.call("skinDark"), 0, g)
		r.dot(qx_2 - 1, qy_2 + 1, m.call("skinDark"), 1, g)
		r.line(H.x(0.8, -0.8), H.y(0.8, -0.8), H.x(1.2, -2.8), H.y(1.2, -2.8), m.call("paint"), 2, g)
		r.line(H.x(-0.6, -0.6), H.y(-0.6, -0.6), H.x(-0.4, -2.4), H.y(-0.4, -2.4), m.call("paint"), 2, g)
		r.fill(H.poly([4.6, -5.6, 6.4, -5.6, 6.6, -1, 5.8, -0.4]), m.call("tusk"), {"group": g, "bevel": 0.8})
		r.fill(H.poly([1.8, -5.8, 3, -5.8, 2.9, -2.6, 2.3, -2.4]), m.call("tusk"), {"group": g, "bevel": 0.6, "toneBias": -1})
	if (sp == "imp") and (face != "ko"):
		# One fang over the lip.
		r.dot(mx + 1, my + 1, m.call("tusk"), 3, g)
	if (sp == "wisp") and (face != "ko"):
		# Glowing tear marks under the eyes.
		r.dot(nx, ny + 3, m.call("hairGlow"), 3, g)
		r.dot(nx, ny + 4, m.call("hairGlow"), 2, g)
		r.dot(fx, fy + 3, m.call("hairGlow"), 3, g)
	if sp == "myco":
		# Rosy cheeks under the eyes.
		var _d5 = px(H, 1.6, -1.4)
		var ax = _d5[0]
		var ay = _d5[1]
		r.dot(ax, ay, m.call("inner"), 2, g)
		var _d6 = px(H, 5.4, -1.6)
		var bx = _d6[0]
		var by = _d6[1]
		r.dot(bx, by, m.call("inner"), 2, g)

##  Golem: no eyes, just a glowing visor slit that dims when hurt, and a carved seam for a mouth.
static func draw_golem_face(r, H, face: String, m) -> void:
	var g: float = G["head"]
	r.line(H.x(0.6, 1.6), H.y(0.6, 1.6), H.x(6.4, 1.2), H.y(6.4, 1.2), m.call("skinDark"), 0, g)
	if face == "ko":
		r.line(H.x(0.8, 0.6), H.y(0.8, 0.6), H.x(6, 0.4), H.y(6, 0.4), m.call("stoneCrack"), 0, g)
	else:
		var dim: bool = ((face == "hurt") or (face == "blink"))
		r.line(H.x(0.8, 0.6), H.y(0.8, 0.6), H.x(6, 0.4), H.y(6, 0.4), m.call(("stoneCrack" if dim else "eyeGlow")), (1 if dim else 4), g)
		if not dim:
			r.dot.callv(TS.arr(px(H, 1.6, 0.6)) + [m.call("eyeGlow"), 4, g])
			r.dot.callv(TS.arr(px(H, 4.8, 0.5)) + [m.call("eyeGlow"), 4, g])
	var open: bool = face == "shout"
	r.line(H.x(2.6, -3.4), H.y(2.6, -3.4), H.x(6, -3.6), H.y(6, -3.6), m.call(("gem" if open else "stoneCrack")), (3 if open else 0), g)

static func hides_hair(art) -> bool:
	return ((((art["headHair"] or (not (not art.get("headBald")))) or (art["headgear"] == "iron_helm")) or (art["headgear"] == "executioner_hood")) or (not (not (null if SpriteArmour2.stock_head(art["headgear"]) == null else SpriteArmour2.stock_head(art["headgear"])["hair"]))))

static func draw_hair_back(r, art, H, m, sway: float) -> void:
	if (not has_hair(art)) or art.get("headBald"):
		return
	var style: float = art["look"]["hair"]
	var hm: float = m.call("hair")
	var s: float = sway * 2
	if style == 1:
		# Ponytail
		var pts = [[-5.6, 3, 1.9], [(-9.5) - s, 1, 2.2], [(-11) - (s * 1.3), -4, 1.8], [(-10.5) - (s * 1.6), -9, 1.0]]
		var shapes = []
		for i in range(1, pts.size()):
			shapes.append(H.cap(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1], pts[i - 1][2], pts[i][2]))
		r.fill(PixelSdf.union.callv(TS.arr(shapes)), hm, {"group": G["hair"], "bevel": 2})
	elif style == 3:
		# Mane: a big wild volume behind the head and down the back.
		var shapes_2 = [H.ell(-3, 0.5, 6.4, 7.6), H.poly([-6, -3, (-9.5) - s, -9, -5.5, -6, (-6.5) - s, -12, -2.5, -6.5, -1, -4]), H.poly([-7, 4, (-11) - s, 3, -7.5, 1]), H.poly([-6, 6, (-9.5) - s, 8.5, -4.5, 7.5])]
		r.fill(PixelSdf.union.callv(TS.arr(shapes_2)), hm, {"group": G["hair"], "bevel": 2.6})
	elif style == 5:
		# Braid down the back.
		var shapes_3 = []
		var x: float = -5.5
		var y: float = -1
		for i_2 in range(5):
			var nx: float = ((-6.5) - (s * (i_2 / 4.0))) - (i_2 * 0.3)
			var ny: float = y - 2.8
			shapes_3.append(H.circ(x, y, 1.9 - (i_2 * 0.12)))
			x = nx
			y = ny
		r.fill(PixelSdf.union.callv(TS.arr(shapes_3)), hm, {"group": G["hair"], "bevel": 1.6})
		r.dot(H.x(x + 0.2, y + 1.4), H.y(x + 0.2, y + 1.4), m.call("accent"), 3, G["hair"])
	elif style == 2:
		# Bob: back volume down to the jaw.
		r.fill(H.poly([-6.8, 3, -7.4, -2.5, -6, -5.2, -2.5, -5, -1, 0]), hm, {"group": G["hair"], "bevel": 2.4})

static func has_hair(art) -> bool:
	return CharacterAppearance.SPECIES.get(art["look"]["species"])["hair"]

##  What grows on a hairless head: a myco cap or golem crystals, in the shape `look.hair` picks.
static func draw_crown(r, art, H, m) -> void:
	if hides_hair(art):
		return
	var sp: String = art["look"]["species"]
	var style: float = fmod(art["look"]["hair"], (TS.nn((null if CharacterAppearance.SPECIES.get(sp).get("styles") == null else CharacterAppearance.SPECIES.get(sp).get("styles").size()), 1)))
	if sp == "myco":
		draw_cap(r, H, m, style)
	else:
		draw_crystals(r, H, m, style)

static func draw_cap(r, H, m, style: float) -> void:
	var g: float = G["hair"]
	var spot = (func(x: float, y: float, rad: float): r.fill(H.circ(x, y, rad), m.call("capSpot"), {"group": g, "flat": 2, "noLine": true}))
	if style == 1:
		# Cone: a tall pointed cap that bends back at the tip.
		r.fill(H.ell(-0.2, 3, 7.4, 1.2), m.call("gill"), {"group": g, "bevel": 1, "toneBias": -1})
		r.fill(H.poly([-7.6, 3.2, 7, 3.4, 3.2, 9, -1.2, 14.4, -5, 15.8, -3, 12.6, -4.6, 7.6], 0.6), m.call("cap"), {"group": g, "bevel": 2.6, "softLight": true})
		spot.call(1.8, 6.2, 1.1)
		spot.call(-2.4, 9.6, 0.9)
		spot.call(-4.6, 5, 0.8)
	elif style == 2:
		# Parasol: flat and very wide, drooping at the rim, with a nub on top.
		r.fill(H.ell(-0.4, 3.6, 10.6, 1.2), m.call("gill"), {"group": g, "bevel": 1, "toneBias": -1})
		var top = H.ell(-0.4, 3.8, 11.4, 4.2)
		r.fill(PixelSdf.intersect(top, above(H, 3.8, 3, top.box)), m.call("cap"), {"group": g, "bevel": 2.6, "softLight": true})
		r.fill(H.ell(-0.4, 7.9, 2.2, 1.1), m.call("cap"), {"group": g, "bevel": 1.2, "toneBias": -1})
		spot.call(4.6, 5.4, 1)
		spot.call(-3.6, 6.2, 1.2)
		spot.call(-8.4, 4.6, 0.8)
		spot.call(8.6, 4.4, 0.7)
	else:
		# Dome: broad, round and spotted.
		r.fill(H.ell(-0.4, 2.7, 8.4, 1.3), m.call("gill"), {"group": g, "bevel": 1, "toneBias": -1})
		var dome = H.ell(-0.4, 2.6, 9.2, 7.6)
		r.fill(PixelSdf.intersect(dome, above(H, 3.2, 2.2, dome.box)), m.call("cap"), {"group": g, "bevel": 3, "softLight": true})
		for _e0 in [[1.6, 6.6, 1.4], [-3.6, 7.4, 1.1], [5.4, 4.6, 0.9], [-6.8, 4.2, 1], [-1, 9.1, 0.8]]:
			var x_2 = _e0[0]
			var y_2 = _e0[1]
			var rad_2 = _e0[2]
			spot.call(x_2, y_2, rad_2)

static func draw_crystals(r, H, m, style: float) -> void:
	var c: float = m.call("gem")
	var o = {"group": G["hair"], "bevel": 1}
	if style == 1:
		# Spire: one tall crystal with two small ones at its foot.
		r.fill(H.poly([-2.2, 5.6, -1, 15, 0.6, 15.6, 1.8, 6]), c, o)
		r.fill(H.poly([-4.6, 4.4, -6.4, 8.6, -2.6, 5.6]), c, TS.merge([o, {"toneBias": -1}]))
		r.fill(H.poly([2, 5.8, 4.4, 9.4, 4.4, 5.2]), c, o)
	elif style == 2:
		# Shards: a cluster swept back like a mane.
		r.fill(H.poly([-1.6, 6.4, -6, 11.6, -4.4, 6.2]), c, o)
		r.fill(H.poly([-4, 5.2, -10, 7.4, -6, 3.2]), c, TS.merge([o, {"toneBias": -1}]))
		r.fill(H.poly([-5.4, 2.4, -10.6, 2, -6, 0]), c, TS.merge([o, {"toneBias": -1}]))
		r.fill(H.poly([1, 6.6, -1.6, 12.2, -0.8, 6.6]), c, o)
		r.fill(H.poly([2.8, 6.2, 2.4, 9.4, 4.8, 5.6]), c, o)
	else:
		# Crown: three crystals in a row.
		r.fill(H.poly([-4, 4.5, -5.5, 9.5, -2, 6]), c, o)
		r.fill(H.poly([-1.5, 6, -0.5, 11, 1.8, 6.2]), c, o)
		r.fill(H.poly([1.5, 5.8, 4, 8.6, 4, 5]), c, o)

static func draw_hair_front(r, art, H, m) -> void:
	if not has_hair(art):
		draw_crown(r, art, H, m)
		return
	if hides_hair(art):
		return
	var style: float = art["look"]["hair"]
	var hm: float = m.call("hair")
	var parts = []
	var _sw0 = style
	if _sw0 == 0:
		parts.append(hair_cap(H, 2.4, -3.8, 1))
		parts.append(H.poly([-5.8, 2.5, -10, 4.2, -6.4, 5.8]))
		parts.append(H.poly([-5, 5.2, -7.4, 10, -2, 7]))
		parts.append(H.poly([-2.2, 6.8, -0.4, 11.2, 2, 7]))
		parts.append(H.poly([1.8, 6.6, 5.8, 9.4, 4.8, 5]))
		parts.append(H.poly([5, 4.5, 8.2, 0.6, 6.6, 3.6]))
		parts.append(H.poly([3.6, 4.4, 4.6, 0.4, 2, 3.6]))
	elif _sw0 == 1:
		parts.append(hair_cap(H, 2.6, -2.6, 0.8))
		parts.append(H.poly([4.4, 4.6, 7.4, 1.4, 6.8, 4]))
		parts.append(H.circ(-5.6, 3, 1.6))
	elif _sw0 == 2:
		parts.append(hair_cap(H, 2, -4.2, 1.1))
		parts.append(H.poly([3, 4.8, 7.4, 1, 7.2, 4.2]))
		parts.append(H.poly([0.6, 4.2, 3.2, 1.2, 4, 4.4]))
	elif _sw0 == 3:
		parts.append(hair_cap(H, 2.2, -3.2, 1.3))
		parts.append(H.poly([4.6, 5, 8.6, 0, 6.8, 4.2]))
		parts.append(H.poly([2, 6, 4.2, 9.8, 5.4, 5.2]))
		parts.append(H.poly([-2, 6.8, -1, 10.6, 1.8, 6.8]))
	elif _sw0 == 4:
		parts.append(hair_cap(H, 3.4, -2, 0.55))
	elif _sw0 == 5:
		parts.append(hair_cap(H, 2.8, -3, 0.9))
		parts.append(H.poly([4.6, 4.4, 7.2, 1.6, 7, 4.2]))
	r.fill(PixelSdf.union.callv(TS.arr(parts)), hm, {"group": G["hair"], "bevel": 2.4})
	if art["look"]["species"] == "wisp":
		# Cold flame licking up off the crown.
		var f: float = m.call("hairGlow")
		r.fill(H.poly([-2.6, 6.4, -4.2, 12.6, -0.6, 7.6]), f, {"group": G["hair"], "bevel": 1})
		r.fill(H.poly([0.2, 7, 1.2, 13.6, 2.4, 7.2]), f, {"group": G["hair"], "bevel": 1})
		r.fill(H.poly([-5.2, 4.8, -8.4, 9, -4.2, 6.4]), f, {"group": G["hair"], "bevel": 1})

static func draw_ears_behind(r, art, H, m) -> void:
	var sp: String = art["look"]["species"]
	if (art["headgear"] == "executioner_hood") or ((null if SpriteArmour2.stock_head(art["headgear"]) == null else SpriteArmour2.stock_head(art["headgear"])["ears"]) == "all"):
		return
	var helm: bool = ((art["headgear"] == "iron_helm") or ((null if SpriteArmour2.stock_head(art["headgear"]) == null else SpriteArmour2.stock_head(art["headgear"])["ears"]) == "side"))
	if (sp == "wisp") and (not helm):
		# A thin halo floating over the crown.
		var outer = H.ell(-1.6, 12.6, 4.8, 1.5, 0.12)
		r.fill(PixelSdf.subtract(outer, H.ell(-1.6, 12.6, 3.7, 0.7, 0.12)), m.call("hairGlow"), {"group": G["ears"], "flat": 3, "noLine": true})

##  Imp horn: rises from the crown, sweeps back and curls down at the tip.
static func horn_shape(H, dx: float, k: float) -> Variant:
	var pts = [[1.4, 4.8, 1.8], [1.6, 8.8, 1.5], [-0.6, 12, 1.2], [-4, 13.2, 0.9], [-6.6, 11.8, 0.6], [-7, 9.6, 0.3]]
	var shapes = []
	for i in range(1, pts.size()):
		var _d0 = pts[i - 1]
		var ax = _d0[0]
		var ay = _d0[1]
		var ar = _d0[2]
		var _d1 = pts[i]
		var bx = _d1[0]
		var by = _d1[1]
		var br = _d1[2]
		shapes.append(H.cap(dx + (ax * k), ay * k, dx + (bx * k), by * k, ar * k, br * k))
	return PixelSdf.union.callv(TS.arr(shapes))

static func draw_ears_front(r, art, H, m, sp: String) -> void:
	var ears = (null if SpriteArmour2.stock_head(art["headgear"]) == null else SpriteArmour2.stock_head(art["headgear"])["ears"])
	var hood: bool = ((art["headgear"] == "executioner_hood") or (ears == "all"))
	var helm: bool = ((art["headgear"] == "iron_helm") or (ears == "side"))
	if hood:
		return
	if sp == "imp":
		if not helm:
			# Far horn a step ahead and darker, then the near one.
			r.fill(horn_shape(H, 2.6, 0.88), m.call("horn"), {"group": G["ears"], "bevel": 1.2, "toneBias": -1})
			r.fill(horn_shape(H, 0, 1), m.call("horn"), {"group": G["ears"], "bevel": 1.4})
			# Ridges across the horn.
			for _e0 in [[0.6, 6.6], [-0.2, 9.6], [-2.8, 11.6]]:
				var x = _e0[0]
				var y = _e0[1]
				r.dot.callv(TS.arr(px(H, x, y)) + [m.call("hornRidge"), 1, G["ears"]])
		# Long pointed ear swept back.
		r.fill(H.poly([-1.4, 0.8, -9, 3.8, -7.4, 1.8, -1.8, -1.8]), m.call("skin"), {"group": G["ears"], "bevel": 1.4})
		r.fill(H.poly([-2.6, 0.4, -7.4, 2.6, -2.8, -0.8]), m.call("inner"), {"group": G["ears"], "flat": 2, "noLine": true})
	elif sp == "ogrin":
		# Big drooping ear with a gold hoop.
		r.fill(H.poly([-1.2, 1, -8.2, 1.6, -7, -1.2, -1.6, -2]), m.call("skin"), {"group": G["ears"], "bevel": 1.6})
		r.fill(PixelSdf.subtract(H.circ(-6.8, -1.9, 1.3), H.circ(-6.8, -1.9, 0.6)), m.call("gold"), {"group": G["ears"], "bevel": 0.6})
	elif sp == "wisp":
		# Long, thin ear swept back with a glowing tip.
		r.fill(H.poly([-1.2, 1, -9.6, 4.6, -1.8, -1.6]), m.call("skin"), {"group": G["ears"], "bevel": 1.2})
		r.dot.callv(TS.arr(px(H, -8.8, 4.1)) + [m.call("hairGlow"), 3, G["ears"]])
	elif (sp == "human") and (not helm):
		# Small round ear, set back from the cheek.
		r.fill(H.ell(-2.4, -0.6, 1.5, 2), m.call("skin"), {"group": G["ears"], "bevel": 1.2})

static func draw_headgear(r, art, H, m, sway: float) -> void:
	var g: float = G["headgear"]
	if art["headDraw"] != null:
		art["headDraw"].call(r, H, m, g, sway)
	else:
		var _sw0 = art["headgear"]
		if _sw0 == "iron_helm":
			var dome = hair_cap(H, 1.2, -3.6, 1.25)
			r.fill(dome, m.call("helm"), {"group": g, "bevel": 3})
			r.fill(H.poly([1.4, 1.6, 4.8, 1.6, 4, -3.2, 1.8, -2.8]), m.call("helm"), {"group": g, "bevel": 1.6})
			r.fill(H.rect(5.6, 0.2, 0.6, 2.6), m.call("helm"), {"group": g, "bevel": 1})
			r.fill(PixelSdf.intersect(dome, H.rect(0, 2.1, 9, 0.5)), m.call("helmDark"), {"group": g, "flat": 1, "noLine": true})
			r.dot(H.x(-3, 1.8), H.y(-3, 1.8), m.call("helm"), 4, g)
			r.dot(H.x(0, 1.8), H.y(0, 1.8), m.call("helm"), 4, g)
		elif _sw0 == "berserker_mask":
			r.fill(H.poly([0.8, 3.6, 7.2, 3, 7.6, -1.2, 5.4, -5.2, 1.4, -4.8, 0.6, -1]), m.call("mask"), {"group": g, "bevel": 2})
			# Eye slits and teeth.
			r.line(H.x(2.4, 0.4), H.y(2.4, 0.4), H.x(3.6, -0.2), H.y(3.6, -0.2), m.call("maskEye"), 3, g)
			r.dot(H.x(5.6, 0.2), H.y(5.6, 0.2), m.call("maskEye"), 3, g)
			r.line(H.x(3, -3.2), H.y(3, -3.2), H.x(6, -3.2), H.y(6, -3.2), m.call("maskHorn"), 3, g)
			# Horns sweeping back.
			r.fill(H.poly([1.4, 3.4, -1.4, 7.6, -5, 9.2, -2, 6.4, -0.4, 3]), m.call("maskHorn"), {"group": g, "bevel": 1.2})
			r.fill(H.poly([5, 3.2, 5.8, 7.4, 3.6, 9.8, 4.4, 6.6, 3.6, 3.2]), m.call("maskHorn"), {"group": g, "bevel": 1.2, "toneBias": -1})
		elif _sw0 == "chrono_circlet":
			r.fill(H.cap(-6.4, 2.2, 6.6, 3.4, 0.7), m.call("gold"), {"group": g, "bevel": 1})
			r.fill(H.poly([5.4, 3.4, 6.4, 5.2, 7.4, 3.4, 6.4, 1.8]), m.call("gemPurple"), {"group": g})
		elif _sw0 == "executioner_hood":
			var hood = PixelSdf.union(H.ell(-0.8, 1.2, 7.8, 7.6), H.poly([-7.6, 1, -6.4, -6.8, 1, -7.4, 3, -4]))
			r.fill(hood, m.call("hood"), {"group": g, "bevel": 3, "softLight": true})
			# Face in shadow with two burning eyes.
			r.fill(H.ell(3.8, -1.3, 3.7, 4.1), m.call("hood"), {"group": g, "flat": 0, "noLine": true})
			r.dot(H.x(2.6, 0.2), H.y(2.6, 0.2), m.call("hoodEye"), 3, g)
			r.dot(H.x(3.6, 0.2), H.y(3.6, 0.2), m.call("hoodEye"), 3, g)
			r.dot(H.x(5.8, 0.1), H.y(5.8, 0.1), m.call("hoodEye"), 3, g)
		elif _sw0 == "storm_crown":
			r.fill(H.poly([-4.6, 4.4, -5.4, 8.8, -3.2, 6.6, -1.6, 9.8, 0.4, 7, 2.2, 9.8, 3.4, 6.6, 5.4, 8.8, 5, 4.4, 0, 5.4]), m.call("gold"), {"group": g, "bevel": 1.6})
			r.dot(H.x(0.2, 6.6), H.y(0.2, 6.6), m.call("spark"), 3, g)
			r.dot(H.x(-1.6, 9.8), H.y(-1.6, 9.8), m.call("spark"), 3, g)
			r.dot(H.x(2.2, 9.8), H.y(2.2, 9.8), m.call("spark"), 3, g)
		elif _sw0 == "duelist_band":
			var s: float = sway * 2
			r.fill(H.cap(-6.6, 1.8, 6.6, 3, 1), m.call("band"), {"group": g, "bevel": 1})
			r.fill(H.poly([-6.2, 2.4, (-11.5) - s, 0.5, (-10.6) - s, -0.8, -6.4, 0.8]), m.call("bandTail"), {"group": g, "bevel": 1})
			r.fill(H.poly([-6.2, 1.6, (-10) - s, -3.2, (-9) - s, -4, -6, 0.4]), m.call("bandTail"), {"group": g, "bevel": 1, "toneBias": -1})
		else:
			if SpriteArmour2.stock_head(art["headgear"]) != null:
				(null if SpriteArmour2.stock_head(art["headgear"]) == null else SpriteArmour2.stock_head(art["headgear"])["draw"]).call(r, H, m, g, sway)
	if (art["gear"].get("special") == "phoenix_feather") and (art["headgear"] != "executioner_hood"):
		if (null if art["specialSkin"] == null else art["specialSkin"].get("plume")) != null:
			art["specialSkin"].get("plume").call(r, H, m, g, sway)
		else:
			r.fill(H.poly([-5, 4, -9.5, 9.5, -8.6, 10.4, -4.2, 5]), m.call("plume"), {"group": g, "bevel": 1})
			r.dot(H.x(-9, 10), H.y(-9, 10), m.call("plumeTip"), 3, g)

# -----------------------------------------------------------------------------
# Weapons
# -----------------------------------------------------------------------------
static func draw_main(r, art, sk, pose, hold, OX: float, OY: float, m, bias: float) -> void:
	var wm = (func(k: String): return m.call("w." + k))
	if art["family"] == "bow":
		var t = SpriteXform.frame_at(OX, OY, sk["handF"], pose["wAng"] + pose["rot"])
		var pull: float = (hold.get("pull") if hold.get("pull") != null else 0)
		var string_to = ([OX + sk["handN"]["x"], OY - sk["handN"]["y"]] if pull > 0.05 else null)
		art["main"]["draw"].call(r, t, wm, {"group": G["main"], "toneBias": bias, "pull": pull, "stringTo": string_to})
		figureMarks["tip"] = t.p(-3, 20)
		return
	var sc: float = (hold.get("mainScale") if hold.get("mainScale") != null else 1)
	var t_2 = SpriteXform.frame_at(OX, OY, sk["handN"], pose["wAng"] + pose["rot"], sc)
	art["main"]["draw"].call(r, t_2, wm, {"group": G["main"], "toneBias": bias})
	figureMarks["tip"] = t_2.p(art["main"]["tip"] * 0.85, 0)

##  A fist weapon over one hand, lined up with the forearm so it always points where the punch goes.
static func draw_fist(r, art, sk, side: String, OX: float, OY: float, m) -> void:
	var far: bool = side == "F"
	var hand = (sk["handF"] if far else sk["handN"])
	var el = (sk["elF"] if far else sk["elN"])
	var t = SpriteXform.frame_at(OX, OY, hand, atan2(hand["y"] - el["y"], hand["x"] - el["x"]))
	art["main"]["draw"].call(r, t, (func(k: String): return m.call("w." + k)), {"group": (G["sec"] if far else G["main"]), "toneBias": (-1 if far else 0)})
	if not far:
		figureMarks["tip"] = t.p(art["main"]["tip"] * 0.85, 0)

static func draw_main_on_back(r, art, sk, OX: float, OY: float, m) -> void:
	var wm = (func(k: String): return m.call("w." + k))
	var back = {"x": ((sk["chest"]["x"] + sk["hip"]["x"]) / 2.0) - 3.5, "y": ((sk["chest"]["y"] + sk["hip"]["y"]) / 2.0) + 1}
	if art["family"] == "bow":
		var t = SpriteXform.frame_at(OX, OY, back, -0.75)
		art["main"]["draw"].call(r, t, wm, {"group": G["main"], "toneBias": -1})
		return
	var ang: float = 2.2
	var g = {"x": back["x"] - ((cos(ang) * art["main"]["tip"]) * 0.45), "y": back["y"] - ((sin(ang) * art["main"]["tip"]) * 0.45)}
	art["main"]["draw"].call(r, SpriteXform.frame_at(OX, OY, g, ang), wm, {"group": G["main"], "toneBias": -1})

static func draw_sec(r, art, sk, pose, hold, OX: float, OY: float, m, bias: float) -> void:
	if art["sec"] == null:
		return
	var sm = (func(k: String): return m.call("s." + k))
	var t = SpriteXform.frame_at(OX, OY, sk["handF"], pose["sAng"] + pose["rot"])
	art["sec"]["draw"].call(r, t, sm, {"group": G["sec"], "toneBias": bias, "pull": hold.get("pull")})
	figureMarks["secTip"] = t.p(art["sec"]["tip"] * 0.8, 0)

static func draw_sec_holster(r, art, sk, T, OX: float, OY: float, m, back: bool) -> void:
	if art["sec"] == null:
		return
	var sm = (func(k: String): return m.call("s." + k))
	if back:
		# Shield on the back, rim showing behind the shoulder.
		var p = {"x": (sk["chest"]["x"] - art["body"]["chestW"]) - 1.5, "y": ((sk["chest"]["y"] + sk["hip"]["y"]) / 2.0) + 2}
		art["sec"]["draw"].call(r, SpriteXform.frame_at(OX, OY, p, -1.45), sm, {"group": G["sec"], "toneBias": -1})
		return
	# Small items hang at the back of the belt.
	var bx: float = T.x((-art["body"]["waistW"]) - 0.6, 2.2)
	var by: float = T.y((-art["body"]["waistW"]) - 0.6, 2.2)
	art["sec"]["draw"].call(r, SpriteXform.Xf.new(bx, by, (-2.2 if art["secFamily"] == "horn" else -1.95), 0.85, 0.85), sm, {"group": G["sec"], "toneBias": 0})

static func smear_mats(art) -> Variant:
	var s = TS.id_get(smearCache, art)
	if s == null:
		var skin = (null if art["mainSkin"] == null else art["mainSkin"].get("trail"))
		var tint: float = (0xffc070 if art["mainId"] == "ember_wand" else (0xd8ffc0 if art["mainId"] == "dagger" else (0xffe0d8 if art["mainId"] == "greataxe" else 0xf4f8ff)))
		s = ([PixelRaster.material({"base": skin[0], "glow": true}), PixelRaster.material({"base": skin[1], "glow": true})] if skin != null else [PixelRaster.material({"base": tint, "glow": true}), PixelRaster.material({"base": PixelColor.mix(tint, 0x8aa0c8, 0.45), "glow": true})])
		TS.id_set(smearCache, art, s)
	return s

static func smear_mat(art) -> Variant:
	return smear_mats(art)[0]

static func smear_dim(art) -> Variant:
	return smear_mats(art)[1]

# --- hand-written (godot/src/patches/render/sprite/draw.gd) ---

## Smooth union of `s` (same maths as PixelSdf.blend).
static func blend_shapes(k: float, s: Array) -> PixelSdf.Shape:
	return PixelSdf.blend_of(k, s)


## Hair cap: everything of an enlarged head above the brow-to-nape line.
static func hair_cap(H, front: float, back: float, grow: float = 0.9) -> PixelSdf.Shape:
	var cap: PixelSdf.Shape = H.ell(-0.4, 0.9, 6.2 + grow, 6.1 + grow)
	var a: Array = H.p(7, front)
	var b: Array = H.p(-7.5, back)
	# Keep the side of line a→b where the crown is.
	var dx: float = b[0] - a[0]
	var dy: float = b[1] - a[1]
	var nx := -dy
	var ny := dx
	var crown: Array = H.p(0, 6)
	if (crown[0] - a[0]) * nx + (crown[1] - a[1]) * ny > 0:
		nx = -nx
		ny = -ny
	var l := sqrt(nx * nx + ny * ny)
	if l == 0.0: l = 1.0
	return PixelSdf.intersect(cap, PixelSdf.half_plane_box(a[0], a[1], nx / l, ny / l, cap.box))


## Head-space half plane above the line through (−10, back) and (10, front).
static func above(H, front: float, back: float, box: Dictionary) -> PixelSdf.Shape:
	var a: Array = H.p(10, front)
	var b: Array = H.p(-10, back)
	var dx: float = b[0] - a[0]
	var dy: float = b[1] - a[1]
	var nx := -dy
	var ny := dx
	var crown: Array = H.p(0, front + 10)
	if (crown[0] - a[0]) * nx + (crown[1] - a[1]) * ny > 0:
		nx = -nx
		ny = -ny
	var l := sqrt(nx * nx + ny * ny)
	if l == 0.0: l = 1.0
	return PixelSdf.half_plane_box(a[0], a[1], nx / l, ny / l, box)


## Weapon smear: a crescent trailing the swing, behind the body (the GPU paints it pixel by pixel).
static func draw_smear(r, art, sk, s, OX: float, OY: float) -> void:
	if s.get("ring"):
		draw_ring(r, art, sk, OX, OY)
		return
	var sh = sk["shN"]
	var tip: float = art["main"]["tip"]
	var reach: float = sqrt(pow(sk["handN"]["x"] - sh["x"], 2) + pow(sk["handN"]["y"] - sh["y"], 2)) + tip
	var cx: float = OX + sh["x"]
	var cy: float = OY - sh["y"]
	var shape := PixelSdf.arc(cx, cy, maxf(3, reach - tip * 0.75), reach + 1, -s["from"], -s["to"])
	var mat: int = r.add(smear_mat(art))
	var dim: int = r.add(smear_dim(art))
	var legend: bool = art["mainSkin"] != null and art["mainSkin"].get("fx") != null
	r.smear(shape, mat, dim, cx, cy, s["from"], s["to"] - s["from"], tip, reach, legend)


## Whirlwind: a flat band of motion around the waist, behind the body where they overlap.
static func draw_ring(r, art, sk, OX: float, OY: float) -> void:
	var cx: float = OX + sk["hip"]["x"]
	var cy: float = OY - (sk["hip"]["y"] + sk["chest"]["y"]) / 2.0
	var mat: int = r.add(smear_mat(art))
	var dim: int = r.add(smear_dim(art))
	r.ring(mat, dim, cx, cy, art["main"]["tip"] + 10, 5)
