		r.fill(PixelSdf.subtract(plate, shin.poly([kx - 1.8, (-w) * 0.2, kx + 1.3, (-w) * 0.3, kx + 2.4, w * 0.2, kx + 1.8, w + 0.3, kx - 1.8, w + 0.1])), m.call("ob.gold"), TS.merge([o, {"flat": 2, "noLine": true}]))
