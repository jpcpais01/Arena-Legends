		# The knee plate: a shield rising over the knee, gold rimmed, a small oni face on it.
		var kx: float = c["len"] - 0.6
		var plate = shin.poly([kx - 2.4, (-w) * 0.4, kx + 1.6, (-w) * 0.6, kx + 3, w * 0.2, kx + 2.2, w + 0.9, kx - 2.4, w + 0.6])
