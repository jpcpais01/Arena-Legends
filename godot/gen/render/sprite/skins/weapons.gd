		SpriteWeaponKit.fill_all(r, [t.cap(0, -2.6, 0, 2.6, 1.45)], m.call("grip"), o, 1)
		var top = path.call(1, 1)
		var bot = path.call(1, -1)
		r.dot(t.x(top[0], top[1]), t.y(top[0], top[1]), m.call("tip"), 3, (o.get("group") if o.get("group") != null else 6))
		r.dot(t.x(bot[0], bot[1]), t.y(bot[0], bot[1]), m.call("tip"), 3, (o.get("group") if o.get("group") != null else 6))
		var st = (o.get("stringTo") if o.get("stringTo") != null else t.p((-bend) - 0.5, 0))
		r.line(t.x(top[0], top[1] - 0.5), t.y(top[0], top[1] - 0.5), st[0], st[1], m.call("string"), 3, 9)
		r.line(st[0], st[1], t.x(bot[0], bot[1] + 0.5), t.y(bot[0], bot[1] + 0.5), m.call("string"), 3, 9)
		if (o.get("stringTo") != null) and (pull > 0.15):
			var hx: float = t.x(7, 0)
			var hy: float = t.y(7, 0)
			r.line(st[0], st[1], hx, hy, m.call("arrow"), 2, 9)
			r.dot(hx, hy, m.call("arrow"), 4, 9)
			r.dot(st[0], st[1] - 1, m.call("fletch"), 3, 9)
	return {"tip": 22, "mats": spec["mats"], "draw": _fn3}

