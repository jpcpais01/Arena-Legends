##  A longbow with the stock one's grip, reach and string behaviour, reshaped.
static func bow(spec) -> Variant:
	var _fn3 = func(r, t, m, o):
		var pull: float = (o.get("pull") if o.get("pull") != null else 0)
		var bend: float = 2.5 + (pull * 2.5)
		var _fn0 = func(u: float, s: float):
			var flick: float = maxf(0, u - 0.72)
			return [(((-bend) * u) * u) + (((spec["recurve"] * flick) * flick) * 14), (s * 22) * u]
		var path = _fn0
		var limbs = []
		for s_2 in [-1, 1]:
			var _d1 = path.call(0, s_2)
			var px = _d1[0]
			var py = _d1[1]
			for i in range(1, 8 + 1):
				var _d2 = path.call(i / 8.0, s_2)
				var nx = _d2[0]
				var ny = _d2[1]
				limbs.append(t.cap(px, py, nx, ny, spec["thick"].call(i / 8.0)))
				px = nx
				py = ny
