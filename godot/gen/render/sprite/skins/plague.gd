		for x in [-2, -0.7, 0.6, 1.9]:
			r.line(F.x(x, 5.2), F.y(x, 5.2), F.x(x, 6.4), F.y(x, 6.4), M["brass"], 1, 4)
	r.fill(PixelSdf.intersect(PixelSdf.subtract(F.ell(0, 6.6, 3.4, 3), F.ell(0, 6.6, 2.8, 2.4)), F.rect(0, 8.6, 4, 2)), M["brass"], {"group": 4, "bevel": 0.4})
