	var k: float = ([0, 1, 0.4, -0.6])[f]
	var pts = [[(-1.6) + (k * 0.3), -4.6, 0.6], [0.6, (-4) + (k * 0.2), 0.85], [1.4 - (k * 0.3), -2.2, 1], [-0.2, (-0.9) + (k * 0.3), 1], [(-1.4) + (k * 0.4), 0.6, 0.85], [(-0.6) + (k * 0.6), 1.8 - (k * 0.2), 0.6]]
	var segs = []
	for i in range(1, pts.size()):
		segs.append(F.cap(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1], pts[i - 1][2], pts[i][2]))
	r.fill(PixelSdf.union.callv(TS.arr(segs)), M["leech"], {"group": 2, "bevel": 0.9})
	for i_2 in range(1, pts.size() - 1):
		r.dot(F.x(pts[i_2][0] + 0.3, pts[i_2][1] + 0.4), F.y(pts[i_2][0] + 0.3, pts[i_2][1] + 0.4), M["leech"], 4, 2)
	r.dot(F.x(pts[5][0], pts[5][1] + 0.4), F.y(pts[5][0], pts[5][1] + 0.4), M["seal"], 2, 2)
	# Bubbles climbing to the surface.
	for _e0 in [[1.9, (-5) + (f * 1.6)], [-2, (-3) + ((fmod((f + 2), 4)) * 1.4)]]:
		var bx = _e0[0]
		var by = _e0[1]
		if by < (lvl - 0.4):
			r.dot(F.x(bx, by), F.y(bx, by), M["hot"], 4, 1)
