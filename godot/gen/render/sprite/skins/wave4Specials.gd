static func scaled(t, s: float, dx: float = 0.0, dy: float = 0.0) -> Variant:
	return SpriteXform.Xf.new(t.x(dx, dy), t.y(dx, dy), 0, s, s)

##  A four-point star: a hot centre and four arms.
static func sparkle(r, t, x: float, y: float, hot: float, arm: float, g: float) -> void:
	px(r, t, x, y, hot, 3, g)
	for _e0 in [[1, 0], [-1, 0], [0, 1], [0, -1]]:
		var dx = _e0[0]
		var dy = _e0[1]
		px(r, t, x + dx, y + dy, arm, 3, g)

##  Projectiles with a top and a bottom fly upright both ways.
static func upright(t) -> Variant:
	return (SpriteXform.Xf.new(t.ox, t.oy, t.ang, 1, -1) if cos(t.ang) < 0 else t)

## A tall carved cedar pole (origin at its base): a bear at the foot, a frog
## above it, and on top the thunderbird, wings spread wide and painted in
## black, red and teal formline, lightning running through its feathers and
## its eyes lit with the storm. `f` 0..3 rests (the lightning crawls), 4..7 strikes.
static func thunderbird_pole(r, t, m, f: float) -> void:
	var hot: bool = f >= 4
	var ph: float = TS.i32(int(f) & 3)
	var cedar: float = m.call("k.cedar")
	var ink: float = m.call("k.ink")
	var red: float = m.call("k.red")
	var teal: float = m.call("k.teal")
	var bone: float = m.call("k.bone")
	var storm: float = m.call("k.storm")
	var storm_hot: float = m.call("k.stormHot")
	# Wings behind the pole, raised in a wide V, feathers stepping down from the tips to the shoulders.
	for sd in [-1, 1]:
		var w = (func(pts): return t.poly(TS.map(pts, (func(v: float, i: float, _a2 = null): return (v if fmod(i, 2) else v * sd)))))
		r.fill(w.call([2.4, 27.4, 6.4, 30.6, 10.8, 33.4, 11.6, 30.6, 10.2, 30.4, 10.8, 27.8, 9, 27.6, 9.2, 25, 7.4, 25.2, 7.2, 22.8, 5.2, 23.4, 4.6, 21.2, 2.4, 22]), teal, {"group": 2, "bevel": 1.4})
		# Formline: a black ovoid at the shoulder, red U-feathers out along the span.
		r.fill(w.call([2.6, 22.4, 4.4, 21.6, 5, 23.4, 3.4, 24]), ink, {"group": 3, "flat": 1})
		r.fill(w.call([8.4, 30.4, 10.6, 32.4, 10.4, 30.6]), red, {"group": 3, "flat": 2})
		r.fill(w.call([6.2, 25.4, 7.8, 27.6, 8, 25.8]), red, {"group": 3, "flat": 2})
		# Lightning zigzag through the feathers; a pulse runs out toward the tip.
		var zz = [[2.8, 25.6], [5, 28.2], [5.8, 26.6], [8, 30], [8.6, 28.6], [10.8, 32]]
		for i_2 in range(zz.size() - 1):
			var lit: bool = ((hot or (i_2 == ph)) or (i_2 == (ph + 1)))
			r.line(t.x(zz[i_2][0] * sd, zz[i_2][1]), t.y(zz[i_2][0] * sd, zz[i_2][1]), t.x(zz[i_2 + 1][0] * sd, zz[i_2 + 1][1]), t.y(zz[i_2 + 1][0] * sd, zz[i_2 + 1][1]), (storm_hot if lit else storm), 3, 4)
	# The pole, flaring at the foot.
	r.fill(t.poly([-5.2, 0, -4.2, 2, -3.6, 2.6, -3.6, 24, 3.6, 24, 3.6, 2.6, 4.2, 2, 5.2, 0]), cedar, {"group": 5, "bevel": 2.6})
	# Bear (bottom): round ears, big eyes, a red grinning mouth.
	for sd_2 in [-1, 1]:
		r.fill(t.circ(sd_2 * 3.2, 11.4, 1.2), cedar, {"group": 4, "bevel": 1})
		px(r, t, sd_2 * 3.3, 11.4, ink, 1, 4)
		r.fill(t.ell(sd_2 * 1.8, 8.4, 1.5, 1.1), bone, {"group": 5, "bevel": 0.8})
		px(r, t, (sd_2 * 1.6) - (0 if sd_2 > 0 else 0.2), 8.2, ink, 0, 5)
		r.line(t.x(sd_2 * 0.6, 10.2), t.y(sd_2 * 0.6, 10.2), t.x(sd_2 * 3.2, 9.6), t.y(sd_2 * 3.2, 9.6), ink, 1, 5)
	r.fill(t.rect(0, 5, 2.6, 1.1, 0.6), red, {"group": 5, "bevel": 0.8})
	r.line(t.x(-1.8, 5), t.y(-1.8, 5), t.x(1.8, 5), t.y(1.8, 5), bone, 3, 5)
	r.line(t.x(-3.6, 2.6), t.y(-3.6, 2.6), t.x(3.6, 2.6), t.y(3.6, 2.6), ink, 1, 5)
	# Frog (middle): teal lidded eyes, a wide red mouth.
	r.line(t.x(-3.6, 12.8), t.y(-3.6, 12.8), t.x(3.6, 12.8), t.y(3.6, 12.8), ink, 1, 5)
	for sd_3 in [-1, 1]:
		r.fill(t.ell(sd_3 * 1.9, 17.4, 1.6, 1.2), teal, {"group": 5, "bevel": 0.8})
		px(r, t, sd_3 * 1.9, 17.2, ink, 0, 5)
	r.fill(t.rect(0, 14.6, 3, 0.7, 0.3), red, {"group": 5, "flat": 2})
	r.line(t.x(-3.6, 19.6), t.y(-3.6, 19.6), t.x(3.6, 19.6), t.y(3.6, 19.6), ink, 1, 5)
	# Thunderbird: chest, head, curled horns, the storm orb between them, a big hooked beak.
	r.fill(t.ell(0, 23.4, 4, 3.4), cedar, {"group": 7, "bevel": 2})
	r.fill(t.poly([-2.8, 25, 0, 21, 2.8, 25, 0, 23.4]), red, {"group": 7, "flat": 2})
	for sd_4 in [-1, 1]:
		r.fill(t.cap(sd_4 * 1.4, 31.4, sd_4 * 2.8, 34.6, 0.9, 0.6), teal, {"group": 8, "bevel": 0.8})
		r.fill(t.cap(sd_4 * 2.8, 34.6, sd_4 * 4.2, 34, 0.6, 0.5), teal, {"group": 8, "bevel": 0.6})
	r.fill(t.circ(0, 34.4, (1.3 if hot else 1)), (storm_hot if hot else storm), {"group": 8})
	r.fill(t.circ(0, 29.4, 3.5), cedar, {"group": 9, "bevel": 1.8})
	r.line(t.x(-3, 31.4), t.y(-3, 31.4), t.x(3, 31.4), t.y(3, 31.4), ink, 1, 9)
	for sd_5 in [-1, 1]:
		r.fill(t.ell(sd_5 * 1.9, 29.8, 1.1, 0.9), bone, {"group": 9, "flat": 3})
		px(r, t, sd_5 * 1.7, 29.8, (storm_hot if hot or (ph == 2) else storm), 3, 9)
		px(r, t, sd_5 * 0.2, 29.8, ink, 1, 9)
	r.fill(t.poly([-1.6, 28.6, 1.6, 28.6, 1.8, 26.2, 0.6, 24, -0.4, 24.2, 0.4, 25.6, -0.6, 26.6, -1.4, 27.2]), red, {"group": 10, "bevel": 1})
	r.line(t.x(-1.4, 28.4), t.y(-1.4, 28.4), t.x(1.4, 28.4), t.y(1.4, 28.4), ink, 1, 10)
	px(r, t, 0.6, 24.4, ink, 1, 10)
	# Striking: arcs crackle between the horn tips.
	if hot:
		var k: float = (1 if TS.i32(int(ph) & 1) else -1)
		r.line(t.x(-4.2, 34.4), t.y(-4.2, 34.4), t.x(-2.2, 36 + (k * 0.6)), t.y(-2.2, 36 + (k * 0.6)), storm_hot, 3, 11)
		r.line(t.x(-2.2, 36 + (k * 0.6)), t.y(-2.2, 36 + (k * 0.6)), t.x(-0.8, 35.2 - (k * 0.6)), t.y(-0.8, 35.2 - (k * 0.6)), storm, 3, 11)
		r.line(t.x(0.8, 35.2 + (k * 0.6)), t.y(0.8, 35.2 + (k * 0.6)), t.x(2.2, 36 - (k * 0.6)), t.y(2.2, 36 - (k * 0.6)), storm, 3, 11)
		r.line(t.x(2.2, 36 - (k * 0.6)), t.y(2.2, 36 - (k * 0.6)), t.x(4.2, 34.4), t.y(4.2, 34.4), storm_hot, 3, 11)

##  The charm that rides along: a small carved thunderbird on a stub of pole (origin at its middle).
static func thunderbird_charm(r, t, m, _a3 = null) -> void:
	var cedar: float = m.call("k.cedar")
	var teal: float = m.call("k.teal")
	var ink: float = m.call("k.ink")
	var red: float = m.call("k.red")
	for sd in [-1, 1]:
		r.fill(t.poly([sd * 1, 1.6, sd * 4.2, 3.4, sd * 4, 0.8, sd * 1, -0.2]), teal, {"group": 1, "bevel": 0.8})
	r.fill(t.rect(0, -1.8, 1.3, 3.6, 0.4), cedar, {"group": 2, "bevel": 1})
	r.fill(t.circ(0, 2.6, 1.6), cedar, {"group": 3, "bevel": 1})
	px(r, t, -0.6, 2.8, m.call("k.storm"), 3, 3)
	px(r, t, 0.6, 2.8, m.call("k.storm"), 3, 3)
	px(r, t, 0, 1.6, ink, 1, 3)
	r.line(t.x(-1.2, -3.2), t.y(-1.2, -3.2), t.x(1.2, -3.2), t.y(1.2, -3.2), red, 2, 3)

## An hourglass of deep-blue glass running with starlight instead of sand,
## in brass caps under a little sun, inside an armillary: a tilted ring
## round its waist carrying a red planet, and an upright ring turning about
## the glass with a blue one (origin at its centre; 8 frames).
static func orrery(r, t, m, f: float) -> void:
	var brass: float = m.call("k.brass")
	var star: float = m.call("k.star")
	var star_hot: float = m.call("k.starHot")
	var ink: float = m.call("k.ink")
	var phi: float = (f / 8.0) * PI
	# Point on ring i at angle th: [x, y, depth] (depth > 0 is behind the glass).
	var _fn0 = func(i: float, th: float):
		if i == 0:
			var x: float = cos(th) * 8.6
			var y: float = sin(th) * 2.2
			var c: float = cos(0.18)
			var sn: float = sin(0.18)
			return [(x * c) - (y * sn), ((x * sn) + (y * c)) - 0.4, sin(th)]
		return [(cos(th) * cos(phi)) * 7.2, sin(th) * 7.2, cos(th) * sin(phi)]
	var at = _fn0
	var planets = [[0, 0.6 + (((f / 8.0) * PI) * 2), "k.mars", 1], [1, 0.9, "k.sea", 1.2]]
	var _fn4 = func(back: bool):
		for i_2 in range(2):
			for k in range(80):
				var _d1 = at.call(i_2, ((k / 80.0) * PI) * 2)
				var x_2 = _d1[0]
				var y_2 = _d1[1]
				var d = _d1[2]
				if (d > 0) != back:
					continue
				px(r, t, x_2, y_2, brass, (1 if back else (4 if (x_2 - (y_2 * 0.3)) > 4 else 3)), (1 if back else 8))
		# Planets ride their rings, passing behind the glass and back out.
		for _e2 in planets:
			var i_3 = _e2[0]
			var th_2 = _e2[1]
			var mat = _e2[2]
			var size = _e2[3]
			var _d3 = at.call(i_3, th_2)
			var x_3 = _d3[0]
			var y_3 = _d3[1]
			var d_2 = _d3[2]
			if (d_2 > 0) != back:
				continue
			r.fill(t.circ(x_3, y_3, size + 0.9), ink, {"group": 10 + i_3, "flat": 0})
			r.fill(t.circ(x_3, y_3, size), m.call(mat), {"group": 10 + i_3, "bevel": 1})
			if i_3 == 1:
				px(r, t, x_3 + 2, y_3 + 1.2, m.call("k.moon"), 3, 12)
	var ring = _fn4
	ring.call(true)
	# The glass on a dark backing (this sprite has no outline: the rings stay one pixel fine).
	r.fill(t.poly([-4.8, 6.6, 4.8, 6.6, 4.4, 4.6, 1.4, 0, 4.4, -4.6, 4.8, -6.6, -4.8, -6.6, -4.4, -4.6, -1.4, 0, -4.4, 4.6]), ink, {"group": 3, "flat": 0})
	r.fill(PixelSdf.union(t.poly([-3.2, 4.8, 3.2, 4.8, 0.6, 0.4, -0.6, 0.4]), t.poly([-3.2, -4.8, 3.2, -4.8, 0.6, -0.4, -0.6, -0.4])), m.call("k.glass"), {"group": 4, "bevel": 1.4})
	# A little starlight left in the top, a heap of it below, a mote trickling down.
	r.fill(t.poly([-1.4, 2.2, 1.4, 2.2, 0.4, 0.9, -0.4, 0.9]), star, {"group": 5})
	r.fill(t.poly([-3, -4.6, 3, -4.6, 1, -2.8, -1, -2.8]), star, {"group": 5})
	px(r, t, 0, (-1) - (fmod(f, 3)), star_hot, 3, 5)
	for _e5 in [[-1.6, 3.6], [1.4, 3.2], [-1.6, -4], [1.2, -3.6]]:
		var x_4 = _e5[0]
		var y_4 = _e5[1]
		px(r, t, x_4, y_4, (star if (int(f) >> 1) % 2 else star_hot), 3, 5)
	px(r, t, -2, 4, m.call("k.glass"), 4, 5)
	# Brass caps, the little sun on top.
	r.fill(t.rect(0, 5.6, 4.2, 0.9, 0.4), brass, {"group": 6, "bevel": 1})
	r.fill(t.rect(0, -5.6, 4.2, 0.9, 0.4), brass, {"group": 6, "bevel": 1})
	r.fill(t.circ(0, 7.8, 1.3), m.call("k.sun"), {"group": 7})
	var rays = ([[0, 10], [2, 7.8], [-2, 7.8]] if TS.i32(int(f) & 1) else [[1.5, 9.3], [-1.5, 9.3], [0, 10.2]])
	for _e6 in rays:
		var x_5 = _e6[0]
		var y_5 = _e6[1]
		px(r, t, x_5, y_5, m.call("k.sun"), 3, 7)
	ring.call(false)

## A golden heater shield with a warding rune burning on its blue face,
## three glyphs circling it (origin at its centre; frames 0..3 rest, 4..7
## lit, when it has just raised a shield).
static func aegis_rune(r, t, m, f: float) -> void:
	var lit: bool = f >= 4
	var gold: float = m.call("k.gold")
	var _fn1 = func(back: bool):
		for k in range(3):
			var a: float = (((TS.i32(int(f) & 3)) / 4.0) * ((PI * 2) / 3.0)) + (((k * PI) * 2) / 3.0)
			if (sin(a) > 0) != back:
				continue
			var x: float = cos(a) * 7.6
			var y: float = (sin(a) * 2.6) - 0.6
			for _e0 in GLYPHS[k]:
				var dx = _e0[0]
				var dy = _e0[1]
				px(r, t, x + dx, y + dy, (gold if back else m.call("k.glyph")), (2 if back else 3), (1 if back else 9))
	var glyphs = _fn1
	glyphs.call(true)
	var shield = [-4.6, 4.8, 4.6, 4.8, 4.6, 0.6, 3.4, -2.8, 0, -6, -3.4, -2.8, -4.6, 0.6]
	r.fill(t.poly(shield), gold, {"group": 3, "bevel": 1.6, "lightBias": (0.25 if lit else 0)})
	r.fill(t.poly([-3.4, 3.6, 3.4, 3.6, 3.4, 0.6, 2.4, -2, 0, -4.4, -2.4, -2, -3.4, 0.6]), m.call("k.face"), {"group": 4, "bevel": 1.2, "lightBias": (0.3 if lit else 0)})
	# Algiz, the warding rune.
	var rune: float = (m.call("k.runeHot") if lit else m.call("k.rune"))
	r.line(t.x(0, 2.8), t.y(0, 2.8), t.x(0, -3.4), t.y(0, -3.4), rune, 3, 5)
	r.line(t.x(0, -0.2), t.y(0, -0.2), t.x(-2.2, 2.4), t.y(-2.2, 2.4), rune, 3, 5)
	r.line(t.x(0, -0.2), t.y(0, -0.2), t.x(2.2, 2.4), t.y(2.2, 2.4), rune, 3, 5)
	# Rivets at the corners, a boss of light at the point when lit.
	px(r, t, -3.8, 4, gold, 4, 6)
	px(r, t, 3.8, 4, gold, 4, 6)
	if lit:
		px(r, t, 0, -4.8, m.call("k.runeHot"), 3, 6)
	glyphs.call(false)

##  A tongue of flame from (x, y) out along (dx, dy), `w` wide at its root, with a hot core.
static func tongue(r, t, m, x: float, y: float, dx: float, dy: float, w: float, g: float) -> void:
	var l: float = (sqrt(dx * dx + dy * dy) if sqrt(dx * dx + dy * dy) else 1)
	var nx: float = ((-dy) / l) * w
	var ny: float = (dx / l) * w
	r.fill(t.poly([x + nx, y + ny, ((x + (dx * 0.55)) + (nx * 0.7)) + (dx * 0.1), (y + (dy * 0.55)) + (ny * 0.7), x + dx, y + dy, (x + (dx * 0.5)) - (nx * 0.6), (y + (dy * 0.5)) - (ny * 0.6), x - nx, y - ny]), m.call("k.flame"), {"group": g})
	if l > 2.4:
		r.fill(t.poly([x + (nx * 0.4), y + (ny * 0.4), x + (dx * 0.55), y + (dy * 0.55), x - (nx * 0.4), y - (ny * 0.4)]), m.call("k.flameHot"), {"group": g})

static func sun_falcon(r, t, m, pose: float) -> void:
	var p = (TS.at(FALCON, pose) if TS.at(FALCON, pose) != null else FALCON[0])
	pix(r, t, m, p["rows"], FALCON_INK, p["ax"], p["ay"])

##  The falcon's stoop: wings swept back into a blazing dart, a trail of fire behind.
static func sun_dive(r, t0, m, f: float) -> void:
	var t = upright(t0)
	var d: float = (-0.8 if f else 0)
	var plume: float = m.call("k.plume")
	var dk: float = m.call("k.plumeDk")
	tongue(r, t, m, -8, 0, (-6) + f, 0.6, 1.8, 1)
	tongue(r, t, m, -9, 1.4, (-4) - f, 2, 1, 1)
	tongue(r, t, m, -9, -1.2, -4, (-1.4) - (f * 0.6), 1, 1)
	r.fill(t.poly([0.5, 1.6, -3.6, 7.6 + d, -10.6, 9 + d, -5.2, 3]), dk, {"group": 2, "bevel": 1})
	r.fill(t.poly([-4, 0.9, -9.6, 0.6, -9.6, -1.6, -4, -0.9]), dk, {"group": 3, "bevel": 1})
	r.fill(t.ell(0, 0, 5, 2.2, -0.05), plume, {"group": 3, "bevel": 1.6})
	r.fill(t.ell(0.6, -1, 3.8, 1.1), m.call("k.breast"), {"group": 3, "bevel": 1})
	r.fill(t.circ(4.6, 0.7, 2.1), plume, {"group": 3, "bevel": 1.4})
	r.fill(t.poly([6.2, 1.4, 8.6, 0.6, 8, -0.8, 6.4, -0.2]), m.call("k.beak"), {"group": 4, "bevel": 0.8})
	px(r, t, 5.2, 1.2, m.call("k.eye"), 3, 4)
	r.fill(t.poly([3, 1.2, 0.4, 4.4, -4, 6.6 + d, -12.4, 7.4 + d, -7, 3.4, -2, 1.2]), plume, {"group": 5, "bevel": 1.2})
	tongue(r, t, m, -9.6, 6.8 + d, -3.6, 1.2, 0.9, 5)
	r.line(t.x(-1, 3.4), t.y(-1, 3.4), t.x(-6, 5.2 + (d * 0.6)), t.y(-6, 5.2 + (d * 0.6)), m.call("k.breast"), 2, 5)

static func starwyrm_sprite(r, t, m, pose: float) -> void:
	var p = (TS.at(WYRM, pose) if TS.at(WYRM, pose) != null else WYRM[0])
	pix(r, t, m, p["rows"], WYRM_INK, p["ax"], p["ay"])

##  Starfire: a rolling puff of blue flame with white stars caught in it.
static func star_breath(r, t, m, f: float) -> void:
	var p = ([[0, 0.6, -0.4], [0.7, -0.4, 0.6], [-0.5, 0.2, 0.9]])[f]
	r.fill(PixelSdf.union(t.circ(2.4, p[0], 4.2), t.circ(-2.8, 1.8 + p[1], 3.2), t.circ(-2.4, (-2) + p[2], 2.9), t.circ(-7, p[0], 2.2), t.circ(-10.4, 1 - p[1], 1.2)), m.call("k.fireDeep"), {"group": 1})
	r.fill(PixelSdf.union(t.circ(2.6, p[0] * 0.5, 3.1), t.circ(-2.2, 1.2 + p[1], 2.1), t.circ(-2, (-1.4) + p[2], 1.9), t.circ(-6.4, p[0], 1.2)), m.call("k.fire"), {"group": 1})
	r.fill(PixelSdf.union(t.circ(3, 0, 1.8), t.circ(0.2, 0.8 + (p[1] * 0.5), 1.1)), m.call("k.starHot"), {"group": 1})
	var stars = ([[[-4, 3], [-8, -1.6]], [[-5, -2.6], [-9, 1.8]], [[-3.4, 2.8], [-7.6, -2.4]]])[f]
	for _e0 in stars:
		var x = _e0[0]
		var y = _e0[1]
		sparkle(r, t, x, y, m.call("k.starHot"), m.call("k.star"), 2)
