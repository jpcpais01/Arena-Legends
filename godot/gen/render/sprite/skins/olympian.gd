			r.line(shin.x(x, a), shin.y(x, a), shin.x(x + 2.7, b), shin.y(x + 2.7, b), m.call("b.ol.strap"), 2, c["g"])
			x += 2.7
			k += 1
		r.fill(shin.rect(top - 0.4, 0, 0.6, w + 0.3), m.call("b.ol.cuff"), TS.merge([o, {"bevel": 0.5}]))
		r.fill(shin.rect(0.6, 0, 0.55, w + 0.25), m.call("b.ol.cuff"), TS.merge([o, {"bevel": 0.5}]))
		# The wings at the ankle, sweeping back and up, beating over the loop; the far ankle's sits behind.
		var beat: float = ([0, 0.22, 0.38, 0.18])[ph]
		var fs = [[2, 6.4, -0.45], [1.7, 5.4, -0.95], [1.4, 4.4, -1.45], [1.1, 3.4, -1.95]]
