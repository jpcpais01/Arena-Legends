		r.fill(shin.cap(1.8, w * 0.75, c["top"] - 0.6, w * 0.75, 0.42), m.call("k.gold"), TS.merge([o, {"bevel": 0.5}]))
		r.dot(shin.x(1.4, w * 0.4), shin.y(1.4, w * 0.4), m.call("k.gem"), 3, c["g"])
