		# A gold collar band, a sunburst of gold around the sternum sapphire, and filigree scrolls sweeping out from it.
		r_3.fill(T_2.ell(b["chestPush"] * 0.35, top_2 + 0.3, 4.2, 1.2), m_3.call("k.gold"), {"group": c_3["g"], "bevel": 1})
		var x_2: float = (b["chestPush"] * 0.7) + 1.2
