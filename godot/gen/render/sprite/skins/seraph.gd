## One great wing rising from the back (torso frame T): long feathers fanning from the arm, each its own outline,
## coverts over their roots and a gold edge along the leading arm. `flex` lifts and spreads it.
static func great_wing(r, T, m, rx: float, ry: float, flex: float, sway: float, bias: float, g0: float) -> void:
	var W = [((rx - 7.2) - (flex * 0.3)) - sway, (ry + 10.4) + (flex * 0.9)]
	var R = [rx, ry]
	var n: float = 7
	# Long feathers first, from the root (lowest, shortest) to the wrist (longest), so the upper ones lie on top.
	var k: float = n - 1
	while k >= 0:
		var u: float = k / (n - 1)
		var bx: float = W[0] + (((R[0] - W[0]) * u) * 0.92)
		var by: float = W[1] + (((R[1] - W[1]) * u) * 0.92)
		var a: float = (2.72 + (u * 1.25)) - ((flex * 0.12) * (1 - u))
		var len_: float = (13.4 - (u * 5.2)) + ((flex * 0.5) * (1 - u))
		var F = sub(T, bx, by, a)
		r.fill(feather_shape(F, len_, 1.5), m.call(("k.featherD" if fmod(k, 2) else "k.feather")), {"group": g0 + k, "bevel": 1, "toneBias": bias, "lightBias": 0.25, "local": F})
		k -= 1
	# Coverts: a soft mass along the arm, scalloped at its lower edge.
	var cov = []
	for k_2 in range(5):
		var u_2: float = k_2 / 4.0
		cov.append(T.circ(((W[0] + ((R[0] - W[0]) * u_2)) - 1) + (u_2 * 0.2), (W[1] + ((R[1] - W[1]) * u_2)) - 1.1, 2.1 - (u_2 * 0.3)))
	r.fill(PixelSdf.union.callv(TS.arr(cov) + [T.cap(W[0], W[1], R[0], R[1], 1.4, 1.6)]), m.call("k.covert"), {"group": g0 + n, "bevel": 1.2, "toneBias": bias, "local": T})
	# A gold edge along the leading arm, a pearl at the wrist.
	r.fill(T.cap(R[0] + 0.4, R[1] + 0.8, W[0] + 0.2, W[1] + 0.9, 0.45), m.call("k.gold"), {"group": g0 + n, "bevel": 0.5, "toneBias": bias})
	r.dot(T.x(W[0] + 0.2, W[1] + 0.9), T.y(W[0] + 0.2, W[1] + 0.9), m.call("k.light"), 3, g0 + n)

static func wingplate() -> Variant:
	# White enamel plate worked with pale gold filigree, a sky sapphire at the sternum in a gold sunburst, pearl
	# pauldrons rimmed in gold, and above all a pair of great white wings rising from the back that breathe slowly.
	var _fn0 = func(r, T, m, c):
		var ph: float = fmod(r.phase, 4)
