			var sw: float = sin((ph * SkinsKit.Q) + (i * 1.3)) * 0.25
			pts.append_array([L * 0.12, v, (-1.6) - ((i % 2) * 0.8), (v + 0.25) + sw])
		pts.append_array([L * 0.36, w + 0.3])
		r.fill(t.poly(pts), m.call("l.fur"), TS.merge([o, {"bevel": 1, "local": t}]))
		# The bone kneecap with an ochre stripe.
