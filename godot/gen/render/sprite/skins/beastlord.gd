		r.line(t.x((L * 0.04) - 0.6, w * 0.55), t.y((L * 0.04) - 0.6, w * 0.55), t.x((L * 0.04) + 0.6, w * 0.55), t.y((L * 0.04) + 0.6, w * 0.55), m.call("l.paint"), 2, c["g"] + 22)
		# A fang toggle on the thong round the middle.
