##  Paints a pixel map with (ax, ay) on the frame origin, `S` raster pixels per letter.
static func pix(r, t, m, rows, ax: float, ay: float, S = null, group = null) -> void:
	if S == null: S = 1
	if group == null: group = 1
	for y in range(rows.size()):
		for x in range(rows[y].length()):
			var e = RAPTOR_INK.get(rows[y][x])
			if e == null:
				continue
			if S == 1:
				r.dot((TS.round(t.ox) + x) - ax, (TS.round(t.oy) + y) - ay, m.call(e[0]), e[1], group)
			else:
				var x0: float = TS.round(t.ox + ((x - ax) * S))
				var y0: float = TS.round(t.oy + ((y - ay) * S))
				var x1: float = TS.round(t.ox + (((x + 1) - ax) * S))
				var y1: float = TS.round(t.oy + (((y + 1) - ay) * S))
				var yy: float = y0
				while yy < y1:
					var xx: float = x0
					while xx < x1:
						r.dot(xx, yy, m.call(e[0]), e[1], group)
						xx += 1
					yy += 1

