static func patchwork_trousers() -> Variant:
	# Old trousers of patchwork burlap, a plum patch on the thigh sewn with ember-bright thread, a brass button,
	# twine tied under the knee, and straw poking out of the ragged hems over the boots.
	var _fn0 = func(r, t, m, c):
		var o = {"group": c["g"], "toneBias": c["bias"]}
		var L: float = c["len"]
		var w: float = c["w"]
		# A patch on the front of the thigh, ember-stitched round its edge (plum on the near leg, moss on the far).
		var p0: float = L * 0.3
		var p1: float = L * 0.86
		var patch = t.poly([p0, (-w) * 0.35, p0 - 0.2, w + 0.35, p1, w + 0.2, p1 + 0.2, (-w) * 0.25])
		r.fill(patch, m.call(("l.hw.moss" if c["far"] else "l.hw.plum")), TS.merge([o, {"bevel": 0.8, "local": t}]))
		stitches(r, t, p0, w + 0.35, p1, w + 0.2, 4, m.call("l.hw.thread"), 2, c["g"])
		stitches(r, t, p0, (-w) * 0.35, p0 - 0.2, w + 0.35, 3, m.call("l.hw.thread"), 2, c["g"])
		if not c["far"]:
			r.dot(t.x(p1 - 0.6, w * 0.3), t.y(p1 - 0.6, w * 0.3), m.call("l.hw.brass"), 4, c["g"])
		# Twine tied round just under the knee... and just above it, a loose loop.
		r.fill(t.cap(0.5, (-w) - 0.3, 0.7, w + 0.3, 0.42), m.call("l.hw.twine"), TS.merge([o, {"bevel": 0.4}]))
	var _fn1 = func(r_2, shin, _foot, m_2, c_2):
		var o_2 = {"group": c_2["g"], "toneBias": c_2["bias"]}
		var w_2: float = c_2["body"]["shinR"] + 0.5
		var x: float = c_2["top"] + 0.4
		var ph: float = fmod(r_2.phase, 4)
		# The ragged hem over the boot cuff, straw sticking out from under it.
		r_2.fill(tuft(shin, x + 0.6, 0, (-0.1) + (([0, 0.05, 0.1, 0.05])[ph]), 2.8, 2.6, 5, 0.42, (2 if c_2["far"] else 6)), m_2.call("l.hw.straw"), TS.merge([o_2, {"bevel": 0.4, "toneBias": c_2["bias"] - (1 if c_2["far"] else 0)}]))
		r_2.fill(shin.poly([x + 1.6, -w_2, x + 1.6, w_2, x - 0.3, w_2, x + 0.4, w_2 * 0.4, x - 0.5, (-w_2) * 0.1, x + 0.3, (-w_2) * 0.6, x - 0.2, -w_2]), m_2.call("legLeather"), TS.merge([o_2, {"bevel": 1, "local": shin}]))
		r_2.fill(shin.cap(x + 1.2, (-w_2) - 0.2, x + 1.3, w_2 + 0.2, 0.4), m_2.call("l.hw.twine"), TS.merge([o_2, {"bevel": 0.4}]))
	return TS.merge([{"mats": {"legLeather": R(BURLAP, {"tex": weave}), "legLeatherDark": twine(), "l.hw.plum": R([0x2e1238, 0x4a1e56, 0x6e3082, 0x9450a8, 0xc080d0], {"tex": plaid}), "l.hw.moss": R(MOSS, {"tex": weave}), "l.hw.thread": {"base": 0xb06a2a, "ramp": [0x4a2208, 0x6e3410, 0x9a5420, 0xc87a34, 0xffc060], "tex": embers}, "l.hw.straw": straw(), "l.hw.twine": twine(), "l.hw.brass": gold(), "l.hw.rag": R(BURLAP)}, "legs": {"mat": "legLeather", "trim": null, "knee": null, "tasset": null, "rune": null, "wraps": null, "bulk": 0.25, "over": _fn0, "shin": _fn1}}, FX])

