	var _fn1 = func(r_2, S, m_2, c_2):
		var o = {"group": c_2["g"], "toneBias": c_2["bias"]}
		# Straw bursting out of the top of the sleeve, a burlap patch sewn over the shoulder.
		r_2.fill(tuft(S, -0.6, 1.8, PI * 0.62, 3.4, 1.2, 5, 0.45, (3 if c_2["far"] else 8)), m_2.call("hk.straw"), TS.merge([o, {"bevel": 0.5}]))
		r_2.fill(S.poly([-2.2, 2.2, 2, 2.6, 2.4, -0.6, -1.8, -1]), m_2.call("hk.burlap"), TS.merge([o, {"bevel": 0.9}]))
		if not c_2["far"]:
