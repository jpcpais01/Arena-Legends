##  The torso's main volumes (as the figure draws them), for clipping patches to it.
static func torso_body(T, b, top: float) -> Variant:
	return PixelSdf.union(T.ell(0.3, 0.6, b["hipW"], 3.6), T.ell(0.5, top * 0.46, b["waistW"], top * 0.28), T.ell(b["chestPush"] * 0.7, top - 3.4, b["chestW"], 5.4))

##  A row of cross stitches from (ax, ay) to (bx, by) in frame F.
static func stitches(r, F, ax: float, ay: float, bx: float, by: float, n: float, mat: float, tone: float, g: float) -> void:
	var dx: float = bx - ax
	var dy: float = by - ay
	var l: float = (sqrt(dx * dx + dy * dy) if sqrt(dx * dx + dy * dy) else 1)
	var nx: float = ((-dy) / l) * 0.45
	var ny: float = (dx / l) * 0.45
	for i in range(floori(n) + 1):
		var x: float = ax + ((dx * i) / n)
		var y: float = ay + ((dy * i) / n)
		r.line(F.x(x - nx, y - ny), F.y(x - nx, y - ny), F.x(x + nx, y + ny), F.y(x + nx, y + ny), mat, tone, g)

static func scarecrow_rags() -> Variant:
	# A plum plaid shirt patched with burlap and moss-green cloth, cross-stitched in twine, straw bursting out
