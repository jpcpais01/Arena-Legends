static func hallow_treads() -> Variant:
	# Black leather boots with long toes curling up to a point, a plum cuff, a gold buckle set with an amber gem
	# and a little bat wing at each ankle, beating.
	var _fn1 = func(r, shin, foot, m, c):
		var o = {"group": c["g"], "toneBias": c["bias"]}
		var ph: float = fmod(r.phase, 4)
		var w: float = c["w"]
		var T: float = c["toe"]
		# The toe drawn out long and curling up to a point.
		r.fill(foot.poly([T - 2.4, -1.4, T + 0.6, -1.2, T + 2.4, -0.4, T + 3.4, 1, T + 3, 2.2, T + 2.2, 1.4, T + 1.8, 0.4, T, 0.6, T - 2.4, 0.9]), m.call("b.hw.leather"), TS.merge([o, {"bevel": 0.9}]))
		r.dot(foot.x(T + 3, 2.1), foot.y(T + 3, 2.1), m.call("b.hw.gold"), 4, c["g"])
		# The buckle over the instep with its amber gem.
		r.fill(foot.rect(0.8, 0.9, 0.9, 0.75, 0.15), m.call("b.hw.gold"), TS.merge([o, {"bevel": 0.5}]))
		r.dot(foot.x(0.8, 0.9), foot.y(0.8, 0.9), m.call("b.hw.gem"), (4 if ph == 1 else 3), c["g"])
		if c["far"]:
			return
		# A bat wing at the back of the ankle, beating.
		var lift: float = ([-0.35, 0.05, 0.4, 0.05])[ph]
		var W = SpriteXform.Xf.new(shin.x(c["top"] * 0.62, (-w) + 0.2), shin.y(c["top"] * 0.62, (-w) + 0.2), 0)
		var wg = bat_wing(W, 0, 0, -1, 5.6, lift)
		r.fill(wg["shape"], m.call("b.hw.bat"), TS.merge([o, {"bevel": 0.7}]))
		for _e0 in TS.slice(wg["bones"], 0, 3):
			var ax = _e0[0]
			var ay = _e0[1]
			var bx = _e0[2]
			var by = _e0[3]
			r.line(W.x(ax, ay), W.y(ax, ay), W.x(bx, by), W.y(bx, by), m.call("b.hw.batHi"), 3, c["g"])
	return TS.merge([{"mats": {"shadow": R(LEATHER, {"tex": (func(x, _a1 = null, _a2 = null): return (TX.sel(TX.lt(SkinsKit.wrap___tx(x, 2.4), 0.4), -1, 0)))}), "shadowGlow": R(PLUM, {"tex": plaid}), "b.hw.leather": R(LEATHER), "b.hw.gold": gold(), "b.hw.gem": amber(), "b.hw.bat": R([0x16101e, 0x2a1c38, 0x44305a, 0x624a7e, 0x8a72a8]), "b.hw.batHi": R(PLUM)}, "boots": {"height": 0.64, "bulk": 0.32, "over": _fn1}}, FX])

##  A small jack-o'-lantern sitting on the ground at (px, py), its face flickering.
static func ground_jack(g, px: float, py: float, t: float, k: float) -> void:
	g["fillStyle"] = A["rindDk"]
	g["fillRect"].call(px - 3, py - 3, 7, 3)
	g["fillStyle"] = A["rind"]
	g["fillRect"].call(px - 2, py - 4, 5, 4)
	g["fillRect"].call(px - 3, py - 2, 7, 1)
	g["fillStyle"] = A["rindHi"]
	g["fillRect"].call(px - 1, py - 4, 1, 1)
	g["fillStyle"] = A["stem"]
	g["fillRect"].call(px, py - 5, 1, 1)
	var f: float = (0.75 + (sin((t * 9) + (k * 2.1)) * 0.15)) + (sin((t * 23) + k) * 0.1)
	g["globalAlpha"] = f
	g["fillStyle"] = A["fire"]
	g["fillRect"].call(px - 2, py - 3, 1, 1)
	g["fillRect"].call(px + 2, py - 3, 1, 1)
	g["fillRect"].call(px - 1, py - 1, 3, 1)
	g["globalAlpha"] = 1

##  The full-set aura around the feet at (x, y) art pixels; `t` is seconds.
static func hallow_aura(g, x: float, y: float, t: float, layer: String) -> void:
	# Fallen leaves swirling round the feet on the wind, tumbling as they go.
	var step: float = floor(t * 6)
	for i in range(12):
		var a: float = (((i / 12.0) * PI) * 2) + (t * 0.7)
		var s: float = sin(a)
		if (s < 0) != (layer == "back"):
			continue
		var rad: float = 14 + ((i % 3) * 1.5)
		var px: float = TS.round(x + (cos(a) * rad))
		var py: float = TS.round(y + (s * 3.6)) - (i % 2)
		var flat: float = fmod((step + i), 3)
		g["fillStyle"] = A["leaf"][i % 5]
		g["fillRect"].call(px, py, 1, 1)
		g["fillRect"].call(px + (1 if flat == 0 else 0), py + (-1 if flat == 1 else 0), 1, 1)
	# Two jack-o'-lanterns sitting on the ground, one behind and one in front.
	if layer == "back":
		ground_jack(g, x - 15, y - 3, t, 0)
	else:
		ground_jack(g, x + 16, y + 3, t, 1)
	# Bats circling up round the fighter, wings beating.
	for k in range(2):
		var u: float = fmod((t * 0.22) + (k * 0.5), 1)
		var a_2: float = ((u * PI) * 4) + (k * 2)
		var s_2: float = sin(a_2)
		if (s_2 < 0) != (layer == "back"):
			continue
		var px_2: float = TS.round(x + (cos(a_2) * (15 - (u * 4))))
		var py_2: float = TS.round(((y - 14) - (u * 30)) + (s_2 * 3))
		g["globalAlpha"] = (u / 0.1 if u < 0.1 else ((1 - u) / 0.15 if u > 0.85 else 1))
		var up: bool = fmod(floor((t * 10) + (k * 3)), 2) == 0
		g["fillStyle"] = A["bat"]
		g["fillRect"].call(px_2, py_2, 1, 2)
		g["fillRect"].call(px_2 - 2, (py_2 - 1 if up else py_2 + 1), 2, 1)
		g["fillRect"].call(px_2 + 1, (py_2 - 1 if up else py_2 + 1), 2, 1)
		g["fillRect"].call(px_2 - 1, py_2, 1, 1)
		g["fillRect"].call(px_2 + 1, py_2, 1, 1)
		g["fillStyle"] = A["batHi"]
		g["fillRect"].call(px_2 - 3, (py_2 - 2 if up else py_2 + 1), 1, 1)
		g["fillRect"].call(px_2 + 3, (py_2 - 2 if up else py_2 + 1), 1, 1)
	g["globalAlpha"] = 1
