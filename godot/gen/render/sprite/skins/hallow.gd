		var cx: float = fx + 1.4
		var cy: float = top_2 - 4.2
		r_3.fill(PixelSdf.intersect(body, T_2.poly([cx - 2, cy + 1.9, cx + 2.2, cy + 1.6, cx + 2.4, cy - 1.8, cx - 1.8, cy - 1.7])), m_3.call("hk.burlap"), {"group": 60, "bevel": 0.8, "local": T_2})
		stitches(r_3, T_2, cx - 1.9, cy + 1.8, cx + 2.2, cy + 1.6, 4, m_3.call("hk.thread"), 3, 60)
		stitches(r_3, T_2, cx + 2.3, cy + 1.5, cx + 2.4, cy - 1.7, 3, m_3.call("hk.thread"), 3, 60)
		var mx: float = fx - 1
