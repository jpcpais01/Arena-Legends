		var py: float = top - 9
		r.fill(T.rect(px, py, 1.5, 1.3, 0.2), m.call("hk.burlap"), {"group": c["g"], "bevel": 0.6, "toneBias": -1})
		stitches(r, T, px - 1.5, py + 1.3, px + 1.5, py + 1.3, 3, m.call("hk.thread"), 2, c["g"])
