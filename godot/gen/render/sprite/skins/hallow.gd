			if i < N:
				hem.append_array([x + 0.8, (y + 3.2) + (rip * 0.3)])
		r.fill(T.poly(([-0.6, top + 0.6, -5.2, top - 0.8, (-9.2) - s, top - 6.4, (-11.8) - (s * 1.3), -6] + TS.arr(hem) + [-1.6, -3, -0.6, 0])), m.call("hk.rag"), {"group": c["g"], "bevel": 2.6, "toneBias": -1, "softLight": true, "local": T})
		# A burlap patch stitched on it.
