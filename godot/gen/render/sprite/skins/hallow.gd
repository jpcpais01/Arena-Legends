		jack(r_3, SpriteXform.Xf.new(T_2.x(lx, ly), T_2.y(lx, ly), 0), 0, 0, 1.75, {"rind": m_3.call("hk.rind"), "rindDk": m_3.call("hk.rindDk"), "stem": m_3.call("hk.stem"), "fire": m_3.call("hk.fire"), "hot": m_3.call("hk.hot")}, 65, 0, (4 if ph_2 == 2 else 3))
