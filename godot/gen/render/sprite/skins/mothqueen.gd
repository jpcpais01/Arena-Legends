	for i in range(4):
		var a: float = rot + (i * (PI / 2.0))
		var F = sub(t, cx + ((cos(a) * 2.6) * k), (sin(a) * 2.6) * k, a + 0.75, k * 0.54, 1)
		if i % 2:
			hind_wing(r, F, m, {"group": g + i, "toneBias": bias})
		else:
			fore_wing(r, F, m, {"group": g + i, "toneBias": bias})
	r.fill(hoop(t, cx, 0, 3.7 * k, 3.7 * k, 1.3 * k), m["silver"], {"group": g + 5, "bevel": 0.9, "toneBias": bias})
