	for i_2 in range(4):
		var a_2: float = (rot + (i_2 * (PI / 2.0))) + (PI / 4.0)
		dot(r, t, cx + ((cos(a_2) * 3.05) * k), (sin(a_2) * 3.05) * k, m["stone"], 3, g + 5)

