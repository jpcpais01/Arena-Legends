	return TS.merge([{"mats": {"robe": S["saffron"].call(folds), "robeTrim": S["maroon"].call(), "k.shawl": S["maroon"].call(folds), "k.shawlEdge": S["saffron"].call(), "k.bronze": S["bronze"].call(null), "k.dark": SkinsKit.plain(BRONZE[0]), "k.bead": S["wood"].call(), "k.jade": S["jade"].call()}, "chest": {"cape": null, "hood": null, "pauldron": null, "noScarf": true, "back": _fn0, "shoulder": _fn1, "over": _fn2}}, FX])

# -----------------------------------------------------------------------------
# Cloudstep Trousers
# -----------------------------------------------------------------------------
static func cloudstep_trousers() -> Variant:
	# Loose trousers of unbleached cotton bound at hip and knee with maroon wraps, a cloud scroll embroidered
	# in bronze thread on the thigh, and maroon tie-ends fluttering off the knee wrap knotted round a jade bead.
	var _fn1 = func(r, t, m, c):
		var ph: float = fmod(r.phase, 4)
		var w: float = c["w"]
		var L: float = c["len"]
		# A cloud scroll on the outside of the thigh: three lobes and a curl.
		var cx: float = L * 0.52
		var cy: float = w * 0.15
		curl(r, t, cx, cy, 1.5, 0.8, PI * 0.9, -1, m.call("l.thread"), (2 if c["far"] else 3), c["g"])
		for _e0 in [[1.6, -0.9], [2.4, 0.6]]:
			var dx = _e0[0]
			var dy = _e0[1]
			var pts = []
			for i in range(5 + 1):
				var a: float = PI * (1.1 - (i * 0.22))
				pts.append_array([t.x((cx + dx) + (cos(a) * 0.9), (cy + dy) + (sin(a) * 0.9)), t.y((cx + dx) + (cos(a) * 0.9), (cy + dy) + (sin(a) * 0.9))])
			var i_2: float = 0
			while (i_2 + 3) < pts.size():
				r.line(pts[i_2], pts[i_2 + 1], pts[i_2 + 2], pts[i_2 + 3], m.call("l.thread"), (2 if c["far"] else 3), c["g"])
				i_2 += 2
		if c["far"]:
			return
		# Tie-ends off the knee wrap, fluttering back, knotted round a jade bead.
		var fl: float = ([0, 0.4, 0.7, 0.3])[ph]
		r.fill(t.poly([1.4, (-w) + 0.2, 0.6, ((-w) - 2.6) - fl, 1.2, ((-w) - 2.8) - fl, 2, (-w) + 0.2]), m.call("l.tie"), {"group": c["g"], "bevel": 0.5, "toneBias": c["bias"]})
		r.fill(t.poly([1.6, (-w) + 0.2, 2.4, ((-w) - 2) + (fl * 0.5), 3, ((-w) - 1.8) + (fl * 0.5), 2.4, (-w) + 0.4]), m.call("l.tie"), {"group": c["g"], "bevel": 0.5, "toneBias": c["bias"] - 1})
		dot(r, t, 1.7, (-w) + 0.1, m.call("l.jade"), 3, c["g"])
	return TS.merge([{"mats": {"windLeg": {"base": COTTON[2], "ramp": COTTON, "tex": folds}, "windTrim": S["maroon"].call(wound), "l.thread": S["bronze"].call(null), "l.tie": S["maroon"].call(), "l.jade": S["jade"].call()}, "legs": {"mat": "windLeg", "trim": "windTrim", "wraps": "windTrim", "knee": null, "tasset": null, "rune": null, "bulk": 0.35, "over": _fn1}}, FX])

# -----------------------------------------------------------------------------
# Cloudwalker Sandals
# -----------------------------------------------------------------------------
static func cloudwalker_sandals() -> Variant:
	# Maroon cloth wound up the shin and criss-crossed with saffron straps over thick wooden soles, a bronze
	# anklet with a jade bead, and little clouds puffing round the heel with every step.
	var _fn0 = func(r, shin, foot, m, c):
		var o = {"group": c["g"], "toneBias": c["bias"]}
		var ph: float = fmod(r.phase, 4)
		var w: float = c["w"]
		# Saffron straps criss-crossing up the wraps.
		var x: float = 2
		while (x + 1.6) < c["top"]:
			r.line(shin.x(x, -w), shin.y(x, -w), shin.x(x + 1.6, w), shin.y(x + 1.6, w), m.call("k.strap"), (2 if c["far"] else 3), c["g"])
			r.line(shin.x(x, w), shin.y(x, w), shin.x(x + 1.6, -w), shin.y(x + 1.6, -w), m.call("k.strap"), (1 if c["far"] else 2), c["g"])
			x += 2.2
		# The wooden sole under the foot.
		r.fill(foot.cap(-1.8, -2.1, c["toe"] - 0.3, -1.3, 0.6, 0.5), m.call("k.sole"), TS.merge([o, {"bevel": 0.5}]))
		# The anklet and its jade bead.
		r.fill(shin.rect(1.4, 0, 0.45, w + 0.35), m.call("k.anklet"), TS.merge([o, {"bevel": 0.4}]))
		if c["far"]:
			return
		dot(r, shin, 1.4, w + 0.3, m.call("k.jade"), 3, c["g"])
		# Clouds puffing round the heel, rolling back and thinning out over the loop.
		var roll: float = ([0, 0.5, 1, 1.5])[ph]
		for k in range(3):
			var x_2: float = ((-2.4) - (k * 1.5)) - (roll * 0.6)
			var y: float = ((-1.6) + (k * 0.5)) + (sin(ph + k) * 0.3)
			var rr: float = (1.15 - (k * 0.25)) - (roll * 0.08)
			if rr > 0.45:
				r.fill(foot.circ(x_2, y, rr), m.call("k.cloud"), {"group": 33, "bevel": 0.6, "toneBias": (-1 if k > 1 else 0)})
	return TS.merge([{"mats": {"zephyr": S["maroon"].call(wound), "zephyrTrim": S["bronze"].call(null), "k.strap": S["saffron"].call(), "k.sole": S["wood"].call(), "k.anklet": S["bronze"].call(null), "k.jade": S["jade"].call(), "k.cloud": S["cloud"].call()}, "boots": {"wing": null, "height": 0.62, "over": _fn0}}, FX])

static func wind_dot(g, px: float, py: float, i: float) -> void:
	# Dashes racing round: a whirlwind on the ground.
	var k: float = fmod((i + auraStep), 10)
	if k > 4:
		return
	g["fillStyle"] = (AC["wind"] if k == 0 else AC["windDeep"])
	g["fillRect"].call(px, py, 1, 1)

##  The full-set aura around the feet at (x, y) art pixels; `t` is seconds.
static func skybell_aura(g, x: float, y: float, t: float, layer: String) -> void:
	var back: bool = layer == "back"
	# A whirlwind ring at the feet, its dashes racing round.
	auraStep = fmod(floor(t * 14), 10)
	g["globalAlpha"] = 0.65
	RenderAuraKit.ring(g, x, y, 14, 3.6, 40, layer, wind_dot)
	# A string of prayer flags circling the shins on the wind, its flags rippling.
	var turn: float = t * 0.7
	var n: float = 9
	var RX: float = 16
	var RY: float = 4.2
	var cy: float = y - 7
	g["globalAlpha"] = (0.7 if back else 0.95)
	for k in range(ceili(n)):
		var a: float = turn + (((k / n) * PI) * 2)
		var s: float = sin(a)
		if (s < 0) != back:
			continue
		var bob: float = sin((t * 3) + (k * 1.3)) * 0.6
		var px: float = TS.round(x + (cos(a) * RX))
		var py: float = TS.round((cy + (s * RY)) + bob)
		# The cord sagging to the next flag.
		g["fillStyle"] = AC["cord"]
		for j in range(1, 4):
			var b: float = a + ((j / 4.0) * ((PI * 2) / n))
			g["fillRect"].call(TS.round(x + (cos(b) * RX)), TS.round(((cy + (sin(b) * RY)) + bob) + (1 if j == 2 else 0.5)), 1, 1)
		# The far side of the circle in shadow.
		g["fillStyle"] = (AC["flagsDim"] if back else AC["flags"])[k % 5]
		var fl: float = (1 if sin((t * 9) + (k * 2.1)) > 0 else 0)
		g["fillRect"].call(px - 1, py, 2, 2 + fl)
	# Marigold petals spiralling up round the fighter on the wind.
	for k_2 in range(6):
		var u: float = fmod((t * 0.28) + (k_2 / 6.0), 1)
		var a_2: float = ((t * 2.2) + (k_2 * 2.4)) + (u * 5)
		var s_2: float = sin(a_2)
		if (s_2 < 0) != back:
			continue
		var rr: float = 10 + (u * 6)
		var px_2: float = TS.round(x + (cos(a_2) * rr))
		var py_2: float = TS.round(((y - 3) - (u * 34)) + (s_2 * 3))
		g["globalAlpha"] = min(1, (1 - u) * 3, u * 8)
		g["fillStyle"] = (AC["petal"] if k_2 % 2 else AC["petal2"])
		g["fillRect"].call(px_2, py_2, 1, 1)
		if sin((t * 7) + k_2) > 0.2:
			g["fillRect"].call(px_2 + (1 if cos(a_2) > 0 else -1), py_2, 1, 1)
	g["globalAlpha"] = 1
