	var c: float = cos(a)
	var n: float = sin(a)
	r.fill(t.poly([x, y, (x + ((c * s) * 0.5)) - ((n * s) * 0.32), (y + ((n * s) * 0.5)) + ((c * s) * 0.32), x + (c * s), y + (n * s), (x + ((c * s) * 0.5)) + ((n * s) * 0.32), (y + ((n * s) * 0.5)) - ((c * s) * 0.32)]), m, {"group": g})

##  The half of frame t on the leading side of local x = cx (front) or the trailing side.
static func side(t, cx: float, front: bool) -> Variant:
	var c: float = cos(t.ang)
	var n: float = sin(t.ang)
	return (PixelSdf.half_plane(t.x(cx, 0), t.y(cx, 0), -c, n) if front else PixelSdf.half_plane(t.x(cx, 0), t.y(cx, 0), c, -n))

##  The accretion disk: a tilted ring of burning matter round the hole, the half behind it or the half in front.
static func disk(r, t, cx: float, f: float, front: bool, h, g: float) -> void:
	var half = side(t, cx, front)
	r.fill(PixelSdf.intersect(PixelSdf.subtract(t.ell(cx, 0, 5.6, 13.4, 0.3), t.ell(cx, 0, 4.2, 10.6, 0.3)), half), h.call("diskDeep"), {"group": g})
	r.fill(PixelSdf.intersect(PixelSdf.subtract(t.ell(cx, 0, 5, 12.4, 0.3), t.ell(cx, 0, 4.4, 11.2, 0.3)), half), h.call("disk"), {"group": g})
	# Hot knots riding round the disk, a step each frame.
	for k in range(4):
		var a: float = (((k / 4.0) * PI) * 2) + (f * (PI / 8.0))
		var x: float = cos(a) * 4.7
		var y: float = sin(a) * 11.8
		var c: float = cos(0.3)
		var sn: float = sin(0.3)
		var lx: float = (cx + (x * c)) - (y * sn)
		var ly: float = (x * sn) + (y * c)
		if (lx > cx) != front:
			continue
		r.dot(t.x(lx, ly), t.y(lx, ly), h.call("hot"), 3, g)
