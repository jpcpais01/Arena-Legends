	g["globalAlpha"] = 0.7 * a
	g["fillStyle"] = AC["white"]
	var ex: float = (hx - 5 if s < 0 else hx + 6)
	g["fillRect"].call(ex, y - 10, 1, 2)
	g["fillRect"].call(ex + s, y - 7, 1, 2)

