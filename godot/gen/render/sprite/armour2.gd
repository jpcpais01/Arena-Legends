# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
static func ramp(base: float, r, o = null) -> Variant:
	if o == null: o = {}
	return (TS.merge([{"base": base, "ramp": r}, o]))

##  A tapering chain of capsules through [x, y, radius] points.
static func chain(F, pts) -> Variant:
	var s = []
	for i in range(1, pts.size()):
		s.append(F.cap(pts[i - 1][0], pts[i - 1][1], pts[i][0], pts[i][1], pts[i - 1][2], pts[i][2]))
	return PixelSdf.union.callv(TS.arr(s))

##  Line in a local frame.
static func ln(r, F, ax: float, ay: float, bx: float, by: float, mat: float, tone: float, g: float) -> void:
	r.line(F.x(ax, ay), F.y(ax, ay), F.x(bx, by), F.y(bx, by), mat, tone, g)

static func dt(r, F, x: float, y: float, mat: float, tone: float, g: float) -> void:
	r.dot(F.x(x, y), F.y(x, y), mat, tone, g)

##  The torso's main volumes (as drawn by the figure), for clipping bands and seams to it.
static func torso_body(T, b, top: float) -> Variant:
	return PixelSdf.union(T.ell(0.3, 0.6, b["hipW"], 3.6), T.ell(0.5, top * 0.46, b["waistW"], top * 0.28), T.ell(b["chestPush"] * 0.7, top - 3.4, b["chestW"], 5.4))

##  A lumpy roll (fur, moss) from (ax, ay) to (bx, by).
static func roll(F, ax: float, ay: float, bx: float, by: float, rad: float, n: float) -> Variant:
	var parts = [F.cap(ax, ay, bx, by, rad * 0.85)]
	for i in range(floori(n) + 1):
		var u: float = i / n
		parts.append(F.circ(ax + ((bx - ax) * u), ay + ((by - ay) * u), rad * (1.08 if i % 2 else 0.9)))
	return PixelSdf.union.callv(TS.arr(parts))

##  A small leaf at (x, y) pointing along angle `a`.
static func leaf(F, x: float, y: float, a: float, len_: float, w: float) -> Variant:
	var c: float = cos(a)
	var s: float = sin(a)
	var p = (func(u: float, v: float): return [(x + (c * u)) - (s * v), (y + (s * u)) + (c * v)])
	return F.poly((TS.arr(p.call(0, 0)) + TS.arr(p.call(len_ * 0.4, w)) + TS.arr(p.call(len_, 0)) + TS.arr(p.call(len_ * 0.4, -w))))

static func bark_tex(x: float, y: float, _a2 = null):
	return (TX.sel(TX.lt(SkinsKit.wrap___tx(TX.add(TX.mul(x, 0.75), TX.mul(TX.sin(TX.mul(y, 0.45)), 1.1)), 2.6), 0.7), -1, 0))

##  The stock headgear look for a new head piece, if it is one.
static func stock_head(id) -> Variant:
	return (TS.nn((null if ARMOUR2.get(id) == null else ARMOUR2.get(id).get("head")), null) if id else null)
