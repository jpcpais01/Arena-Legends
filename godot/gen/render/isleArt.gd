		var r: float = maxf(2.5, th * rng.range_(0.4, 0.6))
		tmp.rect(TS.round(tx), TS.round(ttop - (th * 0.6)), (2 if w > 60 else 1), ceil(th * 0.6), SG["bark"][1])
