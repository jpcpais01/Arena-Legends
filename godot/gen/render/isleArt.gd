		var dx: float = ((k if k < 4 else 8 - k) - 2 if glyph == 0 else (0 if glyph == 1 else (-2 if k == 4 else 0)))
		p.set_(rx + dx, y_2, SG["rune"][2])
		if (glyph == 2) and (k == 4):
			p.set_(rx - 1, y_2, SG["rune"][2])
			p.set_(rx + 1, y_2, SG["rune"][2])
		p.set_((rx + dx) + 1, y_2, SG["rune"][0])
		y_2 += 1
