# --- The grove on the island's back edge ------------------------------------------
static func paint_tree(rng, h: float, leaves, seed_: float) -> Variant:
	var cr: float = TS.round(h * rng.range_(0.25, 0.32))
	var lean: float = rng.range_(-0.12, 0.12)
	var w: float = ceil(((cr * 3) + 12) + ((absf(lean) * h) * 2))
	var ph: float = h + 2
	var p = PixelPaint.Pix.new(w, ph)
	var cx: float = w / 2.0
	var base: float = ph - 1
	var ccy: float = cr + 3
	var tw: float = maxf(4, TS.round(h * 0.055))
	var at = (func(y: float): return (cx + (lean * (base - y))) + (sin((base - y) * 0.09) * 1.2))
	var y_2: float = TS.round(ccy)
	while y_2 <= base:
		var flare: float = ((y_2 - (base - 6)) * 0.8 if y_2 > (base - 6) else 0)
		var xl: float = TS.round((at.call(y_2) - (tw / 2.0)) - flare)
		var xr: float = TS.round((at.call(y_2) + (tw / 2.0)) + flare)
		var x: float = xl
		while x <= xr:
			var c: float = (SG["bark"][0] if x == xl else (SG["bark"][2] if x >= (xr - 1) else SG["bark"][1]))
			if ((x > xl) and (x < (xr - 1))) and (RenderScenery.hash_(x, (((((int(y_2)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 2), seed_) < 0.22):
				c = SG["bark"][0]
			p.set_(x, y_2, c)
			x += 1
		y_2 += 1
	# Branches reaching into the crown.
	for s in [-1, 1]:
		var by: float = TS.round(ccy + (cr * rng.range_(0.5, 0.9)))
		var bx: float = at.call(by)
		for i in range(ceili(cr * 0.8)):
			p.set_(TS.round(bx + (s * i)), TS.round(by - (i * 0.7)), SG["bark"][1])
			p.set_(TS.round(bx + (s * i)), TS.round((by - (i * 0.7)) + 1), SG["bark"][0])
	var blobs = [{"x": at.call(ccy), "y": ccy + (cr * 0.15), "rx": cr * 1.15, "ry": cr * 0.72}]
	var n: float = rng.int(6, 9)
	for i_2 in range(ceili(n)):
		var a: float = (PI + ((i_2 / (n - 1)) * PI)) + rng.range_(-0.2, 0.2)
		var r: float = cr * rng.range_(0.38, 0.55)
		blobs.append({"x": at.call(ccy) + ((cos(a) * cr) * 0.85), "y": (ccy + ((sin(a) * cr) * 0.55)) + (cr * 0.15), "rx": r * 1.15, "ry": r * 0.85})
	foliage(p, blobs, leaves, seed_)
	# A few hanging vines.
	for i_3 in range(3):
		if not rng.chance(0.6):
			continue
		var vx: float = TS.round(at.call(ccy) + rng.range_(-cr, cr))
		var vy: float = TS.round(ccy + (cr * 0.75))
		var len_: float = rng.int(5, 16)
		for k in range(ceili(len_)):
			p.set_(vx + (1 if (k % 6) == 3 else 0), vy + k, leaves[1])
			if (k % 3) == 1:
				p.set_(vx + (1 if ((((((k) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 1) & 1) else -1), vy + k, leaves[3])
	p.outline(SG["ink"])
	return p

static func paint_arch(rng) -> Variant:
	var w: float = 54
	var h: float = 76
	var col_w: float = 9
	var p = PixelPaint.Pix.new(w + 6, h + 2)
	var ox: float = 3
	var acy: float = 27
	var R: float = w / 2.0
	var r: float = R - 8
	var ax: float = ox + (w / 2.0)
	var S = SG["stone"]
	var broke_top: float = acy + rng.int(8, 20)
	for _e0 in [[ox, acy], [(ox + w) - col_w, broke_top]]:
		var c0 = _e0[0]
		var y_top = _e0[1]
		var y: float = y_top
		while y < h:
			var x: float = c0
			while x < (c0 + col_w):
				if ((y < (y_top + 3)) and (RenderScenery.hash_(x, y, 3) < 0.5)) and (c0 != ox):
					x += 1
					continue
				var u: float = (x - c0) / (col_w - 1)
				var c: float = (S[0] if u < 0.2 else (S[2] if u > 0.75 else S[1]))
				if (fmod((y - acy), 10) == 0) or (RenderScenery.hash_(x, y, 5) < 0.05):
					c = S[0]
				p.set_(x, y, c)
				x += 1
			y += 1
	# Broken just past the keystone.
	var cut: float = rng.range_(1.2, 1.42)
	var y_2: float = acy - R
	while y_2 <= acy:
		var x_2: float = ax - R
		while x_2 <= (ax + R):
			var d: float = sqrt(((x_2 + 0.5) - ax) * ((x_2 + 0.5) - ax) + ((y_2 + 0.5) - acy) * ((y_2 + 0.5) - acy))
			if (d < r) or (d > R):
				x_2 += 1
				continue
			var a: float = atan2((y_2 + 0.5) - acy, (x_2 + 0.5) - ax)
			if a > (-cut):
				x_2 += 1
				continue
			var c_2: float = (S[2] if d > (R - 1.5) else (S[0] if d < (r + 1) else S[1]))
			if absf(fmod((a + PI) / 0.32, 1)) < 0.1:
				c_2 = S[0]
			p.set_(x_2, y_2, c_2)
			x_2 += 1
		y_2 += 1
	# Fallen blocks at the foot of the broken side.
	for i in range(3):
		var bx: float = ((((ox + w) - col_w) - 10) + (i * 7)) + rng.int(-1, 1)
		var bw: float = rng.int(5, 8)
		var bh: float = rng.int(3, 5)
		p.rect(bx, h - bh, bw, bh, S[1])
		p.rect(bx, h - bh, bw, 1, S[2])
		p.rect(bx, h - 1, bw, 1, S[0])
	# Moss on every top surface, dripping a little.
	for x_3 in range(ceili(p.w)):
		var y_3: float = 0
		while (y_3 < p.h) and (not p.has(x_3, y_3)):
			y_3 += 1
		if y_3 >= (p.h - 4):
			continue
		var drip: float = (3 if RenderScenery.hash_(x_3, 0, 9) < 0.25 else 1)
		for k in range(floori(drip) + 1):
			p.set_(x_3, y_3 + k, (SG["grass"][3] if k == 0 else SG["grass"][2]))
	# Ivy down the left column.
	var y_4: float = acy + 4
	while y_4 < (h - 6):
		var x_4: float = (ox + 2) + TS.round(sin(y_4 * 0.35) * 2)
		p.set_(x_4, y_4, SG["leaves"][1])
		if fmod(y_4, 3) == 0:
			p.set_(x_4 + 1, y_4, SG["leaves"][3])
		y_4 += 1
	p.outline(SG["ink"])
	return p

##  A stone lantern with a glowing crystal behind its window.
static func paint_lantern() -> Variant:
	var p = PixelPaint.Pix.new(11, 24)
