##  A mossy boulder, lit from the upper right.
static func boulder(p, x: float, base: float, rx: float, ry: float) -> void:
	var cy: float = base - ry
	var y: float = floor(cy - ry)
	while y <= base:
		var xx: float = floor(x - rx)
		while xx <= (x + rx):
			var u: float = ((xx + 0.5) - x) / rx
			var v: float = ((y + 0.5) - cy) / ry
			var d: float = (u * u) + (v * v)
			if d > 1:
				xx += 1
				continue
			var c: float = RenderScenery.tone(SG["stone"], (0.55 - (v * 0.4)) + (u * 0.25), xx, y)
			if v < ((-0.35) + (sin(xx * 0.9) * 0.15)):
				c = (SG["grass"][3] if v < (-0.7) else SG["grass"][2])
			p.set_(xx, y, c)
			xx += 1
		y += 1

##  Paints the grove; returns the lanterns' crystal windows (layer coordinates).
static func paint_grove(p, sa, sb, rng, floor_top: float, hw_l: float, hw_r: float, sky: float) -> Variant:
	var cx: float = p.w / 2.0
	var left: float = cx - hw_l
	var right: float = cx + hw_r
	# Back row: tall, hazed trees, leaving the middle open for the view.
	var x: float = left + rng.range_(10, 30)
	while x < (right - 10):
		if absf(x - cx) < 46:
			x += rng.range_(64, 110)
			continue
		var t = paint_tree(rng, rng.int(100, 146), (SG["blossom"] if rng.chance(0.22) else SG["leaves"]), rng.int(0, 9999))
		RenderScenery.haze(t, sky, 0.24)
		p.blit(t, TS.round(x - (t.w / 2.0)), (floor_top - 8) - t.h)
		x += rng.range_(64, 110)
	# A ruined arch framing the middle, stone lanterns either side.
	var arch = paint_arch(rng)
	var ax: float = TS.round(cx + rng.range_(-24, 24))
	p.blit(arch, ax - (((((int(arch.w)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 1), (floor_top - 6) - arch.h)
	var lantern = paint_lantern()
	var lamps = []
	for s in [-1, 1]:
		p.blit(lantern, (ax + (s * 46)) - (((((int(lantern.w)) + 0x80000000) & 0xFFFFFFFF) - 0x80000000) >> 1), (floor_top - 5) - lantern.h)
		lamps.append([ax + (s * 46), ((floor_top - 5) - lantern.h) + 6])
	# Front row: fewer, bigger crowns.
	var x_2: float = left + rng.range_(40, 90)
	while x_2 < (right - 30):
		if absf(x_2 - cx) < 90:
			x_2 += rng.range_(150, 240)
			continue
		var t_2 = paint_tree(rng, rng.int(80, 116), (SG["blossom"] if rng.chance(0.3) else SG["leaves"]), rng.int(0, 9999))
		p.blit(t_2, TS.round(x_2 - (t_2.w / 2.0)), (floor_top - 4) - t_2.h)
		x_2 += rng.range_(150, 240)
	# Bushes, boulders, mushrooms and long grass along the edge, shrinking toward the ends.
	var band = PixelPaint.Pix.new(p.w, 34)
	var by: float = band.h - 1
	var x_3: float = maxf(0, floor(left))
	while x_3 < minf(p.w, right):
		var y: float = by - 3
		while y <= by:
			band.set_(x_3, y, (SG["grass"][2] if PixelPaint.bayer(x_3, y) < 0.3 else SG["grass"][1]))
			y += 1
		x_3 += 1
	var x_4: float = left + rng.range_(0, 6)
	while x_4 < right:
		var edge: float = minf(x_4 - left, right - x_4)
		if edge < 2:
			x_4 += rng.range_(8, 15)
			continue
		var k: float = minf(1, 0.3 + (edge / 50.0))
		var rx: float = rng.range_(8, 15) * k
		var ry: float = rng.range_(6, 11) * k
		var pal = (SG["blossom"] if rng.chance(0.12) else SG["bush"])
		foliage(band, [{"x": x_4, "y": by - (ry * 0.6), "rx": rx, "ry": ry}, {"x": x_4 + (rx * 0.6), "y": by - (ry * 0.3), "rx": rx * 0.7, "ry": ry * 0.7}], pal, rng.int(0, 9999))
		if is_same(pal, SG["bush"]):
			for i in range(3):
				if rng.chance(0.5):
					band.set_(TS.round(x_4 + (rng.range_(-rx, rx) * 0.6)), TS.round(by - (ry * rng.range_(0.3, 1.1))), rng.pick(SG["flowers"]))
		x_4 += rng.range_(8, 15)
	var x_5: float = left + rng.range_(20, 60)
	while x_5 < (right - 20):
		if absf(x_5 - ax) < 40:
			x_5 += rng.range_(60, 120)
			continue
		var r: float = rng.range_(5, 9)
		boulder(band, x_5, by, r, r * rng.range_(0.6, 0.8))
		# Mushrooms at the foot.
		var i_2: float = 0
		while i_2 < rng.int(1, 3):
			var mx: float = TS.round(((x_5 + r) + 2) + (i_2 * 3))
			var mh: float = rng.int(2, 4)
			band.rect(mx, (by - mh) + 1, 1, mh, 0xf0e0c8)
			band.rect(mx - 1, by - mh, 3, 1, 0xd8483a)
			band.set_(mx, (by - mh) - 1, 0xd8483a)
			band.set_(mx - 1, by - mh, 0xfff0e0)
			i_2 += 1
		x_5 += rng.range_(60, 120)
	var x_6: float = maxf(0, floor(left + 3))
	while x_6 < minf(p.w, right - 3):
		if RenderScenery.hash_(x_6, 1, 31) < 0.35:
			var hgt: float = 2 + floor(RenderScenery.hash_(x_6, 2, 31) * 4)
			for k_2 in range(ceili(hgt)):
				band.set_(x_6, by - k_2, (SG["grass"][4] if k_2 == (hgt - 1) else SG["grass"][3]))
		x_6 += 1
	band.outline(SG["ink"])
	p.blit(band, 0, (floor_top - band.h) + 1)
	# Tall stalks and flower stems swaying in the wind (two frames).
	var x_7: float = left + rng.range_(2, 6)
	while x_7 < (right - 4):
		var base: float = floor_top - rng.int(1, 6)
		var hgt_2: float = rng.int(6, 14)
		var head: float = (rng.pick(SG["flowers"]) if rng.chance(0.35) else (SG["dirt"][2] if rng.chance(0.4) else -1))
		var stem: float = (SG["grass"][3] if rng.chance(0.5) else SG["grass"][2])
		for _e0 in [[sa, rng.range_(0, 0.6)], [sb, rng.range_(1.2, 2.2)]]:
			var buf = _e0[0]
			var lean = _e0[1]
			var tx: float = 0
			for k_3 in range(ceili(hgt_2)):
				tx = TS.round(x_7 + (lean * pow((k_3 / hgt_2), 2)))
				buf.set_(tx, base - k_3, stem)
				if (k_3 > 2) and ((k_3 % 4) == 2):
					buf.set_(tx + (1 if (k_3 & 4) else -1), base - k_3, SG["grass"][4])
			if head >= 0:
				buf.set_(tx, base - hgt_2, head)
				buf.set_(tx + 1, base - hgt_2, head)
				buf.set_(tx, (base - hgt_2) - 1, PixelColor.mix(head, 0xffffff, 0.35))
		x_7 += rng.range_(4, 9)
	return lamps

# --- Floor and underside -------------------------------------------------------------
##  The meadow: u = world px (centre at w/2), v = depth row; transparent past the island's edge.
static func paint_meadow(rng, w: float, h: float, D: float, v_top: float, edge_at, lip_at) -> Variant:
	var p = PixelPaint.Pix.new(w, h)
	var cx: float = w / 2.0
	var G = SG["grass"]
	var dt = SG["dirt"]
	var v_back: float = D * 1.22
	for v in range(ceili(h)):
		var hl: float = edge_at.call(v, -1)
		var hr: float = edge_at.call(v, 1)
		if (hl <= 0) or (hr <= 0):
			continue
		var z: float = v * 2.6
		var x: float = maxf(0, floor(cx - hl))
		while x < minf(w, ceil(cx + hr)):
			var du: float = (x + 0.5) - cx
			var edge: float = (hl + du if du < 0 else hr - du)
			if edge < 0:
				x += 1
				continue
			var lip: float = lip_at.call(du)
			if v < lip:
				# Front face showing through the ragged lip: soil with root ends.
				p.set_(x, v, (SG["bark"][1] if RenderScenery.hash_(x, v, 9) < 0.06 else (SG["soil"][0] if PixelPaint.bayer(x, v) < ((lip - v) / 5.0) else SG["soil"][1])))
				x += 1
				continue
			# The trodden path the fighters duel on, ragged at the edges.
			var pc: float = D + ((RenderScenery.noise(du, 0, 90, 0, 11) - 0.5) * 5)
			var ph: float = (5 + (RenderScenery.noise(du, 0, 34, 0, 12) * 3.5)) * minf(1, edge / 70.0)
			var pd: float = absf(v - pc) - ph
			var c: float
			if (pd < (-0.5)) or ((pd < 1.5) and (PixelPaint.bayer(x, v) < (0.5 - (pd * 0.4)))):
				var n: float = RenderScenery.noise(du, z, 14, 6, 13) + ((PixelPaint.bayer(x, v) - 0.5) * 0.3)
				c = (dt[0] if n < 0.35 else (dt[2] if n > 0.72 else dt[1]))
				var r: float = RenderScenery.hash_(x, v, 14)
				if r < 0.025:
					c = SG["stone"][2]
				elif (pd > (-2.5)) and (r < 0.3):
					c = G[2]
			else:
				var n_2: float = ((RenderScenery.noise(du, z, 26, 26, 21) * 0.7) + (RenderScenery.noise(du, z, 7, 7, 22) * 0.3)) + ((PixelPaint.bayer(x, v) - 0.5) * 0.22)
				var i: float = (1 if n_2 < 0.36 else (3 if n_2 > 0.64 else 2))
				var r_2: float = RenderScenery.hash_(x, v, 23)
				if r_2 < 0.07:
					i = minf(4, i + 1)
				elif r_2 < 0.13:
