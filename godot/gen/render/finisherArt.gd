## The great sword of Judgement, point down: the tip at (x, tip), a blade
## `len` px long rising from it to a winged golden guard, the grip and a
## pommel, a gem set in the guard. `glow` brightens its edges.
static func draw_great_sword(g, x: float, tip: float, len_: float, scale: float, glow: float, gem: float, alpha: float) -> void:
	if alpha <= 0:
		return
	var w: float = maxf(2, TS.round(5 * scale))
	var top: float = tip - len_
	g.global_alpha = alpha
	# Blade: an edge on each side, a fuller down the middle, tapering to the point.
	var y: float = top
	while y <= tip:
		var k: float = (y - top) / len_
		var ww: float = (maxf(0, TS.round(w * (1 - ((k - 0.82) / 0.18)))) if k > 0.82 else w)
		g.fill_style = "#c8b070"
		g.fill_rect(x - ww, y, (ww * 2) + 1, 1)
		g.fill_style = "#fff8e0"
		g.fill_rect((x - ww) + 1, y, maxf(1, ww - 1), 1)
		if (ww > 2) and (k < 0.78):
			g.fill_style = "#d8b850"
			g.fill_rect(x, y, 1, 1)
		if (glow > 0) and (fmod((y + floor(glow * 40)), 9) == 0):
			g.fill_style = "#ffffff"
			g.fill_rect(x - ww, y, 1, 1)
		y += 1
	# Guard: swept wings of gold, darker underneath.
	var gw: float = TS.round(17 * scale)
	var gy: float = top - 1
	var i: float = -gw
	while i <= gw:
		var lift: float = TS.round(((pow((absf(i) / gw), 2)) * 4) * scale)
		g.fill_style = "#8a5a10"
		g.fill_rect(x + i, (gy - lift) + 1, 1, maxf(2, TS.round(3 * scale)))
		g.fill_style = ("#fff0a0" if fmod(absf(i), 5) == 0 else "#ffd040")
		g.fill_rect(x + i, gy - lift, 1, maxf(1, TS.round(2 * scale)))
		i += 1
	RenderEntranceArt.blob(g, x, gy, TS.round(3 * scale), TS.round(3 * scale), "#ffd040")
	RenderEntranceArt.blob(g, x, gy, maxf(1, TS.round(1.6 * scale)), maxf(1, TS.round(1.6 * scale)), PixelColor.css(gem))
	g.fill_style = "#ffffff"
	g.fill_rect(x - 1, gy - 1, 1, 1)
	# Grip and pommel.
	var gl: float = TS.round(14 * scale)
	for y_2 in range(ceili(gl)):
		g.fill_style = ("#6a3a20" if y_2 % 3 else "#a86a30")
		g.fill_rect(x - maxf(1, TS.round(1.5 * scale)), (gy - (3 * scale)) - y_2, maxf(2, TS.round(3 * scale)), 1)
	RenderEntranceArt.blob(g, x, TS.round(((gy - (3 * scale)) - gl) - (2 * scale)), TS.round(3 * scale), TS.round(3 * scale), "#ffd040")
	g.global_alpha = 1

##  A ring of golden runes turning in the sky.
static func draw_rune_ring(g, cx: float, cy: float, r: float, k: float, t: float) -> void:
	if k <= 0:
		return
	var R: float = r * RenderEntranceArt.ease_out(k)
	var ry: float = R * 0.32
	g.global_alpha = minf(1, k * 1.4)
	for i in range(72):
		var a: float = ((i / 72.0) * PI) * 2
		g.fill_style = "#ffe070"
		g.fill_rect(TS.round(cx + (cos(a) * R)), TS.round(cy + (sin(a) * ry)), 1, 1)
		if (i % 2) == 0:
			g.fill_rect(TS.round(cx + ((cos(a) * R) * 0.8)), TS.round(cy + ((sin(a) * ry) * 0.8)), 1, 1)
	# Rune marks between the two rings, turning.
	g.fill_style = "#fff8d0"
	for i_2 in range(12):
		var a_2: float = (((i_2 / 12.0) * PI) * 2) + (t * 0.8)
		var x: float = TS.round(cx + ((cos(a_2) * R) * 0.9))
		var y: float = TS.round(cy + ((sin(a_2) * ry) * 0.9))
		g.fill_rect(x, y - 1, 1, 3)
		if (i_2 % 3) == 0:
			g.fill_rect(x - 1, y, 3, 1)
	g.global_alpha = 1

##  A rock to put a foot up on (the Champion pose): a rough lump with a lit top and a dark base.
static func draw_rock(g, cx: float, gy: float, w: float, h: float) -> void:
	RenderEntranceArt.blob(g, cx, gy - TS.round(h * 0.45), w, maxf(1, TS.round(h * 0.6)), "#4a4048")
	RenderEntranceArt.blob(g, cx - 1, gy - TS.round(h * 0.6), w - 2, maxf(1, TS.round(h * 0.4)), "#7a6c70")
	g.fill_style = "#a89a98"
	g.fill_rect((cx - w) + 3, gy - h, (w * 2) - 7, 1)
	g.fill_style = "#2a2228"
	g.fill_rect(cx - w, gy, w * 2, 1)
