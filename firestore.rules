rules_version = '2';

// Arena Legends accounts. Each player reads and writes only their own save;
// usernames are claimed once, by the account whose sign-in address carries them.
// Friends: any signed-in player can look a name up and see a shared hero;
// friend requests and friend lists are only seen by the two players involved.
service cloud.firestore {
  match /databases/{database}/documents {

    // usernames/{lowercase name} -> { uid, name }
    match /usernames/{name} {
      // Any signed-in player can look a name up (adding a friend by name).
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.auth.token.email == name + '@users.arenalegends.app'
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.lower() == name;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, update: if false;
    }

    // players/{uid} -> { name, save: { localStorage key: JSON string }, at, v }
    match /players/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'save', 'at', 'v'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.save is map
        && request.resource.data.save.size() <= 64
        && request.resource.data.at is int;
      allow list, delete: if false;
    }

    // heroes/{uid} -> { name, hero: the hero as a JSON string, w, l, at }: what friends see.
    match /heroes/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'hero', 'w', 'l', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.hero is string
        && request.resource.data.hero.size() <= 8000
        && request.resource.data.w is int
        && request.resource.data.l is int
        && request.resource.data.at is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }

    // requests/{from}_{to} -> { from, to, fromName, toName, at }: a pending friend request.
    match /requests/{id} {
      allow get: if request.auth != null
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.fromName is string
        && request.resource.data.toName is string
        && request.resource.data.at is int
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.fromName.lower())).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.toName.lower())).data.uid == request.resource.data.to;
      allow update: if false;
    }

    // friends/{uid}/list/{other} -> { name, at }: written for both players by the one who accepts a request.
    match /friends/{uid}/list/{other} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.at is int
        && ((request.auth.uid == uid && exists(/databases/$(database)/documents/requests/$(other + '_' + uid)))
          || (request.auth.uid == other && exists(/databases/$(database)/documents/requests/$(uid + '_' + other))));
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == other);
      allow update: if false;
    }

    // invites/{from}_{to} -> { from, to, fromName, code, at, state }: a battle invite to a friend.
    // The inviter hosts online room `code`; the friend accepts or declines by setting `state`.
    match /invites/{id} {
      function validInvite() {
        let d = request.resource.data;
        return d.keys().hasOnly(['from', 'to', 'fromName', 'code', 'at', 'state'])
          && d.from == request.auth.uid
          && d.to is string
          && d.to != request.auth.uid
          && id == request.auth.uid + '_' + d.to
          && d.code is string
          && d.code.matches('^[0-9]{5}$')
          && d.at is int
          && d.state == 'open'
          && d.fromName is string
          && get(/databases/$(database)/documents/usernames/$(d.fromName.lower())).data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(d.to));
      }
      allow get: if request.auth != null
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && validInvite();
      allow update: if request.auth != null
        && ((resource.data.from == request.auth.uid && validInvite())
          || (resource.data.to == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
            && request.resource.data.state in ['accepted', 'declined']));
    }
  }
}
